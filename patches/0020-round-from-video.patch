+import AVFoundation
+import UIKit
+
+/// Кружок из любого видео — как на ПК: ролик обрезается до квадрата по
+/// центру, ужимается до размера кружка и укорачивается до минуты. Звук
+/// остаётся.
+///
+/// Здесь только сама обработка ролика. Отправляет готовый файл Telegram —
+/// тем же путём, что и записанный с камеры кружок.
+public enum LunagramRoundVideoMaker {
+    /// Сторона кружка в точках видео. Столько же пишет камера Telegram.
+    public static let side: Int = 400
+    /// Кружок у Telegram не длиннее минуты.
+    public static let maxDuration: Double = 60.0
+
+    public struct Result {
+        public let url: URL
+        public let duration: Double
+        public let thumbnail: UIImage?
+    }
+
+    public enum MakeError: Error {
+        case noVideo
+        case exportFailed
+    }
+
+    /// Делает кружок из ролика. Завершение приходит не на главной очереди.
+    public static func make(from source: URL, completion: @escaping (Swift.Result<Result, MakeError>) -> Void) {
+        // Без расширения система не узнаёт в файле видео, а Telegram хранит
+        // скачанное как раз без него — работаем с копией.
+        let workDirectory = FileManager.default.temporaryDirectory.appendingPathComponent("lunagram-round-\(UUID().uuidString)", isDirectory: true)
+        let input = workDirectory.appendingPathComponent("input.mp4")
+        let output = workDirectory.appendingPathComponent("video.mp4")
+        do {
+            try FileManager.default.createDirectory(at: workDirectory, withIntermediateDirectories: true, attributes: nil)
+            try FileManager.default.copyItem(at: source, to: input)
+        } catch {
+            completion(.failure(.noVideo))
+            return
+        }
+
+        let asset = AVURLAsset(url: input)
+        guard let track = asset.tracks(withMediaType: .video).first else {
+            completion(.failure(.noVideo))
+            return
+        }
+        let duration = min(CMTimeGetSeconds(asset.duration), maxDuration)
+        guard duration > 0.0 else {
+            completion(.failure(.noVideo))
+            return
+        }
+        let timeRange = CMTimeRange(start: .zero, duration: CMTime(seconds: duration, preferredTimescale: 600))
+
+        // Ролики с телефона часто сняты боком и лишь помечены поворотом.
+        // Сначала поворачиваем, потом режем квадрат по центру и ужимаем.
+        let rotated = CGRect(origin: .zero, size: track.naturalSize).applying(track.preferredTransform)
+        let width = abs(rotated.width)
+        let height = abs(rotated.height)
+        let crop = min(width, height)
+        guard crop > 0.0 else {
+            completion(.failure(.noVideo))
+            return
+        }
+        let scale = CGFloat(side) / crop
+        let transform = track.preferredTransform
+            .concatenating(CGAffineTransform(translationX: -rotated.minX, y: -rotated.minY))
+            .concatenating(CGAffineTransform(translationX: -(width - crop) / 2.0, y: -(height - crop) / 2.0))
+            .concatenating(CGAffineTransform(scaleX: scale, y: scale))
+
+        let layerInstruction = AVMutableVideoCompositionLayerInstruction(assetTrack: track)
+        layerInstruction.setTransform(transform, at: .zero)
+        let instruction = AVMutableVideoCompositionInstruction()
+        instruction.timeRange = timeRange
+        instruction.layerInstructions = [layerInstruction]
+        let videoComposition = AVMutableVideoComposition()
+        videoComposition.renderSize = CGSize(width: side, height: side)
+        videoComposition.frameDuration = CMTime(value: 1, timescale: 30)
+        videoComposition.instructions = [instruction]
+
+        guard let export = AVAssetExportSession(asset: asset, presetName: AVAssetExportPresetMediumQuality) else {
+            completion(.failure(.exportFailed))
+            return
+        }
+        export.outputURL = output
+        export.outputFileType = .mp4
+        export.videoComposition = videoComposition
+        export.timeRange = timeRange
+        export.shouldOptimizeForNetworkUse = true
+        export.exportAsynchronously {
+            try? FileManager.default.removeItem(at: input)
+            guard export.status == .completed else {
+                completion(.failure(.exportFailed))
+                return
+            }
+            completion(.success(Result(url: output, duration: duration, thumbnail: firstFrame(of: output))))
+        }
+    }
+
+    /// Первый кадр — превью, пока кружок грузится.
+    private static func firstFrame(of url: URL) -> UIImage? {
+        let generator = AVAssetImageGenerator(asset: AVURLAsset(url: url))
+        generator.appliesPreferredTrackTransform = true
+        guard let image = try? generator.copyCGImage(at: .zero, actualTime: nil) else {
+            return nil
+        }
+        return UIImage(cgImage: image)
+    }
+}
