index 00000000..4711ff8a
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramRoundFromVideo.swift
@@ -0,0 +1,65 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import AccountContext
+import SaveToCameraRoll
+import OverlayStatusController
+import Lunagram
+
+// Lunagram: кружок из любого видео, как на ПК. У любого видео в чате в
+// меню есть «Отправить кружком»: ролик обрезается до квадрата по центру,
+// ужимается, укорачивается до минуты и уходит в тот же чат кружком — тем же
+// путём, что и записанный с камеры.
+
+func lunagramSendVideoAsRound(context: AccountContext, message: Message, file: TelegramMediaFile, present: @escaping (ViewController) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let progress = OverlayStatusController(theme: presentationData.theme, type: .loading(cancelled: nil))
+    present(progress)
+
+    let fail = {
+        progress.dismiss()
+        present(textAlertController(context: context, title: nil, text: "Не получилось сделать кружок из этого видео.", actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]))
+    }
+
+    // Видео может быть ещё не скачано — докачиваем, как «Сохранить в галерею».
+    let _ = (fetchMediaData(context: context, userLocation: .peer(message.id.peerId), mediaReference: .message(message: MessageReference(message), media: file))
+    |> mapToSignal { state, _ -> Signal<String, NoError> in
+        if case let .data(data) = state, data.isComplete {
+            return .single(data.path)
+        }
+        return .complete()
+    }
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { path in
+        LunagramRoundVideoMaker.make(from: URL(fileURLWithPath: path), completion: { result in
+            Queue.mainQueue().async {
+                guard case let .success(round) = result, let data = try? Data(contentsOf: round.url) else {
+                    fail()
+                    return
+                }
+                try? FileManager.default.removeItem(at: round.url.deletingLastPathComponent())
+
+                let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max))
+                context.engine.resources.storeResourceData(id: EngineMediaResource.Id(resource.id), data: data, synchronous: true)
+
+                var previewRepresentations: [TelegramMediaImageRepresentation] = []
+                if let thumbnail = round.thumbnail, let thumbnailData = thumbnail.jpegData(compressionQuality: 0.6) {
+                    let thumbnailResource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max))
+                    context.engine.resources.storeResourceData(id: EngineMediaResource.Id(thumbnailResource.id), data: thumbnailData)
+                    previewRepresentations.append(TelegramMediaImageRepresentation(dimensions: PixelDimensions(thumbnail.size), resource: thumbnailResource, progressiveSizes: [], immediateThumbnailData: nil, hasVideo: false, isPersonal: false))
+                }
+
+                let side = Int32(LunagramRoundVideoMaker.side)
+                let media = TelegramMediaFile(fileId: EngineMedia.Id(namespace: Namespaces.Media.LocalFile, id: Int64.random(in: Int64.min ... Int64.max)), partialReference: nil, resource: resource, previewRepresentations: previewRepresentations, videoThumbnails: [], immediateThumbnailData: nil, mimeType: "video/mp4", size: Int64(data.count), attributes: [.FileName(fileName: "video.mp4"), .Video(duration: round.duration, size: PixelDimensions(width: side, height: side), flags: [.instantRoundVideo], preloadSize: nil, coverTime: nil, videoCodec: nil)], alternativeRepresentations: [])
+
+                let _ = enqueueMessages(account: context.account, peerId: message.id.peerId, messages: [.message(text: "", attributes: [], inlineStickers: [:], mediaReference: .standalone(media: media), threadId: message.threadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])]).startStandalone()
+                progress.dismiss()
+            }
+        })
+    })
+}
