+/// Рамка пропорцией телефона посередине образца.
+///
+/// Экран айфона примерно девять к девятнадцати с половиной. Показывать обои в
+/// лежачем прямоугольнике бессмысленно: на телефоне они лягут иначе, и по
+/// такому образцу не понять, что окажется видно.
+private func lunagramPhoneShapedFrame(in size: CGSize) -> CGRect {
+    let height = max(1.0, size.height - 16.0)
+    let width = min(max(1.0, size.width - 24.0), floor(height * 9.0 / 19.5))
+    return CGRect(x: floor((size.width - width) / 2.0), y: 8.0, width: width, height: height)
+}
