+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: все надписи Telegram, а не отобранная горсть.
+//
+// Отобранных у нас 71 — с понятными названиями, которые я им дал. Всего надписей
+// 12 913, и подмена работает по ключу для любой из них: ограничивал их только
+// мой список.
+//
+// Качать ничего не надо, в отличие от плагина, откуда взята задумка: весь
+// словарь надписей уже лежит в памяти клиента.
+//
+// Разбиваем по началу ключа — «Chat», «Conversation», «Settings». Получается
+// 697 разделов, самый крупный на 736 строк; каждый такой список телефон тянет
+// без труда, а вот 12 913 строк одним экраном — уже нет.
+
+/// Ключи всех надписей, разложенные по разделам. Считается один раз: разбор
+/// тринадцати тысяч ключей на каждое открытие экрана ни к чему.
+private final class LunagramWordingIndex {
+    static let shared = LunagramWordingIndex()
+
+    private var groups: [(name: String, keys: [String])]?
+    private var allKeys: [String]?
+    private let lock = NSLock()
+
+    /// Раздел — то, что стоит до первой точки. У ключа без точки раздел — он сам.
+    private static func group(of key: String) -> String {
+        if let dot = key.firstIndex(of: ".") {
+            return String(key[key.startIndex ..< dot])
+        }
+        return key
+    }
+
+    func build(strings: PresentationStrings) {
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        if self.groups != nil {
+            return
+        }
+        let keys = lunagramAllStringKeys(strings)
+        self.allKeys = keys.sorted()
+        var byName: [String: [String]] = [:]
+        for key in keys {
+            byName[LunagramWordingIndex.group(of: key), default: []].append(key)
+        }
+        self.groups = byName.keys.sorted(by: { $0.lowercased() < $1.lowercased() }).map { name in
+            return (name: name, keys: byName[name]!.sorted())
+        }
+    }
+
+    func allGroups(strings: PresentationStrings) -> [(name: String, keys: [String])] {
+        self.build(strings: strings)
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        return self.groups ?? []
+    }
+
+    func keys(inGroup name: String, strings: PresentationStrings) -> [String] {
+        return self.allGroups(strings: strings).first(where: { $0.name == name })?.keys ?? []
+    }
+
+    func everyKey(strings: PresentationStrings) -> [String] {
+        self.build(strings: strings)
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        return self.allKeys ?? []
+    }
+}
+
+/// Ключи всех надписей одним списком — для поиска.
+func lunagramEveryWordingKey(_ strings: PresentationStrings) -> [String] {
+    return LunagramWordingIndex.shared.everyKey(strings: strings)
+}
+
+/// Что сейчас написано по этому ключу: своё, если правил, иначе телеграмовское.
+///
+/// Свои слова передаём словарём, а не спрашиваем по одному: за ними каждый раз
+/// перечитывается и разбирается всё хранилище наборов, а ключей тут тринадцать
+/// тысяч. Один раз на список — и хватит.
+func lunagramWordingCurrentText(_ strings: PresentationStrings, key: String, own: [String: String]) -> String {
+    if let mine = own[key] {
+        return mine
+    }
+    return lunagramOriginalString(strings, key: key) ?? ""
+}
+
+private enum LunagramGroupEntry: ItemListNodeEntry {
+    case group(Int32, String, Int)
+    case line(Int32, String, String, Bool)
+    case info(String)
+
+    var section: ItemListSectionId {
+        return 0
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .group(index, _, _):
+            return index
+        case let .line(index, _, _, _):
+            return index
+        case .info:
+            return 1_000_000
+        }
+    }
+
+    static func ==(lhs: LunagramGroupEntry, rhs: LunagramGroupEntry) -> Bool {
+        switch lhs {
+        case let .group(index, name, count):
+            if case let .group(rhsIndex, rhsName, rhsCount) = rhs, index == rhsIndex, name == rhsName, count == rhsCount {
+                return true
+            }
+            return false
+        case let .line(index, key, value, isOwn):
+            if case let .line(rhsIndex, rhsKey, rhsValue, rhsIsOwn) = rhs, index == rhsIndex, key == rhsKey, value == rhsValue, isOwn == rhsIsOwn {
+                return true
+            }
+            return false
+        case let .info(text):
+            if case let .info(rhsText) = rhs, text == rhsText {
+                return true
+            }
+            return false
+        }
+    }
+
+    static func <(lhs: LunagramGroupEntry, rhs: LunagramGroupEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramGroupArguments
+        switch self {
+        case let .group(_, name, count):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: name, label: "\(count)", sectionId: self.section, style: .blocks, action: {
+                arguments.openGroup(name)
+            })
+        case let .line(_, key, value, isOwn):
+            // Название строки — сам ключ: своего имени у этих надписей нет,
+            // а ключ хотя бы говорит, из какого они места.
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: key, label: value, labelStyle: isOwn ? .coloredText(presentationData.theme.list.itemAccentColor) : .text, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: {
+                arguments.edit(key)
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private final class LunagramGroupArguments {
+    let openGroup: (String) -> Void
+    let edit: (String) -> Void
+
+    init(openGroup: @escaping (String) -> Void, edit: @escaping (String) -> Void) {
+        self.openGroup = openGroup
+        self.edit = edit
+    }
+}
+
+/// Экран «Все надписи» — список разделов.
+func lunagramAllWordingController(context: AccountContext, editKey: @escaping (String) -> Void) -> ViewController {
+    let versionPromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var version = 0
+    var pushImpl: ((ViewController) -> Void)?
+
+    let arguments = LunagramGroupArguments(openGroup: { name in
+        pushImpl?(lunagramWordingGroupController(context: context, group: name, editKey: editKey))
+    }, edit: { key in
+        editKey(key)
+        version += 1
+        versionPromise.set(version)
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, versionPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [LunagramGroupEntry] = []
+        var index: Int32 = 0
+        for group in LunagramWordingIndex.shared.allGroups(strings: presentationData.strings) {
+            entries.append(.group(index, group.name, group.keys.count))
+            index += 1
+        }
+        entries.append(.info("Разделы названы так, как их назвали в самом Telegram: это начало ключа надписи. Число справа — сколько в разделе строк.\n\nЧто не найдётся здесь — ищи поиском на прошлом экране: он смотрит сразу по всем."))
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Все надписи"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    controller.lunagramShowsBackground = true
+    pushImpl = { [weak controller] c in
+        controller?.push(c)
+    }
+    return controller
+}
+
+/// Экран одного раздела.
+private func lunagramWordingGroupController(context: AccountContext, group: String, editKey: @escaping (String) -> Void) -> ViewController {
+    let versionPromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var version = 0
+
+    let arguments = LunagramGroupArguments(openGroup: { _ in
+    }, edit: { key in
+        editKey(key)
+        version += 1
+        versionPromise.set(version)
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, versionPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [LunagramGroupEntry] = []
+        var index: Int32 = 0
+        let own = LunagramWording.overrides
+        for key in LunagramWordingIndex.shared.keys(inGroup: group, strings: presentationData.strings) {
+            entries.append(.line(index, key, lunagramWordingCurrentText(presentationData.strings, key: key, own: own), own[key] != nil))
+            index += 1
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(group), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    controller.lunagramShowsBackground = true
+    return controller
+}
