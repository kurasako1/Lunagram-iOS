+/// Вставки вроде %@, %1$@ и %d Telegram подставляет сам: имя, число, название.
+/// Потеряешь такую — в надписи окажется пустота, поэтому правку не принимаем.
+private func lunagramWordingPlaceholders(_ text: String) -> [String] {
+    guard let pattern = try? NSRegularExpression(pattern: "%\\d+\\$@|%[@d]|%%", options: []) else {
+        return []
+    }
+    var result: [String] = []
+    let range = NSRange(text.startIndex ..< text.endIndex, in: text)
+    pattern.enumerateMatches(in: text, options: [], range: range, using: { match, _, _ in
+        if let match = match, let found = Range(match.range, in: text) {
+            result.append(String(text[found]))
+        }
+    })
+    return result.sorted()
+}
