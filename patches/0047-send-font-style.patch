+import Foundation
+
+/// Стиль исходящих сообщений — как на ПК.
+///
+/// Буквы подменяются похожими символами Юникода, поэтому стиль видят все и в
+/// любом клиенте: это не разметка Telegram, а сам текст. Обратная сторона —
+/// такой текст не находится поиском Telegram.
+public enum LunagramSendFont: Int, CaseIterable {
+    case disabled
+    case bold
+    case italic
+    case script
+    case gothic
+    case monospace
+    case doubleStruck
+    case strikethrough
+    case underline
+    case spaced
+    case stars
+    case smallCaps
+
+    /// Название с честной пометкой, где работает. Стилизованных алфавитов для
+    /// кириллицы в Юникоде нет вовсе — это не наше ограничение, поэтому
+    /// пишем прямо в названии, чтобы выбор не был вслепую.
+    public var title: String {
+        switch self {
+        case .disabled:
+            return "Выключен"
+        case .bold:
+            return "𝐁𝐨𝐥𝐝 — только латиница"
+        case .italic:
+            return "𝐼𝑡𝑎𝑙𝑖𝑐 — только латиница"
+        case .script:
+            return "𝓢𝓬𝓻𝓲𝓹𝓽 — только латиница"
+        case .gothic:
+            return "𝕲𝖔𝖙𝖍𝖎𝖈 — только латиница"
+        case .monospace:
+            return "𝙼𝚘𝚗𝚘 — только латиница"
+        case .doubleStruck:
+            return "𝔻𝕠𝕦𝕓𝕝𝕖 — только латиница"
+        case .strikethrough:
+            return "Зачёркнутый — работает с русским"
+        case .underline:
+            return "Подчёркнутый — работает с русским"
+        case .spaced:
+            return "Р а з р я д к а — работает с русским"
+        case .stars:
+            return "✦Звёздочки✦ — работает с русским"
+        case .smallCaps:
+            return "ᴍᴀᴧᴇʜьᴋиᴇ — работает с русским, набор неполный"
+        }
+    }
+
+    /// Начала стилизованных алфавитов: латинские заглавные, строчные, цифры.
+    /// Пусто там, где алфавита нет.
+    private var bases: (upper: UInt32, lower: UInt32, digits: UInt32)? {
+        switch self {
+        case .bold:
+            return (0x1D400, 0x1D41A, 0x1D7CE)
+        case .italic:
+            return (0x1D434, 0x1D44E, 0)
+        case .script:
+            return (0x1D4D0, 0x1D4EA, 0)
+        case .gothic:
+            return (0x1D56C, 0x1D586, 0)
+        case .monospace:
+            return (0x1D670, 0x1D68A, 0x1D7F6)
+        case .doubleStruck:
+            return (0x1D538, 0x1D552, 0x1D7D8)
+        default:
+            return nil
+        }
+    }
+
+    /// Знак, который ставится поверх каждой буквы. Такой знак ложится на
+    /// любую букву, поэтому эти стили годятся и для русского.
+    private var combining: String? {
+        switch self {
+        case .strikethrough:
+            return "\u{0336}"
+        case .underline:
+            return "\u{0332}"
+        default:
+            return nil
+        }
+    }
+
+    /// Переводит текст в выбранный стиль.
+    public func apply(to text: String) -> String {
+        guard self != .disabled, !text.isEmpty else {
+            return text
+        }
+        switch self {
+        case .spaced:
+            // Пробел между буквами, но не между словами дважды.
+            return text.map({ String($0) }).joined(separator: " ")
+        case .stars:
+            return "✦" + text + "✦"
+        case .smallCaps:
+            return String(text.map { LunagramSendFont.smallCapsMap[$0] ?? $0 })
+        default:
+            break
+        }
+        if let combining = combining {
+            var result = ""
+            for character in text {
+                result.append(character)
+                if !character.isWhitespace {
+                    result.append(combining)
+                }
+            }
+            return result
+        }
+        guard let bases = bases else {
+            return text
+        }
+        var result = ""
+        for character in text {
+            result.append(LunagramSendFont.mapped(character, bases: bases))
+        }
+        return result
+    }
+
+    /// Одна буква в стилизованную. Что не легло — оставляем как есть: лучше
+    /// обычная буква, чем дырка в слове.
+    private static func mapped(_ character: Character, bases: (upper: UInt32, lower: UInt32, digits: UInt32)) -> String {
+        guard let scalar = character.unicodeScalars.first, character.unicodeScalars.count == 1 else {
+            return String(character)
+        }
+        let value = scalar.value
+        var replacement: UInt32?
+        if value >= 65, value <= 90 {
+            replacement = bases.upper + (value - 65)
+        } else if value >= 97, value <= 122 {
+            replacement = bases.lower + (value - 97)
+        } else if value >= 48, value <= 57, bases.digits != 0 {
+            replacement = bases.digits + (value - 48)
+        }
+        if let replacement = replacement, let converted = Unicode.Scalar(replacement) {
+            return String(Character(converted))
+        }
+        return String(character)
+    }
+
+    /// Маленькие заглавные. Набор в Юникоде неполный — чего нет, оставляем.
+    private static let smallCapsMap: [Character: Character] = [
+        "а": "ᴀ", "в": "ʙ", "г": "ᴦ", "е": "ᴇ", "к": "ᴋ", "м": "ᴍ", "н": "ʜ",
+        "о": "ᴏ", "п": "ᴨ", "р": "ᴘ", "с": "ᴄ", "т": "ᴛ", "у": "ʏ", "х": "x",
+        "л": "ᴧ",
+        "a": "ᴀ", "b": "ʙ", "c": "ᴄ", "d": "ᴅ", "e": "ᴇ", "f": "ꜰ", "g": "ɢ",
+        "h": "ʜ", "i": "ɪ", "j": "ᴊ", "k": "ᴋ", "l": "ʟ", "m": "ᴍ", "n": "ɴ",
+        "o": "ᴏ", "p": "ᴘ", "q": "Q", "r": "ʀ", "s": "s", "t": "ᴛ", "u": "ᴜ",
+        "v": "ᴠ", "w": "ᴡ", "x": "x", "y": "ʏ", "z": "ᴢ"
+    ]
+}
