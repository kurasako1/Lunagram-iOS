@@ -0,0 +1,153 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: что именно копировать, становясь копией человека.
+//
+// Раньше вопрос был один — «сделать копию?» — и копировалось всё разом. Теперь
+// вместо окошка экран: видно, что будет взято, и можно снять лишнее. Выбор
+// запоминается, так что во второй раз ничего отмечать не надо.
+
+private enum LunagramCopyFieldEntry: ItemListNodeEntry {
+    case header(String)
+    case field(Int32, String, Bool)
+    case run(String)
+    case info(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .header, .field:
+            return 0
+        case .run, .info:
+            return 1
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .header:
+            return 0
+        case let .field(index, _, _):
+            return 1 + index
+        case .run:
+            return 100
+        case .info:
+            return 101
+        }
+    }
+
+    static func ==(lhs: LunagramCopyFieldEntry, rhs: LunagramCopyFieldEntry) -> Bool {
+        switch lhs {
+        case let .header(lhsText):
+            if case let .header(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        case let .field(lhsIndex, lhsTitle, lhsChecked):
+            if case let .field(rhsIndex, rhsTitle, rhsChecked) = rhs, lhsIndex == rhsIndex, lhsTitle == rhsTitle, lhsChecked == rhsChecked {
+                return true
+            }
+            return false
+        case let .run(lhsTitle):
+            if case let .run(rhsTitle) = rhs, lhsTitle == rhsTitle {
+                return true
+            }
+            return false
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        }
+    }
+
+    static func <(lhs: LunagramCopyFieldEntry, rhs: LunagramCopyFieldEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramCopyFieldArguments
+        switch self {
+        case let .header(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .field(index, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.toggle(Int(index))
+            })
+        case let .run(title):
+            return ItemListActionItem(presentationData: presentationData, title: title, kind: .destructive, alignment: .center, sectionId: self.section, style: .blocks, action: {
+                arguments.run()
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private final class LunagramCopyFieldArguments {
+    let toggle: (Int) -> Void
+    let run: () -> Void
+
+    init(toggle: @escaping (Int) -> Void, run: @escaping () -> Void) {
+        self.toggle = toggle
+        self.run = run
+    }
+}
+
+func lunagramCopyFieldsScreen(context: AccountContext, peerName: String, onCopy: @escaping (LunagramCopyFields) -> Void) -> ViewController {
+    let changed = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    var dismiss: (() -> Void)?
+
+    let arguments = LunagramCopyFieldArguments(toggle: { index in
+        guard index >= 0, index < LunagramCopyFields.items.count else {
+            return
+        }
+        let field = LunagramCopyFields.items[index].field
+        var current = LunagramCopyFields.current
+        if current.contains(field) {
+            current.remove(field)
+        } else {
+            current.insert(field)
+        }
+        LunagramCopyFields.current = current
+        counter += 1
+        changed.set(counter)
+    }, run: {
+        let current = LunagramCopyFields.current
+        guard !current.isEmpty else {
+            return
+        }
+        onCopy(current)
+        dismiss?()
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, changed.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let current = LunagramCopyFields.current
+        var entries: [LunagramCopyFieldEntry] = []
+        entries.append(.header("Что взять у него"))
+        for (index, item) in LunagramCopyFields.items.enumerated() {
+            entries.append(.field(Int32(index), item.title, current.contains(item.field)))
+        }
+        entries.append(.run(current.isEmpty ? "Ничего не отмечено" : "Стать копией"))
+        entries.append(.info("Отмеченное станет твоим, и это увидят все, кто тебя видит. Прежнее своё сохраню — вернёшь тем же ползунком в его профиле.\n\n@ник не копируется: чужой занят, такого в Telegram не бывает. Цвет имени, фон профиля и значок-статус сервер примет только при своём премиуме.\n\nПри возврате чужая аватарка удаляется, а не закрывается твоей сверху: иначе она оставалась бы у тебя в истории фотографий."))
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Копия: " + peerName), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    dismiss = { [weak controller] in
+        controller?.dismiss()
+    }
+    return controller
+}
