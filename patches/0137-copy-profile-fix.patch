+///
+/// `done` говорит, осталась ли под снесённой хоть одна фотография.
+private func lunagramDropCopiedAvatar(context: AccountContext, done: @escaping (Bool) -> Void) {
+    let _ = (context.engine.peers.requestPeerPhotos(peerId: context.account.peerId)
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { photos in
+        // Верхняя — первая в списке, так его отдаёт сервер.
+        guard let newest = photos.first, let reference = newest.reference else {
+            done(false)
+            return
+        }
+        let refresh = context.engine.peers.fetchAndUpdateCachedPeerData(peerId: context.account.peerId)
+        |> map { _ -> Void in
+            return Void()
+        }
+        let _ = (context.engine.accountData.removeAccountPhoto(reference: reference)
+        |> then(refresh)
+        |> deliverOnMainQueue).startStandalone(completed: {
+            done(photos.count > 1)
+        })
+    })
+}
