+import Foundation
+import UIKit
+import Display
+import TelegramPresentationData
+import AccountContext
+import Lunagram
+
+// Lunagram: свой цвет кнопок и подписи под аватаркой.
+//
+// Кнопку QR, «Изменить», строку с номером и @ником Telegram красит сам —
+// подбирает цвет под обложку профиля. Подбор бывает неудачным: хозяин
+// сказал, что на его аватарке «немного не совпадает». Значит, нужен способ
+// выбрать цвет руками.
+//
+// Один цвет на все четыре — так и выбрали. Пока цвет не выбран, ничего не
+// подменяется: профиль выглядит ровно как выглядел. Только свой профиль,
+// как баннер, рамка и имя.
+//
+// Отдельной строки в настройках нет намеренно: хозяин выбрал «зажать прямо
+// на них». Зажатие по кнопке и зажатие по строке с номером открывают одно и
+// то же окошко.
+enum LunagramProfileButtonsColor {
+    /// Палитра держит делегата слабо, поэтому держим его сами: иначе он
+    /// умрёт сразу после показа и цвет не запомнится.
+    private static var pickerDelegate: AnyObject?
+
+    static var isSet: Bool {
+        return LunagramSettings.profileButtonsColor != nil
+    }
+
+    static func reset() {
+        LunagramSettings.profileButtonsColor = nil
+    }
+
+    /// Показать выбор. `reset` — предлагать ли возврат к телеграмовскому
+    /// подбору: если цвет ещё не выбран, возвращать не к чему.
+    static func present(context: AccountContext, reset: Bool) {
+        guard reset else {
+            self.presentPicker(context: context)
+            return
+        }
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let sheet = ActionSheetController(presentationData: presentationData)
+        sheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: "Выбрать цвет", action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                    LunagramProfileButtonsColor.presentPicker(context: context)
+                }),
+                ActionSheetButtonItem(title: "Вернуть как было", color: .destructive, action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                    LunagramProfileButtonsColor.reset()
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak sheet] in
+                    sheet?.dismissAnimated()
+                })
+            ])
+        ])
+        context.sharedContext.mainWindow?.present(sheet, on: .root)
+    }
+
+    private static func presentPicker(context: AccountContext) {
+        guard #available(iOS 14.0, *) else {
+            return
+        }
+        let picker = UIColorPickerViewController()
+        picker.supportsAlpha = false
+        if let rgb = LunagramSettings.profileButtonsColor {
+            picker.selectedColor = UIColor(rgb: rgb)
+        }
+        let delegate = PickerDelegate()
+        self.pickerDelegate = delegate
+        picker.delegate = delegate
+        (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController?.present(picker, animated: true, completion: nil)
+    }
+
+    @available(iOS 14.0, *)
+    private final class PickerDelegate: NSObject, UIColorPickerViewControllerDelegate {
+        func colorPickerViewController(_ viewController: UIColorPickerViewController, didSelect color: UIColor, continuously: Bool) {
+            var red: CGFloat = 0.0
+            var green: CGFloat = 0.0
+            var blue: CGFloat = 0.0
+            var alpha: CGFloat = 0.0
+            color.getRed(&red, green: &green, blue: &blue, alpha: &alpha)
+            let r = UInt32(max(0.0, min(1.0, red)) * 255.0)
+            let g = UInt32(max(0.0, min(1.0, green)) * 255.0)
+            let b = UInt32(max(0.0, min(1.0, blue)) * 255.0)
+            LunagramSettings.profileButtonsColor = (r << 16) | (g << 8) | b
+        }
+
+        func colorPickerViewControllerDidFinish(_ viewController: UIColorPickerViewController) {
+            LunagramProfileButtonsColor.pickerDelegate = nil
+        }
+    }
+}
