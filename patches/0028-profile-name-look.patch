+    // MARK: Вид имени в профиле
+
+    /// Цвета имени в шапке профиля — как на ПК. Ноль оставлен под обычный
+    /// белый, поэтому здесь только цветные.
+    public static let profileNameColors: [(title: String, rgb: UInt32)] = [
+        ("Золотой", 0xF0C460),
+        ("Розовый", 0xFF8FC4),
+        ("Голубой", 0x7FD4FF),
+        ("Мятный", 0x8FE3B8),
+        ("Сиреневый", 0xC2A0FF),
+        ("Алый", 0xFF7A6E)
+    ]
+
+    /// Какой цвет у имени: 0 — обычный белый, дальше по списку.
+    public static var profileNameColor: Int {
+        get { return defaults.integer(forKey: Key.profileNameColor) }
+        set {
+            defaults.set(newValue, forKey: Key.profileNameColor)
+            changed()
+        }
+    }
+
+    /// Свечение вокруг имени: 0 — нет, 1 — мягкое, 2 — сильное.
+    public static var profileNameGlow: Int {
+        get { return defaults.integer(forKey: Key.profileNameGlow) }
+        set {
+            defaults.set(max(0, min(2, newValue)), forKey: Key.profileNameGlow)
+            changed()
+        }
+    }
+
+    /// Цвет имени, которым его рисовать, или `nil` — тогда обычный белый.
+    public static func profileNameTint() -> CGColor? {
+        let index = profileNameColor
+        guard index > 0, index <= profileNameColors.count else {
+            return nil
+        }
+        return color(from: profileNameColors[index - 1].rgb, alpha: 1.0)
+    }
+
+    /// Цвет свечения под именем, или `nil` — если свечение выключено.
+    /// Светится самим цветом имени: так оно выглядит своим, а не обведённым.
+    public static func profileNameGlowColor() -> CGColor? {
+        let glow = profileNameGlow
+        guard glow > 0 else {
+            return nil
+        }
+        let index = profileNameColor
+        let rgb = index > 0 && index <= profileNameColors.count ? profileNameColors[index - 1].rgb : 0xFFFFFF
+        return color(from: rgb, alpha: glow == 1 ? 0.5 : 0.9)
+    }
+
+    private static func color(from rgb: UInt32, alpha: CGFloat) -> CGColor {
+        let red = CGFloat((rgb >> 16) & 0xFF) / 255.0
+        let green = CGFloat((rgb >> 8) & 0xFF) / 255.0
+        let blue = CGFloat(rgb & 0xFF) / 255.0
+        let space = CGColorSpaceCreateDeviceRGB()
+        return CGColor(colorSpace: space, components: [red, green, blue, alpha]) ?? CGColor(gray: 1.0, alpha: alpha)
+    }
+
