diff --git a/submodules/TelegramUI/Sources/LunagramPersonalReaction.swift b/submodules/TelegramUI/Sources/LunagramPersonalReaction.swift
new file mode 100644
index 00000000..20f59f4a
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramPersonalReaction.swift
@@ -0,0 +1,89 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: своя быстрая реакция для каждой переписки, как на ПК. Двойное
+// касание по сообщению ставит не общую реакцию, а ту, что задана для этого
+// чата: в одном огонёк, в другом палец вверх.
+
+/// Реакция по двойному касанию для переписки: своя, если задана, иначе
+/// общая. Меняется на лету — выбрал в меню, и уже следующее касание ставит
+/// новую.
+func lunagramPersonalDefaultReaction(peerId: EnginePeer.Id?, base: Signal<(MessageReaction.Reaction?, Bool), NoError>) -> Signal<(MessageReaction.Reaction?, Bool), NoError> {
+    guard let peerId = peerId else {
+        return base
+    }
+    let changes = Signal<Void, NoError> { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+            subscriber.putNext(Void())
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+    return combineLatest(base, changes)
+    |> map { value, _ -> (MessageReaction.Reaction?, Bool) in
+        if let emoji = LunagramSettings.personalReaction(peerId: peerId.toInt64()) {
+            return (.builtin(emoji), value.1)
+        }
+        return value
+    }
+    |> distinctUntilChanged(isEqual: { lhs, rhs in
+        return lhs.0 == rhs.0 && lhs.1 == rhs.1
+    })
+}
+
+/// Меню выбора своей реакции для переписки.
+///
+/// Берём обычные реакции из списка сервера — премиальные и свои эмодзи тут
+/// не показываем: для них нужен полноценный выбиратель. Первые дюжина —
+/// самые ходовые, сервер отдаёт их первыми.
+func lunagramPresentPersonalReactionSheet(context: AccountContext, peerId: EnginePeer.Id, present: @escaping (ViewController) -> Void) {
+    let _ = (context.engine.stickers.availableReactions()
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { availableReactions in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let current = LunagramSettings.personalReaction(peerId: peerId.toInt64())
+        var choices: [(emoji: String, title: String)] = []
+        for reaction in availableReactions?.reactions ?? [] {
+            guard reaction.isEnabled, !reaction.isPremium, case let .builtin(emoji) = reaction.value else {
+                continue
+            }
+            choices.append((emoji, reaction.title))
+            if choices.count == 12 {
+                break
+            }
+        }
+
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        var items: [ActionSheetItem] = []
+        items.append(ActionSheetTextItem(title: "Двойное касание по сообщению в этой переписке будет ставить выбранную реакцию. В остальных останется общая."))
+        items.append(ActionSheetButtonItem(title: current == nil ? "Как обычно ✓" : "Как обычно", color: .accent, action: { [weak actionSheet] in
+            actionSheet?.dismissAnimated()
+            LunagramSettings.setPersonalReaction(peerId: peerId.toInt64(), emoji: nil)
+        }))
+        for choice in choices {
+            let title = "\(choice.emoji)  \(choice.title)" + (choice.emoji == current ? "  ✓" : "")
+            items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak actionSheet] in
+                actionSheet?.dismissAnimated()
+                LunagramSettings.setPersonalReaction(peerId: peerId.toInt64(), emoji: choice.emoji)
+            }))
+        }
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: items),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        present(actionSheet)
+    })
+}
