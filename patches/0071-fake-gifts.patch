--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoVisualMediaPaneNode/Sources/LunagramFakeGifts.swift
@@ -0,0 +1,79 @@
+import Foundation
+import TelegramCore
+import Lunagram
+
+// Lunagram: свои подарки в профиле — понарошку.
+//
+// Зажал чужой подарок → «Скопировать себе», и такой же ложится в твой
+// профиль первым. Видно его только тебе: на сервер ничего не уходит,
+// подарок нигде не появляется и никому не приходит.
+//
+// Ссылку на настоящий подарок при копировании выбрасываем: без неё карточка
+// открывается, но кнопки вроде «Продать» ни во что не упираются — иначе они
+// целились бы в чужой подарок, и сервер ругался бы в ответ.
+
+enum LunagramFakeGifts {
+    static let didChangeNotification = Notification.Name("LunagramFakeGiftsDidChange")
+
+    /// Все скопированные подарки, свежие первыми.
+    static func stored() -> [ProfileGiftsContext.State.StarGift] {
+        guard let data = LunagramSettings.fakeGiftsData else {
+            return []
+        }
+        return (try? JSONDecoder().decode([ProfileGiftsContext.State.StarGift].self, from: data)) ?? []
+    }
+
+    /// Скопировать подарок себе.
+    static func add(_ source: ProfileGiftsContext.State.StarGift) {
+        let copy = ProfileGiftsContext.State.StarGift(
+            gift: source.gift,
+            reference: nil,
+            fromPeer: nil,
+            date: Int32(Date().timeIntervalSince1970),
+            text: nil,
+            entities: nil,
+            nameHidden: true,
+            savedToProfile: true,
+            pinnedToTop: false,
+            convertStars: nil,
+            canUpgrade: false,
+            canExportDate: nil,
+            upgradeStars: nil,
+            transferStars: nil,
+            canTransferDate: nil,
+            canResaleDate: nil,
+            collectionIds: nil,
+            prepaidUpgradeHash: nil,
+            upgradeSeparate: false,
+            dropOriginalDetailsStars: nil,
+            number: source.number,
+            isRefunded: false,
+            canCraftAt: nil
+        )
+        var all = stored()
+        all.insert(copy, at: 0)
+        save(all)
+    }
+
+    /// Убрать свой подарок из профиля.
+    static func remove(_ gift: ProfileGiftsContext.State.StarGift) {
+        var all = stored()
+        if let index = all.firstIndex(where: { $0 == gift }) {
+            all.remove(at: index)
+            save(all)
+        }
+    }
+
+    /// Наш ли это подарок: у скопированных нет ни ссылки, ни дарителя.
+    static func isFake(_ gift: ProfileGiftsContext.State.StarGift) -> Bool {
+        guard gift.reference == nil, gift.fromPeer == nil else {
+            return false
+        }
+        return stored().contains(where: { $0 == gift })
+    }
+
+    private static func save(_ gifts: [ProfileGiftsContext.State.StarGift]) {
+        LunagramSettings.fakeGiftsData = try? JSONEncoder().encode(gifts)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
