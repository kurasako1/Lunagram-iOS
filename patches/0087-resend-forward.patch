 public func enqueueMessages(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> Signal<[MessageId?], NoError> {
+    // Lunagram: пересылку из закрытого канала сервер не пропустит, поэтому
+    // такое сообщение пересобирается в своё. Подробности — в
+    // LunagramResendForward. Когда пересобирать нечего, список приходит
+    // нетронутым, и всё идёт как раньше.
+    return lunagramResendRestricted(account: account, messages: messages)
+    |> mapToSignal { messages -> Signal<[MessageId?], NoError> in
+        return enqueueMessagesImpl(account: account, peerId: peerId, messages: messages)
+    }
+}
