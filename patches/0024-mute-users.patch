index 73e61b80..ba095983 100644
--- a/submodules/TelegramCore/Sources/State/LunagramKeepDeletedMessages.swift
+++ b/submodules/TelegramCore/Sources/State/LunagramKeepDeletedMessages.swift
@@ -9,6 +9,20 @@ import LunagramGhost
 // Свои удаления с этого телефона сюда не доходят: Telegram стирает их у себя
 // сразу, и к приходу команды от сервера стирать уже нечего.
 
+/// Отсекает входящие от заглушённых людей — их не сохраняем вовсе. Свои
+/// (исходящие) и всё от остальных проходит как обычно.
+func lunagramFilterMutedMessages(_ messages: [StoreMessage]) -> [StoreMessage] {
+    guard !LunagramSpySettings.mutedIsEmpty else {
+        return messages
+    }
+    return messages.filter { message in
+        guard message.flags.contains(.Incoming) else {
+            return true
+        }
+        return !LunagramSpySettings.isMuted(message.id.peerId.toInt64())
+    }
+}
