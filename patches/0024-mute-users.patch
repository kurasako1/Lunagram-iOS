+    // MARK: Заглушённые люди
+    //
+    // Входящие от заглушённых не сохраняем — их отсекает сетевая часть,
+    // когда сообщения приходят. Уже полученные раньше остаются. Список —
+    // числовые id, хранятся строками: UserDefaults так надёжнее с большими
+    // числами.
+
+    /// Быстрая проверка «список пуст» — чтобы не разбирать его на каждом
+    /// пришедшем сообщении, если глушить некого.
+    public static var mutedIsEmpty: Bool {
+        return (defaults.stringArray(forKey: Key.mutedPeers) ?? []).isEmpty
+    }
+
+    public static func isMuted(_ id: Int64) -> Bool {
+        return muted().contains(id)
+    }
+
+    /// Включить или снять глушение человека или группы.
+    public static func toggleMuted(_ id: Int64) {
+        var set = muted()
+        if set.contains(id) {
+            set.remove(id)
+        } else {
+            set.insert(id)
+        }
+        defaults.set(set.map { String($0) }, forKey: Key.mutedPeers)
+    }
+
+    private static func muted() -> Set<Int64> {
+        return Set((defaults.stringArray(forKey: Key.mutedPeers) ?? []).compactMap { Int64($0) })
+    }
 }
