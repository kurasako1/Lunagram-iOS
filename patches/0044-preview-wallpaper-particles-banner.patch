+        case .banner:
+            url = LunagramSettings.profileBannerURL
+            dimAlpha = [0.0, 0.3, 0.55, 0.75][max(0, min(3, LunagramSettings.profileBannerDim))]
+            blurAlpha = CGFloat(LunagramSettings.profileBannerBlur) / 100.0
+        default:
+            url = LunagramSettings.liveWallpaperURL
+            dimAlpha = [0.0, 0.25, 0.5][max(0, min(2, LunagramSettings.liveWallpaperDim))]
+            blurAlpha = 0.0
+        }
+        dimView.alpha = dimAlpha
+        blurView.alpha = blurAlpha
+
+        let isVideo = kind == .banner ? LunagramSettings.profileBannerIsVideo : true
+        if url != self.shownMediaURL {
+            self.shownMediaURL = url
+            self.mediaPlayerLayer?.removeFromSuperlayer()
+            self.mediaPlayerLayer = nil
+            self.mediaPlayer = nil
+            self.mediaLooper = nil
+            mediaView.image = nil
+            if let url = url {
+                if isVideo {
+                    let player = AVQueuePlayer()
+                    player.isMuted = true
+                    let looper = AVPlayerLooper(player: player, templateItem: AVPlayerItem(asset: AVURLAsset(url: url)))
+                    let layer = AVPlayerLayer(player: player)
+                    layer.videoGravity = .resizeAspectFill
+                    layer.cornerRadius = 12.0
+                    layer.masksToBounds = true
+                    mediaView.layer.addSublayer(layer)
+                    self.mediaPlayerLayer = layer
+                    self.mediaPlayer = player
+                    self.mediaLooper = looper
+                    player.play()
+                } else {
+                    mediaView.image = UIImage(contentsOfFile: url.path)
+                }
+            }
+        }
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.mediaPlayerLayer?.frame = CGRect(origin: CGPoint(), size: area.size)
+        CATransaction.commit()
+
+        // Частицы поверх — те же, что падают в переписке.
+        if kind == .particles {
+            let layer: CALayer
+            if let current = self.particlesLayer {
+                layer = current
+            } else {
+                layer = LunagramParticlesLayer()
+                layer.cornerRadius = 12.0
+                layer.masksToBounds = true
+                self.particlesLayer = layer
+                self.previewContainer.layer.addSublayer(layer)
+            }
+            CATransaction.begin()
+            CATransaction.setDisableActions(true)
+            layer.frame = area
+            CATransaction.commit()
+            if let particles = layer as? LunagramParticlesLayer {
+                particles.updateSize(area.size)
+                particles.applyDensity(LunagramSettings.particlesDensity)
+            }
+            layer.isHidden = false
+        } else {
+            self.particlesLayer?.isHidden = true
         }
     }
 }
