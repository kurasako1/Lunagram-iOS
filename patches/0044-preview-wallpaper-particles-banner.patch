+    /// Образец обоев, частиц и баннера: показываем сам выбранный файл с теми
+    /// же затемнением и размытием, что и на деле.
+    private func updateMedia(kind: LunagramPreviewKind, area: CGRect, theme: PresentationTheme) {
+        let mediaView: UIImageView
+        if let current = self.mediaView {
+            mediaView = current
+        } else {
+            mediaView = UIImageView()
+            mediaView.contentMode = .scaleAspectFill
+            mediaView.clipsToBounds = true
+            mediaView.layer.cornerRadius = 12.0
+            self.mediaView = mediaView
+            self.previewContainer.insertSubview(mediaView, at: 0)
+        }
+        mediaView.frame = area
+        mediaView.backgroundColor = theme.list.itemSecondaryTextColor.withAlphaComponent(0.15)
+
+        let blurView: UIVisualEffectView
+        if let current = self.mediaBlurView {
+            blurView = current
+        } else {
+            blurView = UIVisualEffectView(effect: UIBlurEffect(style: .regular))
+            blurView.isUserInteractionEnabled = false
+            blurView.clipsToBounds = true
+            blurView.layer.cornerRadius = 12.0
+            self.mediaBlurView = blurView
+            self.previewContainer.addSubview(blurView)
+        }
+        blurView.frame = area
+
+        let dimView: UIView
+        if let current = self.mediaDimView {
+            dimView = current
+        } else {
+            dimView = UIView()
+            dimView.backgroundColor = .black
+            dimView.isUserInteractionEnabled = false
+            dimView.layer.cornerRadius = 12.0
+            self.mediaDimView = dimView
+            self.previewContainer.addSubview(dimView)
+        }
+        dimView.frame = area
+
+        // Какой файл и какие затемнение с размытием — зависит от вида.
+        let url: URL?
+        let dimAlpha: CGFloat
+        let blurAlpha: CGFloat
