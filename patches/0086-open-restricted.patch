--- /dev/null
+++ b/submodules/LunagramGhost/Sources/LunagramRestrictionSettings.swift
@@ -0,0 +1,24 @@
+import Foundation
+
+/// Запрет копирования в каналах и группах — снимать ли его у себя.
+///
+/// Живёт рядом с Ghost по той же причине: его читает сетевая часть Telegram
+/// — там, где она отвечает на вопрос «закрыт ли этот канал от копирования».
+public enum LunagramRestrictionSettings {
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let openRestricted = "lunagram.restriction.open"
+    }
+
+    /// Не считать канал закрытым от копирования. Тогда возвращаются
+    /// «Копировать», выделение текста и сохранение картинок и видео.
+    public static var openRestricted: Bool {
+        get {
+            return defaults.bool(forKey: Key.openRestricted)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.openRestricted)
+        }
+    }
+}
