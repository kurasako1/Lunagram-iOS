+/// Какая ступень ближе к числу из настроек.
+private func lunagramNearestStep(_ value: Int, _ steps: [(Int, String)]) -> Int {
+    var best = 0
+    for (index, step) in steps.enumerated() where abs(step.0 - value) < abs(steps[best].0 - value) {
+        best = index
+    }
+    return best
+}
