+/// Наша ли это картинка: сверяем по тем самым, что рисовали сами.
+///
+/// Тот же узел список мог отдать под родной значок просмотров — тогда
+/// перекрашивать его нельзя. Старые картинки из памятки не выкидываем, поэтому
+/// узел со вчерашним цветом всё равно узнаётся.
+func lunagramIsDeletedIcon(_ image: UIImage?) -> Bool {
+    guard let image = image else {
+        return false
+    }
+    lunagramDeletedIconLock.lock()
+    defer {
+        lunagramDeletedIconLock.unlock()
+    }
+    return lunagramDeletedIconCache.values.contains(where: { $0 === image })
+}
