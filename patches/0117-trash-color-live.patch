+/// Ждать её и не надо: от цвета размер значка не меняется, значит хватит
+/// подменить картинку в самом значке.
+///
+/// Узлы держим слабо: список их переиспользует и выбрасывает, и держать их
+/// крепко значило бы не дать им умереть.
+final class LunagramDeletedIconRegistry {
+    static let shared = LunagramDeletedIconRegistry()
+
+    private final class Entry {
+        weak var node: ASImageNode?
+        var baseFontSize: CGFloat
+
+        init(node: ASImageNode, baseFontSize: CGFloat) {
+            self.node = node
+            self.baseFontSize = baseFontSize
+        }
+    }
+
+    private var entries: [Entry] = []
+    private var observer: NSObjectProtocol?
+
+    private init() {
+        self.observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.repaint()
+        })
+    }
+
+    /// Зовётся из раскладки значка, на главном потоке. Один и тот же узел
+    /// приходит при каждой раскладке — записи не плодим.
+    func register(_ node: ASImageNode, baseFontSize: CGFloat) {
+        var alive: [Entry] = []
+        var known = false
+        for entry in self.entries {
+            guard let existing = entry.node else {
+                continue
+            }
+            if existing === node {
+                entry.baseFontSize = baseFontSize
+                known = true
+            }
+            alive.append(entry)
+        }
+        if !known {
+            alive.append(Entry(node: node, baseFontSize: baseFontSize))
+        }
+        self.entries = alive
+    }
+
+    private func repaint() {
+        var alive: [Entry] = []
+        for entry in self.entries {
+            guard let node = entry.node else {
+                continue
+            }
+            alive.append(entry)
+            guard lunagramIsDeletedIcon(node.image) else {
+                continue
+            }
+            if let image = lunagramDeletedIcon(baseFontSize: entry.baseFontSize), node.image !== image {
+                node.image = image
+            }
+        }
+        self.entries = alive
+    }
+}
