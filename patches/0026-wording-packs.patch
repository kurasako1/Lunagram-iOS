+static NSString * _Nonnull lunagramApplyWording(NSString * _Nonnull key, NSString * _Nonnull value) {
+    NSInteger pack = [[NSUserDefaults standardUserDefaults] integerForKey:@"lunagram.wording.pack"];
+    if (pack <= 0) {
+        return value;
+    }
+    NSDictionary<NSString *, NSString *> *dict = lunagramWordingDict(pack);
+    NSString *replacement = dict[key];
+    if (replacement != nil) {
+        return replacement;
+    }
+    return value;
+}
