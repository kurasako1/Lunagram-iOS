+/// Палитра выбора цвета имени — системная, как в самом айфоне.
+@available(iOS 14.0, *)
+private final class LunagramColorPickerDelegate: NSObject, UIColorPickerViewControllerDelegate {
+    private let changed: (UIColor) -> Void
+    private let finished: () -> Void
+
+    init(changed: @escaping (UIColor) -> Void, finished: @escaping () -> Void) {
+        self.changed = changed
+        self.finished = finished
+    }
+
+    func colorPickerViewController(_ viewController: UIColorPickerViewController, didSelect color: UIColor, continuously: Bool) {
+        self.changed(color)
+    }
+
+    func colorPickerViewControllerDidFinish(_ viewController: UIColorPickerViewController) {
+        self.finished()
+    }
+}
+
+/// Цвет в одно число, как его хранят настройки.
+private func lunagramPackColor(_ color: UIColor) -> UInt32 {
+    var red: CGFloat = 0.0
+    var green: CGFloat = 0.0
+    var blue: CGFloat = 0.0
+    var alpha: CGFloat = 0.0
+    color.getRed(&red, green: &green, blue: &blue, alpha: &alpha)
+    let r = UInt32(max(0.0, min(1.0, red)) * 255.0)
+    let g = UInt32(max(0.0, min(1.0, green)) * 255.0)
+    let b = UInt32(max(0.0, min(1.0, blue)) * 255.0)
+    return (r << 16) | (g << 8) | b
+}
