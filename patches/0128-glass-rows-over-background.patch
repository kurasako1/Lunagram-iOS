+/// Строки родных настроек нарисованы под сплошную страницу.
+    ///
+    /// Подложка строки залита цветом блока во всю ширину, а скругление не
+    /// вырезано, а НАРИСОВАНО: поверх строки лежит картинка, залитая цветом
+    /// страницы, у которой прозрачны только уголки. Под чёрной страницей это
+    /// выглядит скруглением, под нашей картинкой — чёрными полосами и чёрными
+    /// углами.
+    ///
+    /// Обойти строки поимённо нельзя: их десятки видов, и новый вид я бы всё
+    /// равно однажды забыл. Поэтому правим то, что сейчас на экране: узнаём
+    /// нарисованные углы по самой картинке, прячем их, а подложку делаем
+    /// полупрозрачной и скругляем маской слоя.
+    private func lunagramRestyleRows() {
+        guard self.lunagramShowsBackground, let theme = self.theme else {
+            return
+        }
+        let opaque = theme.list.itemBlocksBackgroundColor
+        let translucent = opaque.withAlphaComponent(0.72)
+
+        // Картинки углов берутся из темы и хранятся в ней же, поэтому их можно
+        // узнавать по самому объекту: у каждой пары углов своя.
+        var knownCorners: [ObjectIdentifier: (mask: CACornerMask, radius: CGFloat)] = [:]
+        for glass in [true, false] {
+            for (top, bottom) in [(true, true), (true, false), (false, true)] {
+                guard let image = PresentationResourcesItemList.cornersImage(theme, top: top, bottom: bottom, glass: glass) else {
+                    continue
+                }
+                var mask: CACornerMask = []
+                if top {
+                    mask.insert(.layerMinXMinYCorner)
+                    mask.insert(.layerMaxXMinYCorner)
+                }
+                if bottom {
+                    mask.insert(.layerMinXMaxYCorner)
+                    mask.insert(.layerMaxXMaxYCorner)
+                }
+                knownCorners[ObjectIdentifier(image)] = (mask: mask, radius: glass ? 26.0 : 11.0)
+            }
+        }
+
+        self.listNode.forEachItemNode { itemNode in
+            var found: (mask: CACornerMask, radius: CGFloat)?
+            var background: ASDisplayNode?
+            for subnode in itemNode.subnodes ?? [] {
+                if let imageNode = subnode as? ASImageNode, let image = imageNode.image, let corners = knownCorners[ObjectIdentifier(image)] {
+                    imageNode.isHidden = true
+                    found = corners
+                } else if let color = subnode.backgroundColor, color.isEqual(opaque) {
+                    background = subnode
+                }
+            }
+            guard let background = background else {
+                return
+            }
+            background.backgroundColor = translucent
+            if let found = found {
+                background.cornerRadius = found.radius
+                background.layer.cornerCurve = .continuous
+                background.layer.maskedCorners = found.mask
+                background.clipsToBounds = true
+            }
+        }
+    }
