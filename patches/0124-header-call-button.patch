diff --git a/submodules/TelegramUI/Sources/LunagramHeaderCallButton.swift b/submodules/TelegramUI/Sources/LunagramHeaderCallButton.swift
new file mode 100644
index 00000000..49f427c2
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramHeaderCallButton.swift
@@ -0,0 +1,141 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ChatPresentationInterfaceState
+import Lunagram
+
+// Lunagram: кнопка звонка в шапке личной переписки.
+//
+// В Telegram на айфоне звонок спрятан в меню «…» — два нажатия вместо одного.
+// Кладём его в шапку слева от «…», как в официальном клиенте на других
+// платформах.
+//
+// Нажатие — голосовой звонок, долгое — видео. Второй кнопки рядом не ставим:
+// шапка узкая, и имя собеседника пришлось бы подвинуть.
+//
+// Имена с приметой «lunagram» не для красоты: у узлов Telegram уже есть свои
+// `tapped()` и прочие, и одноимённый метод молча перекрыл бы родительский.
+final class LunagramHeaderCallButton: HighlightableButtonNode {
+    private let iconNode: ASImageNode
+    private var appliedColor: UIColor?
+
+    /// Долгое нажатие — видеозвонок.
+    var lunagramLongPressed: (() -> Void)?
+
+    override init(pointerStyle: PointerStyle? = nil) {
+        self.iconNode = ASImageNode()
+        self.iconNode.displaysAsynchronously = false
+        self.iconNode.displayWithoutProcessing = true
+
+        super.init(pointerStyle: pointerStyle)
+
+        self.addSubnode(self.iconNode)
+        self.frame = CGRect(origin: CGPoint(), size: CGSize(width: 44.0, height: 44.0))
+    }
+
+    override func didLoad() {
+        super.didLoad()
+
+        let recognizer = UILongPressGestureRecognizer(target: self, action: #selector(self.lunagramHandleLongPress(_:)))
+        recognizer.minimumPressDuration = 0.4
+        self.view.addGestureRecognizer(recognizer)
+    }
+
+    @objc private func lunagramHandleLongPress(_ recognizer: UILongPressGestureRecognizer) {
+        guard recognizer.state == .began else {
+            return
+        }
+        self.lunagramLongPressed?()
+    }
+
+    /// Значок берём телеграмовский — тот же, что у «Позвонить» в меню.
+    func lunagramUpdate(color: UIColor) {
+        if self.appliedColor != color || self.iconNode.image == nil {
+            self.appliedColor = color
+            self.iconNode.image = generateTintedImage(image: UIImage(bundleImageName: "Chat/Context Menu/Call"), color: color)
+        }
+        if let image = self.iconNode.image {
+            self.iconNode.frame = CGRect(
+                origin: CGPoint(
+                    x: floor((self.bounds.width - image.size.width) / 2.0),
+                    y: floor((self.bounds.height - image.size.height) / 2.0)
+                ),
+                size: image.size
+            )
+        }
+    }
+}
+
+extension ChatControllerImpl {
+    /// Кнопка звонка для шапки — или `nil`, если её сейчас быть не должно.
+    ///
+    /// Условия те же, по которым Telegram показывает «Позвонить» в меню:
+    /// личная переписка не с самим собой, не с ботом, и собеседник звонки
+    /// разрешает. Плюс наши: при выделении сообщений и в поиске шапка занята
+    /// другим, и лезть туда со своей кнопкой нельзя.
+    func lunagramCallBarButtonItem(presentationInterfaceState: ChatPresentationInterfaceState) -> UIBarButtonItem? {
+        guard LunagramSettings.headerCallButton else {
+            return nil
+        }
+        guard case let .peer(peerId) = presentationInterfaceState.chatLocation else {
+            return nil
+        }
+        guard peerId.namespace == Namespaces.Peer.CloudUser, peerId != self.context.account.peerId else {
+            return nil
+        }
+        guard let user = presentationInterfaceState.renderedPeer?.peer as? TelegramUser, user.botInfo == nil else {
+            return nil
+        }
+        guard presentationInterfaceState.callsAvailable else {
+            return nil
+        }
+        if presentationInterfaceState.interfaceState.selectionState != nil {
+            return nil
+        }
+        if presentationInterfaceState.search != nil {
+            return nil
+        }
+        if case .standard(.previewing) = presentationInterfaceState.mode {
+            return nil
+        }
+
+        let button: LunagramHeaderCallButton
+        if let current = self.lunagramCallButton {
+            button = current
+        } else {
+            button = LunagramHeaderCallButton()
+            button.addTarget(self, action: #selector(self.lunagramCallButtonPressed), forControlEvents: .touchUpInside)
+            button.lunagramLongPressed = { [weak self] in
+                self?.lunagramStartCall(isVideo: true)
+            }
+            self.lunagramCallButton = button
+            self.lunagramCallBarItem = UIBarButtonItem(customDisplayNode: button)
+        }
+        button.lunagramUpdate(color: presentationInterfaceState.theme.rootController.navigationBar.buttonColor)
+        return self.lunagramCallBarItem
+    }
+
+    @objc func lunagramCallButtonPressed() {
+        self.lunagramStartCall(isVideo: false)
+    }
+
+    /// Звоним тем же путём, что и пункт меню, — вместе со всеми его проверками
+    /// (недописанное голосовое, закрытые звонки у собеседника).
+    func lunagramStartCall(isVideo: Bool) {
+        guard case let .peer(peerId) = self.chatLocation else {
+            return
+        }
+        if isVideo {
+            // Видео предлагаем, только если собеседник его разрешает. Иначе
+            // долгое нажатие молча начало бы обычный звонок — это обман.
+            guard let cachedData = self.contentData?.state.peerView?.cachedData as? CachedUserData, cachedData.videoCallsAvailable else {
+                return
+            }
+        }
+        self.controllerInteraction?.callPeer(peerId, isVideo)
+    }
+}
