-import Foundation
-import UIKit
-// Без него `state` у распознавателя только читается, а нам его менять.
-import UIKit.UIGestureRecognizerSubclass
-
-/// Круг, расходящийся из-под пальца при нажатии.
-///
-/// Задумка из Ripple Touch (@mihailkotovski) — взята только она сама.
-///
-/// Главное условие: нажатия должны работать ровно так же, как работали. В
-/// iOS отслеживание касаний обычно отнимает их у того, кто под пальцем, —
-/// кнопка перестаёт нажиматься или срабатывает с задержкой. Поэтому здесь
-/// не обычный распознаватель жеста, а свой, который сразу объявляет себя
-/// несостоявшимся: он видит касание и тут же уходит с дороги. Вдобавок ему
-/// запрещено и отменять касания, и задерживать их.
-///
-/// Сам круг живёт в отдельном слое поверх всего окна, и этот слой не ловит
-/// нажатия вовсе. Так что худшее, что может случиться при поломке, —
-/// пропавший или кривой кружок, но не сломанный Telegram.
-public final class LunagramRipple {
-    public static let shared = LunagramRipple()
-
-    private weak var window: UIWindow?
-    private var overlay: UIView?
-    private var watcher: LunagramTouchWatcher?
-
-    private init() {
-    }
-
-    /// Поставить наблюдение на окно приложения. Зовут один раз при запуске.
-    public static func install(in window: UIWindow) {
-        shared.attach(to: window)
-    }
-
-    private func attach(to window: UIWindow) {
-        guard self.window !== window else {
-            return
-        }
-        self.window = window
-
-        let overlay = UIView(frame: window.bounds)
-        overlay.autoresizingMask = [.flexibleWidth, .flexibleHeight]
-        overlay.isUserInteractionEnabled = false
-        // Поверх всего, что кладёт Telegram: иначе круг покажется под
-        // экраном переписки и его никто не увидит.
-        overlay.layer.zPosition = 10000.0
-        window.addSubview(overlay)
-        self.overlay = overlay
-
-        let watcher = LunagramTouchWatcher()
-        watcher.onTouch = { [weak self] point in
-            self?.spark(at: point)
-        }
-        window.addGestureRecognizer(watcher)
-        self.watcher = watcher
-    }
-
-    private func spark(at point: CGPoint) {
-        guard LunagramSettings.rippleEnabled else {
-            return
-        }
-        guard let window = self.window, let overlay = self.overlay else {
-            return
-        }
-        // Telegram мог положить свои виды поверх нашего — вернём наш наверх.
-        if overlay.superview !== window {
-            window.addSubview(overlay)
-        } else if window.subviews.last !== overlay {
-            window.bringSubviewToFront(overlay)
-        }
-
-        let radius = LunagramRipple.radius()
-        let circle = CAShapeLayer()
-        circle.path = UIBezierPath(ovalIn: CGRect(x: -radius, y: -radius, width: radius * 2.0, height: radius * 2.0)).cgPath
-        circle.fillColor = LunagramRipple.color(for: window).cgColor
-        circle.position = point
-        circle.opacity = 0.0
-        overlay.layer.addSublayer(circle)
-
-        let strength = Float(LunagramSettings.rippleStrength) / 100.0
-        let duration = 0.45
-
-        let scale = CABasicAnimation(keyPath: "transform.scale")
-        scale.fromValue = 0.05
-        scale.toValue = 1.0
-        scale.duration = duration
-        scale.timingFunction = CAMediaTimingFunction(name: .easeOut)
-
-        let fade = CAKeyframeAnimation(keyPath: "opacity")
-        fade.values = [0.0, strength, 0.0]
-        fade.keyTimes = [0.0, 0.25, 1.0]
-        fade.duration = duration
-
-        let group = CAAnimationGroup()
-        group.animations = [scale, fade]
-        group.duration = duration
-        group.isRemovedOnCompletion = true
-
-        CATransaction.begin()
-        CATransaction.setCompletionBlock { [weak circle] in
-            circle?.removeFromSuperlayer()
-        }
-        circle.add(group, forKey: "lunagramRipple")
-        CATransaction.commit()
-    }
-
-    /// Насколько большой круг. Крутилка идёт процентами, а людям понятнее
-    /// «маленький — большой», поэтому переводим в точки экрана сами.
-    private static func radius() -> CGFloat {
-        let percent = CGFloat(max(0, min(100, LunagramSettings.rippleSize)))
-        return 30.0 + percent * 1.1
-    }
-
-    /// Цвет круга подбираем сами: на тёмном экране белый, на светлом чёрный.
-    /// Один цвет на оба случая был бы не виден на одном из них.
-    private static func color(for window: UIWindow) -> UIColor {
-        let isDark: Bool
-        if #available(iOS 13.0, *) {
-            isDark = window.traitCollection.userInterfaceStyle == .dark
-        } else {
-            isDark = false
-        }
-        return isDark ? UIColor.white : UIColor.black
-    }
-}
-
-/// Распознаватель, который ничего не распознаёт.
-///
-/// Нужен только ради одного: узнать, где палец коснулся экрана. Сразу
-/// объявляет себя несостоявшимся, чтобы не мешать настоящим нажатиям.
-public final class LunagramTouchWatcher: UIGestureRecognizer {
-    public var onTouch: ((CGPoint) -> Void)?
-
-    public override init(target: Any?, action: Selector?) {
-        super.init(target: target, action: action)
-        self.cancelsTouchesInView = false
-        self.delaysTouchesBegan = false
-        self.delaysTouchesEnded = false
-    }
-
-    convenience init() {
-        self.init(target: nil, action: nil)
-    }
-
-    public override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
-        if let touch = touches.first, let view = self.view {
-            self.onTouch?(touch.location(in: view))
-        }
-        self.state = .failed
-    }
-
-    public override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) {
-        self.state = .failed
-    }
-
-    public override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
-        self.state = .failed
-    }
-
-    public override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
-        self.state = .failed
-    }
-}
