-
-/// Раскладка кнопок полосы ввода: сдвиг и поворот.
-///
-/// Задумка из IconMover (@Darksourse399), взята только она. Плагин двигает
-/// что угодно по всему экрану; здесь — только три кнопки полосы ввода.
-/// Так решил хозяин, и так оно безопаснее: полоса ввода — самое частое
-/// место в приложении, и вольная правка чего угодно поверх неё кончилась бы
-/// недосягаемой кнопкой отправки.
-///
-/// Главное свойство: пока ничего не сдвинуто, превращение получается
-/// тождественным — то есть полоса ввода рисуется ровно так же, как без нас.
-/// Выключатель гасит всё сразу, не дожидаясь сброса каждой кнопки.
-public enum LunagramInputIcons {
-    /// Какие кнопки двигаем. Значки внутри поля ввода (смайлик и прочие)
-    /// сюда не берём: они стоят впритык к тексту, и сдвинутые лезли бы на
-    /// буквы.
-    public enum Slot: String, CaseIterable {
-        /// Скрепка слева.
-        case attach
-        /// Кнопка меню бота — она же слева, вместо скрепки.
-        case menu
-        /// Микрофон и отправка справа.
-        case send
-
-        public var title: String {
-            switch self {
-            case .attach:
-                return "Скрепка"
-            case .menu:
-                return "Меню"
-            case .send:
-                return "Микрофон и отправка"
-            }
-        }
-    }
-
-    /// Насколько кнопку разрешено уводить от её места, точки экрана.
-    public static let range: Int = 60
-    /// Насколько разрешено поворачивать, градусы.
-    public static let angleRange: Int = 180
-
-    public struct Placement: Equatable {
-        public var offsetX: Int = 0
-        public var offsetY: Int = 0
-        public var angle: Int = 0
-
-        public var isDefault: Bool {
-            return self.offsetX == 0 && self.offsetY == 0 && self.angle == 0
-        }
-
-        public init(offsetX: Int = 0, offsetY: Int = 0, angle: Int = 0) {
-            self.offsetX = offsetX
-            self.offsetY = offsetY
-            self.angle = angle
-        }
-    }
-
-    private static let enabledKey = "lunagram.inputIcons.enabled"
-    private static let mapKey = "lunagram.inputIcons.map"
-
-    private static var defaults: UserDefaults {
-        return UserDefaults.standard
-    }
-
-    /// Двигаем ли кнопки вообще.
-    public static var enabled: Bool {
-        get {
-            guard defaults.object(forKey: enabledKey) != nil else {
-                return false
-            }
-            return defaults.bool(forKey: enabledKey)
-        }
-        set {
-            defaults.set(newValue, forKey: enabledKey)
-            cache = nil
-            LunagramSettings.changed()
-        }
-    }
-
-    // MARK: Хранение
-
-    // Всё складываем одной строкой: «скрепка:10,-4,15;отправка:0,8,0».
-    // Заводить под каждую кнопку по три ключа — плодить девять настроек
-    // ради одной задумки.
-    private static var cacheSource: String?
-    private static var cache: [Slot: Placement]?
-
-    private static var map: [Slot: Placement] {
-        let source = defaults.string(forKey: mapKey) ?? ""
-        if let cache, cacheSource == source {
-            return cache
-        }
-        var result: [Slot: Placement] = [:]
-        for part in source.split(separator: ";") {
-            let pair = part.split(separator: ":")
-            guard pair.count == 2, let slot = Slot(rawValue: String(pair[0])) else {
-                continue
-            }
-            let numbers = pair[1].split(separator: ",").map { Int($0) ?? 0 }
-            guard numbers.count == 3 else {
-                continue
-            }
-            result[slot] = Placement(offsetX: numbers[0], offsetY: numbers[1], angle: numbers[2])
-        }
-        cacheSource = source
-        cache = result
-        return result
-    }
-
-    private static func store(_ map: [Slot: Placement]) {
-        // Порядок постоянный: иначе строка в настройках переписывалась бы
-        // при каждом сохранении, даже когда ничего не поменялось.
-        let text = Slot.allCases.compactMap { slot -> String? in
-            guard let placement = map[slot], !placement.isDefault else {
-                return nil
-            }
-            return "\(slot.rawValue):\(placement.offsetX),\(placement.offsetY),\(placement.angle)"
-        }.joined(separator: ";")
-        defaults.set(text, forKey: mapKey)
-        cacheSource = nil
-        cache = nil
-        LunagramSettings.changed()
-    }
-
-    public static func placement(_ slot: Slot) -> Placement {
-        return map[slot] ?? Placement()
-    }
-
-    public static func setPlacement(_ placement: Placement, for slot: Slot) {
-        var updated = map
-        let clamped = Placement(
-            offsetX: max(-range, min(range, placement.offsetX)),
-            offsetY: max(-range, min(range, placement.offsetY)),
-            angle: max(-angleRange, min(angleRange, placement.angle))
-        )
-        if clamped.isDefault {
-            updated.removeValue(forKey: slot)
-        } else {
-            updated[slot] = clamped
-        }
-        store(updated)
-    }
-
-    /// Вернуть всё на место.
-    public static func reset() {
-        store([:])
-    }
-
-    public static var hasAnyPlacement: Bool {
-        return !map.isEmpty
-    }
-
-    // MARK: Применение
-
-    /// Превращение для кнопки. Пока ничего не сдвинуто — тождественное, и
-    /// полоса ввода рисуется ровно как без нас.
-    public static func transform(for slot: Slot) -> CGAffineTransform {
-        guard self.enabled else {
-            return .identity
-        }
-        let placement = self.placement(slot)
-        guard !placement.isDefault else {
-            return .identity
-        }
-        var result = CGAffineTransform(translationX: CGFloat(placement.offsetX), y: CGFloat(placement.offsetY))
-        if placement.angle != 0 {
-            result = result.rotated(by: CGFloat(placement.angle) * .pi / 180.0)
-        }
-        return result
-    }
-
-    /// Поставить превращение слою, если оно поменялось.
-    ///
-    /// Сравниваем перед записью: полоса ввода перекладывается на каждый
-    /// набранный знак, а запись в слой каждый раз сбрасывала бы его
-    /// собственные переходы.
-    public static func apply(_ slot: Slot, to layer: CALayer?) {
-        guard let layer else {
-            return
-        }
-        let transform = CATransform3DMakeAffineTransform(self.transform(for: slot))
-        if !CATransform3DEqualToTransform(layer.transform, transform) {
-            layer.transform = transform
-        }
-    }
-}
