+import UIKit
+
+/// Заливка имени профиля градиентом.
+///
+/// Имя рисуется обычной надписью, и цвет ей задаётся одним `UIColor`. Чтобы
+/// залить буквы градиентом, не переписывая отрисовку имени, отдаём ей цвет
+/// ЗАЛИВКОЙ КАРТИНКОЙ: `UIColor(patternImage:)`. Буквы заливаются картинкой,
+/// а картинка у нас — градиент.
+///
+/// Так ни узел надписи, ни шапка профиля не меняются вовсе. Цена приёма в том,
+/// что заливка привязана к началу надписи и повторяется дальше, поэтому
+/// картинку делаем заведомо шире любого имени — тогда повтора не видно.
+public enum LunagramNameFill {
+    /// Шире любого имени: при 28 пунктах даже длинное имя короче.
+    private static let width: CGFloat = 520.0
+    private static let height: CGFloat = 44.0
+
+    private static let lock = NSLock()
+    private static var cache: [String: UIColor] = [:]
+
+    /// Цвет для имени: градиент, если выбран второй цвет, иначе ровный.
+    ///
+    /// Возвращает `nil`, когда своего цвета нет вовсе — тогда имя остаётся
+    /// телеграмовским, и вмешиваться незачем.
+    public static func color() -> UIColor? {
+        guard let first = LunagramSettings.profileNameTint() else {
+            return nil
+        }
+        guard let second = LunagramSettings.profileNameTint2() else {
+            return UIColor(cgColor: first)
+        }
+        let vertical = LunagramSettings.profileNameGradient == 1
+        let key = "\(first.components ?? [])|\(second.components ?? [])|\(vertical)"
+
+        lock.lock()
+        if let cached = cache[key] {
+            lock.unlock()
+            return cached
+        }
+        lock.unlock()
+
+        let size = CGSize(width: width, height: height)
+        let renderer = UIGraphicsImageRenderer(size: size)
+        let image = renderer.image { context in
+            let cg = context.cgContext
+            guard let gradient = CGGradient(
+                colorsSpace: CGColorSpaceCreateDeviceRGB(),
+                colors: [first, second] as CFArray,
+                locations: [0.0, 1.0]
+            ) else {
+                cg.setFillColor(first)
+                cg.fill(CGRect(origin: CGPoint(), size: size))
+                return
+            }
+            let start = CGPoint()
+            let end = vertical
+                ? CGPoint(x: 0.0, y: size.height)
+                : CGPoint(x: size.width, y: 0.0)
+            cg.drawLinearGradient(gradient, start: start, end: end, options: [])
+        }
+        let color = UIColor(patternImage: image)
+
+        lock.lock()
+        cache[key] = color
+        lock.unlock()
+        return color
+    }
+
+    /// Сбросить запомненное — цвета сменились.
+    public static func reset() {
+        lock.lock()
+        cache.removeAll()
+        lock.unlock()
+    }
+}
