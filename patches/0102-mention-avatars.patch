+import CoreGraphics
+import Foundation
+
+/// Аватарка рядом с @упоминанием в сообщении.
+///
+/// Задумка из MentionAvatars (@limeplug), взята только она.
+///
+/// Тут лежат одни настройки: сама отрисовка живёт там, где Telegram
+/// собирает текст сообщения, и тянуть сюда весь его разметчик незачем.
+public enum LunagramMentionAvatars {
+    private static let enabledKey = "lunagram.mentionAvatars.enabled"
+    private static let sizeKey = "lunagram.mentionAvatars.size"
+    private static let afterKey = "lunagram.mentionAvatars.after"
+
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    /// Показывать ли аватарки у упоминаний.
+    public static var enabled: Bool {
+        get {
+            guard defaults.object(forKey: enabledKey) != nil else {
+                return false
+            }
+            return defaults.bool(forKey: enabledKey)
+        }
+        set {
+            defaults.set(newValue, forKey: enabledKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Размер аватарки, проценты. Ноль — вровень с буквой, сто — заметно
+    /// крупнее её. В точки переводим сами: человеку понятнее «меньше —
+    /// больше», чем число точек, да и буквы у всех разного размера.
+    public static var size: Int {
+        get {
+            guard defaults.object(forKey: sizeKey) != nil else {
+                return 50
+            }
+            return max(0, min(100, defaults.integer(forKey: sizeKey)))
+        }
+        set {
+            defaults.set(max(0, min(100, newValue)), forKey: sizeKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Ставить аватарку после ника, а не перед ним.
+    public static var after: Bool {
+        get {
+            guard defaults.object(forKey: afterKey) != nil else {
+                return false
+            }
+            return defaults.bool(forKey: afterKey)
+        }
+        set {
+            defaults.set(newValue, forKey: afterKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Во сколько раз аватарка больше буквы. От неё и считаем: в мелком
+    /// тексте крупная аватарка разорвала бы строку, в крупном мелкая
+    /// потерялась бы.
+    public static func scale() -> CGFloat {
+        return 0.9 + CGFloat(self.size) / 100.0 * 0.7
+    }
+
+    /// Размер аватарки для текста с такой высотой букв.
+    public static func itemSize(fontSize: CGFloat) -> CGFloat {
+        return floor(fontSize * self.scale())
+    }
+}
