+// MARK: - Lunagram: аватарка у @упоминания
+//
+// Свои эмодзи Telegram вставляет в текст так: на месте эмодзи остаётся
+// знак-пустышка, ему приписывается «встроенный предмет» и указатель на
+// ширину, а поверх пустышки потом кладут слой с картинкой. Аватарку у
+// упоминания делаем ровно тем же способом — иначе пришлось бы лезть в
+// сам разметчик текста, а он общий на всё приложение.
+//
+// Оговорка, которую честнее сказать сразу: аватарка появляется там, где
+// в упоминании есть номер человека. Когда в сообщении просто написано
+// «@ник», номера в нём нет, и кто это — приходится искать. Ищем только
+// среди тех, кто уже известен телефону, и ничего не спрашиваем у сервера:
+// иначе каждое чужое сообщение отправляло бы запрос наружу.
+
+private final class LunagramMentionItem {
+    let peerId: EnginePeer.Id?
+    let mention: String
+    let fontSize: CGFloat
+
+    init(peerId: EnginePeer.Id?, mention: String, fontSize: CGFloat) {
+        self.peerId = peerId
+        self.mention = mention
+        self.fontSize = fontSize
+    }
+}
+
+/// Кто скрывается за «@ником». Ответы помним: одно и то же имя
+/// встречается в переписке десятки раз, и перебирать своих знакомых на
+/// каждое его появление незачем.
+private final class LunagramMentionLookup {
+    static let shared = LunagramMentionLookup()
+
+    private var known: [String: EnginePeer.Id?] = [:]
+    private var asking = Set<String>()
+    private var disposables: [String: Disposable] = [:]
+
+    func peerId(for mention: String) -> EnginePeer.Id? {
+        let key = mention.lowercased()
+        if let found = self.known[key] {
+            return found
+        }
+        return nil
+    }
+
+    func lookUp(mention: String, context: AccountContext, done: @escaping () -> Void) {
+        let key = mention.lowercased()
+        if self.known[key] != nil || self.asking.contains(key) {
+            return
+        }
+        self.asking.insert(key)
+        // Поиск по своей базе, без единого запроса наружу.
+        self.disposables[key] = (context.account.postbox.searchPeers(query: key)
+        |> take(1)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] peers in
+            guard let self else {
+                return
+            }
+            self.asking.remove(key)
+            var found: EnginePeer.Id?
+            for rendered in peers {
+                guard let peer = rendered.peer else {
+                    continue
+                }
+                if let username = peer.addressName, username.lowercased() == key {
+                    found = peer.id
+                    break
+                }
+            }
+            self.known[key] = found
+            if found != nil {
+                done()
+            }
+        })
+    }
+}
