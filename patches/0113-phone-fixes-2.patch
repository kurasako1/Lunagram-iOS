+import Foundation
+import UIKit
+
+// Lunagram: цветные плашки у наших строк в родных настройках.
+//
+// Родные строки Telegram помечены цветными квадратиками со значком внутри —
+// по цвету раздел узнаётся раньше, чем прочитано название. Наши строки
+// стояли с пустым местом слева и выглядели чужими и сухими.
+//
+// Рисуем такую же плашку сами: скруглённый квадрат с наклонной заливкой и
+// белый знак поверх. Знаки берём системные — за них отвечает Apple, и они
+// есть на любом телефоне. Цвета свои: телеграмовские заняты родными
+// разделами, и повторять их значило бы путать.
+public enum LunagramPlaceIcon {
+    private static let lock = NSLock()
+    private static var cache: [String: UIImage] = [:]
+
+    /// Плашка 30×30: заливка от `top` к `bottom`, внутри системный знак.
+    ///
+    /// `symbols` — список имён через запятую: берём первое, которое эта
+    /// версия iOS знает. Новые знаки появляются с новыми версиями, и запасное
+    /// имя избавляет от пустого места на старом телефоне.
+    public static func image(symbols: String, top: UInt32, bottom: UInt32) -> UIImage? {
+        let key = "\(symbols)|\(top)|\(bottom)"
+        lock.lock()
+        if let cached = cache[key] {
+            lock.unlock()
+            return cached
+        }
+        lock.unlock()
+
+        let configuration = UIImage.SymbolConfiguration(pointSize: 15.0, weight: .semibold)
+        var glyph: UIImage?
+        for name in symbols.split(separator: ",") {
+            if let symbol = UIImage(systemName: String(name).trimmingCharacters(in: .whitespaces), withConfiguration: configuration) {
+                glyph = symbol.withTintColor(.white, renderingMode: .alwaysOriginal)
+                break
+            }
+        }
+
+        let size = CGSize(width: 30.0, height: 30.0)
+        let image = UIGraphicsImageRenderer(size: size).image { context in
+            let bounds = CGRect(origin: CGPoint(), size: size)
+            let path = UIBezierPath(roundedRect: bounds, cornerRadius: 8.0)
+            path.addClip()
+
+            let space = CGColorSpaceCreateDeviceRGB()
+            let colors = [color(top).cgColor, color(bottom).cgColor] as CFArray
+            var locations: [CGFloat] = [0.0, 1.0]
+            if let gradient = CGGradient(colorsSpace: space, colors: colors, locations: &locations) {
+                context.cgContext.drawLinearGradient(
+                    gradient,
+                    start: CGPoint(x: 0.0, y: 0.0),
+                    end: CGPoint(x: 0.0, y: size.height),
+                    options: []
+                )
+            } else {
+                color(top).setFill()
+                path.fill()
+            }
+
+            if let glyph = glyph {
+                let glyphSize = glyph.size
+                glyph.draw(in: CGRect(
+                    x: floor((size.width - glyphSize.width) / 2.0),
+                    y: floor((size.height - glyphSize.height) / 2.0),
+                    width: glyphSize.width,
+                    height: glyphSize.height
+                ))
+            }
+        }
+
+        lock.lock()
+        cache[key] = image
+        lock.unlock()
+        return image
+    }
+
+    private static func color(_ rgb: UInt32) -> UIColor {
+        return UIColor(
+            red: CGFloat((rgb >> 16) & 0xFF) / 255.0,
+            green: CGFloat((rgb >> 8) & 0xFF) / 255.0,
+            blue: CGFloat(rgb & 0xFF) / 255.0,
+            alpha: 1.0
+        )
+    }
+}
+
+public extension LunagramPlace {
+    /// Цвета плашки: сверху светлее, снизу темнее — как у родных.
+    var iconColors: (top: UInt32, bottom: UInt32) {
+        switch self {
+        case .ghost:
+            return (0x9E8BFF, 0x6C4BFF)
+        case .privacy:
+            return (0x6FA0F5, 0x3A6FE0)
+        case .safety:
+            return (0x3FD0C0, 0x16A394)
+        case .deviceMask:
+            return (0x8D9BB4, 0x5A6A85)
+        case .wallpaper:
+            return (0xFFB25A, 0xFF7A1A)
+        case .dialogList:
+            return (0x5FD98E, 0x23A95A)
+        case .avatars:
+            return (0xFF8FB0, 0xFF4D80)
+        case .particles:
+            return (0xFFD95A, 0xFFB01A)
+        case .conversation:
+            return (0x6CCCF8, 0x1E9FE0)
+        case .wording:
+            return (0xC79BFC, 0xA855F7)
+        case .chatStickers:
+            return (0x7BE3C4, 0x2FB99A)
+        case .deleted:
+            return (0xFF8272, 0xE63B26)
+        case .messages:
+            return (0x74B4FF, 0x2E7BE6)
+        case .profileButtons:
+            return (0xA8B4C8, 0x6E7C93)
+        }
+    }
+
+    /// Готовая плашка для строки настроек.
+    var tileIcon: UIImage? {
+        let colors = self.iconColors
+        return LunagramPlaceIcon.image(symbols: self.iconName, top: colors.top, bottom: colors.bottom)
+    }
+}
