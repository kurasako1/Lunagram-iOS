diff --git a/submodules/TelegramUI/Sources/LunagramStreamerMode.swift b/submodules/TelegramUI/Sources/LunagramStreamerMode.swift
new file mode 100644
index 00000000..dc36f3ad
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramStreamerMode.swift
@@ -0,0 +1,70 @@
+import Foundation
+import UIKit
+import Lunagram
+
+/// Режим стримера: когда идёт запись экрана или трансляция, содержимое
+/// закрывается матовой пеленой. На ПК это кнопка в меню, но там запись ведёт
+/// сторонняя программа и заметить её нельзя. Айфон сам говорит, что экран
+/// пишется, поэтому здесь оно срабатывает само — так надёжнее: не забудешь
+/// нажать перед записью.
+final class LunagramStreamerMode {
+    static let shared = LunagramStreamerMode()
+
+    private var coverView: UIView?
+    private var started = false
+
+    /// Включаем слежение один раз при запуске приложения.
+    func start() {
+        guard !self.started else {
+            return
+        }
+        self.started = true
+        NotificationCenter.default.addObserver(self, selector: #selector(self.update), name: UIScreen.capturedDidChangeNotification, object: nil)
+        NotificationCenter.default.addObserver(self, selector: #selector(self.update), name: LunagramSettings.didChangeNotification, object: nil)
+        self.update()
+    }
+
+    @objc private func update() {
+        let shouldCover = LunagramSettings.streamerMode && UIScreen.main.isCaptured
+        if shouldCover {
+            self.showCover()
+        } else {
+            self.coverView?.removeFromSuperview()
+            self.coverView = nil
+        }
+    }
+
+    private func showCover() {
+        guard self.coverView == nil else {
+            return
+        }
+        // Ищем окно, которое сейчас на экране: приложение может держать
+        // несколько, и класть пелену надо поверх видимого.
+        let window = UIApplication.shared.windows.first(where: { $0.isKeyWindow }) ?? UIApplication.shared.windows.last
+        guard let window = window else {
+            return
+        }
+        let cover = UIView(frame: window.bounds)
+        cover.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        cover.backgroundColor = UIColor.black
+        cover.isUserInteractionEnabled = false
+
+        let blur = UIVisualEffectView(effect: UIBlurEffect(style: .dark))
+        blur.frame = cover.bounds
+        blur.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        cover.addSubview(blur)
+
+        let label = UILabel()
+        label.text = "Идёт запись экрана.\nСодержимое скрыто."
+        label.numberOfLines = 2
+        label.textAlignment = .center
+        label.textColor = UIColor(white: 1.0, alpha: 0.85)
+        label.font = UIFont.systemFont(ofSize: 16.0)
+        label.frame = cover.bounds
+        label.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        cover.addSubview(label)
+
+        window.addSubview(cover)
+        self.coverView = cover
+    }
+}
