diff --git a/submodules/ChatListUI/Sources/Node/LunagramListTextLook.swift b/submodules/ChatListUI/Sources/Node/LunagramListTextLook.swift
new file mode 100644
index 00000000..40b74997
--- /dev/null
+++ b/submodules/ChatListUI/Sources/Node/LunagramListTextLook.swift
@@ -0,0 +1,218 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import TelegramPresentationData
+import Lunagram
+
+// Lunagram: вид текста поверх обоев на всё окно.
+//
+// Как на ПК — пять видов для имён и отрывков в списке переписок: как обычно,
+// тёмная подложка, свечение вокруг букв, свой цвет, переливающийся. Всё это
+// включается только поверх обоев: на обычном фоне цвета темы подобраны и
+// без нас, и трогать их незачем.
+//
+// В самой строке списка — три вызова: тема для раскладки, подложка со
+// свечением после расстановки текста и одно новое поле. Всё остальное здесь.
+
+enum LunagramListTextLook: Int {
+    case plain = 0
+    case backdrop = 1
+    case glow = 2
+    case color = 3
+    case rainbow = 4
+
+    static var current: LunagramListTextLook {
+        guard LunagramSettings.wallpaperEverywhere else {
+            return .plain
+        }
+        return LunagramListTextLook(rawValue: LunagramSettings.listTextMode) ?? .plain
+    }
+}
+
+/// Тема строки с подменёнными цветами текста — для «своего цвета» и
+/// переливания. В остальных видах тема та же самая.
+///
+/// Подменяем тему целиком, а не цвет в каждом месте: имя и отрывок строка
+/// красит в двух десятках мест — черновик, пересланное, голосовое, опрос, — и
+/// все они берут цвет из темы. Одна подмена здесь покрывает их все.
+func lunagramListTextTheme(_ theme: PresentationThemeChatList) -> PresentationThemeChatList {
+    let color: UIColor
+    switch LunagramListTextLook.current {
+    case .color:
+        let own = LunagramSettings.listTextColor
+        guard own >= 0 else {
+            return theme
+        }
+        color = UIColor(rgb: UInt32(truncatingIfNeeded: own))
+    case .rainbow:
+        // Полный оборот за десять секунд, как на ПК: быстрее рябит и мешает
+        // читать, медленнее — не заметно.
+        let phase = CGFloat(fmod(CFAbsoluteTimeGetCurrent(), 10.0) / 10.0)
+        color = UIColor(hue: phase, saturation: 0.55, brightness: 1.0, alpha: 1.0)
+    default:
+        return theme
+    }
+    // Отрывок и время чуть тише имени — как в обычной теме, где они серее.
+    return theme.withUpdated(
+        titleColor: color,
+        dateTextColor: color.withAlphaComponent(0.75),
+        authorNameColor: color,
+        messageTextColor: color.withAlphaComponent(0.85)
+    )
+}
+
+/// Всё, что строке нужно для вида текста. Одним предметом — чтобы в самой
+/// строке было одно новое поле.
+final class LunagramTextLookState {
+    var titleBackdrop: ASDisplayNode?
+    var textBackdrop: ASDisplayNode?
+    var glowApplied = false
+    var appliedSnapshot: Int?
+    var observers: [NSObjectProtocol] = []
+
+    deinit {
+        for observer in self.observers {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+/// Тиканье для переливания. Цвет текста нельзя перекрасить, не разложив
+/// строку заново, поэтому раз в секунду видимые строки перекладываются. Это
+/// недорого — строк на экране десяток, — и идёт только пока переливание
+/// включено. Выключили — таймер останавливается.
+final class LunagramRainbowTicker {
+    static let shared = LunagramRainbowTicker()
+    static let tickNotification = Notification.Name("LunagramListRainbowTick")
+
+    private var timer: Foundation.Timer?
+
+    func sync() {
+        let needed = LunagramListTextLook.current == .rainbow
+        if needed, self.timer == nil {
+            let timer = Foundation.Timer(timeInterval: 1.0, repeats: true, block: { _ in
+                NotificationCenter.default.post(name: LunagramRainbowTicker.tickNotification, object: nil)
+            })
+            // Общий режим, иначе во время прокрутки таймер бы молчал.
+            RunLoop.main.add(timer, forMode: .common)
+            self.timer = timer
+        } else if !needed, let timer = self.timer {
+            timer.invalidate()
+            self.timer = nil
+        }
+    }
+}
+
+/// Слепок настроек, от которых зависит вид текста.
+private func lunagramTextLookSnapshot() -> Int {
+    return LunagramListTextLook.current.rawValue &+ LunagramSettings.listTextColor &* 8
+}
+
+extension ChatListItemNode {
+    /// Подложка и свечение — после того, как строка расставила имя и
+    /// отрывок. Цвета сюда не относятся: их уже дала тема при раскладке.
+    func lunagramApplyTextLook(titleFrame: CGRect, textFrame: CGRect) {
+        let state = self.lunagramTextLookState
+        if state.observers.isEmpty {
+            state.observers.append(NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+                self?.lunagramTextLookSettingsChanged()
+            }))
+            state.observers.append(NotificationCenter.default.addObserver(forName: LunagramRainbowTicker.tickNotification, object: nil, queue: .main, using: { [weak self] _ in
+                self?.lunagramRainbowTick()
+            }))
+        }
+        LunagramRainbowTicker.shared.sync()
+
+        let look = LunagramListTextLook.current
+        state.appliedSnapshot = lunagramTextLookSnapshot()
+
+        if look == .backdrop {
+            let titleBackdrop = self.lunagramBackdropNode(existing: state.titleBackdrop)
+            state.titleBackdrop = titleBackdrop
+            self.lunagramPlace(backdrop: titleBackdrop, frame: titleFrame)
+
+            let textBackdrop = self.lunagramBackdropNode(existing: state.textBackdrop)
+            state.textBackdrop = textBackdrop
+            self.lunagramPlace(backdrop: textBackdrop, frame: textFrame)
+        } else {
+            state.titleBackdrop?.removeFromSupernode()
+            state.titleBackdrop = nil
+            state.textBackdrop?.removeFromSupernode()
+            state.textBackdrop = nil
+        }
+
+        let glow = look == .glow
+        if glow != state.glowApplied {
+            state.glowApplied = glow
+            for layer in [self.titleNode.layer, self.textNode.textNode.layer, self.authorNode.layer] {
+                if glow {
+                    // Белый ореол вокруг букв, как на ПК. Тень у слоя с
+                    // текстом повторяет форму букв — отдельно рисовать не надо.
+                    layer.shadowColor = UIColor.white.cgColor
+                    layer.shadowOpacity = 0.45
+                    layer.shadowRadius = 2.0
+                    layer.shadowOffset = CGSize()
+                    // Тень считается по картинке букв; запоминаем её, чтобы
+                    // не пересчитывать на каждом кадре прокрутки.
+                    layer.shouldRasterize = true
+                    layer.rasterizationScale = UIScreenScale
+                } else {
+                    layer.shadowOpacity = 0.0
+                    layer.shadowRadius = 3.0
+                    layer.shouldRasterize = false
+                }
+            }
+        }
+    }
+
+    private func lunagramBackdropNode(existing: ASDisplayNode?) -> ASDisplayNode {
+        if let existing {
+            return existing
+        }
+        let node = ASDisplayNode()
+        node.isLayerBacked = true
+        // Как на ПК: чёрный на 110 из 255.
+        node.backgroundColor = UIColor(white: 0.0, alpha: 0.43)
+        node.isUserInteractionEnabled = false
+        // Под текст: самым нижним в том, где лежат имя и отрывок.
+        self.mainContentContainerNode.insertSubnode(node, at: 0)
+        return node
+    }
+
+    private func lunagramPlace(backdrop: ASDisplayNode, frame: CGRect) {
+        guard frame.width > 1.0, frame.height > 1.0 else {
+            backdrop.isHidden = true
+            return
+        }
+        backdrop.isHidden = false
+        let radius = floor(frame.height / 3.0)
+        backdrop.frame = frame.insetBy(dx: -radius / 2.0, dy: 0.0)
+        backdrop.cornerRadius = radius
+    }
+
+    private func lunagramRelayoutForTextLook() {
+        guard let layoutParams = self.layoutParams else {
+            return
+        }
+        let (_, apply) = self.asyncLayout()(layoutParams.0, layoutParams.6, layoutParams.1, layoutParams.2, layoutParams.3, layoutParams.4, layoutParams.5)
+        let _ = apply(false, false)
+    }
+
+    private func lunagramTextLookSettingsChanged() {
+        LunagramRainbowTicker.shared.sync()
+        guard lunagramTextLookSnapshot() != self.lunagramTextLookState.appliedSnapshot else {
+            return
+        }
+        self.lunagramRelayoutForTextLook()
+    }
+
+    private func lunagramRainbowTick() {
+        // Только видимые строки: уехавшим за край перекрашиваться незачем,
+        // они разложатся заново, когда вернутся.
+        guard LunagramListTextLook.current == .rainbow, self.view.window != nil else {
+            return
+        }
+        self.lunagramRelayoutForTextLook()
+    }
+}
