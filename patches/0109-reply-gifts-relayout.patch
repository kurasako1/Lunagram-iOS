+    /// Lunagram: перечитать вид сообщений.
+    ///
+    /// Цвет значка «удалено» и секунды у времени вшиваются в сообщение, когда
+    /// его раскладывают, — уже разложенные сообщения о смене настройки не
+    /// знают. Выдаём тот же набор данных оформления заново: переписка
+    /// сравнивает его по совпадению, а не по содержимому, поэтому новый
+    /// набор заставляет разложить всё заново. Ровно это Telegram делает при
+    /// смене темы.
+    private func lunagramSettingsChanged() {
+        let stamp = LunagramSettings.chatLayoutStamp
+        if stamp == self.lunagramLayoutStamp {
+            return
+        }
+        self.lunagramLayoutStamp = stamp
+        let data = self.currentPresentationData
+        let renewed = data.withTheme(data.theme)
+        self.currentPresentationData = renewed
+        self.chatPresentationDataPromise.set(.single(renewed))
+    }
