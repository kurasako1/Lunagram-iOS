+/// Какая ступень ближе всего к числу из настроек: густоту в первой версии
+/// можно было задать любую, не только ступенью.
+private func lunagramNearestLevel(_ value: Int, _ levels: [(String, Int)]) -> Int {
+    var best = 0
+    for (index, level) in levels.enumerated() where abs(level.1 - value) < abs(levels[best].1 - value) {
+        best = index
+    }
+    return best
+}
