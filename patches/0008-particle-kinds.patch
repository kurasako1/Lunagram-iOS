+    /// Снежинка: шесть лучей с боковыми отростками. Классическая форма, по
+    /// которой её узнают даже в десять точек.
+    private static func drawSnow(_ context: CGContext, side: CGFloat, variant: Int) {
+        let arm = side / 2.0 * (0.62 + CGFloat(variant) * 0.12)
+        context.setStrokeColor(UIColor.white.cgColor)
+        context.setLineWidth(max(side * 0.045, 1.0))
+        context.setLineCap(.round)
+        for _ in 0 ..< 6 {
+            context.rotate(by: CGFloat.pi / 3.0)
+            context.move(to: CGPoint())
+            context.addLine(to: CGPoint(x: 0.0, y: -arm))
+            let at = CGPoint(x: 0.0, y: -arm * 0.62)
+            context.move(to: at)
+            context.addLine(to: CGPoint(x: at.x - arm * 0.26, y: at.y - arm * 0.2))
+            context.move(to: at)
+            context.addLine(to: CGPoint(x: at.x + arm * 0.26, y: at.y - arm * 0.2))
+        }
+        context.strokePath()
+    }
+
+    /// Лепесток сакуры: капля с выемкой на кончике — ею он и отличается от
+    /// простого овала.
+    private static func drawSakura(_ context: CGContext, side: CGFloat, variant: Int) {
+        let half = side / 2.0
+        let w = half * (0.44 + CGFloat(variant) * 0.06)
+        let h = half * (0.86 - CGFloat(variant) * 0.06)
+        let petal = UIBezierPath()
+        petal.move(to: CGPoint(x: 0.0, y: h))
+        petal.addCurve(to: CGPoint(x: 0.0, y: -h), controlPoint1: CGPoint(x: w, y: h * 0.5), controlPoint2: CGPoint(x: w * 0.9, y: -h * 0.6))
+        petal.addCurve(to: CGPoint(x: 0.0, y: h), controlPoint1: CGPoint(x: -w * 0.9, y: -h * 0.6), controlPoint2: CGPoint(x: -w, y: h * 0.5))
+        // Выемку вырезаем: всё, что попадёт в неё, стирается.
+        context.saveGState()
+        context.addPath(petal.cgPath)
+        context.clip()
+        let colors = [UIColor(red: 1.0, green: 232.0 / 255.0, blue: 240.0 / 255.0, alpha: 1.0).cgColor, UIColor(red: 1.0, green: 176.0 / 255.0, blue: 206.0 / 255.0, alpha: 1.0).cgColor] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.0, 1.0]) {
+            context.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: -h), end: CGPoint(x: 0.0, y: h), options: [])
+        }
+        context.setBlendMode(.clear)
+        context.fillEllipse(in: CGRect(x: -w * 0.34, y: -h * 1.02 - h * 0.2, width: w * 0.68, height: h * 0.4))
+        context.restoreGState()
+    }
+
+    /// Матрица: не буква, а вертикальная струйка — яркая голова и гаснущий
+    /// хвост. Узнаётся ровно так же, а шрифт с катаканой не нужен.
+    private static func drawMatrix(_ context: CGContext, side: CGFloat, variant: Int) {
+        let width = max(side * (0.1 + CGFloat(variant) * 0.03), 1.0)
+        let rect = CGRect(x: -width / 2.0, y: -side / 2.0, width: width, height: side)
+        context.saveGState()
+        context.addPath(UIBezierPath(roundedRect: rect, cornerRadius: width / 2.0).cgPath)
+        context.clip()
+        let colors = [
+            UIColor(red: 120.0 / 255.0, green: 1.0, blue: 170.0 / 255.0, alpha: 0.0).cgColor,
+            UIColor(red: 80.0 / 255.0, green: 230.0 / 255.0, blue: 140.0 / 255.0, alpha: 0.75).cgColor,
+            UIColor(red: 220.0 / 255.0, green: 1.0, blue: 230.0 / 255.0, alpha: 1.0).cgColor
+        ] as CFArray
+        // Голова струйки внизу: она падает вниз и ведёт хвост за собой.
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.0, 0.75, 1.0]) {
+            context.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: rect.minY), end: CGPoint(x: 0.0, y: rect.maxY), options: [])
+        }
+        context.restoreGState()
+    }
+
+    /// Дождь: короткая черта со скруглёнными концами, светлеющая книзу.
+    private static func drawRain(_ context: CGContext, side: CGFloat, variant: Int) {
+        let length = side * (0.5 + CGFloat(variant) * 0.12)
+        let width = max(side * 0.07, 1.0)
+        let rect = CGRect(x: -width / 2.0, y: -length / 2.0, width: width, height: length)
+        context.saveGState()
+        context.addPath(UIBezierPath(roundedRect: rect, cornerRadius: width / 2.0).cgPath)
+        context.clip()
+        let colors = [
+            UIColor(red: 200.0 / 255.0, green: 226.0 / 255.0, blue: 1.0, alpha: 0.24).cgColor,
+            UIColor(red: 226.0 / 255.0, green: 240.0 / 255.0, blue: 1.0, alpha: 0.86).cgColor
+        ] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.0, 1.0]) {
+            context.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: rect.minY), end: CGPoint(x: 0.0, y: rect.maxY), options: [])
+        }
+        context.restoreGState()
+    }
+
+    /// Осенний лист: две дуги и прожилка посередине — без неё лист
+    /// выглядит просто пятном.
+    private static func drawLeaf(_ context: CGContext, side: CGFloat, variant: Int) {
+        let half = side / 2.0
+        let w = half * 0.5
+        let h = half * (0.8 + CGFloat(variant) * 0.06)
+        let colors = [
+            UIColor(red: 226.0 / 255.0, green: 138.0 / 255.0, blue: 52.0 / 255.0, alpha: 1.0),
+            UIColor(red: 198.0 / 255.0, green: 88.0 / 255.0, blue: 44.0 / 255.0, alpha: 1.0),
+            UIColor(red: 214.0 / 255.0, green: 172.0 / 255.0, blue: 62.0 / 255.0, alpha: 1.0)
+        ]
+        let leaf = UIBezierPath()
+        leaf.move(to: CGPoint(x: 0.0, y: -h))
+        leaf.addQuadCurve(to: CGPoint(x: 0.0, y: h), controlPoint: CGPoint(x: w, y: -h * 0.1))
+        leaf.addQuadCurve(to: CGPoint(x: 0.0, y: -h), controlPoint: CGPoint(x: -w, y: -h * 0.1))
+        context.setFillColor(colors[variant % colors.count].cgColor)
+        context.addPath(leaf.cgPath)
+        context.fillPath()
+        context.setStrokeColor(UIColor(red: 1.0, green: 236.0 / 255.0, blue: 200.0 / 255.0, alpha: 0.6).cgColor)
+        context.setLineWidth(max(side * 0.03, 1.0))
+        context.move(to: CGPoint(x: 0.0, y: -h * 0.9))
+        context.addLine(to: CGPoint(x: 0.0, y: h * 0.9))
+        context.strokePath()
+    }
 }
