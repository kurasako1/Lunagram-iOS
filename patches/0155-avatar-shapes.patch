+    /// Свой контур, вписанный в квадрат по меньшей стороне и выровненный
+    /// по середине: аватарки бывают и не квадратные, а форма должна
+    /// оставаться формой, а не растягиваться в овал.
+    public static func customPath(in rect: CGRect) -> CGPath {
+        let side = min(rect.width, rect.height)
+        guard side > 0.0 else {
+            return CGPath(rect: rect, transform: nil)
+        }
+        let box = CGRect(
+            x: rect.midX - side / 2.0,
+            y: rect.midY - side / 2.0,
+            width: side,
+            height: side)
+        switch self.kind {
+        case .rounded:
+            return UIBezierPath(roundedRect: rect, cornerRadius: cornerRadius(side: side)).cgPath
+        case .star:
+            return self.starPath(in: box, points: 5, inner: 0.42)
+        case .heart:
+            return self.heartPath(in: box)
+        case .flower:
+            return self.flowerPath(in: box, petals: 6)
+        case .pentagon:
+            return self.polygonPath(in: box, sides: 5)
+        case .hexagon:
+            return self.polygonPath(in: box, sides: 6)
+        }
+    }
+
+    /// Правильный многоугольник, вершиной вверх.
+    private static func polygonPath(in box: CGRect, sides: Int) -> CGPath {
+        let path = UIBezierPath()
+        let radius = box.width / 2.0
+        let center = CGPoint(x: box.midX, y: box.midY)
+        for i in 0 ..< sides {
+            // -90° — чтобы первая вершина смотрела вверх, а не вправо.
+            let angle = -CGFloat.pi / 2.0
+                + CGFloat(i) * 2.0 * CGFloat.pi / CGFloat(sides)
+            let point = CGPoint(
+                x: center.x + radius * cos(angle),
+                y: center.y + radius * sin(angle))
+            if i == 0 {
+                path.move(to: point)
+            } else {
+                path.addLine(to: point)
+            }
+        }
+        path.close()
+        return path.cgPath
+    }
+
+    /// Звезда: вершины по кругу, впадины — по кругу поменьше.
+    private static func starPath(in box: CGRect, points: Int, inner: CGFloat) -> CGPath {
+        let path = UIBezierPath()
+        let outer = box.width / 2.0
+        let center = CGPoint(x: box.midX, y: box.midY)
+        let step = CGFloat.pi / CGFloat(points)
+        for i in 0 ..< (points * 2) {
+            let radius = (i % 2 == 0) ? outer : outer * inner
+            let angle = -CGFloat.pi / 2.0 + CGFloat(i) * step
+            let point = CGPoint(
+                x: center.x + radius * cos(angle),
+                y: center.y + radius * sin(angle))
+            if i == 0 {
+                path.move(to: point)
+            } else {
+                path.addLine(to: point)
+            }
+        }
+        path.close()
+        return path.cgPath
+    }
+
+    /// Сердце: два купола сверху и острие снизу, дугами Безье.
+    private static func heartPath(in box: CGRect) -> CGPath {
+        let w = box.width
+        let h = box.height
+        let x = box.minX
+        let y = box.minY
+        let path = UIBezierPath()
+        path.move(to: CGPoint(x: x + w * 0.5, y: y + h * 0.96))
+        path.addCurve(
+            to: CGPoint(x: x, y: y + h * 0.3),
+            controlPoint1: CGPoint(x: x + w * 0.12, y: y + h * 0.75),
+            controlPoint2: CGPoint(x: x, y: y + h * 0.52))
+        path.addArc(
+            withCenter: CGPoint(x: x + w * 0.25, y: y + h * 0.3),
+            radius: w * 0.25,
+            startAngle: CGFloat.pi,
+            endAngle: 0.0,
+            clockwise: true)
+        path.addArc(
+            withCenter: CGPoint(x: x + w * 0.75, y: y + h * 0.3),
+            radius: w * 0.25,
+            startAngle: CGFloat.pi,
+            endAngle: 0.0,
+            clockwise: true)
+        path.addCurve(
+            to: CGPoint(x: x + w * 0.5, y: y + h * 0.96),
+            controlPoint1: CGPoint(x: x + w, y: y + h * 0.52),
+            controlPoint2: CGPoint(x: x + w * 0.88, y: y + h * 0.75))
+        path.close()
+        return path.cgPath
+    }
+
+    /// Цветок: лепестки по кругу. Радиус гуляет по косинусу — получается
+    /// волна без склейки отдельных лепестков, и контур выходит замкнутым
+    /// сам собой.
+    private static func flowerPath(in box: CGRect, petals: Int) -> CGPath {
+        let path = UIBezierPath()
+        let center = CGPoint(x: box.midX, y: box.midY)
+        let base = box.width / 2.0
+        // Шагаем часто: на редких шагах лепестки выходят гранёными.
+        let steps = max(petals * 36, 72)
+        for i in 0 ... steps {
+            let t = CGFloat(i) / CGFloat(steps) * 2.0 * CGFloat.pi
+            let wave = 0.82 + 0.18 * cos(CGFloat(petals) * t)
+            let point = CGPoint(
+                x: center.x + base * wave * cos(t - CGFloat.pi / 2.0),
+                y: center.y + base * wave * sin(t - CGFloat.pi / 2.0))
+            if i == 0 {
+                path.move(to: point)
+            } else {
+                path.addLine(to: point)
+            }
+        }
+        path.close()
+        return path.cgPath
+    }
