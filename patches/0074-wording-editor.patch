+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: свои надписи вместо телеграмовских.
+//
+// Экран показывает ходовые надписи: слева — что это за место в приложении,
+// справа — что там написано сейчас. Нажал строку — вписал своё. Правка
+// ложится поверх выбранного набора, поэтому можно взять «Мурлыкающий» и
+// поменять в нём одно слово.
+
+private enum LunagramWordingEditorEntry: ItemListNodeEntry {
+    case search(String)
+    case reset
+    case line(Int32, String, String, String, Bool)
+    case info(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .search, .reset:
+            return 0
+        case .line, .info:
+            return 1
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .search:
+            return 0
+        case .reset:
+            return 1
+        case let .line(index, _, _, _, _):
+            return 100 + index
+        case .info:
+            return 100_000
+        }
+    }
+
+    static func ==(lhs: LunagramWordingEditorEntry, rhs: LunagramWordingEditorEntry) -> Bool {
+        switch lhs {
+        case let .search(text):
+            if case let .search(rhsText) = rhs, text == rhsText {
+                return true
+            }
+            return false
+        case .reset:
+            if case .reset = rhs {
+                return true
+            }
+            return false
+        case let .line(index, key, title, value, isOwn):
+            if case let .line(rhsIndex, rhsKey, rhsTitle, rhsValue, rhsIsOwn) = rhs, index == rhsIndex, key == rhsKey, title == rhsTitle, value == rhsValue, isOwn == rhsIsOwn {
+                return true
+            }
+            return false
+        case let .info(text):
+            if case let .info(rhsText) = rhs, text == rhsText {
+                return true
+            }
+            return false
+        }
+    }
+
+    static func <(lhs: LunagramWordingEditorEntry, rhs: LunagramWordingEditorEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramWordingEditorArguments
+        switch self {
+        case let .search(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: "Найти надпись", type: .regular(capitalization: false, autocorrection: false), clearType: .always, sectionId: self.section, textUpdated: { value in
+                arguments.search(value)
+            }, action: {})
+        case .reset:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Сбросить мои правки", kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.reset()
+            })
+        case let .line(_, key, title, value, isOwn):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: value, labelStyle: isOwn ? .coloredText(presentationData.theme.list.itemAccentColor) : .text, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: {
+                arguments.edit(key)
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private final class LunagramWordingEditorArguments {
+    let search: (String) -> Void
+    let edit: (String) -> Void
+    let reset: () -> Void
+
+    init(search: @escaping (String) -> Void, edit: @escaping (String) -> Void, reset: @escaping () -> Void) {
+        self.search = search
+        self.edit = edit
+        self.reset = reset
+    }
+}
+
+/// Экран «Свои надписи».
+func lunagramWordingEditor(context: AccountContext) -> ViewController {
+    let queryPromise = ValuePromise<String>("", ignoreRepeated: true)
+    let versionPromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var version = 0
+    var presentAlertImpl: ((UIViewController) -> Void)?
+
+    let refresh: () -> Void = {
+        version += 1
+        versionPromise.set(version)
+    }
+
+    let arguments = LunagramWordingEditorArguments(search: { text in
+        queryPromise.set(text)
+    }, edit: { key in
+        presentAlertImpl?(lunagramWordingEditAlert(key: key, completed: refresh))
+    }, reset: {
+        LunagramWording.clearOverrides()
+        refresh()
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, queryPromise.get(), versionPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, query, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [LunagramWordingEditorEntry] = [.search(query)]
+        if !LunagramWording.overrides.isEmpty {
+            entries.append(.reset)
+        }
+        let needle = query.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        var index: Int32 = 0
+        for entry in LunagramWording.entries {
+            let current = LunagramWording.currentText(for: entry.key) ?? (lunagramOriginalString(presentationData.strings, key: entry.key) ?? "")
+            if !needle.isEmpty {
+                let haystack = "\(entry.title) \(current)".lowercased()
+                if !haystack.contains(needle) {
+                    continue
+                }
+            }
+            entries.append(.line(index, entry.key, entry.title, current, LunagramWording.overrides[entry.key] != nil))
+            index += 1
+        }
+        if entries.count <= 2 {
+            entries.append(.info("Ничего не нашлось. Ищи по названию места («печатает», «Избранное») или по самому тексту."))
+        } else {
+            entries.append(.info("Нажми строку и впиши своё. Правка ложится поверх выбранного набора: что не трогал — остаётся из набора. Пустая строка возвращает надпись как была.\n\nЧасть надписей меняется сразу, остальные — после перезапуска Lunagram."))
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Свои надписи"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentAlertImpl = { [weak controller] alert in
+        controller?.present(alert, animated: true, completion: nil)
+    }
+    return controller
+}
+
+/// Окошко правки одной надписи. Родное системное: поле ввода и две кнопки.
+private func lunagramWordingEditAlert(key: String, completed: @escaping () -> Void) -> UIViewController {
+    let entry = LunagramWording.entries.first(where: { $0.key == key })
+    let alert = UIAlertController(title: entry?.title ?? "Надпись", message: "Впиши, что должно быть написано вместо этого.", preferredStyle: .alert)
+    alert.addTextField(configurationHandler: { field in
+        field.text = LunagramWording.currentText(for: key)
+        field.clearButtonMode = .whileEditing
+    })
+    alert.addAction(UIAlertAction(title: "Готово", style: .default, handler: { _ in
+        LunagramWording.setOverride(key: key, text: alert.textFields?.first?.text)
+        completed()
+    }))
+    alert.addAction(UIAlertAction(title: "Вернуть как было", style: .destructive, handler: { _ in
+        LunagramWording.setOverride(key: key, text: nil)
+        completed()
+    }))
+    alert.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: nil))
+    return alert
+}
