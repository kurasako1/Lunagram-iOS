+    /// родная. Остальные — обычные шрифты, лежащие в системе с давних пор.
+    public static let builtInStyles: [(id: Int, title: String)] = [
+        (1, "Округлый"),
+        (2, "С засечками"),
+        (3, "Печатная машинка"),
+        (4, "Книжный"),
+        (5, "Плакатный"),
+        (6, "Широкий"),
+        (7, "Узкий")
+    ]
+
+    /// Какое начертание выбрано: 0 — системное, 1…7 — готовое,
+    /// `ownFileStyle` — свой файл.
+    public static var style: Int {
+        get {
+            lock.lock()
+            defer { lock.unlock() }
+            if let styleCache = self.styleCache {
+                return styleCache
+            }
+            let value = defaults.integer(forKey: Key.style)
+            self.styleCache = value
+            return value
+        }
+        set {
+            defaults.set(newValue, forKey: Key.style)
+            invalidate()
+        }
+    }
+
+    /// Шрифт готового начертания. Если в нём вдруг не окажется русских
+    /// букв — не берём его вовсе: лучше системный, чем пустые квадраты.
+    private static func builtInFont(style: Int, size: CGFloat) -> UIFont? {
+        switch style {
+        case 1, 2:
+            // Системный шрифт другой выделки — кириллица в нём родная.
+            let design: UIFontDescriptor.SystemDesign = style == 1 ? .rounded : .serif
+            guard let descriptor = UIFont.systemFont(ofSize: size).fontDescriptor.withDesign(design) else {
+                return nil
+            }
+            return UIFont(descriptor: descriptor, size: size)
+        default:
+            // Имена пишем по-разному: у одних шрифтов система знает
+            // семейство, у других — только внутреннее имя начертания.
+            let candidates: [String]
+            switch style {
+            case 3:
+                candidates = ["CourierNewPSMT", "Courier New", "Courier"]
+            case 4:
+                candidates = ["Georgia", "TimesNewRomanPSMT"]
+            case 5:
+                candidates = ["Arial-Black", "Arial Black", "HelveticaNeue-Bold"]
+            case 6:
+                candidates = ["Verdana", "Tahoma"]
+            case 7:
+                candidates = ["AvenirNextCondensed-Regular", "Avenir Next Condensed", "HelveticaNeue-CondensedBold"]
+            default:
+                return nil
+            }
+            for name in candidates {
+                if let font = UIFont(name: name, size: size), hasCyrillic(font) {
+                    return font
+                }
+            }
+            return nil
+        }
+    }
+
+    /// Есть ли в шрифте русские буквы. Проверяем по-настоящему — просим у
+    /// него очертания для «А» и «я»; если хоть одного нет, шрифт не годится.
+    public static func hasCyrillic(_ font: UIFont) -> Bool {
+        let characters: [UniChar] = Array("Ая".utf16)
+        var glyphs = [CGGlyph](repeating: 0, count: characters.count)
+        let found = CTFontGetGlyphsForCharacters(font as CTFont, characters, &glyphs, characters.count)
+        return found && !glyphs.contains(0)
+    }
