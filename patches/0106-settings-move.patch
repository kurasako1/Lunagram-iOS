+/// Экран одного места. Своё свежее состояние — чтобы открываться откуда
+/// угодно, в том числе из родных настроек Telegram.
+public func lunagramPlaceController(context: AccountContext, place: LunagramPlace) -> ViewController {
+    let shared = LunagramSharedState()
+    let arguments = lunagramMakeArguments(context: context, shared: shared)
+    shared.arguments = arguments
+
+    let signal = combineLatest(context.sharedContext.presentationData, shared.valuesPromise.get(), shared.mediaPromise.get(), shared.ghostExpandedPromise.get(), shared.expandedTogglesPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, currentValues, media, ghostExpanded, expandedToggles -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = lunagramPlaceEntries(place: place, values: currentValues, media: media, ghostExpanded: ghostExpanded, expandedToggles: expandedToggles)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(place.title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    shared.push = { [weak controller] c in
+        controller?.push(c)
+    }
+    shared.present = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    return controller
+}
