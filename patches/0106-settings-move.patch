diff --git a/submodules/Lunagram/Sources/LunagramPlaces.swift b/submodules/Lunagram/Sources/LunagramPlaces.swift
new file mode 100644
index 00000000..6466d106
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramPlaces.swift
@@ -0,0 +1,106 @@
+import Foundation
+
+/// Куда разложены настройки Lunagram по родным разделам Telegram.
+///
+/// Раньше всё жило на двух своих экранах — «Функции» и «Оформление», — и до
+/// маскировки устройства надо было идти тремя нажатиями мимо всего
+/// остального. Теперь каждая настройка стоит там, где стоит то, чего она
+/// касается: маскировка — в «Устройствах», призрак — в «Конфиденциальности»,
+/// вид — в «Оформлении».
+///
+/// Этот перечень нужен, чтобы родные экраны могли открыть наш. Напрямую они
+/// не могут: наши экраны лежат в том же куске сборки, что и профиль, а тот
+/// сам зависит от родных настроек — вышло бы кольцо. Поэтому родной экран
+/// называет место числом, а собирает экран тот, кто знает обе стороны.
+public enum LunagramPlace: Int32, CaseIterable {
+    /// Режим призрака целиком, с замочками.
+    case ghost = 1
+    /// Скрыть номер, режим стримера и прочее про себя.
+    case privacy = 2
+    /// Разбор ссылок и метка из открытого реестра.
+    case safety = 3
+    /// Маскировка устройства — в «Устройствах».
+    case deviceMask = 4
+    /// Обои переписки.
+    case wallpaper = 5
+    /// Список переписок: плитки, текст поверх, строка поиска, карандаш.
+    case dialogList = 6
+    /// Аватарки: форма, скругление, рамка.
+    case avatars = 7
+    /// Частицы в переписке.
+    case particles = 8
+    /// Как выглядит сама переписка: буквы, упоминания, панели, полоса ввода.
+    case conversation = 9
+    /// Свои надписи вместо телеграмовских — в «Языке».
+    case wording = 10
+    /// Эмодзи и стикеры чата — в «Стикерах».
+    case chatStickers = 11
+    /// Удалённые и изменённые сообщения — свой раздел в корне.
+    case deleted = 12
+    /// Сообщения и отправка — свой раздел в корне.
+    case messages = 13
+
+    public var title: String {
+        switch self {
+        case .ghost:
+            return "Режим призрака"
+        case .privacy:
+            return "Приватность"
+        case .safety:
+            return "Ссылки и метки"
+        case .deviceMask:
+            return "Маскировка устройства"
+        case .wallpaper:
+            return "Обои"
+        case .dialogList:
+            return "Список переписок"
+        case .avatars:
+            return "Аватарки"
+        case .particles:
+            return "Частицы"
+        case .conversation:
+            return "Переписка"
+        case .wording:
+            return "Надписи"
+        case .chatStickers:
+            return "Эмодзи и стикеры чата"
+        case .deleted:
+            return "Удалённые и изменённые"
+        case .messages:
+            return "Сообщения"
+        }
+    }
+
+    /// Значок из набора системы. Свои значки строк у нас рисуются по
+    /// этому имени, если человек не подставил свою картинку.
+    public var iconName: String {
+        switch self {
+        case .ghost:
+            return "eye.slash"
+        case .privacy:
+            return "hand.raised"
+        case .safety:
+            return "link.badge.plus"
+        case .deviceMask:
+            return "iphone.gen3"
+        case .wallpaper:
+            return "photo"
+        case .dialogList:
+            return "bubble.left.and.bubble.right"
+        case .avatars:
+            return "person.crop.circle"
+        case .particles:
+            return "sparkles"
+        case .conversation:
+            return "text.bubble"
+        case .wording:
+            return "textformat"
+        case .chatStickers:
+            return "face.smiling"
+        case .deleted:
+            return "trash"
+        case .messages:
+            return "paperplane"
+        }
+    }
+}
