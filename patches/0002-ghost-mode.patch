+/// Все выключатели раздела. Один перечень вместо пачки отдельных замыканий:
+/// так новый выключатель добавляется одной строчкой в трёх местах, а не
+/// размазывается по всему файлу.
+private enum LunagramToggle: Int32 {
+    case ghostDontRead
+    case ghostDontType
+    case ghostStayOffline
+    case ghostDontViewStories
+    case particles
+
+    var value: Bool {
+        switch self {
+        case .ghostDontRead:
