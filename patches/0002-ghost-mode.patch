+        case .ghostDontViewStories:
+            return LunagramSettings.ghostDontViewStories
+        case .particles:
+            return LunagramSettings.particlesEnabled
+        }
+    }
+
+    func set(_ value: Bool) {
+        switch self {
+        case .ghostDontRead:
+            LunagramSettings.ghostDontRead = value
+        case .ghostDontType:
+            LunagramSettings.ghostDontType = value
+        case .ghostStayOffline:
+            LunagramSettings.ghostStayOffline = value
+        case .ghostDontViewStories:
+            LunagramSettings.ghostDontViewStories = value
+        case .particles:
+            LunagramSettings.particlesEnabled = value
+        }
+    }
+
+    var title: String {
+        switch self {
+        case .ghostDontRead:
+            return "Не отмечать прочитанным"
+        case .ghostDontType:
+            return "Не показывать «печатает…»"
+        case .ghostStayOffline:
+            return "Не выходить в сеть"
+        case .ghostDontViewStories:
+            return "Не отмечать истории"
+        case .particles:
+            return "Частицы в переписке"
+        }
+    }
+}
 
