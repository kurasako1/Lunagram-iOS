+import Foundation
+import UIKit
+import Lunagram
+
+/// Своя картинка под списком профиля.
+///
+/// Держится по размеру экрана, а не по длине списка: список в профиле очень
+/// длинный, и растянутая на него картинка превратилась бы в полосу. Так она
+/// остаётся на виду и как будто едет за тобой, пока крутишь.
+final class LunagramProfileBackgroundView: UIView {
+    private let imageView = UIImageView()
+    private let blurView = UIVisualEffectView(effect: UIBlurEffect(style: .regular))
+    private let dimView = UIView()
+    private var shownURL: URL?
+    private var settingsObserver: NSObjectProtocol?
+
+    init() {
+        super.init(frame: CGRect())
+        self.isUserInteractionEnabled = false
+        self.clipsToBounds = true
+
+        self.imageView.contentMode = .scaleAspectFill
+        self.imageView.clipsToBounds = true
+        self.addSubview(self.imageView)
+
+        self.blurView.isUserInteractionEnabled = false
+        self.addSubview(self.blurView)
+
+        self.dimView.backgroundColor = .black
+        self.dimView.isUserInteractionEnabled = false
+        self.addSubview(self.dimView)
+
+        self.reload()
+        self.settingsObserver = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let settingsObserver = self.settingsObserver {
+            NotificationCenter.default.removeObserver(settingsObserver)
+        }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let bounds = self.bounds
+        self.imageView.frame = bounds
+        self.blurView.frame = bounds
+        self.dimView.frame = bounds
+    }
+
+    /// Настройки поменялись: перечитываем картинку и силу затемнения.
+    func reload() {
+        let url = LunagramSettings.profileBackgroundURL
+        if url != self.shownURL {
+            self.shownURL = url
+            self.imageView.image = url.flatMap { UIImage(contentsOfFile: $0.path) }
+        }
+        let hasBackground = url != nil
+        self.isHidden = !hasBackground
+        self.dimView.alpha = CGFloat(LunagramSettings.profileBackgroundDim) / 100.0
+        self.blurView.alpha = CGFloat(LunagramSettings.profileBackgroundBlur) / 100.0
+    }
+}
