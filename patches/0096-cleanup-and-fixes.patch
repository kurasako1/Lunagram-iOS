-                    .replacingOccurrences(of: "на", with: "ня")
-                    .replacingOccurrences(of: "ма", with: "мя")
-                    .replacingOccurrences(of: "На", with: "Ня")
-                    .replacingOccurrences(of: "Ма", with: "Мя")
