+/// Призрак глушит отправку отметки о прочтении прямо в сетевой части, и очередь
+/// синхронизации после него пуста: для приложения всё уже отправлено, повторять
+/// ему нечего. Поэтому разбудить отметку обычным способом нельзя — здесь мы
+/// кладём разовый пропуск и сами отправляем то, что у нас уже прочитано.
+///
+/// Лежит в этом файле, а не в своём, потому что отправка читается отсюда:
+/// в Swift private — это «видно только в своём файле».
+public func lunagramMarkPeerReadAfterAction(account: Account, peerId: PeerId) -> Signal<Never, NoError> {
+    LunagramGhostSettings.setForceRead(peerId.toInt64())
+    return pushPeerReadState(network: account.network, postbox: account.postbox, stateManager: account.stateManager, peerId: peerId)
+    |> `catch` { _ -> Signal<Never, NoError> in
+        // Не ушло — останемся непрочитанными, как и были. Ругаться не на что.
+        return .complete()
+    }
+}
