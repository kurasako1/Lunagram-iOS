diff --git a/submodules/TelegramUI/Sources/LunagramSaveSticker.swift b/submodules/TelegramUI/Sources/LunagramSaveSticker.swift
new file mode 100644
index 00000000..c0a78e45
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramSaveSticker.swift
@@ -0,0 +1,112 @@
+import Foundation
+import UIKit
+import Photos
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import PresentationDataUtils
+import DeviceAccess
+import WebPBinding
+import Lunagram
+
+// Lunagram: сохранить стикер или эмодзи в галерею.
+//
+// Галерея берёт картинки и видео в тех видах, которые понимает сам айфон.
+// Стикеры Telegram лежат иначе: неподвижные — в webp, двигающиеся — в своём
+// виде, который рисует сам клиент, а видео-стикеры — в webm. Ни того, ни
+// другого галерея не понимает.
+//
+// Поэтому неподвижные мы разбираем в обычную картинку и кладём в галерею, а
+// про двигающиеся говорим прямо: галерея их не возьмёт, — и предлагаем отдать
+// файлом. Молча отдать первый кадр было бы хуже: человек думал бы, что
+// сохранил стикер, а сохранил картинку.
+
+private func lunagramStickerImage(path: String) -> UIImage? {
+    guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)) else {
+        return nil
+    }
+    if let image = WebP.convert(fromWebP: data) {
+        return image
+    }
+    return UIImage(data: data)
+}
+
+private func lunagramPutInGallery(image: UIImage, context: AccountContext, present: @escaping (ViewController) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let ok = TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+
+    DeviceAccess.authorizeAccess(to: .mediaLibrary(.save), presentationData: presentationData, present: { c, a in
+        context.sharedContext.presentGlobalController(c, a)
+    }, openSettings: context.sharedContext.applicationBindings.openSettings, { authorized in
+        guard authorized else {
+            return
+        }
+        PHPhotoLibrary.shared().performChanges({
+            PHAssetChangeRequest.creationRequestForAsset(from: image)
+        }, completionHandler: { success, _ in
+            Queue.mainQueue().async {
+                if success {
+                    present(textAlertController(context: context, title: nil, text: "Стикер сохранён в галерею.", actions: [ok]))
+                } else {
+                    present(textAlertController(context: context, title: nil, text: "Галерея не приняла стикер.", actions: [ok]))
+                }
+            }
+        })
+    })
+}
+
+/// Отдать файл как есть — окошком «Поделиться». Для двигающихся стикеров это
+/// единственное, что честно: в галерею они не лягут, а в «Файлы» и в переписку
+/// уйдут как были.
+private func lunagramShareFile(path: String, name: String, context: AccountContext, present: @escaping (ViewController) -> Void) {
+    let target = URL(fileURLWithPath: NSTemporaryDirectory()).appendingPathComponent(name)
+    try? FileManager.default.removeItem(at: target)
+    do {
+        try FileManager.default.copyItem(at: URL(fileURLWithPath: path), to: target)
+    } catch {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        present(textAlertController(context: context, title: nil, text: "Не вышло подготовить файл.", actions: [
+            TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+        ]))
+        return
+    }
+    guard let presenter = (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController as? UIViewController else {
+        return
+    }
+    let activity = UIActivityViewController(activityItems: [target], applicationActivities: nil)
+    if let popover = activity.popoverPresentationController {
+        popover.sourceView = presenter.view
+        popover.sourceRect = CGRect(origin: CGPoint(x: presenter.view.bounds.midX, y: presenter.view.bounds.midY), size: CGSize())
+    }
+    presenter.present(activity, animated: true, completion: nil)
+}
+
+func lunagramSaveSticker(context: AccountContext, file: TelegramMediaFile, present: @escaping (ViewController) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let ok = TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+
+    guard let path = context.account.postbox.mediaBox.completedResourcePath(file.resource) else {
+        present(textAlertController(context: context, title: nil, text: "Стикер ещё не скачан. Открой его в переписке и попробуй снова.", actions: [ok]))
+        return
+    }
+
+    let moving = file.isAnimatedSticker || file.isVideoSticker || file.isVideoEmoji
+    if moving {
+        let name = file.isVideoSticker || file.isVideoEmoji ? "sticker.webm" : "sticker.tgs"
+        present(textAlertController(context: context, title: "Двигающийся стикер", text: "Галерея айфона такие не принимает: она берёт только те виды картинок и видео, которые понимает сам айфон, а этот стикер рисует Telegram.\n\nМогу отдать его файлом — в «Файлы» или в переписку он уйдёт как есть.", actions: [
+            TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .defaultAction, title: "Отдать файлом", action: {
+                lunagramShareFile(path: path, name: name, context: context, present: present)
+            })
+        ], actionLayout: .vertical))
+        return
+    }
+
+    guard let image = lunagramStickerImage(path: path) else {
+        present(textAlertController(context: context, title: nil, text: "Не вышло разобрать стикер в картинку.", actions: [ok]))
+        return
+    }
+    lunagramPutInGallery(image: image, context: context, present: present)
+}
