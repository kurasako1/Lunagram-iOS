+++ b/submodules/TelegramUI/Components/Chat/ChatTextInputPanelNode/Sources/LunagramTypingAnimation.swift
@@ -0,0 +1,156 @@
+import Foundation
+import UIKit
+import Lunagram
+
+// Lunagram: как появляются набираемые буквы.
+//
+// На ПК поверх новой буквы кладут заплатку цвета фона и растворяют её. Здесь
+// поле ввода стеклянное, и сплошная заплатка была бы видна прямоугольником,
+// поэтому место новых букв вырезается маской.
+//
+// Для видов, где буквы двигаются, одной маски мало: маска умеет только
+// показать или спрятать, а двигать надо сами буквы. Поэтому с них снимается
+// копия картинкой, кладётся поверх поля и летит, пока настоящие спрятаны под
+// маской. В конце копия убирается, маска снимается — и на месте оказываются
+// настоящие буквы, ровно там, где им и положено быть.
+//
+// Что бы тут ни случилось, набор текста это не трогает: пострадать может
+// только картинка.
+
+private let lunagramTypingMaskName = "lunagramTyping"
+
+/// Снять копию куска слоя картинкой. Зовётся до того, как поставлена маска:
+/// иначе в копию попала бы и она.
+private func lunagramTypingSnapshot(layer: CALayer, rect: CGRect) -> UIImage? {
+    guard rect.width > 0.5, rect.height > 0.5, rect.width < 2000.0, rect.height < 2000.0 else {
+        return nil
+    }
+    // Плотность точек не задаём: рисовальщик сам берёт ту, что у экрана.
+    let format = UIGraphicsImageRendererFormat()
+    format.opaque = false
+    return UIGraphicsImageRenderer(size: rect.size, format: format).image { context in
+        context.cgContext.translateBy(x: -rect.minX, y: -rect.minY)
+        layer.render(in: context.cgContext)
+    }
+}
+
+/// Откуда буквы прилетают — сдвиг в начале полёта.
+private func lunagramTypingOffset(_ effect: LunagramTypingEffect, size: CGSize) -> CGPoint {
+    switch effect {
+    case .flyUp:
+        return CGPoint(x: 0.0, y: size.height * 1.2)
+    case .flyDown:
+        return CGPoint(x: 0.0, y: -size.height * 1.2)
+    case .flyLeft:
+        return CGPoint(x: size.width * 0.8, y: 0.0)
+    case .flyRight:
+        return CGPoint(x: -size.width * 0.8, y: 0.0)
+    default:
+        return CGPoint()
+    }
+}
+
+func lunagramRunTypingEffect(on layer: CALayer, hole: CGRect, effect: LunagramTypingEffect) {
+    // Чужую маску не трогаем — только свою прошлую.
+    if let current = layer.mask, current.name != lunagramTypingMaskName {
+        return
+    }
+
+    // Копию снимаем первой: после маски копировать было бы нечего.
+    var ghost: CALayer?
+    if effect.movesLetters, let superlayer = layer.superlayer, let image = lunagramTypingSnapshot(layer: layer, rect: hole) {
+        let copy = CALayer()
+        copy.contents = image.cgImage
+        copy.contentsScale = image.scale
+        copy.frame = layer.convert(hole, to: superlayer)
+        copy.isOpaque = false
+        superlayer.addSublayer(copy)
+        ghost = copy
+    }
+
+    let bounds = layer.bounds
+    let mask = CALayer()
+    mask.name = lunagramTypingMaskName
+    mask.frame = bounds
+    let outside = CAShapeLayer()
+    outside.frame = CGRect(origin: CGPoint(), size: bounds.size)
+    let path = UIBezierPath(rect: CGRect(origin: CGPoint(), size: bounds.size))
+    path.append(UIBezierPath(rect: hole))
+    outside.path = path.cgPath
+    outside.fillRule = .evenOdd
+    outside.fillColor = UIColor.white.cgColor
+    mask.addSublayer(outside)
+    let reveal = CALayer()
+    reveal.frame = hole
+    reveal.backgroundColor = UIColor.white.cgColor
+    mask.addSublayer(reveal)
+    layer.mask = mask
+
+    let duration: Double = ghost == nil ? 0.16 : 0.22
+
+    CATransaction.begin()
+    CATransaction.setCompletionBlock({ [weak layer, weak ghost] in
+        ghost?.removeFromSuperlayer()
+        if let layer = layer, layer.mask === mask {
+            layer.mask = nil
+        }
+    })
+
+    if let ghost = ghost {
+        // Настоящие буквы держим спрятанными, пока летит копия.
+        reveal.opacity = 0.0
+
+        let fade = CABasicAnimation(keyPath: "opacity")
+        fade.fromValue = 0.0
+        fade.toValue = 1.0
+        fade.duration = duration * 0.6
+        ghost.add(fade, forKey: "lunagramGhostFade")
+
+        switch effect {
+        case .flyUp, .flyDown, .flyLeft, .flyRight:
+            let offset = lunagramTypingOffset(effect, size: hole.size)
+            let move = CABasicAnimation(keyPath: "transform.translation")
+            move.fromValue = NSValue(cgSize: CGSize(width: offset.x, height: offset.y))
+            move.toValue = NSValue(cgSize: CGSize())
+            move.duration = duration
+            move.timingFunction = CAMediaTimingFunction(name: .easeOut)
+            ghost.add(move, forKey: "lunagramGhostMove")
+        case .grow:
+            let scale = CABasicAnimation(keyPath: "transform.scale")
+            scale.fromValue = 0.3 as NSNumber
+            scale.toValue = 1.0 as NSNumber
+            scale.duration = duration
+            scale.timingFunction = CAMediaTimingFunction(name: .easeOut)
+            ghost.add(scale, forKey: "lunagramGhostScale")
+        case .spring:
+            let scale = CAKeyframeAnimation(keyPath: "transform.scale")
+            scale.values = [0.5 as NSNumber, 1.18 as NSNumber, 0.94 as NSNumber, 1.0 as NSNumber]
+            scale.keyTimes = [0.0 as NSNumber, 0.5 as NSNumber, 0.8 as NSNumber, 1.0 as NSNumber]
+            scale.duration = duration
+            ghost.add(scale, forKey: "lunagramGhostSpring")
+        case .spin:
+            let spin = CABasicAnimation(keyPath: "transform.rotation.z")
+            spin.fromValue = -0.7 as NSNumber
+            spin.toValue = 0.0 as NSNumber
+            spin.duration = duration
+            spin.timingFunction = CAMediaTimingFunction(name: .easeOut)
+            ghost.add(spin, forKey: "lunagramGhostSpin")
+            let scale = CABasicAnimation(keyPath: "transform.scale")
+            scale.fromValue = 0.6 as NSNumber
+            scale.toValue = 1.0 as NSNumber
+            scale.duration = duration
+            ghost.add(scale, forKey: "lunagramGhostSpinScale")
+        case .fade:
+            break
+        }
+    } else {
+        // Копию снять не вышло — остаётся то, что было всегда: проявление.
+        let animation = CABasicAnimation(keyPath: "opacity")
+        animation.fromValue = 0.0
+        animation.toValue = 1.0
+        animation.duration = duration
+        reveal.add(animation, forKey: "lunagramReveal")
+    }
+
+    CATransaction.commit()
+}
