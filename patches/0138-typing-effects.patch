+import Foundation
+
+/// Как появляются буквы, которые ты набираешь.
+///
+/// Раньше вид был один — буквы просто проявлялись. Это осталось, но теперь
+/// рядом стоят те, где буквы двигаются: прилетают, разворачиваются,
+/// отпружинивают. Всё это видишь только ты и только в своём поле ввода —
+/// собеседнику уходит обычный текст.
+public enum LunagramTypingEffect: Int, CaseIterable {
+    case fade = 0
+    case flyUp = 1
+    case flyDown = 2
+    case flyLeft = 3
+    case flyRight = 4
+    case grow = 5
+    case spring = 6
+    case spin = 7
+
+    public var title: String {
+        switch self {
+        case .fade:
+            return "Проявляются"
+        case .flyUp:
+            return "Прилетают снизу"
+        case .flyDown:
+            return "Падают сверху"
+        case .flyLeft:
+            return "Прилетают справа"
+        case .flyRight:
+            return "Прилетают слева"
+        case .grow:
+            return "Вырастают"
+        case .spring:
+            return "С пружинкой"
+        case .spin:
+            return "С поворотом"
+        }
+    }
+
+    /// Двигаются ли сами буквы. Проявление обходится маской, остальным нужна
+    /// копия букв: двигать можно только то, что нарисовано отдельно.
+    public var movesLetters: Bool {
+        return self != .fade
+    }
+}
