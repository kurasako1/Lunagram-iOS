diff --git a/submodules/TelegramUI/Components/Chat/ChatTextInputPanelNode/Sources/LunagramTypingAnimation.swift b/submodules/TelegramUI/Components/Chat/ChatTextInputPanelNode/Sources/LunagramTypingAnimation.swift
