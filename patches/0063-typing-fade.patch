+    /// Lunagram: сколько было символов — чтобы понять, сколько добавилось.
+    private var lunagramTypedLength = 0
+
+    /// Lunagram: плавное появление набираемых букв — как на ПК.
+    ///
+    /// На ПК поверх новой буквы кладут заплатку цвета фона и растворяют её. Здесь
+    /// поле ввода стеклянное, и сплошная заплатка была бы видна прямоугольником,
+    /// поэтому делаем маской: место новых букв сперва прозрачное и за миг
+    /// проявляется. Сам набор текста не трогаем — пострадать может только
+    /// картинка, но не ввод.
+    private func lunagramAnimateTyping() {
+        guard let node = self.richTextInputNode else {
+            return
+        }
+        let length = (node.text as NSString).length
+        let delta = length - self.lunagramTypedLength
+        self.lunagramTypedLength = length
+        guard LunagramSettings.typingAnimation, delta > 0, delta <= 8 else {
+            return
+        }
+        let caret = node.selectedRange.location
+        guard caret >= delta, let rect = node.firstSelectionRect(forCharacterRange: NSRange(location: caret - delta, length: delta)), rect.width > 0.0, rect.height > 0.0 else {
+            return
+        }
+        let layer = node.asNode.layer
+        // Чужую маску не трогаем — только свою прошлую.
+        if let current = layer.mask, current.name != "lunagramTyping" {
+            return
+        }
+        let bounds = layer.bounds
+        let hole = rect.insetBy(dx: -1.0, dy: -1.0).offsetBy(dx: -bounds.minX, dy: -bounds.minY)
+        let mask = CALayer()
+        mask.name = "lunagramTyping"
+        mask.frame = bounds
+        let outside = CAShapeLayer()
+        outside.frame = CGRect(origin: CGPoint(), size: bounds.size)
+        let path = UIBezierPath(rect: CGRect(origin: CGPoint(), size: bounds.size))
+        path.append(UIBezierPath(rect: hole))
+        outside.path = path.cgPath
+        outside.fillRule = .evenOdd
+        outside.fillColor = UIColor.white.cgColor
+        mask.addSublayer(outside)
+        let reveal = CALayer()
+        reveal.frame = hole
+        reveal.backgroundColor = UIColor.white.cgColor
+        mask.addSublayer(reveal)
+        layer.mask = mask
+        CATransaction.begin()
+        CATransaction.setCompletionBlock({ [weak layer] in
+            if let layer = layer, layer.mask === mask {
+                layer.mask = nil
+            }
+        })
+        let animation = CABasicAnimation(keyPath: "opacity")
+        animation.fromValue = 0.0
+        animation.toValue = 1.0
+        animation.duration = 0.16
+        reveal.add(animation, forKey: "lunagramReveal")
+        CATransaction.commit()
+    }
