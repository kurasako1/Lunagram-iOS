+/// Прежняя настройка приватности — чтобы вернуть свою, а не «для всех».
+///
+/// Хранить умеем немного: кому видно (всем, контактам, никому), списки
+/// исключений по номерам и телеграмовские галочки про премиум, ботов и
+/// близких друзей. Этого хватает: больше в настройке ничего и нет.
+private struct LunagramPrivacyBackup: Codable {
+    var option: Int
+    var enableFor: [Int64]
+    var disableFor: [Int64]
+    var enableForPremium: Bool
+    var enableForBots: Bool
+    var enableForCloseFriends: Bool
+}
+
+private func lunagramBackupKey(_ type: UpdateSelectiveAccountPrivacySettingsType) -> String {
+    switch type {
+    case .presence:
+        return "presence"
+    case .profilePhoto:
+        return "photo"
+    case .bio:
+        return "bio"
+    case .phoneNumber:
+        return "phone"
+    default:
+        return "other"
+    }
+}
+
+private func lunagramMakeBackup(_ settings: SelectivePrivacySettings) -> LunagramPrivacyBackup {
+    switch settings {
+    case let .enableEveryone(disableFor):
+        return LunagramPrivacyBackup(option: 0, enableFor: [], disableFor: disableFor.keys.map { $0.toInt64() }, enableForPremium: false, enableForBots: false, enableForCloseFriends: false)
+    case let .enableContacts(enableFor, disableFor, enableForPremium, enableForBots):
+        return LunagramPrivacyBackup(option: 1, enableFor: enableFor.keys.map { $0.toInt64() }, disableFor: disableFor.keys.map { $0.toInt64() }, enableForPremium: enableForPremium, enableForBots: enableForBots, enableForCloseFriends: false)
+    case let .disableEveryone(enableFor, enableForCloseFriends, enableForPremium, enableForBots):
+        return LunagramPrivacyBackup(option: 2, enableFor: enableFor.keys.map { $0.toInt64() }, disableFor: [], enableForPremium: enableForPremium, enableForBots: enableForBots, enableForCloseFriends: enableForCloseFriends)
+    }
+}
+
+private func lunagramRestoreSettings(_ backup: LunagramPrivacyBackup, peers: [PeerId: SelectivePrivacyPeer], hiddenIds: [PeerId]) -> SelectivePrivacySettings {
+    func map(_ ids: [Int64]) -> [PeerId: SelectivePrivacyPeer] {
+        var result: [PeerId: SelectivePrivacyPeer] = [:]
+        for id in ids {
+            let peerId = PeerId(id)
+            if let peer = peers[peerId] {
+                result[peerId] = peer
+            }
+        }
+        return result
+    }
+    switch backup.option {
+    case 1:
+        var disableFor = map(backup.disableFor)
+        // Кого прятал поимённо — тех прячем и дальше.
+        for peerId in hiddenIds {
+            if let peer = peers[peerId] {
+                disableFor[peerId] = peer
+            }
+        }
+        var enableFor = map(backup.enableFor)
+        for peerId in hiddenIds {
+            enableFor.removeValue(forKey: peerId)
+        }
+        return .enableContacts(enableFor: enableFor, disableFor: disableFor, enableForPremium: backup.enableForPremium, enableForBots: backup.enableForBots)
+    case 2:
+        var enableFor = map(backup.enableFor)
+        for peerId in hiddenIds {
+            enableFor.removeValue(forKey: peerId)
+        }
+        return .disableEveryone(enableFor: enableFor, enableForCloseFriends: backup.enableForCloseFriends, enableForPremium: backup.enableForPremium, enableForBots: backup.enableForBots)
+    default:
+        var disableFor = map(backup.disableFor)
+        for peerId in hiddenIds {
+            if let peer = peers[peerId] {
+                disableFor[peerId] = peer
+            }
+        }
+        return .enableEveryone(disableFor: disableFor)
+    }
+}
+
+private func lunagramLoadPrivacyBackup() -> [String: LunagramPrivacyBackup]? {
+    guard let data = LunagramSettings.privacyBackupData else {
+        return nil
+    }
+    return try? JSONDecoder().decode([String: LunagramPrivacyBackup].self, from: data)
+}
+
+private func lunagramSavePrivacyBackup(_ value: [String: LunagramPrivacyBackup]?) {
+    if let value = value {
+        LunagramSettings.privacyBackupData = try? JSONEncoder().encode(value)
+    } else {
+        LunagramSettings.privacyBackupData = nil
+    }
+}
+
