diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditor.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditor.swift
new file mode 100644
index 00000000..12a50817
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditor.swift
@@ -0,0 +1,337 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import AccountContext
+import Lunagram
+
+// Lunagram: панель правки оформления профиля — вид по плагину Custom Profile.
+//
+// Хозяин прислал снимки и сказал «точь в точь». Вид строк взят с них:
+//   * заголовок раздела прописными и серым («БАННЕР ПРОФИЛЯ»);
+//   * строка: слева крупное название, под ним серая подпись, справа рычаг;
+//   * полоска из плашек для выбора одного из нескольких (Медиа · Цвет ·
+//     Градиент), выбранная светлая;
+//   * цвет: название слева, кружок цвета и код вида #00000000 справа.
+//
+// Строки пишу СВОИ, а не беру готовые из настроек Telegram: готовые дают
+// родной вид списка, а весь смысл просьбы — чтобы выглядело как в плагине.
+// Ради этого же панель не прокручивает профиль: она живёт в окошке снизу, а
+// профиль над ней настоящий и меняется на ходу.
+
+let lgDecorRowHeight: CGFloat = 56.0
+let lgDecorRowHeightSub: CGFloat = 64.0
+let lgDecorInset: CGFloat = 16.0
+let lgDecorTabHeight: CGFloat = 36.0
+
+/// Что правим. Порядок вкладок — он же порядок в панели.
+public enum LunagramDecorTab: Int, CaseIterable {
+    case banner
+    case background
+    case name
+    case avatar
+    case frame
+    case buttons
+    case music
+
+    var title: String {
+        switch self {
+        case .banner: return "Баннер"
+        case .background: return "Фон"
+        case .name: return "Ник"
+        case .avatar: return "Аватар"
+        case .frame: return "Рамка"
+        case .buttons: return "Кнопки"
+        case .music: return "Музыка"
+        }
+    }
+}
+
+/// Одна строка панели.
+enum LunagramDecorRow {
+    /// Заголовок раздела: прописными и серым.
+    case header(String)
+    /// Переключатель: название, подпись под ним, включён ли.
+    case toggle(String, String?, Bool, (Bool) -> Void)
+    /// Полоска плашек: названия, какая выбрана.
+    case segments([String], Int, (Int) -> Void)
+    /// Цвет: название, сам цвет (nil — не выбран), что делать по нажатию.
+    case color(String, UInt32?, () -> Void)
+    /// Ползунок: название, значение, от, до, шаг.
+    case slider(String, Int, Int, Int, Int, (Int) -> Void)
+    /// Строка-действие со стрелкой: название и подпись.
+    case action(String, String?, () -> Void)
+}
+
+/// Переключатель с подписью — как «Включить баннер / Заменять фон шапки».
+final class LunagramDecorToggleNode: ASDisplayNode {
+    private let titleNode = ImmediateTextNode()
+    private let subtitleNode = ImmediateTextNode()
+    private let switchView = UISwitch()
+    private var changed: ((Bool) -> Void)?
+
+    override init() {
+        super.init()
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.subtitleNode)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.switchView.addTarget(self, action: #selector(self.switched), for: .valueChanged)
+        self.view.addSubview(self.switchView)
+    }
+
+    @objc private func switched() {
+        self.changed?(self.switchView.isOn)
+    }
+
+    func update(title: String, subtitle: String?, value: Bool, theme: PresentationTheme, width: CGFloat, changed: @escaping (Bool) -> Void) -> CGFloat {
+        self.changed = changed
+        // Название крупное и жирное — на снимке оно заметно больше подписи.
+        self.titleNode.attributedText = NSAttributedString(
+            string: title,
+            font: Font.semibold(17.0),
+            textColor: theme.list.itemPrimaryTextColor)
+        self.subtitleNode.attributedText = subtitle.flatMap {
+            NSAttributedString(
+                string: $0,
+                font: Font.regular(13.0),
+                textColor: theme.list.itemSecondaryTextColor)
+        }
+        self.switchView.isOn = value
+        self.switchView.onTintColor = theme.list.itemSwitchColors.positiveColor
+
+        let height = (subtitle == nil) ? lgDecorRowHeight : lgDecorRowHeightSub
+        let switchSize = self.switchView.bounds.size
+        let available = width - lgDecorInset * 2.0 - switchSize.width - 12.0
+        let titleSize = self.titleNode.updateLayout(CGSize(width: available, height: 100.0))
+        let subtitleSize = self.subtitleNode.updateLayout(CGSize(width: available, height: 100.0))
+
+        let textHeight = titleSize.height + (subtitle == nil ? 0.0 : subtitleSize.height + 2.0)
+        var y = floor((height - textHeight) / 2.0)
+        self.titleNode.frame = CGRect(origin: CGPoint(x: lgDecorInset, y: y), size: titleSize)
+        y += titleSize.height + 2.0
+        self.subtitleNode.frame = CGRect(origin: CGPoint(x: lgDecorInset, y: y), size: subtitleSize)
+        self.switchView.frame = CGRect(
+            x: width - lgDecorInset - switchSize.width,
+            y: floor((height - switchSize.height) / 2.0),
+            width: switchSize.width,
+            height: switchSize.height)
+        return height
+    }
+}
+
+/// Полоска плашек — как «Медиа · Цвет · Градиент».
+final class LunagramDecorSegmentsNode: ASDisplayNode {
+    private var buttons: [HighlightTrackingButtonNode] = []
+    private var labels: [ImmediateTextNode] = []
+    private var selected: ((Int) -> Void)?
+
+    func update(titles: [String], selectedIndex: Int, theme: PresentationTheme, width: CGFloat, selected: @escaping (Int) -> Void) -> CGFloat {
+        self.selected = selected
+        while self.buttons.count > titles.count {
+            self.buttons.removeLast().removeFromSupernode()
+            self.labels.removeLast().removeFromSupernode()
+        }
+        while self.buttons.count < titles.count {
+            let button = HighlightTrackingButtonNode()
+            button.addTarget(self, action: #selector(self.pressed(_:)), forControlEvents: .touchUpInside)
+            self.addSubnode(button)
+            self.buttons.append(button)
+            let label = ImmediateTextNode()
+            label.isUserInteractionEnabled = false
+            self.addSubnode(label)
+            self.labels.append(label)
+        }
+
+        let height = lgDecorTabHeight + 8.0
+        let gap: CGFloat = 8.0
+        let total = width - lgDecorInset * 2.0 - gap * CGFloat(max(0, titles.count - 1))
+        let itemWidth = floor(total / CGFloat(max(1, titles.count)))
+        for (index, title) in titles.enumerated() {
+            let isOn = index == selectedIndex
+            let frame = CGRect(
+                x: lgDecorInset + CGFloat(index) * (itemWidth + gap),
+                y: 4.0,
+                width: itemWidth,
+                height: lgDecorTabHeight)
+            let button = self.buttons[index]
+            button.frame = frame
+            button.backgroundColor = isOn
+                ? theme.list.itemPrimaryTextColor.withAlphaComponent(0.92)
+                : theme.list.itemBlocksBackgroundColor
+            button.cornerRadius = lgDecorTabHeight / 2.0
+            button.clipsToBounds = true
+
+            let label = self.labels[index]
+            label.attributedText = NSAttributedString(
+                string: title,
+                font: Font.semibold(15.0),
+                textColor: isOn
+                    ? theme.list.itemBlocksBackgroundColor
+                    : theme.list.itemPrimaryTextColor)
+            let size = label.updateLayout(CGSize(width: itemWidth, height: lgDecorTabHeight))
+            label.frame = CGRect(
+                x: frame.minX + floor((itemWidth - size.width) / 2.0),
+                y: frame.minY + floor((lgDecorTabHeight - size.height) / 2.0),
+                width: size.width,
+                height: size.height)
+        }
+        return height
+    }
+
+    @objc private func pressed(_ sender: HighlightTrackingButtonNode) {
+        guard let index = self.buttons.firstIndex(where: { $0 === sender }) else {
+            return
+        }
+        self.selected?(index)
+    }
+}
+
+/// Цвет: название слева, кружок и код справа — как «Цвет баннера #00000000».
+final class LunagramDecorColorNode: ASDisplayNode {
+    private let titleNode = ImmediateTextNode()
+    private let codeNode = ImmediateTextNode()
+    private let swatchNode = ASImageNode()
+    private let button = HighlightTrackingButtonNode()
+    private var action: (() -> Void)?
+
+    override init() {
+        super.init()
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.swatchNode)
+        self.addSubnode(self.codeNode)
+        self.addSubnode(self.button)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.button.addTarget(self, action: #selector(self.pressed), forControlEvents: .touchUpInside)
+    }
+
+    @objc private func pressed() {
+        self.action?()
+    }
+
+    func update(title: String, color: UInt32?, theme: PresentationTheme, width: CGFloat, action: @escaping () -> Void) -> CGFloat {
+        self.action = action
+        self.titleNode.attributedText = NSAttributedString(
+            string: title,
+            font: Font.semibold(17.0),
+            textColor: theme.list.itemPrimaryTextColor)
+        // Код цвета как у них: восемь цифр с прозрачностью впереди.
+        let code = color.map { String(format: "#FF%06X", $0 & 0xFFFFFF) } ?? "#00000000"
+        self.codeNode.attributedText = NSAttributedString(
+            string: code,
+            font: Font.regular(15.0),
+            textColor: theme.list.itemSecondaryTextColor)
+
+        let swatchSide: CGFloat = 36.0
+        self.swatchNode.image = LunagramDecorColorNode.swatch(
+            color: color,
+            side: swatchSide)
+
+        let titleSize = self.titleNode.updateLayout(CGSize(width: width / 2.0, height: 100.0))
+        let codeSize = self.codeNode.updateLayout(CGSize(width: width / 2.0, height: 100.0))
+        self.titleNode.frame = CGRect(
+            x: lgDecorInset,
+            y: floor((lgDecorRowHeight - titleSize.height) / 2.0),
+            width: titleSize.width,
+            height: titleSize.height)
+        self.codeNode.frame = CGRect(
+            x: width - lgDecorInset - codeSize.width,
+            y: floor((lgDecorRowHeight - codeSize.height) / 2.0),
+            width: codeSize.width,
+            height: codeSize.height)
+        self.swatchNode.frame = CGRect(
+            x: self.codeNode.frame.minX - 10.0 - swatchSide,
+            y: floor((lgDecorRowHeight - swatchSide) / 2.0),
+            width: swatchSide,
+            height: swatchSide)
+        self.button.frame = CGRect(x: 0.0, y: 0.0, width: width, height: lgDecorRowHeight)
+        return lgDecorRowHeight
+    }
+
+    /// Кружок цвета. Не выбран — рисуем шашечку, как у них: так сразу видно,
+    /// что цвета нет, а не что он чёрный.
+    private static func swatch(color: UInt32?, side: CGFloat) -> UIImage? {
+        let size = CGSize(width: side, height: side)
+        return UIGraphicsImageRenderer(size: size).image { context in
+            let cg = context.cgContext
+            let rect = CGRect(origin: CGPoint(), size: size)
+            cg.addPath(UIBezierPath(roundedRect: rect, cornerRadius: 8.0).cgPath)
+            cg.clip()
+            if let color = color {
+                cg.setFillColor(UIColor(rgb: color).cgColor)
+                cg.fill(rect)
+            } else {
+                let cell: CGFloat = 6.0
+                var row = 0
+                var y: CGFloat = 0.0
+                while y < size.height {
+                    var column = 0
+                    var x: CGFloat = 0.0
+                    while x < size.width {
+                        let light = (row + column) % 2 == 0
+                        cg.setFillColor((light ? UIColor.white : UIColor(white: 0.78, alpha: 1.0)).cgColor)
+                        cg.fill(CGRect(x: x, y: y, width: cell, height: cell))
+                        x += cell
+                        column += 1
+                    }
+                    y += cell
+                    row += 1
+                }
+            }
+        }
+    }
+}
+
+/// Значок палитры для верхней полосы профиля.
+///
+/// Рисую сам: в Telegram такого значка нет, а брать чужой файл шрифта или
+/// картинки хозяин запретил. Палитра — скруглённый блин с выемкой под
+/// большой палец и три пятна краски.
+public func lunagramDecorIcon(_ theme: PresentationTheme) -> UIImage? {
+    let side: CGFloat = 26.0
+    return generateImage(CGSize(width: side, height: side), rotatedContext: { size, context in
+        context.clear(CGRect(origin: CGPoint(), size: size))
+        context.setStrokeColor(UIColor.white.cgColor)
+        context.setFillColor(UIColor.white.cgColor)
+        context.setLineWidth(1.6)
+
+        let inset: CGFloat = 3.0
+        let body = CGRect(
+            x: inset, y: inset,
+            width: size.width - inset * 2.0,
+            height: size.height - inset * 2.0)
+
+        // Сам блин — кругом, обводкой.
+        context.strokeEllipse(in: body)
+
+        // Выемка под палец: маленький круг у правого края, тоже обводкой.
+        let thumbSide: CGFloat = 5.0
+        context.strokeEllipse(in: CGRect(
+            x: body.maxX - thumbSide - 1.2,
+            y: body.midY - thumbSide / 2.0,
+            width: thumbSide,
+            height: thumbSide))
+
+        // Три пятна краски. Залиты — чтобы значок читался и в 26 точек.
+        let dotSide: CGFloat = 3.4
+        let dots = [
+            CGPoint(x: body.midX - 4.2, y: body.midY - 4.4),
+            CGPoint(x: body.midX + 1.4, y: body.midY - 5.0),
+            CGPoint(x: body.midX - 5.4, y: body.midY + 1.6),
+        ]
+        for dot in dots {
+            context.fillEllipse(in: CGRect(
+                x: dot.x - dotSide / 2.0,
+                y: dot.y - dotSide / 2.0,
+                width: dotSide,
+                height: dotSide))
+        }
+    })
+}
diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditorScreen.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditorScreen.swift
new file mode 100644
index 00000000..f92eb559
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramDecorEditorScreen.swift
@@ -0,0 +1,1044 @@
+import Foundation
+import UIKit
+import PhotosUI
+import UniformTypeIdentifiers
+import AsyncDisplayKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import Lunagram
+
+// Lunagram: сама панель правки оформления — вкладки сверху, строки под ними.
+//
+// Вид по снимкам из плагина Custom Profile: ряд плашек-вкладок (Баннер · Фон ·
+// Ник · Аватар · Рамка · Кнопки · Музыка), под ним строки выбранной вкладки.
+// Живой профиль — НАД панелью: панель живёт в окошке снизу
+// (`LunagramEditorSheet`), и шапка профиля видна и меняется на ходу.
+//
+// Строки собираются заново на каждую перестройку, а узлы под них берутся из
+// запаса и переиспользуются: вкладок семь, строк в каждой до десятка, и
+// плодить по узлу на строку при каждом щелчке рычага незачем.
+//
+// Заголовки, ползунки и действия описаны здесь же, а переключатель, плашки и
+// цвет — в `LunagramDecorEditor.swift`. Делить по файлам пришлось из-за
+// размера, работают они вместе.
+
+/// Заголовок раздела: прописными и серым, как «БАННЕР ПРОФИЛЯ» на снимке.
+final class LunagramDecorHeaderNode: ASDisplayNode {
+    private let titleNode = ImmediateTextNode()
+
+    override init() {
+        super.init()
+        self.addSubnode(self.titleNode)
+    }
+
+    func update(title: String, theme: PresentationTheme, width: CGFloat) -> CGFloat {
+        self.titleNode.attributedText = NSAttributedString(
+            string: title.uppercased(),
+            font: Font.semibold(13.0),
+            textColor: theme.list.itemSecondaryTextColor)
+        let size = self.titleNode.updateLayout(CGSize(width: width - lgDecorInset * 2.0, height: 100.0))
+        let height: CGFloat = 38.0
+        self.titleNode.frame = CGRect(
+            x: lgDecorInset,
+            y: height - size.height - 8.0,
+            width: size.width,
+            height: size.height)
+        return height
+    }
+}
+
+/// Ползунок: название слева, значение справа, под ними сама полоска.
+///
+/// Беру родной `UISlider`, а не рисую свой: на снимке он и есть обычный
+/// ползунок, а своему пришлось бы объяснять все мелочи вроде нажатия мимо
+/// кружка. Выигрыша нет, а поломаться есть чему.
+final class LunagramDecorSliderNode: ASDisplayNode {
+    private let titleNode = ImmediateTextNode()
+    private let valueNode = ImmediateTextNode()
+    private let sliderView = UISlider()
+    private var changed: ((Int) -> Void)?
+    private var step = 1
+
+    override init() {
+        super.init()
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.valueNode)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.sliderView.addTarget(self, action: #selector(self.slid), for: .valueChanged)
+        self.view.addSubview(self.sliderView)
+    }
+
+    @objc private func slid() {
+        // Округляю к шагу: иначе «затемнение 0…3» ехало бы дробями.
+        let raw = Int(self.sliderView.value.rounded())
+        let snapped = self.step > 1 ? (raw / self.step) * self.step : raw
+        self.changed?(snapped)
+    }
+
+    func update(
+        title: String,
+        value: Int,
+        minValue: Int,
+        maxValue: Int,
+        step: Int,
+        theme: PresentationTheme,
+        width: CGFloat,
+        changed: @escaping (Int) -> Void
+    ) -> CGFloat {
+        self.changed = changed
+        self.step = max(1, step)
+        self.titleNode.attributedText = NSAttributedString(
+            string: title,
+            font: Font.semibold(17.0),
+            textColor: theme.list.itemPrimaryTextColor)
+        self.valueNode.attributedText = NSAttributedString(
+            string: "\(value)",
+            font: Font.regular(15.0),
+            textColor: theme.list.itemSecondaryTextColor)
+        self.sliderView.minimumValue = Float(minValue)
+        self.sliderView.maximumValue = Float(maxValue)
+        self.sliderView.value = Float(value)
+        self.sliderView.minimumTrackTintColor = theme.list.itemAccentColor
+        self.sliderView.maximumTrackTintColor = theme.list.controlSecondaryColor
+
+        let titleSize = self.titleNode.updateLayout(CGSize(width: width * 0.7, height: 100.0))
+        let valueSize = self.valueNode.updateLayout(CGSize(width: width * 0.3, height: 100.0))
+        self.titleNode.frame = CGRect(
+            x: lgDecorInset, y: 10.0, width: titleSize.width, height: titleSize.height)
+        self.valueNode.frame = CGRect(
+            x: width - lgDecorInset - valueSize.width,
+            y: 10.0 + floor((titleSize.height - valueSize.height) / 2.0),
+            width: valueSize.width,
+            height: valueSize.height)
+        self.sliderView.frame = CGRect(
+            x: lgDecorInset,
+            y: 10.0 + titleSize.height + 4.0,
+            width: width - lgDecorInset * 2.0,
+            height: 30.0)
+        return 10.0 + titleSize.height + 4.0 + 30.0 + 8.0
+    }
+}
+
+/// Строка-действие со стрелкой: открывает что-то ещё.
+final class LunagramDecorActionNode: ASDisplayNode {
+    private let titleNode = ImmediateTextNode()
+    private let subtitleNode = ImmediateTextNode()
+    private let arrowNode = ASImageNode()
+    private let button = HighlightTrackingButtonNode()
+    private var action: (() -> Void)?
+
+    override init() {
+        super.init()
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.subtitleNode)
+        self.addSubnode(self.arrowNode)
+        self.addSubnode(self.button)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.button.addTarget(self, action: #selector(self.pressed), forControlEvents: .touchUpInside)
+    }
+
+    @objc private func pressed() {
+        self.action?()
+    }
+
+    func update(
+        title: String,
+        subtitle: String?,
+        theme: PresentationTheme,
+        width: CGFloat,
+        action: @escaping () -> Void
+    ) -> CGFloat {
+        self.action = action
+        self.titleNode.attributedText = NSAttributedString(
+            string: title,
+            font: Font.semibold(17.0),
+            textColor: theme.list.itemPrimaryTextColor)
+        self.subtitleNode.attributedText = subtitle.flatMap {
+            NSAttributedString(
+                string: $0,
+                font: Font.regular(13.0),
+                textColor: theme.list.itemSecondaryTextColor)
+        }
+        self.arrowNode.image = PresentationResourcesItemList.disclosureArrowImage(theme)
+
+        let height = (subtitle == nil) ? lgDecorRowHeight : lgDecorRowHeightSub
+        let arrowSize = self.arrowNode.image?.size ?? CGSize()
+        let available = width - lgDecorInset * 2.0 - arrowSize.width - 10.0
+        let titleSize = self.titleNode.updateLayout(CGSize(width: available, height: 100.0))
+        let subtitleSize = self.subtitleNode.updateLayout(CGSize(width: available, height: 100.0))
+        let textHeight = titleSize.height + (subtitle == nil ? 0.0 : subtitleSize.height + 2.0)
+        var y = floor((height - textHeight) / 2.0)
+        self.titleNode.frame = CGRect(origin: CGPoint(x: lgDecorInset, y: y), size: titleSize)
+        y += titleSize.height + 2.0
+        self.subtitleNode.frame = CGRect(origin: CGPoint(x: lgDecorInset, y: y), size: subtitleSize)
+        self.arrowNode.frame = CGRect(
+            x: width - lgDecorInset - arrowSize.width,
+            y: floor((height - arrowSize.height) / 2.0),
+            width: arrowSize.width,
+            height: arrowSize.height)
+        self.button.frame = CGRect(x: 0.0, y: 0.0, width: width, height: height)
+        return height
+    }
+}
+
+/// Ряд вкладок сверху панели. Семь штук в ширину телефона не влезают,
+/// поэтому ряд прокручивается боком — как у них.
+private final class LunagramDecorTabsNode: ASDisplayNode, UIScrollViewDelegate {
+    private let scrollNode: ASScrollNode
+    private var buttons: [HighlightTrackingButtonNode] = []
+    private var labels: [ImmediateTextNode] = []
+    private var selectedIndex = 0
+    var selected: ((Int) -> Void)?
+
+    override init() {
+        self.scrollNode = ASScrollNode()
+        super.init()
+        self.scrollNode.view.showsHorizontalScrollIndicator = false
+        self.scrollNode.view.alwaysBounceHorizontal = false
+        self.addSubnode(self.scrollNode)
+    }
+
+    func update(selectedIndex: Int, theme: PresentationTheme, width: CGFloat) -> CGFloat {
+        self.selectedIndex = selectedIndex
+        let tabs = LunagramDecorTab.allCases
+        while self.buttons.count < tabs.count {
+            let button = HighlightTrackingButtonNode()
+            button.addTarget(self, action: #selector(self.pressed(_:)), forControlEvents: .touchUpInside)
+            self.scrollNode.addSubnode(button)
+            self.buttons.append(button)
+            let label = ImmediateTextNode()
+            label.isUserInteractionEnabled = false
+            self.scrollNode.addSubnode(label)
+            self.labels.append(label)
+        }
+
+        let height = lgDecorTabHeight + 16.0
+        var x = lgDecorInset
+        for (index, tab) in tabs.enumerated() {
+            let isOn = index == selectedIndex
+            let label = self.labels[index]
+            label.attributedText = NSAttributedString(
+                string: tab.title,
+                font: Font.semibold(15.0),
+                textColor: isOn
+                    ? theme.list.itemCheckColors.foregroundColor
+                    : theme.list.itemPrimaryTextColor)
+            let textSize = label.updateLayout(CGSize(width: 200.0, height: lgDecorTabHeight))
+            let itemWidth = textSize.width + 28.0
+
+            let button = self.buttons[index]
+            button.frame = CGRect(x: x, y: 8.0, width: itemWidth, height: lgDecorTabHeight)
+            button.backgroundColor = isOn
+                ? theme.list.itemAccentColor
+                : theme.list.itemPrimaryTextColor.withAlphaComponent(0.08)
+            button.cornerRadius = lgDecorTabHeight / 2.0
+            button.clipsToBounds = true
+
+            label.frame = CGRect(
+                x: x + floor((itemWidth - textSize.width) / 2.0),
+                y: 8.0 + floor((lgDecorTabHeight - textSize.height) / 2.0),
+                width: textSize.width,
+                height: textSize.height)
+            x += itemWidth + 8.0
+        }
+
+        self.scrollNode.frame = CGRect(x: 0.0, y: 0.0, width: width, height: height)
+        self.scrollNode.view.contentSize = CGSize(width: x - 8.0 + lgDecorInset, height: height)
+        return height
+    }
+
+    @objc private func pressed(_ sender: HighlightTrackingButtonNode) {
+        guard let index = self.buttons.firstIndex(where: { $0 === sender }) else {
+            return
+        }
+        self.selected?(index)
+    }
+}
+
+/// Узел панели: ряд вкладок и прокручиваемые строки под ним.
+private final class LunagramDecorEditorNode: ViewControllerTracingNode {
+    private weak var controller: ViewController?
+    private let context: AccountContext
+    private var theme: PresentationTheme
+
+    private let tabsNode = LunagramDecorTabsNode()
+    private let separatorNode = ASDisplayNode()
+    private let scrollNode: ASScrollNode
+
+    private var tab: LunagramDecorTab = .banner
+    /// Какой вид заливки выбран в этой вкладке: 0 — медиа, 1 — цвет,
+    /// 2 — градиент. Хранится только пока панель открыта: у нас цвет и
+    /// картинка живут рядом и не исключают друг друга, а плашки нужны
+    /// затем, чтобы показывать по одной группе строк, а не всё разом.
+    private var fillMode: [LunagramDecorTab: Int] = [:]
+
+    /// Запас узлов: на перестройку достаём отсюда, лишние прячем.
+    private var toggleNodes: [LunagramDecorToggleNode] = []
+    private var headerNodes: [LunagramDecorHeaderNode] = []
+    private var sliderNodes: [LunagramDecorSliderNode] = []
+    private var colorNodes: [LunagramDecorColorNode] = []
+    private var actionNodes: [LunagramDecorActionNode] = []
+    private var segmentNodes: [LunagramDecorSegmentsNode] = []
+
+    private var validLayout: ContainerViewLayout?
+    private var settingsDisposable: Any?
+    /// Приёмщик выбранного файла, пока окошко выбора открыто.
+    fileprivate var pickerDelegate: AnyObject?
+
+    init(controller: ViewController, context: AccountContext) {
+        self.controller = controller
+        self.context = context
+        self.theme = context.sharedContext.currentPresentationData.with({ $0 }).theme
+        self.scrollNode = ASScrollNode()
+
+        super.init()
+
+        self.backgroundColor = self.theme.list.blocksBackgroundColor
+        self.addSubnode(self.tabsNode)
+
+        self.separatorNode.backgroundColor = self.theme.list.itemBlocksSeparatorColor
+        self.addSubnode(self.separatorNode)
+
+        self.scrollNode.view.alwaysBounceVertical = true
+        self.addSubnode(self.scrollNode)
+
+        self.tabsNode.selected = { [weak self] index in
+            guard let self = self, let tab = LunagramDecorTab(rawValue: index) else {
+                return
+            }
+            self.tab = tab
+            self.scrollNode.view.setContentOffset(CGPoint(), animated: false)
+            self.rebuild()
+        }
+    }
+
+    deinit {
+        if let token = self.settingsDisposable as? NSObjectProtocol {
+            NotificationCenter.default.removeObserver(token)
+        }
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        // Панель слушает те же настройки, что и шапка профиля: цвет мог
+        // смениться в окошке цвета, и строка должна показать новый код.
+        self.settingsDisposable = NotificationCenter.default.addObserver(
+            forName: LunagramSettings.didChangeNotification,
+            object: nil,
+            queue: .main,
+            using: { [weak self] _ in
+                self?.rebuild()
+            })
+    }
+
+    func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        self.validLayout = layout
+        self.rebuild()
+    }
+
+    /// Какая плашка выбрана в этой вкладке.
+    ///
+    /// Пока человек её не трогал, беру из настроек: уже выбран цвет — значит
+    /// открывать надо на «Цвете», а не на «Как в теме» со спрятанной строкой
+    /// цвета. Иначе выходило бы, что цвет стоит, а панель это скрывает.
+    private func mode(for tab: LunagramDecorTab) -> Int {
+        if let stored = self.fillMode[tab] {
+            return stored
+        }
+        switch tab {
+        case .name:
+            if LunagramSettings.profileNameCustomColor2 != nil {
+                return 2
+            }
+            return LunagramSettings.profileNameCustomColor != nil ? 1 : 0
+        case .music:
+            return (LunagramSettings.profileMusicBgURL == nil
+                && LunagramSettings.profileMusicBgColor != nil) ? 1 : 0
+        default:
+            return 0
+        }
+    }
+
+    /// Собрать строки выбранной вкладки и разложить их.
+    private func rebuild() {
+        guard let layout = self.validLayout else {
+            return
+        }
+        let width = layout.size.width
+
+        let tabsHeight = self.tabsNode.update(
+            selectedIndex: self.tab.rawValue, theme: self.theme, width: width)
+        self.tabsNode.frame = CGRect(x: 0.0, y: 0.0, width: width, height: tabsHeight)
+        self.separatorNode.frame = CGRect(
+            x: 0.0, y: tabsHeight, width: width, height: UIScreenPixel)
+
+        let rows = self.rows(for: self.tab)
+
+        var toggleIndex = 0
+        var headerIndex = 0
+        var sliderIndex = 0
+        var colorIndex = 0
+        var actionIndex = 0
+        var segmentIndex = 0
+        var y: CGFloat = 0.0
+
+        for row in rows {
+            switch row {
+            case let .header(title):
+                while self.headerNodes.count <= headerIndex {
+                    let node = LunagramDecorHeaderNode()
+                    self.scrollNode.addSubnode(node)
+                    self.headerNodes.append(node)
+                }
+                let node = self.headerNodes[headerIndex]
+                headerIndex += 1
+                node.isHidden = false
+                let height = node.update(title: title, theme: self.theme, width: width)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            case let .toggle(title, subtitle, value, changed):
+                while self.toggleNodes.count <= toggleIndex {
+                    let node = LunagramDecorToggleNode()
+                    self.scrollNode.addSubnode(node)
+                    self.toggleNodes.append(node)
+                }
+                let node = self.toggleNodes[toggleIndex]
+                toggleIndex += 1
+                node.isHidden = false
+                let height = node.update(
+                    title: title,
+                    subtitle: subtitle,
+                    value: value,
+                    theme: self.theme,
+                    width: width,
+                    changed: changed)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            case let .segments(titles, selectedIndex, selected):
+                while self.segmentNodes.count <= segmentIndex {
+                    let node = LunagramDecorSegmentsNode()
+                    self.scrollNode.addSubnode(node)
+                    self.segmentNodes.append(node)
+                }
+                let node = self.segmentNodes[segmentIndex]
+                segmentIndex += 1
+                node.isHidden = false
+                let height = node.update(
+                    titles: titles,
+                    selectedIndex: selectedIndex,
+                    theme: self.theme,
+                    width: width,
+                    selected: selected)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            case let .color(title, value, action):
+                while self.colorNodes.count <= colorIndex {
+                    let node = LunagramDecorColorNode()
+                    self.scrollNode.addSubnode(node)
+                    self.colorNodes.append(node)
+                }
+                let node = self.colorNodes[colorIndex]
+                colorIndex += 1
+                node.isHidden = false
+                let height = node.update(
+                    title: title, color: value, theme: self.theme, width: width, action: action)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            case let .slider(title, value, minValue, maxValue, step, changed):
+                while self.sliderNodes.count <= sliderIndex {
+                    let node = LunagramDecorSliderNode()
+                    self.scrollNode.addSubnode(node)
+                    self.sliderNodes.append(node)
+                }
+                let node = self.sliderNodes[sliderIndex]
+                sliderIndex += 1
+                node.isHidden = false
+                let height = node.update(
+                    title: title,
+                    value: value,
+                    minValue: minValue,
+                    maxValue: maxValue,
+                    step: step,
+                    theme: self.theme,
+                    width: width,
+                    changed: changed)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            case let .action(title, subtitle, action):
+                while self.actionNodes.count <= actionIndex {
+                    let node = LunagramDecorActionNode()
+                    self.scrollNode.addSubnode(node)
+                    self.actionNodes.append(node)
+                }
+                let node = self.actionNodes[actionIndex]
+                actionIndex += 1
+                node.isHidden = false
+                let height = node.update(
+                    title: title,
+                    subtitle: subtitle,
+                    theme: self.theme,
+                    width: width,
+                    action: action)
+                node.frame = CGRect(x: 0.0, y: y, width: width, height: height)
+                y += height
+            }
+        }
+
+        // Лишние узлы из запаса прячем, а не убираем: следующая вкладка,
+        // скорее всего, попросит их снова.
+        for index in toggleIndex ..< self.toggleNodes.count {
+            self.toggleNodes[index].isHidden = true
+        }
+        for index in headerIndex ..< self.headerNodes.count {
+            self.headerNodes[index].isHidden = true
+        }
+        for index in sliderIndex ..< self.sliderNodes.count {
+            self.sliderNodes[index].isHidden = true
+        }
+        for index in colorIndex ..< self.colorNodes.count {
+            self.colorNodes[index].isHidden = true
+        }
+        for index in actionIndex ..< self.actionNodes.count {
+            self.actionNodes[index].isHidden = true
+        }
+        for index in segmentIndex ..< self.segmentNodes.count {
+            self.segmentNodes[index].isHidden = true
+        }
+
+        let scrollTop = tabsHeight + UIScreenPixel
+        self.scrollNode.frame = CGRect(
+            x: 0.0,
+            y: scrollTop,
+            width: width,
+            height: max(0.0, layout.size.height - scrollTop))
+        self.scrollNode.view.contentInset = UIEdgeInsets(
+            top: 0.0, left: 0.0, bottom: layout.intrinsicInsets.bottom + 16.0, right: 0.0)
+        self.scrollNode.view.contentSize = CGSize(width: width, height: y)
+    }
+
+    /// Открыть своё окошко цвета и положить выбранное куда сказано.
+    private func pickColor(
+        title: String,
+        current: UInt32?,
+        allowsClear: Bool,
+        apply: @escaping (UInt32?) -> Void
+    ) {
+        guard let presenter = self.controller?.view.window?.rootViewController else {
+            return
+        }
+        LunagramColorWheel.present(
+            from: presenter,
+            title: title,
+            color: current,
+            allowsAlpha: true,
+            allowsClear: allowsClear,
+            onPick: { packed in
+                apply(packed)
+            },
+            onClear: allowsClear ? { apply(nil) } : nil)
+    }
+
+    // MARK: Строки вкладок
+
+    private func rows(for tab: LunagramDecorTab) -> [LunagramDecorRow] {
+        switch tab {
+        case .banner:
+            return self.bannerRows()
+        case .background:
+            return self.backgroundRows()
+        case .name:
+            return self.nameRows()
+        case .avatar:
+            return self.avatarRows()
+        case .frame:
+            return self.frameRows()
+        case .buttons:
+            return self.buttonsRows()
+        case .music:
+            return self.musicRows()
+        }
+    }
+
+    private func bannerRows() -> [LunagramDecorRow] {
+        var rows: [LunagramDecorRow] = []
+        rows.append(.header("Баннер профиля"))
+        rows.append(.toggle(
+            "Включить баннер",
+            "Фото или видео за аватаркой и именем",
+            LunagramSettings.profileBannerEnabled,
+            { value in
+                LunagramSettings.profileBannerEnabled = value
+            }))
+        guard LunagramSettings.profileBannerEnabled else {
+            return rows
+        }
+        rows.append(.action(
+            "Выбрать картинку",
+            LunagramSettings.hasProfileBanner ? "Выбрано" : "Не выбрано",
+            { [weak self] in
+                self?.openBannerPicker()
+            }))
+        rows.append(.header("Как показывать"))
+        rows.append(.slider(
+            "Затемнение", LunagramSettings.profileBannerDim, 0, 3, 1,
+            { value in
+                LunagramSettings.profileBannerDim = value
+            }))
+        rows.append(.slider(
+            "Размытие", LunagramSettings.profileBannerBlur, 0, 100, 5,
+            { value in
+                LunagramSettings.profileBannerBlur = value
+            }))
+        rows.append(.slider(
+            "Растворение к низу", LunagramSettings.profileBannerFade, 0, 100, 5,
+            { value in
+                LunagramSettings.profileBannerFade = value
+            }))
+        rows.append(.header("Звук"))
+        rows.append(.toggle(
+            "Звук видео",
+            "Только пока профиль открыт",
+            LunagramSettings.profileBannerSound,
+            { value in
+                LunagramSettings.profileBannerSound = value
+            }))
+        if LunagramSettings.profileBannerSound {
+            rows.append(.slider(
+                "Громкость", LunagramSettings.profileBannerVolume, 0, 100, 5,
+                { value in
+                    LunagramSettings.profileBannerVolume = value
+                }))
+        }
+        return rows
+    }
+
+    private func backgroundRows() -> [LunagramDecorRow] {
+        var rows: [LunagramDecorRow] = []
+        rows.append(.header("Фон профиля"))
+        rows.append(.action(
+            "Выбрать картинку",
+            LunagramSettings.profileBackgroundURL != nil ? "Выбрано" : "Не выбрано",
+            { [weak self] in
+                self?.openBackgroundPicker()
+            }))
+        rows.append(.slider(
+            "Затемнение", LunagramSettings.profileBackgroundDim, 0, 100, 5,
+            { value in
+                LunagramSettings.profileBackgroundDim = value
+            }))
+        rows.append(.slider(
+            "Размытие", LunagramSettings.profileBackgroundBlur, 0, 100, 5,
+            { value in
+                LunagramSettings.profileBackgroundBlur = value
+            }))
+        return rows
+    }
+
+    private func nameRows() -> [LunagramDecorRow] {
+        let mode = self.mode(for: .name)
+        var rows: [LunagramDecorRow] = []
+        rows.append(.header("Оформление имени"))
+        rows.append(.segments(["Как в теме", "Цвет", "Градиент"], mode, { [weak self] index in
+            guard let self = self else {
+                return
+            }
+            self.fillMode[.name] = index
+            if index == 0 {
+                LunagramSettings.profileNameCustomColor = nil
+                LunagramSettings.profileNameCustomColor2 = nil
+                LunagramSettings.profileNameGradient = 0
+            } else if index == 1 {
+                // Ушли с градиента — второй цвет убираем, иначе он остался бы
+                // в силе и имя всё равно заливалось переходом.
+                LunagramSettings.profileNameCustomColor2 = nil
+            }
+            LunagramNameFill.reset()
+            self.rebuild()
+        }))
+        if mode >= 1 {
+            rows.append(.color(
+                "Цвет имени",
+                LunagramSettings.profileNameCustomColor,
+                { [weak self] in
+                    self?.pickColor(
+                        title: "Цвет имени",
+                        current: LunagramSettings.profileNameCustomColor,
+                        allowsClear: true,
+                        apply: { value in
+                            LunagramSettings.profileNameCustomColor = value
+                            LunagramNameFill.reset()
+                        })
+                }))
+        }
+        if mode == 2 {
+            rows.append(.color(
+                "Второй цвет",
+                LunagramSettings.profileNameCustomColor2,
+                { [weak self] in
+                    self?.pickColor(
+                        title: "Второй цвет",
+                        current: LunagramSettings.profileNameCustomColor2,
+                        allowsClear: true,
+                        apply: { value in
+                            LunagramSettings.profileNameCustomColor2 = value
+                            // Заливка запоминается по цветам: сменился второй —
+                            // прежняя висела бы до перезапуска.
+                            LunagramNameFill.reset()
+                        })
+                }))
+            rows.append(.segments(
+                ["Вбок", "Вниз"],
+                LunagramSettings.profileNameGradient,
+                { value in
+                    LunagramSettings.profileNameGradient = value
+                    LunagramNameFill.reset()
+                }))
+        }
+        rows.append(.header("Свечение"))
+        rows.append(.slider(
+            "Сила свечения", LunagramSettings.profileNameGlowPercent, 0, 100, 5,
+            { value in
+                LunagramSettings.profileNameGlowPercent = value
+            }))
+        return rows
+    }
+
+    private func avatarRows() -> [LunagramDecorRow] {
+        var rows: [LunagramDecorRow] = []
+        rows.append(.header("Оформление аватара"))
+        // Форму показываю плашками прямо здесь, а не отдельным экраном: их
+        // всего шесть, и в плагине выбор тоже стоит в самом окошке.
+        rows.append(.segments(
