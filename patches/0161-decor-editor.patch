+/// Полоса: либо радуга оттенков, либо прозрачность выбранного цвета.
+final class LunagramColorStripView: UIView {
+    enum Kind {
+        case hue
+        case alpha
+    }
+
+    private let kind: Kind
+    private let gradientLayer = CAGradientLayer()
+    private var checkerLayer: CALayer?
+
+    var solidColor: UIColor = .white {
+        didSet {
+            if self.kind == .alpha {
+                self.updateFill()
+            }
+        }
+    }
+
+    init(kind: Kind) {
+        self.kind = kind
+        super.init(frame: CGRect())
+
+        if kind == .alpha {
+            // Под прозрачностью нужна шашечка, иначе на тёмном окне не видно,
+            // где цвет уже прозрачный.
+            let checker = CALayer()
+            checker.backgroundColor = UIColor(
+                patternImage: LunagramColorStripView.checkerImage()).cgColor
+            self.layer.addSublayer(checker)
+            self.checkerLayer = checker
+        }
+
+        self.gradientLayer.startPoint = CGPoint(x: 0.0, y: 0.5)
+        self.gradientLayer.endPoint = CGPoint(x: 1.0, y: 0.5)
+        self.layer.addSublayer(self.gradientLayer)
+        self.updateFill()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("не используется")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.checkerLayer?.frame = self.bounds
+        self.gradientLayer.frame = self.bounds
+    }
+
+    private func updateFill() {
+        switch self.kind {
+        case .hue:
+            var colors: [CGColor] = []
+            var step = 0
+            while step <= 12 {
+                colors.append(UIColor(
+                    hue: CGFloat(step) / 12.0,
+                    saturation: 1.0,
+                    brightness: 1.0,
+                    alpha: 1.0).cgColor)
+                step += 1
+            }
+            self.gradientLayer.colors = colors
+        case .alpha:
+            self.gradientLayer.colors = [
+                self.solidColor.withAlphaComponent(0.0).cgColor,
+                self.solidColor.withAlphaComponent(1.0).cgColor,
+            ]
+        }
+    }
+
+    private static func checkerImage() -> UIImage {
+        let cell: CGFloat = 6.0
+        let size = CGSize(width: cell * 2.0, height: cell * 2.0)
+        return UIGraphicsImageRenderer(size: size).image { context in
+            let cg = context.cgContext
+            cg.setFillColor(UIColor(white: 0.85, alpha: 1.0).cgColor)
+            cg.fill(CGRect(origin: CGPoint(), size: size))
+            cg.setFillColor(UIColor(white: 0.65, alpha: 1.0).cgColor)
+            cg.fill(CGRect(x: 0.0, y: 0.0, width: cell, height: cell))
+            cg.fill(CGRect(x: cell, y: cell, width: cell, height: cell))
+        }
+    }
+}
