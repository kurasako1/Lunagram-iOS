+/// Панель правки оформления профиля.
+public final class LunagramDecorEditorController: ViewController {
+    private let context: AccountContext
+
+    private var controllerNode: LunagramDecorEditorNode {
+        return self.displayNode as! LunagramDecorEditorNode
+    }
+
+    public init(context: AccountContext) {
+        self.context = context
+
+        let theme = context.sharedContext.currentPresentationData.with({ $0 }).theme
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(
+            presentationTheme: theme,
+            presentationStrings: context.sharedContext.currentPresentationData.with({ $0 }).strings))
+
+        // Заголовок как у них — «Custom Profile» по-нашему.
+        self.title = "Оформление"
+        self.navigationPresentation = .modal
+    }
+
+    required public init(coder: NSCoder) {
+        preconditionFailure()
+    }
+
+    override public func loadDisplayNode() {
+        self.displayNode = LunagramDecorEditorNode(controller: self, context: self.context)
+        self.displayNodeDidLoad()
+    }
+
+    override public func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+
+        let navigationHeight = self.navigationLayout(layout: layout).navigationFrame.maxY
+        let contentLayout = ContainerViewLayout(
+            size: CGSize(width: layout.size.width, height: max(0.0, layout.size.height - navigationHeight)),
+            metrics: layout.metrics,
+            deviceMetrics: layout.deviceMetrics,
+            intrinsicInsets: layout.intrinsicInsets,
+            safeInsets: layout.safeInsets,
+            additionalInsets: layout.additionalInsets,
+            statusBarHeight: nil,
+            inputHeight: layout.inputHeight,
+            inputHeightIsInteractivellyChanging: false,
+            inVoiceOver: false)
+        self.controllerNode.frame = CGRect(
+            x: 0.0,
+            y: navigationHeight,
+            width: contentLayout.size.width,
+            height: contentLayout.size.height)
+        self.controllerNode.containerLayoutUpdated(contentLayout, transition: transition)
+    }
+}
+
+/// Показать правку оформления: панель снизу, живой профиль над ней.
+public func lunagramPresentDecorEditor(context: AccountContext, from controller: ViewController) {
+    let editor = LunagramDecorEditorController(context: context)
+    let sheet = LunagramEditorSheet(context: context, content: editor)
+    controller.present(sheet, in: .window(.root))
+}
