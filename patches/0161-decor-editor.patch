+/// Квадрат оттенков: слева налево насыщенность, сверху вниз яркость.
+final class LunagramColorSquareView: UIView {
+    var hue: CGFloat = 0.0 {
+        didSet {
+            if abs(self.hue - oldValue) > 0.0001 {
+                self.updateFill()
+            }
+        }
+    }
+
+    private let saturationLayer = CAGradientLayer()
+    private let brightnessLayer = CAGradientLayer()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.layer.cornerRadius = 12.0
+        self.clipsToBounds = true
+
+        // Два слоя вместо рисования каждой точки: насыщенность слева направо,
+        // поверх — затемнение сверху вниз. Так квадрат не перерисовывается
+        // на каждое движение пальца, меняется только цвет справа.
+        self.saturationLayer.startPoint = CGPoint(x: 0.0, y: 0.5)
+        self.saturationLayer.endPoint = CGPoint(x: 1.0, y: 0.5)
+        self.layer.addSublayer(self.saturationLayer)
+
+        self.brightnessLayer.colors = [
+            UIColor(white: 0.0, alpha: 0.0).cgColor,
+            UIColor(white: 0.0, alpha: 1.0).cgColor,
+        ]
+        self.brightnessLayer.startPoint = CGPoint(x: 0.5, y: 0.0)
+        self.brightnessLayer.endPoint = CGPoint(x: 0.5, y: 1.0)
+        self.layer.addSublayer(self.brightnessLayer)
+
+        self.updateFill()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("не используется")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        self.saturationLayer.frame = self.bounds
+        self.brightnessLayer.frame = self.bounds
+    }
+
+    private func updateFill() {
+        self.saturationLayer.colors = [
+            UIColor.white.cgColor,
+            UIColor(hue: self.hue, saturation: 1.0, brightness: 1.0, alpha: 1.0).cgColor,
+        ]
+    }
+}
