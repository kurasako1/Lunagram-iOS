+import UIKit
+
+/// Своё окошко выбора цвета — как в плагине Custom Profile.
+///
+/// Почему своё, а не родное iOS (`UIColorPickerViewController`): хозяин
+/// сказал «точь в точь как в плагине». У них квадрат оттенков, под ним
+/// полоса радуги, полоса прозрачности и поле с кодом вида `#00000000`.
+/// Родное окошко iOS выглядит иначе и поля кода с прозрачностью не даёт.
+///
+/// Обычное окно UIKit, а не экран Telegram: внутри только свои рисунки и
+/// жесты, зависимостей не нужно. Так же сделано окно подгонки кадра
+/// (`LunagramCropEditor`) — беру тот же приём.
+public final class LunagramColorWheel: UIViewController {
+    /// Показать окошко. `color` — что выбрано сейчас (nil — ничего).
+    /// `onPick` зовётся при нажатии «Готово», `onClear` — при «Убрать цвет».
+    public static func present(
+        from presenter: UIViewController,
+        title: String,
+        color: UInt32?,
+        allowsAlpha: Bool = true,
+        allowsClear: Bool = true,
+        onPick: @escaping (UInt32) -> Void,
+        onClear: (() -> Void)? = nil
+    ) {
+        let wheel = LunagramColorWheel(
+            titleText: title,
+            color: color,
+            allowsAlpha: allowsAlpha,
+            allowsClear: allowsClear && onClear != nil,
+            onPick: onPick,
+            onClear: onClear)
+        wheel.modalPresentationStyle = .overFullScreen
+        wheel.modalTransitionStyle = .crossDissolve
+        presenter.present(wheel, animated: true, completion: nil)
+    }
+
+    // Цвет держу в HSV, а не в RGB: квадрат и радуга правят именно
+    // насыщенность, яркость и оттенок. Переводить туда-обратно на каждом
+    // движении пальца — значит терять оттенок на чёрном (у чёрного оттенка
+    // нет) и дёргать ползунок радуги.
+    private var hue: CGFloat = 0.0
+    private var saturation: CGFloat = 1.0
+    private var brightness: CGFloat = 1.0
+    private var alpha: CGFloat = 1.0
+
+    private let titleText: String
+    private let allowsAlpha: Bool
+    private let allowsClear: Bool
+    private let onPick: (UInt32) -> Void
+    private let onClear: (() -> Void)?
+
+    private let dimView = UIView()
+    private let sheetView = UIView()
+    private let titleLabel = UILabel()
+    private let squareView = LunagramColorSquareView()
+    private let squareKnob = UIView()
+    private let hueView = LunagramColorStripView(kind: .hue)
+    private let hueKnob = UIView()
+    private let alphaView = LunagramColorStripView(kind: .alpha)
+    private let alphaKnob = UIView()
+    private let previewView = UIView()
+    private let codeField = UITextField()
+    private let clearButton = UIButton(type: .system)
+    private let doneButton = UIButton(type: .system)
+
+    private init(
+        titleText: String,
+        color: UInt32?,
+        allowsAlpha: Bool,
+        allowsClear: Bool,
+        onPick: @escaping (UInt32) -> Void,
+        onClear: (() -> Void)?
+    ) {
+        self.titleText = titleText
+        self.allowsAlpha = allowsAlpha
+        self.allowsClear = allowsClear
+        self.onPick = onPick
+        self.onClear = onClear
+        super.init(nibName: nil, bundle: nil)
+
+        if let color = color {
+            let source = UIColor(
+                red: CGFloat((color >> 16) & 0xFF) / 255.0,
+                green: CGFloat((color >> 8) & 0xFF) / 255.0,
+                blue: CGFloat(color & 0xFF) / 255.0,
+                alpha: 1.0)
+            var h: CGFloat = 0.0
+            var s: CGFloat = 0.0
+            var b: CGFloat = 0.0
+            var a: CGFloat = 0.0
+            if source.getHue(&h, saturation: &s, brightness: &b, alpha: &a) {
+                self.hue = h
+                self.saturation = s
+                self.brightness = b
+            }
+            self.alpha = allowsAlpha ? CGFloat((color >> 24) & 0xFF) / 255.0 : 1.0
+            // Старые цвета писались без прозрачности — там верхний байт
+            // ноль, и цвет вышел бы невидимым. Считаю такой непрозрачным.
+            if (color >> 24) == 0 {
+                self.alpha = 1.0
+            }
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("не используется")
+    }
+
+    public override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .clear
+
+        self.dimView.backgroundColor = UIColor(white: 0.0, alpha: 0.45)
+        self.dimView.addGestureRecognizer(
+            UITapGestureRecognizer(target: self, action: #selector(self.dismissSelf)))
+        self.view.addSubview(self.dimView)
+
+        self.sheetView.backgroundColor = UIColor(white: 0.11, alpha: 1.0)
+        self.sheetView.layer.cornerRadius = 20.0
+        self.sheetView.clipsToBounds = true
+        self.view.addSubview(self.sheetView)
+
+        self.titleLabel.text = self.titleText
+        self.titleLabel.font = .systemFont(ofSize: 17.0, weight: .semibold)
+        self.titleLabel.textColor = .white
+        self.titleLabel.textAlignment = .center
+        self.sheetView.addSubview(self.titleLabel)
+
+        self.sheetView.addSubview(self.squareView)
+        self.sheetView.addSubview(self.hueView)
+        if self.allowsAlpha {
+            self.sheetView.addSubview(self.alphaView)
+        }
+
+        for knob in [self.squareKnob, self.hueKnob, self.alphaKnob] {
+            knob.isUserInteractionEnabled = false
+            knob.layer.borderWidth = 3.0
+            knob.layer.borderColor = UIColor.white.cgColor
+            knob.layer.shadowColor = UIColor.black.cgColor
+            knob.layer.shadowOpacity = 0.35
+            knob.layer.shadowRadius = 2.0
+            knob.layer.shadowOffset = CGSize(width: 0.0, height: 1.0)
+        }
+        self.sheetView.addSubview(self.squareKnob)
+        self.sheetView.addSubview(self.hueKnob)
+        if self.allowsAlpha {
+            self.sheetView.addSubview(self.alphaKnob)
+        }
+
+        self.previewView.layer.cornerRadius = 8.0
+        self.previewView.layer.borderWidth = 1.0
+        self.previewView.layer.borderColor = UIColor(white: 1.0, alpha: 0.25).cgColor
+        self.sheetView.addSubview(self.previewView)
+
+        // Поле кода. Правка кода руками — как у них: вставил «#FF3B30» и
+        // ползунки сами встали на место.
+        self.codeField.font = UIFont.monospacedDigitSystemFont(ofSize: 16.0, weight: .regular)
+        self.codeField.textColor = .white
+        self.codeField.backgroundColor = UIColor(white: 1.0, alpha: 0.08)
+        self.codeField.layer.cornerRadius = 8.0
+        self.codeField.autocapitalizationType = .allCharacters
+        self.codeField.autocorrectionType = .no
+        self.codeField.spellCheckingType = .no
+        self.codeField.returnKeyType = .done
+        self.codeField.textAlignment = .center
+        self.codeField.delegate = self
+        self.codeField.addTarget(
+            self, action: #selector(self.codeChanged), for: .editingDidEnd)
+        self.codeField.addTarget(
+            self, action: #selector(self.codeChanged), for: .editingDidEndOnExit)
+        self.sheetView.addSubview(self.codeField)
+
+        self.clearButton.setTitle("Убрать цвет", for: .normal)
+        self.clearButton.setTitleColor(UIColor(red: 1.0, green: 0.27, blue: 0.23, alpha: 1.0), for: .normal)
+        self.clearButton.titleLabel?.font = .systemFont(ofSize: 17.0)
+        self.clearButton.addTarget(self, action: #selector(self.clearPressed), for: .touchUpInside)
+        self.clearButton.isHidden = !self.allowsClear
+        self.sheetView.addSubview(self.clearButton)
+
+        self.doneButton.setTitle("Готово", for: .normal)
+        self.doneButton.setTitleColor(.white, for: .normal)
+        self.doneButton.titleLabel?.font = .systemFont(ofSize: 17.0, weight: .semibold)
+        self.doneButton.backgroundColor = UIColor(red: 0.2, green: 0.52, blue: 0.9, alpha: 1.0)
+        self.doneButton.layer.cornerRadius = 12.0
+        self.doneButton.addTarget(self, action: #selector(self.donePressed), for: .touchUpInside)
+        self.sheetView.addSubview(self.doneButton)
+
+        let squarePan = UIPanGestureRecognizer(target: self, action: #selector(self.squareTouched(_:)))
+        let squareTap = UITapGestureRecognizer(target: self, action: #selector(self.squareTouched(_:)))
+        self.squareView.addGestureRecognizer(squarePan)
+        self.squareView.addGestureRecognizer(squareTap)
+
+        let huePan = UIPanGestureRecognizer(target: self, action: #selector(self.hueTouched(_:)))
+        let hueTap = UITapGestureRecognizer(target: self, action: #selector(self.hueTouched(_:)))
+        self.hueView.addGestureRecognizer(huePan)
+        self.hueView.addGestureRecognizer(hueTap)
+
+        let alphaPan = UIPanGestureRecognizer(target: self, action: #selector(self.alphaTouched(_:)))
+        let alphaTap = UITapGestureRecognizer(target: self, action: #selector(self.alphaTouched(_:)))
+        self.alphaView.addGestureRecognizer(alphaPan)
+        self.alphaView.addGestureRecognizer(alphaTap)
+
+        self.refresh()
+    }
+
+    public override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        let bounds = self.view.bounds
+        self.dimView.frame = bounds
+
+        let inset: CGFloat = 16.0
+        let width = min(bounds.width - inset * 2.0, 400.0)
+        let contentWidth = width - inset * 2.0
+        let squareSide = contentWidth
+        let stripHeight: CGFloat = 28.0
+
+        var y: CGFloat = 16.0
+        self.titleLabel.frame = CGRect(x: inset, y: y, width: contentWidth, height: 24.0)
+        y += 24.0 + 14.0
+
+        self.squareView.frame = CGRect(x: inset, y: y, width: squareSide, height: squareSide)
+        y += squareSide + 16.0
+
+        self.hueView.frame = CGRect(x: inset, y: y, width: contentWidth, height: stripHeight)
+        self.hueView.layer.cornerRadius = stripHeight / 2.0
+        self.hueView.clipsToBounds = true
+        y += stripHeight + 14.0
+
+        if self.allowsAlpha {
+            self.alphaView.frame = CGRect(x: inset, y: y, width: contentWidth, height: stripHeight)
+            self.alphaView.layer.cornerRadius = stripHeight / 2.0
+            self.alphaView.clipsToBounds = true
+            y += stripHeight + 14.0
+        }
+
+        let previewSide: CGFloat = 40.0
+        self.previewView.frame = CGRect(x: inset, y: y, width: previewSide, height: previewSide)
+        self.codeField.frame = CGRect(
+            x: inset + previewSide + 10.0,
+            y: y,
+            width: contentWidth - previewSide - 10.0,
+            height: previewSide)
+        y += previewSide + 16.0
+
+        if self.allowsClear {
+            self.clearButton.frame = CGRect(x: inset, y: y, width: contentWidth, height: 40.0)
+            y += 40.0 + 4.0
+        }
+
+        self.doneButton.frame = CGRect(x: inset, y: y, width: contentWidth, height: 48.0)
+        y += 48.0 + 16.0
+
+        let height = y
+        self.sheetView.frame = CGRect(
+            x: floor((bounds.width - width) / 2.0),
+            y: floor((bounds.height - height) / 2.0),
+            width: width,
+            height: height)
+
+        self.layoutKnobs()
+    }
+
+    // MARK: Жесты
+
+    @objc private func squareTouched(_ gesture: UIGestureRecognizer) {
+        let point = gesture.location(in: self.squareView)
+        let size = self.squareView.bounds.size
+        guard size.width > 0.0, size.height > 0.0 else {
+            return
+        }
+        self.saturation = max(0.0, min(1.0, point.x / size.width))
+        self.brightness = max(0.0, min(1.0, 1.0 - point.y / size.height))
+        self.refresh()
+    }
+
+    @objc private func hueTouched(_ gesture: UIGestureRecognizer) {
+        let point = gesture.location(in: self.hueView)
+        let width = self.hueView.bounds.width
+        guard width > 0.0 else {
+            return
+        }
+        self.hue = max(0.0, min(0.9999, point.x / width))
+        self.refresh()
+    }
+
+    @objc private func alphaTouched(_ gesture: UIGestureRecognizer) {
+        let point = gesture.location(in: self.alphaView)
+        let width = self.alphaView.bounds.width
+        guard width > 0.0 else {
+            return
+        }
+        self.alpha = max(0.0, min(1.0, point.x / width))
+        self.refresh()
+    }
+
+    // MARK: Кнопки
+
+    @objc private func dismissSelf() {
+        self.dismiss(animated: true, completion: nil)
+    }
+
+    @objc private func clearPressed() {
+        let onClear = self.onClear
+        self.dismiss(animated: true, completion: {
+            onClear?()
+        })
+    }
+
+    @objc private func donePressed() {
+        let packed = self.packed
+        let onPick = self.onPick
+        self.dismiss(animated: true, completion: {
+            onPick(packed)
+        })
+    }
+
+    @objc private func codeChanged() {
+        guard let text = self.codeField.text else {
+            return
+        }
+        guard let parsed = LunagramColorWheel.parse(text) else {
+            // Набрано не то — возвращаю прежний код, молча. Ругаться окошком
+            // на каждую опечатку хуже, чем просто не послушаться.
+            self.refresh()
+            return
+        }
+        let source = UIColor(
+            red: CGFloat((parsed >> 16) & 0xFF) / 255.0,
+            green: CGFloat((parsed >> 8) & 0xFF) / 255.0,
+            blue: CGFloat(parsed & 0xFF) / 255.0,
+            alpha: 1.0)
+        var h: CGFloat = 0.0
+        var s: CGFloat = 0.0
+        var b: CGFloat = 0.0
+        var a: CGFloat = 0.0
+        if source.getHue(&h, saturation: &s, brightness: &b, alpha: &a) {
+            self.hue = h
+            self.saturation = s
+            self.brightness = b
+        }
+        if self.allowsAlpha {
+            self.alpha = CGFloat((parsed >> 24) & 0xFF) / 255.0
+        }
+        self.refresh()
+    }
+
+    // MARK: Пересчёт
+
+    /// Цвет одним числом: прозрачность в верхнем байте, дальше красный,
+    /// зелёный, синий.
+    private var packed: UInt32 {
+        let color = UIColor(
+            hue: self.hue,
+            saturation: self.saturation,
+            brightness: self.brightness,
+            alpha: 1.0)
+        var r: CGFloat = 0.0
+        var g: CGFloat = 0.0
+        var b: CGFloat = 0.0
+        var a: CGFloat = 0.0
+        color.getRed(&r, green: &g, blue: &b, alpha: &a)
+        let alphaByte = UInt32(round(max(0.0, min(1.0, self.alpha)) * 255.0))
+        return (alphaByte << 24)
+            | (UInt32(round(r * 255.0)) << 16)
+            | (UInt32(round(g * 255.0)) << 8)
+            | UInt32(round(b * 255.0))
+    }
+
+    private func refresh() {
+        let solid = UIColor(
+            hue: self.hue,
+            saturation: self.saturation,
+            brightness: self.brightness,
+            alpha: 1.0)
+        self.squareView.hue = self.hue
+        self.alphaView.solidColor = solid
+        self.previewView.backgroundColor = solid.withAlphaComponent(self.alpha)
+        let packed = self.packed
+        if !self.codeField.isFirstResponder {
+            self.codeField.text = String(format: "#%08X", packed)
+        }
+        self.layoutKnobs()
+    }
+
+    private func layoutKnobs() {
+        let squareFrame = self.squareView.frame
+        guard squareFrame.width > 0.0 else {
+            return
+        }
+        let knobSide: CGFloat = 22.0
+        self.squareKnob.layer.cornerRadius = knobSide / 2.0
+        self.squareKnob.backgroundColor = UIColor(
+            hue: self.hue, saturation: self.saturation, brightness: self.brightness, alpha: 1.0)
+        self.squareKnob.frame = CGRect(
+            x: squareFrame.minX + self.saturation * squareFrame.width - knobSide / 2.0,
+            y: squareFrame.minY + (1.0 - self.brightness) * squareFrame.height - knobSide / 2.0,
+            width: knobSide,
+            height: knobSide)
+
+        let hueFrame = self.hueView.frame
+        let stripKnob = hueFrame.height + 4.0
+        self.hueKnob.layer.cornerRadius = stripKnob / 2.0
+        self.hueKnob.backgroundColor = UIColor(
+            hue: self.hue, saturation: 1.0, brightness: 1.0, alpha: 1.0)
+        self.hueKnob.frame = CGRect(
+            x: hueFrame.minX + self.hue * hueFrame.width - stripKnob / 2.0,
+            y: hueFrame.midY - stripKnob / 2.0,
+            width: stripKnob,
+            height: stripKnob)
+
+        guard self.allowsAlpha else {
+            return
+        }
+        let alphaFrame = self.alphaView.frame
+        self.alphaKnob.layer.cornerRadius = stripKnob / 2.0
+        self.alphaKnob.backgroundColor = UIColor(
+            hue: self.hue, saturation: self.saturation, brightness: self.brightness, alpha: 1.0)
+        self.alphaKnob.frame = CGRect(
+            x: alphaFrame.minX + self.alpha * alphaFrame.width - stripKnob / 2.0,
+            y: alphaFrame.midY - stripKnob / 2.0,
+            width: stripKnob,
+            height: stripKnob)
+    }
+
+    /// Разобрать код цвета. Понимаю и «#RRGGBB», и «#AARRGGBB», и без решётки.
+    private static func parse(_ text: String) -> UInt32? {
+        var cleaned = text.trimmingCharacters(in: .whitespacesAndNewlines).uppercased()
+        if cleaned.hasPrefix("#") {
+            cleaned.removeFirst()
+        }
+        guard cleaned.count == 6 || cleaned.count == 8 else {
+            return nil
+        }
+        guard let value = UInt32(cleaned, radix: 16) else {
+            return nil
+        }
+        if cleaned.count == 6 {
+            return 0xFF00_0000 | value
+        }
+        return value
+    }
+}
+
+extension LunagramColorWheel: UITextFieldDelegate {
+    public func textFieldShouldReturn(_ textField: UITextField) -> Bool {
+        textField.resignFirstResponder()
+        return true
+    }
+}
