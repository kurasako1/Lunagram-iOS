+    // MARK: Выбор картинки
+
+    // Выбираю файл прямо отсюда, а не отправляю на старый экран: весь смысл
+    // панели в том, чтобы не уходить с профиля. Перенос файла к себе уже
+    // написан и проверен (`importProfileBanner` и соседи) — зову его.
+
+    private func openBannerPicker() {
+        self.pickMedia(kind: .banner)
+    }
+
+    private func openBackgroundPicker() {
+        self.pickMedia(kind: .background)
+    }
+
+    private func openFramePicker() {
+        self.pickMedia(kind: .frame)
+    }
+
+    private func openMusicPicker() {
+        self.pickMedia(kind: .music)
+    }
+
+    private enum MediaKind {
+        case banner
+        case background
+        case frame
+        case music
+    }
+
+    private func pickMedia(kind: MediaKind) {
+        guard #available(iOS 14.0, *) else {
+            return
+        }
+        guard let presenter = self.controller?.view.window?.rootViewController else {
+            return
+        }
+        var configuration = PHPickerConfiguration()
+        // Баннером бывает и видео, остальное — только картинка.
+        configuration.filter = (kind == .banner)
+            ? PHPickerFilter.any(of: [.images, .videos])
+            : PHPickerFilter.images
+        configuration.selectionLimit = 1
+        let picker = PHPickerViewController(configuration: configuration)
+        let delegate = LunagramDecorPickerDelegate(importer: { url, isVideo in
+            switch kind {
+            case .banner:
+                try LunagramSettings.importProfileBanner(from: url, isVideo: isVideo)
+                // Выбрал баннер — значит хочет его видеть. Включаю сам:
+                // иначе выбрал файл, а в профиле ничего не изменилось.
+                LunagramSettings.profileBannerEnabled = true
+            case .background:
+                try LunagramSettings.importProfileBackground(from: url)
+            case .frame:
+                try LunagramSettings.importAvatarFrameImage(from: url)
+                LunagramSettings.avatarFrameEnabled = true
+            case .music:
+                try LunagramSettings.importProfileMusicBackground(from: url)
+            }
+        }, completion: { [weak self] in
+            self?.pickerDelegate = nil
+            self?.rebuild()
+        })
+        // Окошко выбора делегата за собой не держит — держу я, иначе его
+        // уберут из памяти до того, как человек что-нибудь выберет.
+        self.pickerDelegate = delegate
+        picker.delegate = delegate
+        presenter.present(picker, animated: true, completion: nil)
+    }
+}
+
+/// Приёмщик выбранного файла. Своя копия, а не общая с настройками: та
+/// лежит внутри другого файла закрытой и завязана на его состояние.
+@available(iOS 14.0, *)
+private final class LunagramDecorPickerDelegate: NSObject, PHPickerViewControllerDelegate {
+    private let importer: (URL, Bool) throws -> Void
+    private let completion: () -> Void
+
+    init(importer: @escaping (URL, Bool) throws -> Void, completion: @escaping () -> Void) {
+        self.importer = importer
+        self.completion = completion
+        super.init()
+    }
+
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        picker.dismiss(animated: true, completion: nil)
+        guard let item = results.first?.itemProvider else {
+            self.completion()
+            return
+        }
+        let videoType = UTType.movie.identifier
+        let imageType = UTType.image.identifier
+        let isVideo = item.hasItemConformingToTypeIdentifier(videoType)
+        let typeIdentifier = isVideo ? videoType : imageType
+        guard item.hasItemConformingToTypeIdentifier(typeIdentifier) else {
+            self.completion()
+            return
+        }
+        let importer = self.importer
+        let completion = self.completion
+        item.loadFileRepresentation(forTypeIdentifier: typeIdentifier, completionHandler: { url, _ in
+            // Файл выдают во временном месте и забирают сразу после возврата,
+            // поэтому переношу его к себе здесь же, а не потом в главной нити.
+            var imported = false
+            if let url = url {
+                imported = ((try? importer(url, isVideo)) != nil)
+            }
+            DispatchQueue.main.async {
+                _ = imported
+                completion()
+            }
+        })
+    }
+}
