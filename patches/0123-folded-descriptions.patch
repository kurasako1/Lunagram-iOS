+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+
+// Lunagram: свёрнутое описание под строкой.
+//
+// Раньше описание лежало под строкой целиком, и экран вытягивался в несколько
+// ростов телефона: у каждой настройки по абзацу, а читают их один раз. Хозяин
+// попросил сворачивать: видна первая строка, к концу буквы тают, справа
+// стрелка. Нажал — раскрылось целиком, стрелка повернулась.
+//
+// Почему своя строка, а не стрелка у самой настройки: описание есть не только у
+// галочек, но и у ползунков, у строк выбора, у цветных кружков и у целых
+// разделов. Отдельная строка одинаково ложится под любую из них, и не надо
+// учить каждый вид строк показывать стрелку по-своему.
+
+final class LunagramAboutItem: ListViewItem, ItemListItem {
+    let presentationData: ItemListPresentationData
+    let text: String
+    let isExpanded: Bool
+    let sectionId: ItemListSectionId
+    let toggle: () -> Void
+    /// Описание живёт вне карточки, как и родная подпись под блоком.
+    let isAlwaysPlain: Bool = true
+    let tag: ItemListItemTag? = nil
+
+    init(presentationData: ItemListPresentationData, text: String, isExpanded: Bool, sectionId: ItemListSectionId, toggle: @escaping () -> Void) {
+        self.presentationData = presentationData
+        self.text = text
+        self.isExpanded = isExpanded
+        self.sectionId = sectionId
+        self.toggle = toggle
+    }
+
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, previousItem: ListViewItem?, nextItem: ListViewItem?, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        async {
+            let node = LunagramAboutItemNode()
+            let (layout, apply) = node.asyncLayout()(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            Queue.mainQueue().async {
+                completion(node, {
+                    return (nil, { _ in apply() })
+                })
+            }
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            guard let nodeValue = node() as? LunagramAboutItemNode else {
+                assertionFailure()
+                return
+            }
+            let makeLayout = nodeValue.asyncLayout()
+            async {
+                let (layout, apply) = makeLayout(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+                Queue.mainQueue().async {
+                    completion(layout, { _ in
+                        apply()
+                    })
+                }
+            }
+        }
+    }
+}
+
+final class LunagramAboutItemNode: ListViewItemNode {
+    private let textNode: TextNode
+    private let arrowNode: ASImageNode
+    /// Растворение хвоста: маска поверх текста, а не другой цвет. Цвет пришлось
+    /// бы подбирать под фон, а под списком у нас бывает картинка.
+    private let fadeLayer: CAGradientLayer
+
+    private var item: LunagramAboutItem?
+    /// Своя копия картинки стрелки: раскладка идёт не на главном потоке, и
+    /// спрашивать её у узла оттуда нельзя.
+    private var arrowImage: UIImage?
+
+    init() {
+        self.textNode = TextNode()
+        self.textNode.isUserInteractionEnabled = false
+        self.textNode.contentMode = .topLeft
+        self.textNode.contentsScale = UIScreen.main.scale
+
+        self.arrowNode = ASImageNode()
+        self.arrowNode.isLayerBacked = true
+        self.arrowNode.displaysAsynchronously = false
+        self.arrowNode.displayWithoutProcessing = true
+
+        self.fadeLayer = CAGradientLayer()
+        self.fadeLayer.startPoint = CGPoint(x: 0.0, y: 0.5)
+        self.fadeLayer.endPoint = CGPoint(x: 1.0, y: 0.5)
+        self.fadeLayer.locations = [0.0, 0.82, 1.0] as [NSNumber]
+        self.fadeLayer.colors = [
+            UIColor.white.cgColor,
+            UIColor.white.cgColor,
+            UIColor.white.withAlphaComponent(0.25).cgColor
+        ]
+
+        super.init(layerBacked: false, dynamicBounce: false)
+
+        self.addSubnode(self.textNode)
+        self.addSubnode(self.arrowNode)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+
+        let recognizer = UITapGestureRecognizer(target: self, action: #selector(self.tapped))
+        self.view.addGestureRecognizer(recognizer)
+    }
+
+    @objc private func tapped() {
+        self.item?.toggle()
+    }
+
+    func asyncLayout() -> (_ item: LunagramAboutItem, _ params: ListViewItemLayoutParams, _ neighbors: ItemListNeighbors) -> (ListViewItemNodeLayout, () -> Void) {
+        let makeTextLayout = TextNode.asyncLayout(self.textNode)
+        let currentItem = self.item
+        let currentArrow = self.arrowImage
+
+        return { [weak self] item, params, neighbors in
+            let leftInset: CGFloat = 15.0 + params.leftInset
+            let rightInset: CGFloat = 15.0 + params.rightInset
+            let arrowWidth: CGFloat = 16.0
+            let topInset: CGFloat = 7.0
+            let bottomInset: CGFloat = 7.0
+
+            let font = Font.regular(item.presentationData.fontSize.itemListBaseHeaderFontSize)
+            let color = item.presentationData.theme.list.freeTextColor
+
+            // Стрелка нужна только чтобы показать, что описание раскрывается;
+            // цвет у неё тот же, что у текста, — она не кнопка со своим смыслом.
+            var arrowImage = currentArrow
+            if currentItem?.presentationData.theme !== item.presentationData.theme || arrowImage == nil {
+                arrowImage = generateTintedImage(image: UIImage(bundleImageName: "Contact List/SubtitleArrow"), color: color)
+            }
+
+            let textWidth = max(1.0, params.width - leftInset - rightInset - arrowWidth - 4.0)
+            let (textLayout, textApply) = makeTextLayout(TextNodeLayoutArguments(
+                attributedString: NSAttributedString(string: item.text, font: font, textColor: color),
+                backgroundColor: nil,
+                maximumNumberOfLines: item.isExpanded ? 0 : 1,
+                truncationType: .end,
+                constrainedSize: CGSize(width: textWidth, height: .greatestFiniteMagnitude),
+                alignment: .natural,
+                cutout: nil,
+                insets: UIEdgeInsets()
+            ))
+
+            let contentSize = CGSize(width: params.width, height: textLayout.size.height + topInset + bottomInset)
+            let layout = ListViewItemNodeLayout(contentSize: contentSize, insets: itemListNeighborsGroupedInsets(neighbors, params))
+
+            return (layout, {
+                guard let strongSelf = self else {
+                    return
+                }
+                strongSelf.item = item
+                strongSelf.arrowImage = arrowImage
+                strongSelf.arrowNode.image = arrowImage
+
+                let _ = textApply()
+                let textFrame = CGRect(origin: CGPoint(x: leftInset, y: topInset), size: textLayout.size)
+                strongSelf.textNode.frame = textFrame
+
+                // Растворение — только у свёрнутого: у раскрытого прятать нечего.
+                if item.isExpanded {
+                    strongSelf.textNode.layer.mask = nil
+                    strongSelf.fadeLayer.removeFromSuperlayer()
+                } else {
+                    strongSelf.fadeLayer.frame = CGRect(origin: CGPoint(), size: textFrame.size)
+                    strongSelf.textNode.layer.mask = strongSelf.fadeLayer
+                }
+
+                if let arrowImage = arrowImage {
+                    // Свёрнуто — стрелка вправо, раскрыто — вниз. Поворачиваем
+                    // ту же картинку: своей для каждого положения не нужно.
+                    let arrowFrame = CGRect(
+                        origin: CGPoint(x: params.width - rightInset - arrowImage.size.width, y: topInset + floor((font.lineHeight - arrowImage.size.height) / 2.0) + 1.0),
+                        size: arrowImage.size
+                    )
+                    strongSelf.arrowNode.frame = arrowFrame
+                    strongSelf.arrowNode.transform = CATransform3DMakeRotation(item.isExpanded ? CGFloat.pi / 2.0 : 0.0, 0.0, 0.0, 1.0)
+                }
+            })
+        }
+    }
+
+    override func animateInsertion(_ currentTimestamp: Double, duration: Double, options: ListViewItemAnimationOptions) {
+        self.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.3)
+    }
+
+    override func animateRemoved(_ currentTimestamp: Double, duration: Double) {
+        self.layer.animateAlpha(from: 1.0, to: 0.0, duration: 0.15, removeOnCompletion: false)
+    }
+}
