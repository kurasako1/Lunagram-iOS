+/// Какие описания сейчас раскрыты.
+///
+/// Ключ — сам текст описания. Не номер строки: строки меняются местами и
+/// появляются по условию, и номер со временем указал бы не на то описание. И не
+/// в настройках: раскрыто описание или нет — это состояние взгляда, ему незачем
+/// переживать перезапуск.
+private enum LunagramExpandedInfos {
+    static var current: Set<String> = []
+
+    static func toggle(_ text: String) {
+        if current.contains(text) {
+            current.remove(text)
+        } else {
+            current.insert(text)
+        }
+    }
 }
 
