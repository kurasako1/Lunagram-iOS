new file mode 100644
index 00000000..8547d346
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramVideoWallpaper.swift
@@ -0,0 +1,170 @@
+import AVFoundation
+import QuartzCore
+import UIKit
+
+/// Живые обои: один проигрыватель на всё приложение.
+///
+/// Урок с ПК: там каждая часть окна открывала ролик сама, и видео
+/// раскодировалось по нескольку раз за кадр — всё тормозило. Здесь
+/// проигрыватель один, а каждый фон переписки лишь показывает его картинку
+/// своим слоем. Раскодирование одно, сколько бы фонов ни было.
+public final class LunagramVideoWallpaper {
+    public static let shared = LunagramVideoWallpaper()
+
+    let player: AVQueuePlayer
+    private var looper: AVPlayerLooper?
+    private var currentURL: URL?
+    // Сколько фонов сейчас показывают видео. Ни одного — нечего и
+    // раскодировать: ставим на паузу, батарея важнее.
+    private var attached = 0
+    private var foregroundObserver: NSObjectProtocol?
+
+    private init() {
+        let player = AVQueuePlayer()
+        player.isMuted = true
+        // Обои не должны мешать телефону засыпать.
+        player.preventsDisplaySleepDuringVideoPlayback = false
+        self.player = player
+
+        // Свёрнутое приложение система ставит на паузу, а обратно не
+        // запускает. Имя уведомления берём строкой, а не через UIApplication:
+        // наш модуль попадает и в расширения, где UIApplication запрещён.
+        self.foregroundObserver = NotificationCenter.default.addObserver(forName: Notification.Name("UIApplicationWillEnterForegroundNotification"), object: nil, queue: .main, using: { [weak self] _ in
+            self?.sync()
+        })
+    }
+
+    deinit {
+        if let foregroundObserver = self.foregroundObserver {
+            NotificationCenter.default.removeObserver(foregroundObserver)
+        }
+    }
+
+    func attach() {
+        self.attached += 1
+        self.sync()
+    }
+
+    func detach() {
+        self.attached = max(0, self.attached - 1)
+        if self.attached == 0 {
+            self.player.pause()
+        }
+    }
+
+    /// Подгоняет проигрыватель под настройки: открывает ролик, если его
+    /// сменили; останавливает, если обои выключили.
+    public func sync() {
+        guard LunagramSettings.liveWallpaperEnabled, let url = LunagramSettings.liveWallpaperURL else {
+            self.stop()
+            return
+        }
+        if url != self.currentURL {
+            self.open(url)
+        }
+        if self.attached > 0 {
+            self.player.play()
+        }
+    }
+
+    private func open(_ url: URL) {
+        self.looper?.disableLooping()
+        self.looper = nil
+        self.player.removeAllItems()
+        let item = AVPlayerItem(asset: LunagramVideoWallpaper.silentAsset(url))
+        self.looper = AVPlayerLooper(player: self.player, templateItem: item)
+        self.currentURL = url
+    }
+
+    private func stop() {
+        self.player.pause()
+        self.looper?.disableLooping()
+        self.looper = nil
+        self.player.removeAllItems()
+        self.currentURL = nil
+    }
+
+    /// Ролик без звуковой дорожки.
+    ///
+    /// Приглушить мало: даже беззвучный проигрыватель с дорожкой может
+    /// оборвать музыку в другом приложении. Нет дорожки — нечем обрывать.
+    private static func silentAsset(_ url: URL) -> AVAsset {
+        let asset = AVURLAsset(url: url)
+        let composition = AVMutableComposition()
+        guard let source = asset.tracks(withMediaType: .video).first, let target = composition.addMutableTrack(withMediaType: .video, preferredTrackID: kCMPersistentTrackID_Invalid) else {
+            return asset
+        }
+        do {
+            try target.insertTimeRange(CMTimeRange(start: .zero, duration: asset.duration), of: source, at: .zero)
+        } catch {
+            return asset
+        }
+        // Поворот: ролики с телефона часто сняты боком и лишь помечены как
+        // повёрнутые. Без этой пометки видео легло бы на бок.
+        target.preferredTransform = source.preferredTransform
+        return composition
+    }
+}
+
+/// Слой, который показывает общий проигрыватель, и затемнение поверх.
+public final class LunagramVideoWallpaperLayer: CALayer {
+    private var playerLayer: AVPlayerLayer?
+    private var dimLayer: CALayer?
+
+    public override init() {
+        super.init()
+        let playerLayer = AVPlayerLayer(player: LunagramVideoWallpaper.shared.player)
+        // Заполняем целиком, обрезая лишнее по краям: ролик и экран разной
+        // вытянутости, иначе остались бы пустые поля.
+        playerLayer.videoGravity = .resizeAspectFill
+        self.addSublayer(playerLayer)
+        self.playerLayer = playerLayer
+
+        let dimLayer = CALayer()
+        dimLayer.backgroundColor = UIColor.black.cgColor
+        self.addSublayer(dimLayer)
+        self.dimLayer = dimLayer
+
+        self.applyDim()
+        LunagramVideoWallpaper.shared.attach()
+    }
+
+    // Нужен самой системе для копий слоя при анимациях. Проигрыватель такой
+    // копии не нужен, поэтому и к общему мы её не подключаем.
+    public override init(layer: Any) {
+        super.init(layer: layer)
+    }
+
+    required public init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if self.playerLayer != nil {
+            LunagramVideoWallpaper.shared.detach()
+        }
+    }
+
+    public func updateSize(_ size: CGSize) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        let bounds = CGRect(origin: CGPoint(), size: size)
+        self.frame = bounds
+        self.playerLayer?.frame = bounds
+        self.dimLayer?.frame = bounds
+        CATransaction.commit()
+    }
+
+    public func applyDim() {
+        let opacity: Float
+        switch LunagramSettings.liveWallpaperDim {
+        case 0:
+            opacity = 0.0
+        case 2:
+            opacity = 0.5
+        default:
+            opacity = 0.25
+        }
+        self.dimLayer?.opacity = opacity
+    }
+}
