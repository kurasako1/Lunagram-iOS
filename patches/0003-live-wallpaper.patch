+    /// Затемнение поверх видео: 0 — нет, 1 — слегка, 2 — сильно.
+    /// Видео часто пёстрое и светлое, и без затемнения буквы на нём теряются.
+    public static var liveWallpaperDim: Int {
+        get {
+            // Незаданный ключ отдаёт нулём, а по умолчанию нам нужно «слегка».
+            guard defaults.object(forKey: Key.liveWallpaperDim) != nil else {
