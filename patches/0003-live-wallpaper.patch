+    /// Где лежит выбранный ролик. Пусто, если не выбран или файл пропал.
+    public static var liveWallpaperURL: URL? {
+        guard let name = defaults.string(forKey: Key.liveWallpaperFile), let folder = try? lunagramFolder() else {
+            return nil
+        }
+        let url = folder.appendingPathComponent(name)
+        return FileManager.default.fileExists(atPath: url.path) ? url : nil
+    }
+
+    /// Забирает ролик к себе: галерея отдаёт временный файл, который система
+    /// удалит сразу, как только мы его отпустим.
+    ///
+    /// Имя каждый раз новое. Проигрыватель может держать старый файл
+    /// открытым, и подменить файл прямо под ним — значит получить битую
+    /// картинку. Старый просто удаляем: открытый файл при этом дочитается.
+    public static func importLiveWallpaper(from source: URL) throws {
+        let folder = try lunagramFolder()
+        let suffix = source.pathExtension.isEmpty ? "mov" : source.pathExtension.lowercased()
+        let name = "wallpaper-\(UUID().uuidString).\(suffix)"
+        try FileManager.default.copyItem(at: source, to: folder.appendingPathComponent(name))
+
+        let previous = defaults.string(forKey: Key.liveWallpaperFile)
+        defaults.set(name, forKey: Key.liveWallpaperFile)
+        if let previous = previous, previous != name {
+            try? FileManager.default.removeItem(at: folder.appendingPathComponent(previous))
+        }
+        changed()
+    }
+
+    /// Своя папка внутри приложения. В «Application Support», а не в
+    /// «Документах»: это данные приложения, человеку в файлах их видеть незачем.
+    private static func lunagramFolder() throws -> URL {
+        let base = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true)
+        let folder = base.appendingPathComponent("Lunagram", isDirectory: true)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: nil)
+        return folder
+    }
+
     private static func changed() {
