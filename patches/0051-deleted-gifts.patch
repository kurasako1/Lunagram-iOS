index 00000000..f5521bb2
--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GiftSetupScreen/Sources/LunagramDeletedGiftsCatalog.swift
@@ -0,0 +1,166 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import Lunagram
+
+// Lunagram: снятые с продажи подарки в окне «Подарить».
+//
+// Каталог Telegram не трогаем — ни в базе, ни на диске. Подарки дописываются
+// только при показе окна, поверх того, что пришло с сервера. Выключили
+// настройку — окно снова штатное, стирать нечего.
+//
+// Живёт в модуле окна отправки, а не в самом окне подарков: отправке нужно
+// знать, что подарок наш (чтобы сверить цену), а окно подарков этот модуль и
+// так видит.
+
+/// Каталог подарков с дописанными наверх снятыми.
+public func lunagramCatalogWithDeletedGifts(context: AccountContext, catalog: Signal<[StarGift]?, NoError>) -> Signal<[StarGift]?, NoError> {
+    guard LunagramSettings.showDeletedGifts else {
+        return catalog
+    }
+    return combineLatest(catalog, lunagramDeletedGiftEntries(context: context), lunagramDeletedGiftFiles(context: context))
+    |> map { catalog, entries, files -> [StarGift]? in
+        guard let catalog else {
+            return nil
+        }
+        if entries.isEmpty {
+            return catalog
+        }
+
+        var existing = Set<Int64>()
+        // Образец — первый обычный подарок каталога. С него берём картинку,
+        // пока не пришёл стикерпак, и соотношение «цена → во сколько звёзд
+        // его можно обменять» для образца в чате.
+        var donor: StarGift.Gift?
+        for gift in catalog {
+            if case let .generic(gift) = gift {
+                existing.insert(gift.id)
+                if donor == nil {
+                    donor = gift
+                }
+            }
+        }
+
+        var added: [StarGift] = []
+        for entry in entries where !existing.contains(entry.id) {
+            // Картинка из стикерпака по номеру из списка. Нулевая картинка
+            // пака — заглушка, поэтому номер берём как есть, не вычитая единицу.
+            let file: TelegramMediaFile?
+            if !files.isEmpty {
+                file = files[min(entry.sticker, files.count - 1)]
+            } else {
+                // Пак ещё не пришёл — пока картинка образца. Подарок при этом
+                // уже рабочий, просто выглядит чужим; через миг подменится.
+                file = donor?.file
+            }
+            guard let file else {
+                continue
+            }
+            // «Обменять на звёзды» — это решает сервер, когда подарок придёт.
+            // Для образца в чате берём ту же долю, что у настоящего подарка
+            // каталога, а не выдумываем число.
+            var convertStars: Int64 = 0
+            if let donor, donor.price > 0 {
+                convertStars = donor.convertStars * entry.stars / donor.price
+            }
+            added.append(.generic(StarGift.Gift(
+                id: entry.id,
+                title: nil,
+                file: file,
+                price: entry.stars,
+                convertStars: convertStars,
+                // Без ограничений и без перепродажи: иначе окно нарисует
+                // «осталось столько-то», и цифры будут враньём.
+                availability: nil,
+                soldOut: nil,
+                flags: [],
+                upgradeStars: nil,
+                releasedBy: nil,
+                perUserLimit: nil,
+                lockedUntilDate: nil,
+                auctionSlug: nil,
+                auctionGiftsPerRound: nil,
+                auctionStartDate: nil,
+                upgradeVariantsCount: nil,
+                background: nil
+            )))
+        }
+        if added.isEmpty {
+            return catalog
+        }
+        LunagramDeletedGifts.markInjected(added.compactMap { gift -> Int64? in
+            if case let .generic(gift) = gift {
+                return gift.id
+            }
+            return nil
+        })
+        // Наверх, как на ПК: их видно сразу при открытии.
+        return added + catalog
+    }
+}
+
+/// Список: сразу то, что уже есть (сохранённый или зашитый), потом свежий.
+private func lunagramDeletedGiftEntries(context: AccountContext) -> Signal<[LunagramDeletedGifts.Entry], NoError> {
+    return Signal { subscriber in
+        subscriber.putNext(LunagramDeletedGifts.entries)
+        let observer = NotificationCenter.default.addObserver(forName: LunagramDeletedGifts.didUpdateNotification, object: nil, queue: nil, using: { _ in
+            subscriber.putNext(LunagramDeletedGifts.entries)
+        })
+        LunagramDeletedGifts.refreshFromWeb(completion: { ok in
+            if !ok {
+                lunagramRefreshDeletedGiftsFromChannel(context: context)
+            }
+        })
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+/// Запасной путь: тот же список лежит в канале Telegram. Нужен потому, что
+/// у части людей GitHub не открывается, а Telegram работает по определению.
+/// Ищем в канале запись со словом из списка — имя стикерпака там есть всегда.
+private func lunagramRefreshDeletedGiftsFromChannel(context: AccountContext) {
+    let _ = (context.engine.peers.resolvePeerByName(name: LunagramDeletedGifts.channelUsername, referrer: nil)
+    |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+        guard case let .result(peer) = result else {
+            return .complete()
+        }
+        return .single(peer)
+    }
+    |> take(1)
+    |> mapToSignal { peer -> Signal<[String], NoError> in
+        guard let peer else {
+            return .single([])
+        }
+        return context.engine.messages.searchMessages(location: .peer(peerId: peer.id, fromId: nil, tags: nil, reactions: nil, threadId: nil, minDate: nil, maxDate: nil), query: LunagramDeletedGifts.stickerPackName, state: nil, limit: 10)
+        |> take(1)
+        |> map { result, _ -> [String] in
+            return result.messages.map { $0.text }
+        }
+    }
+    |> deliverOnMainQueue).startStandalone(next: { texts in
+        // Свежие записи идут первыми — первая разобранная и есть нужная.
+        for text in texts {
+            if LunagramDeletedGifts.apply(text: text) {
+                break
+            }
+        }
+    })
+}
+
+/// Картинки подарков — стикеры того же пака, что у ПК. Сначала пусто, чтобы
+/// окно не ждало пак, потом сами стикеры.
+private func lunagramDeletedGiftFiles(context: AccountContext) -> Signal<[TelegramMediaFile], NoError> {
+    return .single([])
+    |> then(
+        context.engine.stickers.loadedStickerPack(reference: .name(LunagramDeletedGifts.stickerPackName), forceActualized: false)
+        |> map { pack -> [TelegramMediaFile] in
+            if case let .result(_, items, _) = pack {
+                return items.map { $0.file._parse() }
+            }
+            return []
+        }
+    )
+}
