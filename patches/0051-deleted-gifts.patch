+import Foundation
+
+/// Снятые с продажи подарки: номера и цены.
+///
+/// Сервер таких подарков в каталоге не присылает вовсе, но принимает их по
+/// номеру — на ПК это проверено 29 августа 2026. Поэтому номера берутся со
+/// стороны, из того же списка, что читает ПК-версия (и плагин Deleted Gift
+/// Sender для exteraGram). Список чужой: если он пропадёт или сломается, в
+/// окне подарков просто останутся штатные.
+///
+/// Здесь только сам список — без Telegram. Картинки из стикерпака и запасной
+/// путь через канал живут в модуле окна подарков: им нужна сеть Telegram, а
+/// этому модулю её не положено, иначе правка здесь пересобирала бы всё.
+public enum LunagramDeletedGifts {
+    public struct Entry: Equatable {
+        public let id: Int64
+        public let stars: Int64
+        /// Номер картинки в стикерпаке. Нулевая картинка пака — заглушка.
+        public let sticker: Int
+    }
+
+    /// Рассылается, когда пришёл свежий список.
+    public static let didUpdateNotification = Notification.Name("LunagramDeletedGiftsDidUpdate")
+
+    public static let stickerPackName = "DeletedGiftsStickers"
+    public static let channelUsername = "DeletedGiftsChannel"
+    private static let listURL = URL(string: "https://raw.githubusercontent.com/binbash-0/DeletedGifts-Plugin/refs/heads/main/gift_list.json")!
+
+    private static let cacheKey = "lunagram.deletedGifts.listText"
+
+    private static let lock = NSLock()
+    private static var loadedEntries: [Entry]?
+    private static var injectedIds = Set<Int64>()
+    private static var webRequested = false
+
+    /// Зашитая копия — на самый первый запуск, пока ничего не скачано, и на
+    /// случай, когда недоступны и сайт, и канал. Сверена с файлом 13.09.2026.
+    private static let builtIn: [Entry] = [
+        Entry(id: 5956217000635139069, stars: 50, sticker: 1),
+        Entry(id: 5922558454332916696, stars: 50, sticker: 2),
+        Entry(id: 5800655655995968830, stars: 50, sticker: 3),
+        Entry(id: 5866352046986232958, stars: 50, sticker: 4),
+        Entry(id: 5801108895304779062, stars: 50, sticker: 5),
+        Entry(id: 5893356958802511476, stars: 50, sticker: 6),
+        Entry(id: 5935895822435615975, stars: 50, sticker: 7),
+        Entry(id: 5969796561943660080, stars: 50, sticker: 8),
+        Entry(id: 6026193266406327981, stars: 50, sticker: 9),
+        Entry(id: 5974210632977745012, stars: 50, sticker: 10),
+        Entry(id: 6046178578163303744, stars: 50, sticker: 11)
+    ]
+
+    /// Что показывать прямо сейчас: свежий список, сохранённый или зашитый.
+    public static var entries: [Entry] {
+        lock.lock()
+        defer { lock.unlock() }
+        if let loadedEntries {
+            return loadedEntries
+        }
+        if let text = UserDefaults.standard.string(forKey: cacheKey), let parsed = parse(text), !parsed.isEmpty {
+            loadedEntries = parsed
+            return parsed
+        }
+        return builtIn
+    }
+
+    /// Принять текст списка — с сайта или из канала, формат один.
+    /// Правда, если в нём нашлись подарки.
+    @discardableResult
+    public static func apply(text: String) -> Bool {
+        guard let parsed = parse(text), !parsed.isEmpty else {
+            return false
+        }
+        lock.lock()
+        let changed = loadedEntries != parsed
+        loadedEntries = parsed
+        lock.unlock()
+        UserDefaults.standard.set(text, forKey: cacheKey)
+        if changed {
+            NotificationCenter.default.post(name: didUpdateNotification, object: nil)
+        }
+        return true
+    }
+
+    /// Раз за запуск скачать свежий список с сайта. Ответ — получилось ли;
+    /// на повторные вызовы — сразу «да», второй раз не качаем.
+    public static func refreshFromWeb(completion: @escaping (Bool) -> Void) {
+        lock.lock()
+        let already = webRequested
+        webRequested = true
+        lock.unlock()
+        if already {
+            completion(true)
+            return
+        }
+
+        var request = URLRequest(url: listURL)
+        // Обязательно короткое ожидание: у заблокированного адреса запрос не
+        // отвергается, а молча висит, и запасной путь через канал никогда
+        // бы не включился. На ПК ровно на этом когда-то и споткнулись.
+        request.timeoutInterval = 5.0
+        request.cachePolicy = .reloadIgnoringLocalCacheData
+        URLSession.shared.dataTask(with: request, completionHandler: { data, response, _ in
+            // Постоянная, а не переменная: её забирает другая очередь.
+            let ok: Bool
+            if let data, let http = response as? HTTPURLResponse, http.statusCode == 200, let text = String(data: data, encoding: .utf8) {
+                ok = apply(text: text)
+            } else {
+                ok = false
+            }
+            DispatchQueue.main.async {
+                completion(ok)
+            }
+        }).resume()
+    }
+
+    /// Какие номера мы сами дописали в каталог. По ним окно отправки
+    /// понимает, что это наш подарок и цену надо сверить.
+    public static func markInjected(_ ids: [Int64]) {
+        lock.lock()
+        injectedIds.formUnion(ids)
+        lock.unlock()
+    }
+
+    public static func isInjected(_ id: Int64) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return injectedIds.contains(id)
+    }
+
+    /// Разбор. Числа достаём прямо из текста, а не разбором JSON в числа:
+    /// номера девятнадцатизначные, и любой путь через дробное число портит
+    /// последние цифры — на ПК из-за этого сервер отвечал STARGIFT_INVALID.
+    /// Здесь разбирается каждый подарок по отдельности, так что сбитый
+    /// порядок полей номер с чужой ценой не склеит.
+    private static func parse(_ text: String) -> [Entry]? {
+        guard text.contains("\"gifts\"") else {
+            return nil
+        }
+        guard let objectRegex = try? NSRegularExpression(pattern: "\\{[^{}]*\\}", options: []) else {
+            return nil
+        }
+        let range = NSRange(text.startIndex..., in: text)
+        var result: [Entry] = []
+        for match in objectRegex.matches(in: text, options: [], range: range) {
+            guard let objectRange = Range(match.range, in: text) else {
+                continue
+            }
+            let object = String(text[objectRange])
+            guard let idText = number(named: "id", in: object), let rawId = UInt64(idText) else {
+                continue
+            }
+            // Номер в Telegram — знаковое 64-битное число; большие беззнаковые
+            // сервер понимает так же, как их двоичная запись.
+            let id = Int64(bitPattern: rawId)
+            guard id != 0 else {
+                continue
+            }
+            let stars = number(named: "price", in: object).flatMap { Int64($0) } ?? 0
+            // Цена без звёзд или заоблачная — значит, в файле что-то не то.
+            guard stars > 0, stars <= 100_000 else {
+                continue
+            }
+            let sticker = number(named: "sticker_number", in: object).flatMap { Int($0) } ?? 0
+            result.append(Entry(id: id, stars: stars, sticker: max(0, sticker)))
+        }
+        return result
+    }
+
+    private static func number(named name: String, in object: String) -> String? {
+        guard let regex = try? NSRegularExpression(pattern: "\"\(name)\"\\s*:\\s*(\\d+)", options: []) else {
+            return nil
+        }
+        let range = NSRange(object.startIndex..., in: object)
+        guard let match = regex.firstMatch(in: object, options: [], range: range), match.numberOfRanges > 1, let valueRange = Range(match.range(at: 1), in: object) else {
+            return nil
+        }
+        return String(object[valueRange])
+    }
+}
+
+/// Сверка цены перед оплатой снятого подарка.
+///
+/// На айфоне кнопка «Отправить за 50 ⭐» платит сразу, без второго окна с
+/// ценой. Цена на кнопке — из нашего списка, а списывает сервер свою. Если
+/// они разошлись, лучше не отправить, чем списать больше, чем было написано.
+public final class LunagramGiftPriceGuard {
+    /// Сколько попросил сервер, если отказались платить.
+    public var askedPrice: Int64?
+
+    public init() {
+    }
+}
