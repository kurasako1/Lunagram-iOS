diff --git a/submodules/TelegramUI/Components/Gifts/GiftSetupScreen/Sources/LunagramDeletedGiftsCatalog.swift b/submodules/TelegramUI/Components/Gifts/GiftSetupScreen/Sources/LunagramDeletedGiftsCatalog.swift
