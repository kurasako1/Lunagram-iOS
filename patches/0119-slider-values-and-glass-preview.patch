+/// Образец оболочки кнопок профиля.
+    ///
+    /// В профиле кнопки «QR» и «Изменить» лежат стеклянными капсулами поверх
+    /// обложки. Здесь то же самое: обложка — своя аватарка, капсулы — выбранным
+    /// цветом и выбранной густотой. Обложка тут не украшение: над однотонным
+    /// фоном густота не видна ни на нуле, ни на сотне.
+    ///
+    /// Пока цвет не выбран, рисуем как Telegram — матовым стеклом, и густота
+    /// ни на что не влияет. Так же ведёт себя и настоящий профиль.
+    private func updateGlass(rowSize: CGSize, theme: PresentationTheme) {
+        let strip: UIView
+        if let current = self.glassStrip {
+            strip = current
+        } else {
+            strip = UIView()
+            strip.clipsToBounds = true
+            strip.layer.cornerRadius = 12.0
+            self.glassStrip = strip
+            self.previewContainer.addSubview(strip)
+
+            let cover = UIImageView()
+            cover.contentMode = .scaleAspectFill
+            cover.clipsToBounds = true
+            strip.addSubview(cover)
+            self.glassCover = cover
+
+            for title in ["QR", "Изменить"] {
+                let capsule = UIView()
+                capsule.clipsToBounds = true
+                strip.addSubview(capsule)
+
+                let blur = UIVisualEffectView(effect: UIBlurEffect(style: .systemThinMaterialDark))
+                blur.isUserInteractionEnabled = false
+                capsule.addSubview(blur)
+
+                let label = UILabel()
+                label.text = title
+                label.textAlignment = .center
+                label.font = .systemFont(ofSize: 15.0, weight: .semibold)
+                capsule.addSubview(label)
+
+                self.glassCapsules.append(capsule)
+                self.glassBlurs.append(blur)
+                self.glassLabels.append(label)
+            }
+        }
+        strip.isHidden = false
+        strip.frame = CGRect(x: 12.0, y: 8.0, width: rowSize.width - 24.0, height: max(1.0, rowSize.height - 34.0))
+
+        self.glassCover?.frame = strip.bounds
+        self.glassCover?.image = self.lunagramOwnAvatar
+        self.glassCover?.backgroundColor = self.lunagramOwnAvatar == nil ? theme.list.itemAccentColor : .clear
+
+        let tint = LunagramSettings.profileGlassTint().flatMap { UIColor(cgColor: $0) }
+        let textColor = LunagramSettings.profileButtonsColor.flatMap { UIColor(rgb: $0) } ?? .white
+        let capsuleHeight: CGFloat = 40.0
+        let gap: CGFloat = 10.0
+        let capsuleWidth = max(1.0, floor((strip.bounds.width - gap * 3.0) / 2.0))
+        let top = floor((strip.bounds.height - capsuleHeight) / 2.0)
+        for index in 0 ..< self.glassCapsules.count {
+            let capsule = self.glassCapsules[index]
+            capsule.frame = CGRect(x: gap + CGFloat(index) * (capsuleWidth + gap), y: top, width: capsuleWidth, height: capsuleHeight)
+            capsule.layer.cornerRadius = capsuleHeight / 2.0
+            capsule.backgroundColor = tint
+            let blur = self.glassBlurs[index]
+            blur.frame = capsule.bounds
+            blur.isHidden = tint != nil
+            let label = self.glassLabels[index]
+            label.frame = capsule.bounds
+            label.textColor = textColor
+        }
+    }
