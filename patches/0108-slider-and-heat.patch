+    /// Оповещение уже назначено и ещё не разослано.
+    ///
+    /// Читается и пишется только с главной очереди — оттуда же, откуда
+    /// рассылается само оповещение.
+    private static var changePending = false
+
     static func changed() {
-        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        if Thread.isMainThread {
+            scheduleChanged()
+        } else {
+            DispatchQueue.main.async {
+                scheduleChanged()
+            }
+        }
+    }
+
+    private static func scheduleChanged() {
+        guard !changePending else {
+            return
+        }
+        changePending = true
+        DispatchQueue.main.async {
+            changePending = false
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
     }
 }
