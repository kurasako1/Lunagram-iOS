@@ -0,0 +1,188 @@
+import Foundation
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import Lunagram
+
+// Lunagram: уборка за снятой функцией скрытия.
+//
+// Раньше здесь было «Скрыть меня от него» и «Скрыть меня от всех»: они
+// закрывали аватарку, описание, время в сети и номер — по-настоящему,
+// настройками приватности самого Telegram. Функцию сняли, а настройки на
+// сервере так и остались бы: без кнопки их было бы уже не вернуть.
+//
+// Поэтому при первом запуске без неё возвращаем всё как было: у кого есть
+// запас прежних настроек — из запаса, а спрятанных поимённо просто
+// вычёркиваем из списков «кому не видно». Получилось — стираем свои записи,
+// не получилось (нет сети) — записи остаются, попробуем в следующий раз.
+
+private var lunagramHideCleanupStarted = false
+
+private let lunagramHideTypes: [UpdateSelectiveAccountPrivacySettingsType] = [.presence, .profilePhoto, .bio, .phoneNumber]
+
+/// Запас прежних настроек, каким его писала снятая функция.
+private struct LunagramPrivacyBackup: Codable {
+    var option: Int
+    var enableFor: [Int64]
+    var disableFor: [Int64]
+    var enableForPremium: Bool
+    var enableForBots: Bool
+    var enableForCloseFriends: Bool
+}
+
+private func lunagramBackupKey(_ type: UpdateSelectiveAccountPrivacySettingsType) -> String {
+    switch type {
+    case .presence:
+        return "presence"
+    case .profilePhoto:
+        return "photo"
+    case .bio:
+        return "bio"
+    case .phoneNumber:
+        return "phone"
+    default:
+        return "other"
+    }
+}
+
+private func lunagramCurrent(_ settings: AccountPrivacySettings, _ type: UpdateSelectiveAccountPrivacySettingsType) -> SelectivePrivacySettings? {
+    switch type {
+    case .presence:
+        return settings.presence
+    case .profilePhoto:
+        return settings.profilePhoto
+    case .bio:
+        return settings.bio
+    case .phoneNumber:
+        return settings.phoneNumber
+    default:
+        return nil
+    }
+}
+
+/// Настройка из запаса. Людей в списках узнаём по номерам — кого сервер не
+/// отдал, того в список не вносим: без самого человека Telegram его и не
+/// примет.
+private func lunagramRestored(_ backup: LunagramPrivacyBackup, peers: [PeerId: SelectivePrivacyPeer]) -> SelectivePrivacySettings {
+    func map(_ ids: [Int64]) -> [PeerId: SelectivePrivacyPeer] {
+        var result: [PeerId: SelectivePrivacyPeer] = [:]
+        for id in ids {
+            let peerId = PeerId(id)
+            if let peer = peers[peerId] {
+                result[peerId] = peer
+            }
+        }
+        return result
+    }
+    switch backup.option {
+    case 1:
+        return .enableContacts(enableFor: map(backup.enableFor), disableFor: map(backup.disableFor), enableForPremium: backup.enableForPremium, enableForBots: backup.enableForBots)
+    case 2:
+        return .disableEveryone(enableFor: map(backup.enableFor), enableForCloseFriends: backup.enableForCloseFriends, enableForPremium: backup.enableForPremium, enableForBots: backup.enableForBots)
+    default:
+        return .enableEveryone(disableFor: map(backup.disableFor))
+    }
+}
+
+/// Вычёркивает спрятанных из списка «кому не видно».
+private func lunagramWithoutHidden(_ settings: SelectivePrivacySettings, hidden: [PeerId]) -> SelectivePrivacySettings {
+    if hidden.isEmpty {
+        return settings
+    }
+    switch settings {
+    case let .enableEveryone(disableFor):
+        var disableFor = disableFor
+        for peerId in hidden {
+            disableFor.removeValue(forKey: peerId)
+        }
+        return .enableEveryone(disableFor: disableFor)
+    case let .enableContacts(enableFor, disableFor, enableForPremium, enableForBots):
+        var disableFor = disableFor
+        for peerId in hidden {
+            disableFor.removeValue(forKey: peerId)
+        }
+        return .enableContacts(enableFor: enableFor, disableFor: disableFor, enableForPremium: enableForPremium, enableForBots: enableForBots)
+    case .disableEveryone:
+        // «Никому»: там прятали не списком, а тем, что человека в список
+        // видящих не вносили. Сами вносить не станем — откроем лишнего.
+        return settings
+    }
+}
+
+private func lunagramForgetHiding() {
+    LunagramSettings.hiddenPeers = []
+    LunagramSettings.hiddenFromEveryone = false
+    LunagramSettings.privacyBackupData = nil
+}
+
+/// Вернуть приватность и забыть о скрытии. Зовётся один раз за запуск.
+func lunagramCleanUpHiding(context: AccountContext) {
+    if lunagramHideCleanupStarted {
+        return
+    }
+    let hiddenIds = LunagramSettings.hiddenPeers.map { PeerId($0) }
+    let backupData = LunagramSettings.privacyBackupData
+    if hiddenIds.isEmpty, backupData == nil, !LunagramSettings.hiddenFromEveryone {
+        return
+    }
+    lunagramHideCleanupStarted = true
+
+    let backup = backupData.flatMap { try? JSONDecoder().decode([String: LunagramPrivacyBackup].self, from: $0) }
+
+    // Людей, которые понадобятся в списках, спрашиваем у сервера разом.
+    var wantedIds = Set(hiddenIds)
+    if let backup {
+        for saved in backup.values {
+            for id in saved.enableFor {
+                wantedIds.insert(PeerId(id))
+            }
+            for id in saved.disableFor {
+                wantedIds.insert(PeerId(id))
+            }
+        }
+    }
+    let ids = Array(wantedIds)
+    let peersSignal: Signal<[PeerId: EnginePeer?], NoError> = ids.isEmpty
+        ? .single([:])
+        : context.engine.data.get(EngineDataMap(ids.map { TelegramEngine.EngineData.Item.Peer.Peer(id: $0) }))
+
+    let _ = (combineLatest(
+        peersSignal,
+        context.engine.privacy.requestAccountPrivacySettings() |> take(1)
+    )
+    |> deliverOnMainQueue).startStandalone(next: { loaded, settings in
+        var peers: [PeerId: SelectivePrivacyPeer] = [:]
+        for (peerId, maybePeer) in loaded {
+            if let peer = maybePeer {
+                peers[peerId] = SelectivePrivacyPeer(peer: peer, participantCount: nil)
+            }
+        }
+
+        var updates: [Signal<Void, NoError>] = []
+        for type in lunagramHideTypes {
+            let base: SelectivePrivacySettings
+            if let saved = backup?[lunagramBackupKey(type)] {
+                base = lunagramRestored(saved, peers: peers)
+            } else if let current = lunagramCurrent(settings, type) {
+                base = current
+            } else {
+                continue
+            }
+            let updated = lunagramWithoutHidden(base, hidden: hiddenIds)
+            if let current = lunagramCurrent(settings, type), updated == current {
+                continue
+            }
+            updates.append(context.engine.privacy.updateSelectiveAccountPrivacySettings(type: type, settings: updated))
+        }
+
+        if updates.isEmpty {
+            lunagramForgetHiding()
+            return
+        }
+        let _ = (combineLatest(updates)
+        |> deliverOnMainQueue).startStandalone(completed: {
+            lunagramForgetHiding()
+        })
+    })
+}
