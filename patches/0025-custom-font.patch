diff --git a/submodules/LunagramFont/BUILD b/submodules/LunagramFont/BUILD
new file mode 100644
index 00000000..97d98a8f
--- /dev/null
+++ b/submodules/LunagramFont/BUILD
@@ -0,0 +1,21 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Свой шрифт интерфейса — отдельно от остального Lunagram.
+#
+# Его читает Display, самый низ приложения: через него идёт весь текст.
+# Всё, от чего Display зависит, при правке пересобирает приложение целиком.
+# Поэтому здесь только шрифт, и меняется это редко. Та же причина, по
+# которой Ghost живёт в LunagramGhost.
+swift_library(
+    name = "LunagramFont",
+    module_name = "LunagramFont",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/submodules/LunagramFont/Sources/LunagramFontSettings.swift b/submodules/LunagramFont/Sources/LunagramFontSettings.swift
new file mode 100644
index 00000000..c3c42282
--- /dev/null
+++ b/submodules/LunagramFont/Sources/LunagramFontSettings.swift
@@ -0,0 +1,199 @@
+import CoreText
+import Foundation
+import UIKit
+
+/// Свой шрифт на весь интерфейс.
+///
+/// Живёт отдельным крошечным модулем по той же причине, что и Ghost: его
+/// читает `Display` — самый низ приложения, через него идёт вообще весь
+/// текст. Если бы шрифт лежал в общем модуле Lunagram, каждая мелкая
+/// правка любой нашей функции пересобирала бы всё приложение. Здесь только
+/// то, что нужно `Display`, и меняется это редко.
+public enum LunagramFontSettings {
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let enabled = "lunagram.font.enabled"
+        static let file = "lunagram.font.file"
+        static let title = "lunagram.font.title"
+    }
+
+    /// Сообщается, когда шрифт сменили: экраны по ней перерисовываются.
+    public static let didChangeNotification = Notification.Name("LunagramFontSettings.didChange")
+
+    // Всё ниже — под замком: `Font.regular(...)` зовут и с главной очереди,
+    // и с фоновых, где Telegram считает разметку.
+    private static let lock = NSLock()
+    private static var cache: [String: UIFont] = [:]
+    private static var registeredFile: String?
+    private static var familyName: String?
+    private static var enabledCache: Bool?
+
+    /// Включён ли свой шрифт. Значение держим в памяти: его спрашивают на
+    /// каждую строчку текста, а не раз в экран.
+    public static var isEnabled: Bool {
+        get {
+            lock.lock()
+            defer { lock.unlock() }
+            if let enabledCache = self.enabledCache {
+                return enabledCache
+            }
+            let value = defaults.bool(forKey: Key.enabled)
+            self.enabledCache = value
+            return value
+        }
+        set {
+            defaults.set(newValue, forKey: Key.enabled)
+            invalidate()
+        }
+    }
+
+    /// Как называется выбранный шрифт — показываем в настройках.
+    public static var title: String? {
+        return defaults.string(forKey: Key.title)
+    }
+
+    /// Есть ли вообще выбранный файл шрифта.
+    public static var hasFont: Bool {
+        return defaults.string(forKey: Key.file) != nil
+    }
+
+    /// Забирает файл шрифта себе. Имя семейства читаем из самого файла:
+    /// у шрифта оно своё и с именем файла обычно не совпадает.
+    public static func importFont(from source: URL) throws {
+        let folder = try lunagramFolder()
+        let ext = source.pathExtension.isEmpty ? "ttf" : source.pathExtension
+        let name = "font-\(UUID().uuidString).\(ext)"
+        let target = folder.appendingPathComponent(name)
+        // Файл из «Файлов» лежит в песочнице чужого приложения — читаем
+        // содержимое, а не переносим ссылку.
+        let data = try Data(contentsOf: source)
+        try data.write(to: target)
+
+        guard let family = readFamilyName(of: target) else {
+            try? FileManager.default.removeItem(at: target)
+            throw ImportError.notAFont
+        }
+
+        clearStoredFile()
+        defaults.set(name, forKey: Key.file)
+        defaults.set(family, forKey: Key.title)
+        defaults.set(true, forKey: Key.enabled)
+        invalidate()
+    }
+
+    /// Убирает свой шрифт — вернётся родной системный.
+    public static func clearFont() {
+        clearStoredFile()
+        defaults.removeObject(forKey: Key.title)
+        defaults.set(false, forKey: Key.enabled)
+        invalidate()
+    }
+
+    /// Шрифт под запрошенный размер и насыщенность, или `nil` — тогда
+    /// `Display` возьмёт родной системный.
+    ///
+    /// Насыщенность и наклон подмешиваем поверх: у взятого со стороны
+    /// шрифта обычно одно начертание, а Telegram просит и жирное, и
+    /// курсив. Где их нет, останется обычное — это лучше, чем потерять
+    /// свой шрифт на половине надписей.
+    public static func font(size: CGFloat, weight: UIFont.Weight, italic: Bool) -> UIFont? {
+        guard isEnabled else {
+            return nil
+        }
+        let key = "\(size)_\(weight.rawValue)_\(italic ? 1 : 0)"
+
+        lock.lock()
+        if let cached = cache[key] {
+            lock.unlock()
+            return cached
+        }
+        let family = self.resolvedFamily()
+        lock.unlock()
+
+        guard let family = family, let base = UIFont(name: family, size: size) else {
+            return nil
+        }
+
+        var traits: UIFontDescriptor.SymbolicTraits = []
+        // UIFont.Weight сравнивать напрямую нельзя — сравниваем числа.
+        if weight.rawValue >= UIFont.Weight.semibold.rawValue {
+            traits.insert(.traitBold)
+        }
+        if italic {
+            traits.insert(.traitItalic)
+        }
+        var font = base
+        if !traits.isEmpty, let descriptor = base.fontDescriptor.withSymbolicTraits(traits) {
+            font = UIFont(descriptor: descriptor, size: size)
+        }
+
+        lock.lock()
+        cache[key] = font
+        lock.unlock()
+        return font
+    }
+
+    // MARK: Внутреннее
+
+    private enum ImportError: Error {
+        case notAFont
+    }
+
+    /// Подключает файл шрифта к системе, если ещё не подключён, и
+    /// возвращает имя семейства. Звать только под замком.
+    private static func resolvedFamily() -> String? {
+        guard let fileName = defaults.string(forKey: Key.file) else {
+            return nil
+        }
+        if fileName == registeredFile, let familyName = self.familyName {
+            return familyName
+        }
+        guard let folder = try? lunagramFolder() else {
+            return nil
+        }
+        let url = folder.appendingPathComponent(fileName)
+        // Подключаем в своё приложение; если уже подключён — это не ошибка.
+        CTFontManagerRegisterFontsForURL(url as CFURL, .process, nil)
+        let family = readFamilyName(of: url)
+        registeredFile = fileName
+        self.familyName = family
+        return family
+    }
+
+    /// Имя, по которому шрифт потом можно попросить у системы.
+    private static func readFamilyName(of url: URL) -> String? {
+        guard let descriptors = CTFontManagerCreateFontDescriptorsFromURL(url as CFURL) as? [CTFontDescriptor], let first = descriptors.first else {
+            return nil
+        }
+        let font = CTFontCreateWithFontDescriptor(first, 0.0, nil)
+        return CTFontCopyPostScriptName(font) as String
+    }
+
+    private static func clearStoredFile() {
+        if let folder = try? lunagramFolder(), let name = defaults.string(forKey: Key.file) {
+            try? FileManager.default.removeItem(at: folder.appendingPathComponent(name))
+        }
+        defaults.removeObject(forKey: Key.file)
+    }
+
+    private static func invalidate() {
+        lock.lock()
+        cache.removeAll()
+        registeredFile = nil
+        familyName = nil
+        enabledCache = nil
+        lock.unlock()
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// Та же папка, что у остального Lunagram. Повторена здесь нарочно:
+    /// этот модуль не должен зависеть от общего, иначе вернётся долгая
+    /// пересборка, ради ухода от которой он и заведён.
+    private static func lunagramFolder() throws -> URL {
+        let base = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true)
+        let folder = base.appendingPathComponent("Lunagram", isDirectory: true)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: nil)
+        return folder
+    }
+}
