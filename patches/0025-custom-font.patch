+/// Выбор файла шрифта в «Файлах».
+private final class LunagramFontPickerDelegate: NSObject, UIDocumentPickerDelegate {
+    private let completion: (Bool) -> Void
+
+    init(completion: @escaping (Bool) -> Void) {
+        self.completion = completion
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard let url = urls.first else {
+            self.completion(false)
+            return
+        }
+        // Файл лежит в чужой папке: система пускает к нему только на время
+        // и только по явному запросу.
+        let opened = url.startAccessingSecurityScopedResource()
+        defer {
+            if opened {
+                url.stopAccessingSecurityScopedResource()
+            }
+        }
+        let imported = (try? LunagramSettings.importFont(from: url)) != nil
+        self.completion(imported)
