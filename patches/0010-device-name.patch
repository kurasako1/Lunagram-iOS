+    /// Имя устройства для списка активных сеансов. Пусто — настоящее.
+    ///
+    /// Telegram сообщает его серверу при подключении, поэтому новое имя
+    /// начинает действовать после перезапуска. Рассылку о смене не делаем:
+    /// поле ввода сохраняет каждую букву, а на лету это имя никому не нужно.
+    public static var deviceModelName: String? {
+        get {
+            guard let value = defaults.string(forKey: Key.deviceModelName), !value.isEmpty else {
+                return nil
+            }
+            return value
+        }
+        set {
+            let value = newValue?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+            if value.isEmpty {
+                defaults.removeObject(forKey: Key.deviceModelName)
+            } else {
+                defaults.set(String(value.prefix(64)), forKey: Key.deviceModelName)
+            }
+        }
+    }
+
