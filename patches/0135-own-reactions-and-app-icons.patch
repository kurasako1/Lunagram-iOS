+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: свой набор реакций.
+//
+// Telegram сам решает, что показать первым в панели реакций: сервер присылает
+// список «часто используемых», и он то и дело перетасовывается. Здесь человек
+// складывает свой набор, и тот лежит как положили.
+//
+// Отмеченные поднимаются наверх списка — ровно в том порядке, в котором их
+// отмечали. Так видно не только что выбрано, но и каким оно будет в панели.
+
+private enum LunagramReactionEntry: ItemListNodeEntry {
+    /// Место в списке, свой номер, значок, надпись, отмечена ли.
+    case reaction(Int32, Int32, String, String, Bool)
+    case info(String)
+
+    var section: ItemListSectionId {
+        return 0
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .reaction(_, id, _, _, _):
+            return id
+        case .info:
+            return 10_000
+        }
+    }
+
+    /// Порядок на экране. Отдельно от номера: номер у реакции свой навсегда,
+    /// а место меняется, как только её отметили или сняли.
+    private var position: Int32 {
+        switch self {
+        case let .reaction(position, _, _, _, _):
+            return position
+        case .info:
+            return 9_999
+        }
+    }
+
+    static func ==(lhs: LunagramReactionEntry, rhs: LunagramReactionEntry) -> Bool {
+        switch lhs {
+        case let .reaction(lhsPosition, lhsId, lhsValue, lhsTitle, lhsChecked):
+            if case let .reaction(rhsPosition, rhsId, rhsValue, rhsTitle, rhsChecked) = rhs, lhsPosition == rhsPosition, lhsId == rhsId, lhsValue == rhsValue, lhsTitle == rhsTitle, lhsChecked == rhsChecked {
+                return true
+            } else {
+                return false
+            }
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        }
+    }
+
+    static func <(lhs: LunagramReactionEntry, rhs: LunagramReactionEntry) -> Bool {
+        return lhs.position < rhs.position
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let select = arguments as! (String) -> Void
+        switch self {
+        case let .reaction(_, _, value, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                select(value)
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+/// Экран «какие реакции показывать первыми».
+func lunagramReactionsScreen(context: AccountContext, refresh: @escaping () -> Void) -> ViewController {
+    let changed = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+
+    let arguments: (String) -> Void = { value in
+        var list = LunagramSettings.ownReactionsList
+        if let index = list.firstIndex(of: value) {
+            list.remove(at: index)
+        } else {
+            list.append(value)
+        }
+        LunagramSettings.ownReactionsList = list
+        counter += 1
+        changed.set(counter)
+        refresh()
+    }
+
+    let signal = combineLatest(
+        context.sharedContext.presentationData,
+        context.engine.stickers.availableReactions(),
+        changed.get()
+    )
+    |> deliverOnMainQueue
+    |> map { presentationData, availableReactions, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        // Только обычные реакции: у премиальных значок — своя картинка, и
+        // выбирать их пришлось бы совсем другим экраном.
+        var all: [(value: String, title: String, isPremium: Bool)] = []
+        for reaction in availableReactions?.reactions ?? [] {
+            guard reaction.isEnabled else {
+                continue
+            }
+            guard case let .builtin(value) = reaction.value else {
+                continue
+            }
+            all.append((value, reaction.title, reaction.isPremium))
+        }
+
+        var numbers: [String: Int32] = [:]
+        for (index, item) in all.enumerated() {
+            numbers[item.value] = Int32(index)
+        }
+
+        // Отмеченные вперёд, в том порядке, в котором их отмечали.
+        let chosen = LunagramSettings.ownReactionsList
+        var ordered = chosen.compactMap { value in
+            return all.first(where: { $0.value == value })
+        }
+        ordered.append(contentsOf: all.filter { !chosen.contains($0.value) })
+
+        var entries: [LunagramReactionEntry] = []
+        for (place, item) in ordered.enumerated() {
+            let title = item.isPremium ? "\(item.value)  \(item.title) · премиум" : "\(item.value)  \(item.title)"
+            entries.append(.reaction(Int32(place), numbers[item.value] ?? Int32(place), item.value, title, chosen.contains(item.value)))
+        }
+        entries.append(.info("Отмеченные поднимаются наверх списка — в этом же порядке они встанут в панели реакций.\n\nПремиальные без премиума не отправятся: Telegram их не примет."))
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Свои реакции"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
