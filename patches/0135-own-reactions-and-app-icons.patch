diff --git a/submodules/Lunagram/Sources/LunagramAppIcons.swift b/submodules/Lunagram/Sources/LunagramAppIcons.swift
new file mode 100644
index 00000000..5d650527
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramAppIcons.swift
@@ -0,0 +1,72 @@
+import Foundation
+import UIKit
+
+// Lunagram: свои картинки вместо значков приложения.
+//
+// На Android значки лежат файлами, и чужой набор подменяет их разом. На iOS
+// они лежат в сжатом каталоге внутри приложения и зовутся по-своему: не
+// «ic_delete», а «Chat/Context Menu/Delete». Чужой набор сюда не ляжет ни
+// одним файлом — имена не совпадают и совпасть не могут. Поэтому меняем
+// поштучно: перечень всех значков, поиск по имени, своя картинка на любой.
+//
+// Хранилище общее со значками строк настроек — тот же список «ключ → файл», —
+// но ключ начинается с «app:». Так выбор картинки, подгонка и уборка
+// ненужных файлов написаны один раз и работают на оба случая.
+
+public enum LunagramAppIcons {
+    /// Есть ли вообще что подменять.
+    ///
+    /// Воронку значков дёргают тысячи раз за запуск, и лезть на каждый
+    /// значок в настройки и в список замен — дорого. Поэтому держим один
+    /// ответ наготове и обновляем его, когда настройки меняются.
+    private static var hasAny = false
+    private static var started = false
+
+    /// Зовётся один раз при запуске, с главного потока.
+    public static func start() {
+        guard !started else {
+            return
+        }
+        started = true
+        refresh()
+        NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+            LunagramAppIcons.refresh()
+        })
+    }
+
+    private static func refresh() {
+        hasAny = LunagramSettings.appIcons && LunagramSettingIcons.appCount > 0
+    }
+
+    /// Ключ значка в общем списке картинок.
+    public static func key(for name: String) -> String {
+        return LunagramSettingIcons.appPrefix + name
+    }
+
+    /// Включены ли свои значки приложения.
+    public static var enabled: Bool {
+        return LunagramSettings.appIcons
+    }
+
+    /// Заменён ли этот значок.
+    public static func hasCustom(_ name: String) -> Bool {
+        return LunagramSettingIcons.hasCustom(key(for: name))
+    }
+
+    /// Сколько значков заменено — для строки настроек.
+    public static var count: Int {
+        return LunagramSettingIcons.appCount
+    }
+
+    /// Своя картинка значка в его же размер.
+    ///
+    /// Размер родного значка держим нарочно: по значкам считается разметка, и
+    /// значок другого размера сдвинул бы всё вокруг — от кнопок в шапке до
+    /// полосы ввода.
+    public static func image(for name: String, size: CGSize) -> UIImage? {
+        guard hasAny else {
+            return nil
+        }
+        return LunagramSettingIcons.image(for: key(for: name), size: size)
+    }
+}
