+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import AppBundle
+import Lunagram
+
+// Lunagram: экран «Значки приложения».
+//
+// Перечень всех значков, поиск по имени и своя картинка на любой. Выбор
+// картинки, подгонка и уборка — те же, что у значков строк настроек: там это
+// уже написано, и делать второй такой же набор окошек незачем.
+//
+// Показываем не весь список разом: значок надо нарисовать, чтобы показать, а
+// их восемь с лишним сотен. Поэтому на экране первые несколько десятков —
+// остальное находится поиском.
+
+private let lunagramAppIconsLimit = 60
+private let lunagramAppIconSide: CGFloat = 26.0
+
+/// Нарисованные значки держим сами: при каждой букве в поиске список
+/// пересобирается, а рисовать одно и то же заново незачем.
+private var lunagramAppIconCache: [String: UIImage] = [:]
+
+private func lunagramAppIconPreview(name: String, tint: UIColor) -> (image: UIImage?, size: CGSize) {
+    guard let original = UIImage(bundleImageName: name) else {
+        return (nil, .zero)
+    }
+    let custom = LunagramAppIcons.image(for: name, size: original.size)
+    let cacheKey = "\(name)|\(custom == nil ? 0 : 1)|\(tint.argb)"
+    if let cached = lunagramAppIconCache[cacheKey] {
+        return (cached, original.size)
+    }
+
+    // Родные значки почти все одноцветные и рисуются цветом темы — без
+    // подкраски половина из них была бы не видна на своём же фоне. Своя
+    // картинка цветная, её не трогаем.
+    let source = custom ?? generateTintedImage(image: original, color: tint) ?? original
+    let side = max(source.size.width, source.size.height)
+    var result = source
+    if side > lunagramAppIconSide {
+        let scale = lunagramAppIconSide / side
+        let target = CGSize(width: max(1.0, source.size.width * scale), height: max(1.0, source.size.height * scale))
+        let format = UIGraphicsImageRendererFormat()
+        format.opaque = false
+        format.scale = 3.0
+        result = UIGraphicsImageRenderer(size: target, format: format).image { _ in
+            source.draw(in: CGRect(origin: CGPoint(), size: target))
+        }
+    }
+    lunagramAppIconCache[cacheKey] = result
+    if lunagramAppIconCache.count > 400 {
+        lunagramAppIconCache.removeAll()
+    }
+    return (result, original.size)
+}
+
+private enum LunagramAppIconEntry: ItemListNodeEntry {
+    case master(Bool)
+    case masterInfo(String)
+    case search(String)
+    /// Место в списке, имя значка, картинка, заменён ли.
+    case icon(Int32, String, UIImage?, Bool)
+    case info(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .master, .masterInfo:
+            return 0
+        case .search:
+            return 1
+        case .icon, .info:
+            return 2
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .master:
+            return 0
+        case .masterInfo:
+            return 1
+        case .search:
+            return 2
+        case let .icon(place, _, _, _):
+            return 100 + place
+        case .info:
+            return 90_000
+        }
+    }
+
+    static func ==(lhs: LunagramAppIconEntry, rhs: LunagramAppIconEntry) -> Bool {
+        switch lhs {
+        case let .master(lhsValue):
+            if case let .master(rhsValue) = rhs, lhsValue == rhsValue {
+                return true
+            }
+            return false
+        case let .masterInfo(lhsText):
+            if case let .masterInfo(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        case let .search(lhsText):
+            if case let .search(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        case let .icon(lhsPlace, lhsName, lhsImage, lhsCustom):
+            if case let .icon(rhsPlace, rhsName, rhsImage, rhsCustom) = rhs, lhsPlace == rhsPlace, lhsName == rhsName, lhsImage === rhsImage, lhsCustom == rhsCustom {
+                return true
+            }
+            return false
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        }
+    }
+
+    static func <(lhs: LunagramAppIconEntry, rhs: LunagramAppIconEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramAppIconsArguments
+        switch self {
+        case let .master(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Свои значки приложения", value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.setEnabled(value)
+            })
+        case let .masterInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .search(text):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: "Поиск по имени", clearType: .always, sectionId: self.section, textUpdated: { value in
+                arguments.setQuery(value)
+            }, action: {})
+        case let .icon(_, name, image, custom):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: image, title: name, label: custom ? "своя" : "", sectionId: self.section, style: .blocks, disclosureStyle: .none, action: {
+                arguments.pick(name)
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private final class LunagramAppIconsArguments {
+    let setEnabled: (Bool) -> Void
+    let setQuery: (String) -> Void
+    let pick: (String) -> Void
+
+    init(setEnabled: @escaping (Bool) -> Void, setQuery: @escaping (String) -> Void, pick: @escaping (String) -> Void) {
+        self.setEnabled = setEnabled
+        self.setQuery = setQuery
+        self.pick = pick
+    }
+}
+
+/// Держит подписку на «настройки изменились», пока жив экран: картинку
+/// выбирают в отдельном окошке, и список надо пересобрать, когда оно закроется.
+private final class LunagramAppIconsWatcher {
+    private var observer: NSObjectProtocol?
+
+    init(changed: @escaping () -> Void) {
+        self.observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+            changed()
+        })
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+func lunagramAppIconsScreen(context: AccountContext, refresh: @escaping () -> Void) -> ViewController {
+    let queryPromise = ValuePromise<String>("", ignoreRepeated: true)
+    let changed = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    let bump: () -> Void = {
+        counter += 1
+        changed.set(counter)
+    }
+    let watcher = LunagramAppIconsWatcher(changed: bump)
+
+    var presentMenu: ((String) -> Void)?
+
+    let arguments = LunagramAppIconsArguments(setEnabled: { value in
+        LunagramSettings.appIcons = value
+        refresh()
+    }, setQuery: { value in
+        queryPromise.set(value)
+    }, pick: { name in
+        presentMenu?(name)
+    })
+
+    let signal = combineLatest(
+        context.sharedContext.presentationData,
+        queryPromise.get(),
+        changed.get()
+    )
+    |> deliverOnMainQueue
+    |> map { presentationData, currentQuery, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        // Пока экран жив, наблюдатель должен быть жив вместе с ним.
+        let _ = watcher
+
+        let needle = currentQuery.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        var matched = LunagramAppIconNames.all
+        if !needle.isEmpty {
+            matched = matched.filter { $0.lowercased().contains(needle) }
+        }
+        // Заменённые вперёд: их ищут чаще всего — чтобы вернуть обычный.
+        let custom = matched.filter { LunagramAppIcons.hasCustom($0) }
+        if !custom.isEmpty {
+            matched = custom + matched.filter { !LunagramAppIcons.hasCustom($0) }
+        }
+        let shown = Array(matched.prefix(lunagramAppIconsLimit))
+
+        var entries: [LunagramAppIconEntry] = []
+        entries.append(.master(LunagramSettings.appIcons))
+        entries.append(.masterInfo("Пока выключено, замены не видны и картинку не выбрать."))
+        entries.append(.search(currentQuery))
+
+        for (place, name) in shown.enumerated() {
+            let preview = lunagramAppIconPreview(name: name, tint: presentationData.theme.list.itemPrimaryTextColor)
+            entries.append(.icon(Int32(place), name, preview.image, LunagramAppIcons.hasCustom(name)))
+        }
+
+        if shown.isEmpty {
+            entries.append(.info("Ничего не нашлось. Имена значков английские: попробуй «call», «trash», «folder»."))
+        } else if matched.count > shown.count {
+            entries.append(.info("Показаны первые \(shown.count) из \(matched.count) — уточни поиск.\n\nЗначок меняется на свою картинку в его же размере: по значкам считается разметка, и значок другого размера сдвинул бы всё вокруг. Некоторые значки приложение запоминает при запуске — они сменятся после перезапуска."))
+        } else {
+            entries.append(.info("Значок меняется на свою картинку в его же размере: по значкам считается разметка, и значок другого размера сдвинул бы всё вокруг.\n\nНекоторые значки приложение запоминает при запуске — они сменятся после перезапуска."))
+        }
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Значки приложения"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentMenu = { [weak controller] name in
+        guard let controller = controller, let original = UIImage(bundleImageName: name) else {
+            return
+        }
+        let presentationData = context.sharedContext.currentPresentationData.with({ $0 })
+        let palette = LunagramSettingIcons.Palette(
+            isDark: presentationData.theme.overallDarkAppearance,
+            background: presentationData.theme.list.blocksBackgroundColor,
+            card: presentationData.theme.list.itemBlocksBackgroundColor,
+            text: presentationData.theme.list.itemPrimaryTextColor,
+            secondaryText: presentationData.theme.list.itemSecondaryTextColor,
+            accent: presentationData.theme.list.itemAccentColor
+        )
+        LunagramSettingIcons.showMenu(key: LunagramAppIcons.key(for: name), icon: original, iconSize: original.size, from: controller.view, palette: palette)
+    }
+    return controller
+}
