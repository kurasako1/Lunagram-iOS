diff --git a/submodules/AppBundle/PublicHeaders/AppBundle/AppBundle.h b/submodules/AppBundle/PublicHeaders/AppBundle/AppBundle.h
index d00fe35e..566e3e1a 100644
--- a/submodules/AppBundle/PublicHeaders/AppBundle/AppBundle.h
+++ b/submodules/AppBundle/PublicHeaders/AppBundle/AppBundle.h
@@ -3,6 +3,20 @@
 
 NSBundle * _Nonnull getAppBundle(void);
 
+/// Lunagram: подмена значков.
+///
+/// Приложение зовёт все свои картинки по имени через
+/// initWithBundleImageName: — это единственная воронка на восемь с лишним
+/// сотен значков. Кто умеет отдать свою картинку, ставит сюда свой
+/// ответчик при запуске.
+///
+/// Ответчику дают имя значка и размер родного: свой обязан быть того же
+/// размера — по значкам считается разметка. Нечего отдать — пусть вернёт
+/// nil, тогда возьмётся родной.
+typedef UIImage * _Nullable (^LunagramIconOverride)(NSString * _Nonnull name, CGSize size);
+
+void LunagramSetIconOverride(LunagramIconOverride _Nullable block);
+
 @interface UIImage (AppBundle)
 
 - (instancetype _Nullable)initWithBundleImageName:(NSString * _Nonnull)bundleImageName;
diff --git a/submodules/AppBundle/Sources/AppBundle/AppBundle.m b/submodules/AppBundle/Sources/AppBundle/AppBundle.m
index e93a19a7..dcc8b60b 100644
--- a/submodules/AppBundle/Sources/AppBundle/AppBundle.m
+++ b/submodules/AppBundle/Sources/AppBundle/AppBundle.m
@@ -18,10 +18,23 @@ NSBundle * _Nonnull getAppBundle() {
     return appBundle;
 }
 
+static LunagramIconOverride _Nullable lunagramIconOverride = nil;
+
+void LunagramSetIconOverride(LunagramIconOverride _Nullable block) {
+    lunagramIconOverride = [block copy];
+}
+
 @implementation UIImage (AppBundle)
 
 - (instancetype _Nullable)initWithBundleImageName:(NSString * _Nonnull)bundleImageName {
-    return [UIImage imageNamed:bundleImageName inBundle:getAppBundle() compatibleWithTraitCollection:nil];
+    UIImage *image = [UIImage imageNamed:bundleImageName inBundle:getAppBundle() compatibleWithTraitCollection:nil];
+    if (lunagramIconOverride != nil && image != nil) {
+        UIImage *custom = lunagramIconOverride(bundleImageName, image.size);
+        if (custom != nil) {
+            return custom;
+        }
+    }
+    return image;
 }
 
 @end
