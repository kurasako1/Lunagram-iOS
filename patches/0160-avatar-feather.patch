+import UIKit
+import CoreImage
+
+/// Растушёвка краёв аватарки профиля.
+///
+/// Из плагина Custom Profile: «Растушёвка краёв» с радиусом. Край аватарки
+/// перестаёт быть резаным и уходит в прозрачность.
+///
+/// Делаем маской-картинкой: контур рисуется белым, потом размывается, и
+/// получившееся служит маской слоя. Контур берём тот же, что у формы, поэтому
+/// растушёвка следует и за звездой, и за сердцем, а не только за кругом.
+///
+/// ВАЖНО — только для аватарки профиля, как и в плагине. Форма у нас общая на
+/// все аватарки, включая список переписок, и размытая маска на каждый размер
+/// там была бы прямой платой за прокрутку. В профиле аватарка одна, размер
+/// один, маска считается однажды и запоминается.
+public enum LunagramAvatarFeather {
+    private static let lock = NSLock()
+    private static var cache: [String: UIImage] = [:]
+    private static let context = CIContext(options: [.useSoftwareRenderer: false])
+
+    /// Маска для аватарки этого размера, или `nil` — если растушёвка выключена
+    /// либо собрать её не удалось.
+    public static func mask(size: CGSize, radius: Int) -> UIImage? {
+        guard radius > 0, size.width > 1.0, size.height > 1.0 else {
+            return nil
+        }
+        // Радиус задан в процентах от половины стороны: так один и тот же
+        // ползунок одинаково смотрится на любом размере аватарки.
+        let side = min(size.width, size.height)
+        let blur = side / 2.0 * CGFloat(radius) / 100.0
+        guard blur > 0.4 else {
+            return nil
+        }
+
+        let key = "\(Int(size.width))x\(Int(size.height))|\(radius)|\(LunagramSettings.avatarShape)|\(LunagramSettings.avatarCorners)"
+        lock.lock()
+        if let cached = cache[key] {
+            lock.unlock()
+            return cached
+        }
+        lock.unlock()
+
+        // Запас по краям: размытие выходит за контур, и без запаса хвост
+        // обрезался бы рамкой картинки — вместо мягкого края получилась бы
+        // резаная полоса.
+        let inset = ceil(blur * 2.0)
+        let canvas = CGSize(width: size.width + inset * 2.0, height: size.height + inset * 2.0)
+
+        let renderer = UIGraphicsImageRenderer(size: canvas)
+        let solid = renderer.image { context in
+            let cg = context.cgContext
+            cg.setFillColor(UIColor.white.cgColor)
+            // Контур сжимаем на величину размытия: размытие «съедает» край в
+            // обе стороны, и без сжатия аватарка стала бы заметно больше.
+            let shapeRect = CGRect(
+                x: inset + blur / 2.0,
+                y: inset + blur / 2.0,
+                width: size.width - blur,
+                height: size.height - blur)
+            cg.addPath(LunagramAvatarShape.path(in: shapeRect))
+            cg.fillPath()
+        }
+
+        guard let input = CIImage(image: solid),
+              let filter = CIFilter(name: "CIGaussianBlur") else {
+            return nil
+        }
+        filter.setValue(input, forKey: kCIInputImageKey)
+        filter.setValue(blur / 2.0, forKey: kCIInputRadiusKey)
+        guard let output = filter.outputImage else {
+            return nil
+        }
+        // Размытие раздвигает границы картинки — берём ровно свой кусок,
+        // иначе маска сдвинется относительно аватарки.
+        let crop = CGRect(origin: CGPoint(x: inset, y: inset), size: size)
+        guard let cgImage = self.context.createCGImage(output, from: crop) else {
+            return nil
+        }
+        let image = UIImage(cgImage: cgImage)
+
+        lock.lock()
+        cache[key] = image
+        lock.unlock()
+        return image
+    }
+
+    /// Сбросить запомненное: сменилась форма, скругление или радиус.
+    public static func reset() {
+        lock.lock()
+        cache.removeAll()
+        lock.unlock()
+    }
+}
