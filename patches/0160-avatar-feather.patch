+    /// Lunagram: мягкий край аватарки профиля.
+    ///
+    /// Маску вешаем на содержимое аватарки, а не на контейнер: контейнер
+    /// участвует в переходах шапки и меняет масштаб, и маска на нём
+    /// растягивалась бы вместе с ним — край то резал бы, то расплывался.
+    ///
+    /// Снимаем только СВОЮ маску, по имени: у аватарки бывает своя под
+    /// истории и под раскрытый вид, и затереть её значило бы сломать
+    /// чужое.
+    private func lunagramApplyFeather(isSettings: Bool) {
+        let layer = self.avatarNode.contentNode.layer
+        let size = self.avatarNode.bounds.size
+        let radius = isSettings ? LunagramSettings.avatarFeather : 0
+        guard radius > 0, let mask = LunagramAvatarFeather.mask(size: size, radius: radius) else {
+            if layer.mask?.name == "lunagramFeather" {
+                layer.mask = nil
+            }
+            return
+        }
+        let maskLayer: CALayer
+        if let current = layer.mask, current.name == "lunagramFeather" {
+            maskLayer = current
+        } else {
+            maskLayer = CALayer()
+            maskLayer.name = "lunagramFeather"
+            layer.mask = maskLayer
+        }
+        maskLayer.frame = CGRect(origin: CGPoint(), size: size)
+        maskLayer.contents = mask.cgImage
+        // Обрезка по рамке теперь мешает: мягкий край должен выходить за
+        // неё, иначе его срежет ровно там, где он начинается.
+        layer.masksToBounds = false
+    }
