+        let width = bounds.width - insets.left - insets.right - side * 2.0
+        let left = insets.left + side
+        var y = insets.top + 20.0
+
+        let canvasSide = floor(min(160.0, width * 0.45))
+        self.canvas.frame = CGRect(x: left, y: y, width: canvasSide, height: canvasSide)
+
+        // Справа — строка настроек, как она выглядит на самом деле.
+        let rowLeft = left + canvasSide + 16.0
+        self.rowIconView.frame = CGRect(x: rowLeft, y: y + floor((canvasSide - self.iconSize.height) / 2.0), width: self.iconSize.width, height: self.iconSize.height)
+        let labelLeft = rowLeft + self.iconSize.width + 12.0
+        self.rowLabel.frame = CGRect(x: labelLeft, y: y + floor((canvasSide - 22.0) / 2.0), width: max(0.0, left + width - labelLeft), height: 22.0)
+        y += canvasSide + 28.0
+
+        self.zoomLabel.frame = CGRect(x: left, y: y, width: width, height: 18.0)
+        y += 24.0
+        self.slider.frame = CGRect(x: left, y: y, width: width, height: 32.0)
+        y += 48.0
+        self.otherButton.frame = CGRect(x: left, y: y, width: width, height: 44.0)
+        y += 52.0
+        let infoSize = self.infoLabel.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+        self.infoLabel.frame = CGRect(x: left, y: y, width: width, height: ceil(infoSize.height))
+    }
+
+    private func refresh() {
+        self.canvas.setNeedsDisplay()
+        self.rowIconView.image = LunagramSettingIcons.image(for: self.key, size: self.iconSize) ?? self.icon
+        if !self.slider.isTracking, let entry = LunagramSettingIcons.entry(for: self.key) {
+            self.slider.value = Float(entry.zoom)
+        }
+        let hasEntry = LunagramSettingIcons.hasCustom(self.key)
+        self.slider.isEnabled = hasEntry
+        self.navigationItem.leftBarButtonItem?.isEnabled = hasEntry
+    }
+
+    @objc private func canvasPanned(_ recognizer: UIPanGestureRecognizer) {
+        switch recognizer.state {
+        case .began:
+            if let entry = LunagramSettingIcons.entry(for: self.key) {
+                self.dragStart = (entry.offsetX, entry.offsetY)
+            }
+        case .changed:
+            guard let start = self.dragStart, let entry = LunagramSettingIcons.entry(for: self.key), let image = LunagramSettingIcons.original(entry.file) else {
+                return
+            }
+            let target = self.canvas.bounds.size
+            let place = LunagramSettingIcons.placement(original: image.size, target: target, entry: entry)
+            // Лишек — то, что не влезло. Нет лишка по оси — двигать нечего.
+            // Двести, а не сто: сдвиг идёт от -100 до +100.
+            let extraX = place.width - target.width
+            let extraY = place.height - target.height
+            let delta = recognizer.translation(in: self.canvas)
+            let offsetX = extraX > 0.0 ? max(-100, min(100, start.x - Int((delta.x * 200.0 / extraX).rounded()))) : entry.offsetX
+            let offsetY = extraY > 0.0 ? max(-100, min(100, start.y - Int((delta.y * 200.0 / extraY).rounded()))) : entry.offsetY
+            LunagramSettingIcons.change(self.key, { entry in
+                entry.offsetX = offsetX
+                entry.offsetY = offsetY
+            })
+        default:
+            self.dragStart = nil
+        }
+    }
+
+    @objc private func canvasPinched(_ recognizer: UIPinchGestureRecognizer) {
+        switch recognizer.state {
+        case .began:
+            self.pinchStartZoom = LunagramSettingIcons.entry(for: self.key)?.zoom
+        case .changed:
+            guard let start = self.pinchStartZoom else {
+                return
+            }
+            let zoom = max(LunagramSettingIcons.zoomMin, min(LunagramSettingIcons.zoomMax, Int((CGFloat(start) * recognizer.scale).rounded())))
+            LunagramSettingIcons.change(self.key, { entry in
+                entry.zoom = zoom
+            })
+        default:
+            self.pinchStartZoom = nil
+        }
+    }
+
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return true
+    }
+
+    @objc private func sliderChanged() {
+        let zoom = Int(self.slider.value.rounded())
+        LunagramSettingIcons.change(self.key, { entry in
+            entry.zoom = zoom
+        })
+    }
+
+    @objc private func otherPressed() {
+        self.chooseOther?()
+    }
+
+    @objc private func resetPressed() {
+        LunagramSettingIcons.reset(self.key)
+        self.dismiss(animated: true, completion: nil)
+    }
+
+    @objc private func donePressed() {
+        self.dismiss(animated: true, completion: nil)
+    }
+}
