@@ -0,0 +1,657 @@
+import Foundation
+import UIKit
+import PhotosUI
+
+/// Свои картинки вместо значков у строк настроек — как на ПК.
+///
+/// Строку узнаём по её тексту, как ПК — по надписи кнопки. Картинка лежит в
+/// папке Lunagram (сторона до 256 точек, как на ПК), а приближение и сдвиг —
+/// в настройках одной строкой. Картинка ложится как есть: при 100% целиком
+/// помещается в значок, прозрачные края остаются прозрачными; приближение
+/// увеличивает её, и лишнее уходит за край, а сдвиг выбирает видимый кусок.
+public enum LunagramSettingIcons {
+    /// Приближение в процентах: 100 — картинка целиком в значке. Как на ПК.
+    static let zoomMin = 100
+    static let zoomMax = 400
+
+    /// Сторона сохранённой картинки — как у значков на ПК.
+    private static let fileSide = 256
+    private static let filePrefix = "icon-"
+
+    struct Entry: Equatable {
+        var file: String
+        var zoom: Int
+        var offsetX: Int
+        var offsetY: Int
+    }
+
+    /// Выключатель «Свои значки в настройках».
+    public static var enabled: Bool {
+        return LunagramSettings.settingIcons
+    }
+
+    // MARK: Список «строка → картинка»
+
+    private static var parsedSource: String?
+    private static var parsedEntries: [String: Entry] = [:]
+
+    /// Разбираем, только когда список сменился: значки рисуются часто, а
+    /// меняется список редко.
+    static func entries() -> [String: Entry] {
+        let source = LunagramSettings.settingIconsMap
+        if source != parsedSource {
+            parsedSource = source
+            var result: [String: Entry] = [:]
+            for line in source.components(separatedBy: "\n") {
+                let parts = line.components(separatedBy: "\t")
+                if parts.count < 5 || parts[0].isEmpty || parts[1].isEmpty {
+                    continue
+                }
+                result[parts[0]] = Entry(
+                    file: parts[1],
+                    zoom: max(zoomMin, min(zoomMax, Int(parts[2]) ?? zoomMin)),
+                    offsetX: max(-100, min(100, Int(parts[3]) ?? 0)),
+                    offsetY: max(-100, min(100, Int(parts[4]) ?? 0))
+                )
+            }
+            parsedEntries = result
+        }
+        return parsedEntries
+    }
+
+    private static func save(_ entries: [String: Entry]) {
+        var lines: [String] = []
+        for key in entries.keys.sorted() {
+            if let entry = entries[key] {
+                lines.append([key, entry.file, "\(entry.zoom)", "\(entry.offsetX)", "\(entry.offsetY)"].joined(separator: "\t"))
+            }
+        }
+        LunagramSettings.settingIconsMap = lines.joined(separator: "\n")
+    }
+
+    /// Ключ строки — её текст. Табуляция и перенос строки — наши
+    /// разделители, в ключ их пускать нельзя.
+    static func normalizedKey(_ text: String) -> String {
+        return text.trimmingCharacters(in: .whitespacesAndNewlines).replacingOccurrences(of: "\t", with: " ").replacingOccurrences(of: "\n", with: " ")
+    }
+
+    static func entry(for key: String) -> Entry? {
+        return entries()[normalizedKey(key)]
+    }
+
+    /// Есть ли у строки своя картинка.
+    public static func hasCustom(_ key: String) -> Bool {
+        return entry(for: key) != nil
+    }
+
+    static func change(_ key: String, _ body: (inout Entry) -> Void) {
+        let key = normalizedKey(key)
+        var all = entries()
+        guard var entry = all[key] else {
+            return
+        }
+        let before = entry
+        body(&entry)
+        if entry == before {
+            return
+        }
+        all[key] = entry
+        save(all)
+    }
+
+    /// «Вернуть обычный»: убрать свою картинку у строки.
+    public static func reset(_ key: String) {
+        let key = normalizedKey(key)
+        var all = entries()
+        guard let entry = all.removeValue(forKey: key) else {
+            return
+        }
+        save(all)
+        removeIfUnused(entry.file)
+    }
+
+    /// Файл, на который больше не ссылается ни один значок, удаляем — иначе
+    /// папка засорялась бы при каждой смене картинки.
+    private static func removeIfUnused(_ file: String) {
+        if entries().values.contains(where: { $0.file == file }) {
+            return
+        }
+        originals.removeValue(forKey: file)
+        guard file.hasPrefix(filePrefix), let folder = try? LunagramSettings.lunagramFolder() else {
+            return
+        }
+        try? FileManager.default.removeItem(at: folder.appendingPathComponent(file))
+    }
+
+    /// Сохранить картинку и привязать к строке. Зовётся не с главного
+    /// потока: файл временный, забрать его надо сразу. Список меняем уже на
+    /// главном.
+    static func install(from source: URL, key: String, completion: @escaping (Bool) -> Void) {
+        let name = filePrefix + UUID().uuidString + ".png"
+        var written = false
+        if let folder = try? LunagramSettings.lunagramFolder() {
+            // PNG — чтобы прозрачный фон остался прозрачным, как у значка.
+            written = (try? LunagramSettings.writeScaledImage(from: source, to: folder.appendingPathComponent(name), asPNG: true, maxPixelSize: fileSide)) != nil
+        }
+        DispatchQueue.main.async {
+            guard written else {
+                completion(false)
+                return
+            }
+            let key = normalizedKey(key)
+            var all = entries()
+            let old = all[key]?.file
+            all[key] = Entry(file: name, zoom: zoomMin, offsetX: 0, offsetY: 0)
+            save(all)
+            if let old = old {
+                removeIfUnused(old)
+            }
+            completion(true)
+        }
+    }
+
+    // MARK: Картинки
+
+    /// Загруженные картинки держим сами, чтобы не читать файл с диска на
+    /// каждой перерисовке строки.
+    private static var originals: [String: UIImage] = [:]
+    private static let rendered: NSCache<NSString, UIImage> = {
+        let cache = NSCache<NSString, UIImage>()
+        cache.countLimit = 200
+        return cache
+    }()
+
+    static func original(_ file: String) -> UIImage? {
+        if let image = originals[file] {
+            return image
+        }
+        guard let folder = try? LunagramSettings.lunagramFolder(), let image = UIImage(contentsOfFile: folder.appendingPathComponent(file).path) else {
+            return nil
+        }
+        originals[file] = image
+        return image
+    }
+
+    /// Где лежит картинка внутри значка — та же расчётка, что на ПК. Меньше
+    /// места — посередине; больше — сдвиг долей от лишка: -100 прижимает к
+    /// левому или верхнему краю, +100 — к другому.
+    static func placement(original: CGSize, target: CGSize, entry: Entry) -> CGRect {
+        guard original.width > 0.0, original.height > 0.0, target.width > 0.0, target.height > 0.0 else {
+            return .zero
+        }
+        let zoom = CGFloat(max(zoomMin, min(zoomMax, entry.zoom))) / 100.0
+        let fit = min(target.width / original.width, target.height / original.height) * zoom
+        let size = CGSize(width: max(1.0, original.width * fit), height: max(1.0, original.height * fit))
+        func place(_ extra: CGFloat, _ percent: Int) -> CGFloat {
+            if extra <= 0.0 {
+                return -extra / 2.0
+            }
+            return -(extra / 2.0 * (1.0 + CGFloat(percent) / 100.0))
+        }
+        return CGRect(origin: CGPoint(x: place(size.width - target.width, entry.offsetX), y: place(size.height - target.height, entry.offsetY)), size: size)
+    }
+
+    /// Своя картинка строки в размер её значка. nil — своей нет или свои
+    /// значки выключены: тогда рисуется обычный.
+    public static func image(for key: String, size: CGSize) -> UIImage? {
+        guard enabled, size.width > 0.0, size.height > 0.0, let entry = entry(for: key), let image = original(entry.file) else {
+            return nil
+        }
+        let cacheKey = "\(entry.file)|\(entry.zoom)|\(entry.offsetX)|\(entry.offsetY)|\(size.width)x\(size.height)" as NSString
+        if let cached = rendered.object(forKey: cacheKey) {
+            return cached
+        }
+        let rect = placement(original: image.size, target: size, entry: entry)
+        let format = UIGraphicsImageRendererFormat()
+        format.opaque = false
+        // Как у рамки: чётко на любом айфоне, а значок крошечный — память не жалко.
+        format.scale = 3.0
+        let result = UIGraphicsImageRenderer(size: size, format: format).image { _ in
+            UIBezierPath(rect: CGRect(origin: CGPoint(), size: size)).addClip()
+            image.draw(in: rect)
+        }
+        rendered.setObject(result, forKey: cacheKey)
+        return result
+    }
+
+    // MARK: Меню и окна
+
+    /// Цвета темы Telegram — чтобы окошки не выпадали из оформления.
+    public struct Palette {
+        public let isDark: Bool
+        public let background: UIColor
+        public let card: UIColor
+        public let text: UIColor
+        public let secondaryText: UIColor
+        public let accent: UIColor
+
+        public init(isDark: Bool, background: UIColor, card: UIColor, text: UIColor, secondaryText: UIColor, accent: UIColor) {
+            self.isDark = isDark
+            self.background = background
+            self.card = card
+            self.text = text
+            self.secondaryText = secondaryText
+            self.accent = accent
+        }
+    }
+
+    /// Долгое нажатие по строке — меню своего значка, как правый щелчок на
+    /// ПК. icon — обычный значок строки: его видно в образце, пока своей
+    /// картинки нет.
+    public static func showMenu(key rawKey: String, icon: UIImage?, iconSize: CGSize, from view: UIView, palette: Palette) {
+        let key = normalizedKey(rawKey)
+        guard enabled, !key.isEmpty, let presenter = findPresenter(for: view) else {
+            return
+        }
+        let sheet = UIAlertController(title: nil, message: nil, preferredStyle: .actionSheet)
+        let choose = {
+            chooseFile(key: key, icon: icon, iconSize: iconSize, palette: palette, presenter: presenter, openAdjust: true)
+        }
+        if hasCustom(key) {
+            sheet.addAction(UIAlertAction(title: "Подогнать значок", style: .default, handler: { _ in
+                DispatchQueue.main.async {
+                    showAdjust(key: key, icon: icon, iconSize: iconSize, palette: palette, presenter: presenter)
+                }
+            }))
+            sheet.addAction(UIAlertAction(title: "Другая картинка", style: .default, handler: { _ in
+                DispatchQueue.main.async {
+                    choose()
+                }
+            }))
+            sheet.addAction(UIAlertAction(title: "Вернуть обычный", style: .destructive, handler: { _ in
+                reset(key)
+            }))
+        } else {
+            sheet.addAction(UIAlertAction(title: "Свой значок", style: .default, handler: { _ in
+                DispatchQueue.main.async {
+                    choose()
+                }
+            }))
+        }
+        sheet.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: nil))
+        if let popover = sheet.popoverPresentationController {
+            popover.sourceView = view
+            popover.sourceRect = view.bounds
+        }
+        sheet.overrideUserInterfaceStyle = palette.isDark ? .dark : .light
+        sheet.view.tintColor = palette.accent
+        presenter.present(sheet, animated: true, completion: nil)
+    }
+
+    /// Экран, с которого показывать окошки: ближайший по цепочке ответчиков,
+    /// а поверх него — то, что уже открыто.
+    private static func findPresenter(for view: UIView) -> UIViewController? {
+        var responder: UIResponder? = view
+        var found: UIViewController?
+        while let current = responder {
+            if let controller = current as? UIViewController {
+                found = controller
+                break
+            }
+            responder = current.next
+        }
+        if found == nil {
+            found = view.window?.rootViewController
+        }
+        return found.map { topmost($0) }
+    }
+
+    private static func topmost(_ controller: UIViewController) -> UIViewController {
+        var result = controller
+        while let presented = result.presentedViewController, !presented.isBeingDismissed {
+            result = presented
+        }
+        return result
+    }
+
+    private static var pickerHolder: AnyObject?
+
+    /// Выбор картинки из галереи. openAdjust — после выбора открыть окно
+    /// подгонки; из самого окна подгонки не нужно: оно уже открыто и само
+    /// покажет новую картинку.
+    static func chooseFile(key: String, icon: UIImage?, iconSize: CGSize, palette: Palette, presenter: UIViewController, openAdjust: Bool) {
+        guard #available(iOS 14.0, *) else {
+            return
+        }
+        var configuration = PHPickerConfiguration()
+        configuration.filter = PHPickerFilter.images
+        configuration.selectionLimit = 1
+        let picker = PHPickerViewController(configuration: configuration)
+        let delegate = LunagramIconPickerDelegate(key: key, completion: { imported in
+            pickerHolder = nil
+            let top = topmost(presenter)
+            if !imported {
+                let alert = UIAlertController(title: nil, message: "Картинка не читается. Нужен PNG, JPG, HEIC или GIF.", preferredStyle: .alert)
+                alert.addAction(UIAlertAction(title: "Понятно", style: .default, handler: nil))
+                alert.overrideUserInterfaceStyle = palette.isDark ? .dark : .light
+                top.present(alert, animated: true, completion: nil)
+                return
+            }
+            if openAdjust {
+                showAdjust(key: key, icon: icon, iconSize: iconSize, palette: palette, presenter: top)
+            }
+        })
+        pickerHolder = delegate
+        picker.delegate = delegate
+        picker.overrideUserInterfaceStyle = palette.isDark ? .dark : .light
+        topmost(presenter).present(picker, animated: true, completion: nil)
+    }
+
+    static func showAdjust(key: String, icon: UIImage?, iconSize: CGSize, palette: Palette, presenter: UIViewController) {
+        let controller = LunagramIconAdjustController(key: key, icon: icon, iconSize: iconSize, palette: palette)
+        controller.chooseOther = { [weak controller] in
+            guard let controller = controller else {
+                return
+            }
+            chooseFile(key: key, icon: icon, iconSize: iconSize, palette: palette, presenter: controller, openAdjust: false)
+        }
+        let navigation = UINavigationController(rootViewController: controller)
+        // Окно закрывается только «Готово»: иначе движение пальцем по образцу
+        // вниз закрывало бы его вместо сдвига картинки.
+        navigation.isModalInPresentation = true
+        navigation.overrideUserInterfaceStyle = palette.isDark ? .dark : .light
+        let appearance = UINavigationBarAppearance()
+        appearance.configureWithOpaqueBackground()
+        appearance.backgroundColor = palette.background
+        appearance.titleTextAttributes = [.foregroundColor: palette.text]
+        appearance.shadowColor = .clear
+        navigation.navigationBar.standardAppearance = appearance
+        navigation.navigationBar.scrollEdgeAppearance = appearance
+        navigation.navigationBar.compactAppearance = appearance
+        navigation.navigationBar.tintColor = palette.accent
+        topmost(presenter).present(navigation, animated: true, completion: nil)
+    }
+}
+
+/// Выбор картинки для значка. Файл из галереи временный — сохраняем его
+/// прямо в ответе, а окно выбора закрываем раньше: так следом можно сразу
+/// показать окно подгонки.
+@available(iOS 14.0, *)
+private final class LunagramIconPickerDelegate: NSObject, PHPickerViewControllerDelegate {
+    private let key: String
+    private let completion: (Bool) -> Void
+
+    init(key: String, completion: @escaping (Bool) -> Void) {
+        self.key = key
+        self.completion = completion
+    }
+
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        let key = self.key
+        let completion = self.completion
+        guard let provider = results.first?.itemProvider else {
+            picker.dismiss(animated: true, completion: nil)
+            // Ничего не выбрали — просто закрыли, это не ошибка.
+            LunagramSettingIcons.releasePicker()
+            return
+        }
+        picker.dismiss(animated: true, completion: {
+            let imageType = "public.image"
+            guard provider.hasItemConformingToTypeIdentifier(imageType) else {
+                completion(false)
+                return
+            }
+            provider.loadFileRepresentation(forTypeIdentifier: imageType) { url, _ in
+                guard let url = url else {
+                    DispatchQueue.main.async {
+                        completion(false)
+                    }
+                    return
+                }
+                LunagramSettingIcons.install(from: url, key: key, completion: completion)
+            }
+        })
+    }
+}
+
+extension LunagramSettingIcons {
+    fileprivate static func releasePicker() {
+        pickerHolder = nil
+    }
+}
+
+/// Крупный образец значка: картинку двигают пальцем и приближают щипком —
+/// как мышью и колесом на ПК.
+private final class LunagramIconCanvasView: UIView {
+    var key: String = ""
+    var palette: LunagramSettingIcons.Palette?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isOpaque = false
+        self.contentMode = .redraw
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func draw(_ rect: CGRect) {
+        let bounds = self.bounds
+        let shape = UIBezierPath(roundedRect: bounds, cornerRadius: 12.0)
+        (self.palette?.card ?? UIColor.secondarySystemBackground).setFill()
+        shape.fill()
+        if let entry = LunagramSettingIcons.entry(for: self.key), let image = LunagramSettingIcons.original(entry.file) {
+            let place = LunagramSettingIcons.placement(original: image.size, target: bounds.size, entry: entry)
+            UIGraphicsGetCurrentContext()?.saveGState()
+            shape.addClip()
+            image.draw(in: place)
+            UIGraphicsGetCurrentContext()?.restoreGState()
+        } else {
+            let text = "нет картинки" as NSString
+            let attributes: [NSAttributedString.Key: Any] = [
+                .font: UIFont.systemFont(ofSize: 15.0),
+                .foregroundColor: self.palette?.secondaryText ?? UIColor.secondaryLabel
+            ]
+            let size = text.size(withAttributes: attributes)
+            text.draw(at: CGPoint(x: (bounds.width - size.width) / 2.0, y: (bounds.height - size.height) / 2.0), withAttributes: attributes)
+        }
+    }
+}
+
+/// Окно подгонки — как на ПК: крупный образец, рядом та же строка в
+/// настоящем размере, «Приближение», «Другая картинка», подсказка; вверху
+/// «Вернуть обычный» и «Готово».
+private final class LunagramIconAdjustController: UIViewController, UIGestureRecognizerDelegate {
+    private let key: String
+    private let icon: UIImage?
+    private let iconSize: CGSize
+    private let palette: LunagramSettingIcons.Palette
+
+    private let canvas = LunagramIconCanvasView()
+    private let rowIconView = UIImageView()
+    private let rowLabel = UILabel()
+    private let zoomLabel = UILabel()
+    private let slider = UISlider()
+    private let otherButton = UIButton(type: .system)
+    private let infoLabel = UILabel()
+
+    private var observer: NSObjectProtocol?
