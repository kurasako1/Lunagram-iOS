+    init(key: String, icon: UIImage?, iconSize: CGSize, palette: LunagramSettingIcons.Palette) {
+        self.key = key
+        self.icon = icon
+        self.iconSize = iconSize
+        self.palette = palette
+        super.init(nibName: nil, bundle: nil)
+        self.title = "Свой значок"
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = self.palette.background
+
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: "Вернуть обычный", style: .plain, target: self, action: #selector(self.resetPressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "Готово", style: .done, target: self, action: #selector(self.donePressed))
+
+        self.canvas.key = self.key
+        self.canvas.palette = self.palette
+        self.view.addSubview(self.canvas)
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.canvasPanned(_:)))
+        pan.delegate = self
+        self.canvas.addGestureRecognizer(pan)
+        let pinch = UIPinchGestureRecognizer(target: self, action: #selector(self.canvasPinched(_:)))
+        pinch.delegate = self
+        self.canvas.addGestureRecognizer(pinch)
+
+        self.rowIconView.contentMode = .center
+        self.view.addSubview(self.rowIconView)
+        self.rowLabel.font = UIFont.systemFont(ofSize: 17.0)
+        self.rowLabel.textColor = self.palette.text
+        self.rowLabel.text = self.key
+        self.rowLabel.lineBreakMode = .byTruncatingTail
+        self.view.addSubview(self.rowLabel)
+
+        self.zoomLabel.font = UIFont.systemFont(ofSize: 13.0)
+        self.zoomLabel.textColor = self.palette.secondaryText
+        self.zoomLabel.text = "ПРИБЛИЖЕНИЕ"
+        self.view.addSubview(self.zoomLabel)
+
+        self.slider.minimumValue = Float(LunagramSettingIcons.zoomMin)
+        self.slider.maximumValue = Float(LunagramSettingIcons.zoomMax)
+        self.slider.minimumTrackTintColor = self.palette.accent
