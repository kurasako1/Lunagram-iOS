+        self.view.addSubview(self.slider)
+
+        self.otherButton.setTitle("Другая картинка", for: .normal)
+        self.otherButton.setTitleColor(self.palette.accent, for: .normal)
+        self.otherButton.titleLabel?.font = UIFont.systemFont(ofSize: 17.0)
+        self.otherButton.contentHorizontalAlignment = .left
+        self.otherButton.addTarget(self, action: #selector(self.otherPressed), for: .touchUpInside)
+        self.view.addSubview(self.otherButton)
+
+        self.infoLabel.font = UIFont.systemFont(ofSize: 13.0)
+        self.infoLabel.textColor = self.palette.secondaryText
+        self.infoLabel.numberOfLines = 0
+        self.infoLabel.text = "Двигай картинку пальцем, чтобы выбрать кусок, щипок приближает. Картинка ложится как есть: PNG с прозрачным фоном смотрится как настоящий значок. Гифка встаёт первым кадром. Выключить все свои значки разом можно в «Оформлении» Lunagram."
