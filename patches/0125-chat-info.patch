+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramChatInfo.swift
@@ -0,0 +1,147 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TelegramStringFormatting
+import AccountContext
+import PresentationDataUtils
+import Lunagram
+
+// Lunagram: «Что известно» — короткая справка о переписке.
+//
+// Задумка из плагина «Инфа о чате» для Android-форка; кода оттуда не брал.
+// Одну его строку не беру намеренно: «общее количество сообщений» он показывает
+// из поля `pts`, а это не число сообщений, а номер обновления. Неверное число
+// хуже отсутствующего.
+//
+// Всё, что здесь показано, телефон уже знает: никаких запросов к серверу ради
+// этой справки не делаем.
+
+/// Показать справку о переписке.
+public func lunagramShowChatInfo(context: AccountContext, peerId: EnginePeer.Id, present: @escaping (ViewController) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let _ = (context.engine.data.get(
+        TelegramEngine.EngineData.Item.Peer.Peer(id: peerId),
+        TelegramEngine.EngineData.Item.Peer.Presence(id: peerId),
+        TelegramEngine.EngineData.Item.Peer.ParticipantCount(id: peerId)
+    )
+    |> deliverOnMainQueue).startStandalone(next: { peer, presence, participantCount in
+        guard let peer = peer else {
+            present(textAlertController(context: context, title: nil, text: "Об этой переписке ничего не известно.", actions: [
+                TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+            ]))
+            return
+        }
+        let text = lunagramChatInfoText(
+            context: context,
+            peer: peer,
+            presence: presence,
+            participantCount: participantCount,
+            presentationData: presentationData
+        )
+        present(textAlertController(context: context, title: "Что известно", text: text, actions: [
+            TextAlertAction(type: .genericAction, title: "Скопировать всё", action: {
+                UIPasteboard.general.string = text
+            }),
+            TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+        ]))
+    })
+}
+
+private func lunagramYesNo(_ value: Bool) -> String {
+    return value ? "да" : "нет"
+}
+
+private func lunagramChatInfoText(
+    context: AccountContext,
+    peer: EnginePeer,
+    presence: EnginePeer.Presence?,
+    participantCount: Int?,
+    presentationData: PresentationData
+) -> String {
+    var lines: [String] = []
+
+    let kind: String
+    switch peer {
+    case let .user(user):
+        kind = user.botInfo != nil ? "Бот" : "Личный чат"
+    case .secretChat:
+        kind = "Секретный чат"
+    case .community:
+        kind = "Сообщество"
+    case .legacyGroup:
+        kind = "Группа"
+    case let .channel(channel):
+        switch channel.info {
+        case .broadcast:
+            kind = "Канал"
+        case .group:
+            kind = "Группа"
+        }
+    }
+    lines.append("Тип: " + kind)
+    lines.append("Номер: \(peer.id.id._internalGetInt64Value())")
+    lines.append("Ник: " + (peer.addressName.flatMap({ "@" + $0 }) ?? "нет"))
+
+    if let presence = presence, case .user = peer {
+        let timestamp = Int32(Date().timeIntervalSince1970)
+        let (status, _) = stringAndActivityForUserPresence(
+            strings: presentationData.strings,
+            dateTimeFormat: presentationData.dateTimeFormat,
+            presence: presence,
+            relativeTo: timestamp
+        )
+        lines.append("Был в сети: " + status)
+    }
+
+    lines.append("")
+    lines.append("Проверен: " + lunagramYesNo(peer.isVerified))
+    lines.append("Скам: " + lunagramYesNo(peer.isScam))
+    lines.append("Фейк: " + lunagramYesNo(peer.isFake))
+    let restriction = peer._asPeer().restrictionText(platform: "ios", contentSettings: context.currentContentSettings.with { $0 })
+    lines.append("Ограничен: " + (restriction.flatMap({ "да — " + $0 }) ?? "нет"))
+
+    switch peer {
+    case let .channel(channel):
+        lines.append("")
+        lines.append("Участников: " + (participantCount.flatMap({ "\($0)" }) ?? "неизвестно"))
+        lines.append("Я создатель: " + lunagramYesNo(channel.flags.contains(.isCreator)))
+        if let rights = channel.adminRights {
+            var granted: [String] = []
+            if rights.rights.contains(.canPostMessages) {
+                granted.append("писать")
+            }
+            if rights.rights.contains(.canDeleteMessages) {
+                granted.append("удалять")
+            }
+            if rights.rights.contains(.canBanUsers) {
+                granted.append("выгонять")
+            }
+            if rights.rights.contains(.canInviteUsers) {
+                granted.append("звать")
+            }
+            if rights.rights.contains(.canChangeInfo) {
+                granted.append("менять описание")
+            }
+            lines.append("Мои права: " + (granted.isEmpty ? "есть, но пустые" : granted.joined(separator: ", ")))
+        } else if channel.flags.contains(.isCreator) {
+            lines.append("Мои права: все")
+        } else {
+            lines.append("Мои права: обычный участник")
+        }
+    case let .legacyGroup(group):
+        lines.append("")
+        lines.append("Участников: " + (participantCount.flatMap({ "\($0)" }) ?? "\(group.participantCount)"))
+        var isCreator = false
+        if case .creator = group.role {
+            isCreator = true
+        }
+        lines.append("Я создатель: " + lunagramYesNo(isCreator))
+    default:
+        break
+    }
+
+    return lines.joined(separator: "\n")
+}
