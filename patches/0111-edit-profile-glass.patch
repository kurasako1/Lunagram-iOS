@@ -0,0 +1,90 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import TelegramPresentationData
+import Lunagram
+
+// Lunagram: матовые скруглённые поля на экране «Изменить профиль».
+//
+// Родные поля там — сплошная заливка во всю ширину, и на айфоне без единого
+// скругления. Так вышло не по недосмотру: скругление Telegram рисует
+// картинкой-маской и только тогда, когда у блока есть отступ от краёв
+// экрана, а на айфоне отступ нулевой. Под обложкой профиля три сплошные
+// полосы выглядят заплаткой, о чём хозяин и сказал.
+//
+// Делаем как у остальных панелей: вместо заливки — матовое стекло, у краёв
+// блока — скругление (сверху у первого поля, снизу у последнего). Ширину и
+// положение не трогаем: за них отвечает сам Telegram, и лезть туда значит
+// ломать его разметку.
+
+/// Стекло под полем. Помнит, под какую тему сделано: пересобирать его на
+/// каждую раскладку дорого, а тема меняется редко.
+private final class LunagramEditFieldBlurView: UIVisualEffectView {
+    var appliedDark: Bool?
+}
+
+enum LunagramEditFieldLook {
+    static var isActive: Bool {
+        return LunagramSettings.editProfileGlass
+    }
+
+    /// Зовётся из раскладки поля, уже после того, как ему поставили рамку.
+    static func update(
+        background: ASDisplayNode,
+        separator: ASDisplayNode,
+        theme: PresentationTheme,
+        roundTop: Bool,
+        roundBottom: Bool
+    ) {
+        var existing: LunagramEditFieldBlurView?
+        for subview in background.view.subviews {
+            if let blur = subview as? LunagramEditFieldBlurView {
+                existing = blur
+                break
+            }
+        }
+
+        guard self.isActive else {
+            existing?.removeFromSuperview()
+            background.backgroundColor = theme.list.itemBlocksBackgroundColor
+            background.cornerRadius = 0.0
+            separator.alpha = 1.0
+            return
+        }
+
+        // Заливку убираем совсем: цвет поверх стекла съел бы прозрачность.
+        background.backgroundColor = .clear
+        background.clipsToBounds = true
+        background.cornerRadius = 12.0
+        background.layer.cornerCurve = .continuous
+        var corners: CACornerMask = []
+        if roundTop {
+            corners.insert(.layerMinXMinYCorner)
+            corners.insert(.layerMaxXMinYCorner)
+        }
+        if roundBottom {
+            corners.insert(.layerMinXMaxYCorner)
+            corners.insert(.layerMaxXMaxYCorner)
+        }
+        background.layer.maskedCorners = corners
+
+        let dark = theme.overallDarkAppearance
+        let blur: LunagramEditFieldBlurView
+        if let existing = existing {
+            blur = existing
+        } else {
+            blur = LunagramEditFieldBlurView(effect: nil)
+            blur.isUserInteractionEnabled = false
+            background.view.insertSubview(blur, at: 0)
+        }
+        if blur.appliedDark != dark {
+            blur.appliedDark = dark
+            blur.effect = UIBlurEffect(style: dark ? .systemThinMaterialDark : .systemThinMaterialLight)
+        }
+        blur.frame = background.bounds
+
+        // Черта между полями поверх стекла слишком резкая — приглушаем.
+        separator.alpha = 0.4
+    }
+}
