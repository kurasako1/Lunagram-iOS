diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramEditFieldLook.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramEditFieldLook.swift
