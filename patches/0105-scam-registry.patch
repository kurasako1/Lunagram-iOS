--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramScamRegistryLoader.swift
@@ -0,0 +1,119 @@
+import AccountContext
+import Foundation
+import Lunagram
+import SwiftSignalKit
+import TelegramCore
+
+// Lunagram: чтение реестра-канала @GID_ScamBase.
+//
+// Ходим только к самому Telegram и только за открытым каналом. Наружу не
+// уходит ничего.
+//
+// Читаем не всю историю подряд, а поиском по слову «ID» внутри канала.
+// Так задумано: в реестре номер всегда пишут после этого слова, а
+// сообщений в канале тысячи — перебирать их целиком значило бы гонять
+// сотни заявок ради того же самого. Заодно не требуется подписка: поиск
+// по открытому каналу работает и без неё.
+//
+// Делаем это раз в месяц: список меняется не каждый день.
+
+private final class LunagramScamRegistryLoader {
+    static let shared = LunagramScamRegistryLoader()
+
+    private var isLoading = false
+    private var disposable: Disposable?
+
+    func load(context: AccountContext, force: Bool, done: @escaping (Int?) -> Void) {
+        if self.isLoading {
+            done(nil)
+            return
+        }
+        if !force && !LunagramScamRegistry.needsRefresh {
+            done(LunagramScamRegistry.count)
+            return
+        }
+        self.isLoading = true
+
+        self.disposable = (context.engine.peers.resolvePeerByName(name: LunagramScamRegistry.channelName, referrer: nil)
+        |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+            switch result {
+            case let .result(peer):
+                return .single(peer)
+            case .progress:
+                return .complete()
+            }
+        }
+        |> take(1)
+        |> mapToSignal { peer -> Signal<Set<Int64>, NoError> in
+            guard let peer else {
+                return .single([])
+            }
+            return lunagramScamRegistryScan(context: context, peer: peer)
+        }
+        |> deliverOnMainQueue).startStrict(next: { [weak self] ids in
+            self?.isLoading = false
+            if ids.isEmpty {
+                done(nil)
+            } else {
+                LunagramScamRegistry.setIds(ids)
+                done(ids.count)
+            }
+        }, completed: { [weak self] in
+            self?.isLoading = false
+        })
+    }
+}
+
+/// Пройти канал поиском и собрать номера.
+private func lunagramScamRegistryScan(context: AccountContext, peer: EnginePeer) -> Signal<Set<Int64>, NoError> {
+    return Signal { subscriber in
+        let disposable = MetaDisposable()
+        var collected = Set<Int64>()
+        var scanned = 0
+
+        func step(state: SearchMessagesState?) {
+            let signal = context.engine.messages.searchMessages(
+                location: .peer(peerId: peer.id, fromId: nil, tags: nil, reactions: nil, threadId: nil, minDate: nil, maxDate: nil),
+                query: "ID",
+                state: state,
+                limit: 100
+            )
+            |> take(1)
+            |> deliverOnMainQueue
+
+            disposable.set(signal.startStrict(next: { result, nextState in
+                let messages = result.messages
+                for message in messages {
+                    let text = message.text
+                    if text.isEmpty {
+                        continue
+                    }
+                    for id in LunagramScamRegistry.parseIds(from: text) {
+                        collected.insert(id)
+                    }
+                }
+                scanned += messages.count
+                if messages.isEmpty || scanned >= LunagramScamRegistry.maxMessages || result.completed {
+                    subscriber.putNext(collected)
+                    subscriber.putCompletion()
+                    return
+                }
+                step(state: nextState)
+            }))
+        }
+
+        step(state: nil)
+
+        return disposable
+    }
+}
+
+/// Перечитать реестр. Зовут при запуске (раз в месяц) и кнопкой в
+/// настройках.
+public func lunagramRefreshScamRegistry(context: AccountContext, force: Bool, done: @escaping (Int?) -> Void = { _ in }) {
+    guard LunagramScamRegistry.enabled else {
+        done(nil)
+        return
+    }
+    LunagramScamRegistryLoader.shared.load(context: context, force: force, done: done)
+}
