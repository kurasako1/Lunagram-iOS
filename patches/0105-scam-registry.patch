@@ -0,0 +1,126 @@
+import Foundation
+
+/// Упоминания из открытого реестра-канала.
+///
+/// Задумка из Scam Base Writer (0patient v Hoffman). Канал `@GID_ScamBase`
+/// ведёт список номеров, за которыми, по мнению его хозяев, стоят
+/// мошенники. Плагин по этому списку вешает в профиле красную строку
+/// «В SCAM БАЗЕ».
+///
+/// Формулировку я поменял намеренно, и это не придирка к словам. Список
+/// чужой, проверить его нечем, а ошибка в нём означает клеймо на живом
+/// человеке — причём показанное так, будто это сказал сам Telegram.
+/// Поэтому строка говорит ровно то, что мы знаем: **человек упомянут в
+/// таком-то канале**, вот ссылка, смотри сам. Это честно и так же
+/// полезно: увидев строку, в сделку не полезешь.
+///
+/// В сеть ходим только к самому Telegram — читаем открытый канал. Наружу
+/// не уходит ничего.
+public enum LunagramScamRegistry {
+    /// Канал-источник. Меняться ему незачем: список ведут там.
+    public static let channelName = "GID_ScamBase"
+    public static let channelLink = "https://t.me/GID_ScamBase"
+
+    /// Как часто перечитывать канал сами. Список меняется не каждый день,
+    /// а чтение — дело на сотни заявок.
+    public static let refreshInterval: Double = 30 * 24 * 60 * 60
+
+    /// Сколько сообщений канала просматриваем за один заход.
+    public static let maxMessages = 5000
+
+    private static let enabledKey = "lunagram.scamRegistry.enabled"
+    private static let idsKey = "lunagram.scamRegistry.ids"
+    private static let updatedKey = "lunagram.scamRegistry.updated"
+
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    /// Показывать строку в профиле.
+    public static var enabled: Bool {
+        get {
+            guard defaults.object(forKey: enabledKey) != nil else {
+                return false
+            }
+            return defaults.bool(forKey: enabledKey)
+        }
+        set {
+            defaults.set(newValue, forKey: enabledKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Когда список читали в последний раз.
+    public static var updatedAt: Double {
+        get { return defaults.double(forKey: updatedKey) }
+        set { defaults.set(newValue, forKey: updatedKey) }
+    }
+
+    public static var needsRefresh: Bool {
+        return Date().timeIntervalSince1970 - self.updatedAt > self.refreshInterval
+    }
+
+    // Номера храним одной строкой через запятую и разбираем один раз:
+    // их тысячи, и перебирать строку на каждый открытый профиль — заметно.
+    private static var cacheSource: String?
+    private static var cache: Set<Int64>?
+
+    public static var ids: Set<Int64> {
+        let source = defaults.string(forKey: idsKey) ?? ""
+        if let cache, cacheSource == source {
+            return cache
+        }
+        var result = Set<Int64>()
+        for part in source.split(separator: ",") {
+            if let value = Int64(part) {
+                result.insert(value)
+            }
+        }
+        cacheSource = source
+        cache = result
+        return result
+    }
+
+    public static func setIds(_ ids: Set<Int64>) {
+        defaults.set(ids.map { String($0) }.joined(separator: ","), forKey: idsKey)
+        self.updatedAt = Date().timeIntervalSince1970
+        cacheSource = nil
+        cache = nil
+        LunagramSettings.changed()
+    }
+
+    public static var count: Int {
+        return self.ids.count
+    }
+
+    /// Упомянут ли этот номер в реестре.
+    public static func mentions(_ peerId: Int64) -> Bool {
+        guard self.enabled else {
+            return false
+        }
+        return self.ids.contains(peerId)
+    }
+
+    /// Номера из текста сообщений канала.
+    ///
+    /// В канале пишут по-разному, но номер всегда идёт после слова «ID».
+    /// Берём только такие: просто длинное число в тексте — это чаще всего
+    /// сумма или дата, а не человек.
+    public static func parseIds(from text: String) -> [Int64] {
+        var result: [Int64] = []
+        let pattern = "(?<![A-Za-zА-Яа-яЁё])ID\\s+(\\d{6,12})(?![0-9])"
+        guard let regex = try? NSRegularExpression(pattern: pattern, options: []) else {
+            return result
+        }
+        let range = NSRange(text.startIndex ..< text.endIndex, in: text)
+        regex.enumerateMatches(in: text, options: [], range: range) { match, _, _ in
+            guard let match, match.numberOfRanges > 1,
+                  let digits = Range(match.range(at: 1), in: text),
+                  let value = Int64(text[digits]) else {
+                return
+            }
+            result.append(value)
+        }
+        return result
+    }
+}
