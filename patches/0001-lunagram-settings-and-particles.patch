--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramSettingsController.swift
@@ -0,0 +1,124 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Раздел настроек Lunagram.
+//
+// Сделан по образцу экрана Apple Watch из SettingsUI — самого маленького
+// экрана-списка у Telegram. Тексты пока прямо здесь, по-русски: переводить
+// на другие языки будем, когда разделов станет больше одного.
+
+private final class LunagramSettingsControllerArguments {
+    let toggleParticles: (Bool) -> Void
+
+    init(toggleParticles: @escaping (Bool) -> Void) {
+        self.toggleParticles = toggleParticles
+    }
+}
+
+private enum LunagramSettingsSection: Int32 {
+    case appearance
+}
+
+private enum LunagramSettingsEntry: ItemListNodeEntry {
+    case appearanceHeader(String)
+    case particles(String, Bool)
+    case particlesInfo(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .appearanceHeader, .particles, .particlesInfo:
+            return LunagramSettingsSection.appearance.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .appearanceHeader:
+            return 0
+        case .particles:
+            return 1
+        case .particlesInfo:
+            return 2
+        }
+    }
+
+    static func ==(lhs: LunagramSettingsEntry, rhs: LunagramSettingsEntry) -> Bool {
+        switch lhs {
+        case let .appearanceHeader(lhsText):
+            if case let .appearanceHeader(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        case let .particles(lhsText, lhsValue):
+            if case let .particles(rhsText, rhsValue) = rhs, lhsText == rhsText, lhsValue == rhsValue {
+                return true
+            } else {
+                return false
+            }
+        case let .particlesInfo(lhsText):
+            if case let .particlesInfo(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        }
+    }
+
+    static func <(lhs: LunagramSettingsEntry, rhs: LunagramSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramSettingsControllerArguments
+        switch self {
+        case let .appearanceHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .particles(text, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: text, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggleParticles(value)
+            })
+        case let .particlesInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private func lunagramSettingsEntries(particles: Bool) -> [LunagramSettingsEntry] {
+    return [
+        .appearanceHeader("ОФОРМЛЕНИЕ"),
+        .particles("Частицы в переписке", particles),
+        .particlesInfo("Снежинки медленно падают поверх фона переписки. Рисует их сама система, поэтому батарею они почти не тратят.")
+    ]
+}
+
+func lunagramSettingsController(context: AccountContext) -> ViewController {
+    // Значение держим в обещании, а не читаем из настроек при каждой
+    // перерисовке: так экран обновляется сразу, как только щёлкнули
+    // выключатель, и не ждёт никаких уведомлений.
+    let particlesPromise = ValuePromise<Bool>(LunagramSettings.particlesEnabled, ignoreRepeated: true)
+
+    let arguments = LunagramSettingsControllerArguments(toggleParticles: { value in
+        LunagramSettings.particlesEnabled = value
+        particlesPromise.set(value)
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, particlesPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, particles -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Lunagram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: lunagramSettingsEntries(particles: particles), style: .blocks, animateChanges: false)
+
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    return controller
+}
