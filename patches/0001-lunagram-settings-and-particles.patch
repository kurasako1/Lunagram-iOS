diff --git a/submodules/Lunagram/BUILD b/submodules/Lunagram/BUILD
new file mode 100644
index 00000000..8c2b11f7
--- /dev/null
+++ b/submodules/Lunagram/BUILD
@@ -0,0 +1,19 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Всё своё, что Lunagram добавляет к Telegram. Модуль нарочно ни от чего
+# телеграмовского не зависит — только от системных библиотек, — чтобы его
+# могла подключить любая часть приложения, даже самая низкоуровневая,
+# вроде фона переписки.
+swift_library(
+    name = "Lunagram",
+    module_name = "Lunagram",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/submodules/Lunagram/Sources/LunagramParticlesLayer.swift b/submodules/Lunagram/Sources/LunagramParticlesLayer.swift
new file mode 100644
index 00000000..82da4c3d
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramParticlesLayer.swift
@@ -0,0 +1,97 @@
+import UIKit
+import QuartzCore
+
+/// Частицы поверх фона переписки.
+///
+/// Рисует их системный CAEmitterLayer — сам, на видеокарте, без таймеров и
+/// перерисовок с нашей стороны. Поэтому снег почти ничего не стоит даже на
+/// старых телефонах, и батарея от него не садится.
+public final class LunagramParticlesLayer: CAEmitterLayer {
+    public override init() {
+        super.init()
+        self.emitterShape = .line
+        self.emitterMode = .outline
+        self.emitterCells = [LunagramParticlesLayer.makeCell()]
+        self.applyDensity(LunagramSettings.particlesDensity)
+    }
+
+    // Нужен самой системе: из него она делает копии слоя для анимаций.
+    public override init(layer: Any) {
+        super.init(layer: layer)
+    }
+
+    // Класс публичный, поэтому и этот обязательный конструктор обязан быть
+    // публичным — иначе Swift не соберёт. Так же сделано у самого Telegram
+    // в SimpleLayer.
+    required public init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// Подгоняет слой под размер фона. Частицы рождаются вдоль верхнего края,
+    /// чуть выше него, — чтобы не возникали из воздуха посреди экрана.
+    public func updateSize(_ size: CGSize) {
+        // Отдельный слой система по умолчанию двигает плавно, и при повороте
+        // экрана снег уезжал бы на новое место секунду. Отключаем это.
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.frame = CGRect(origin: CGPoint(), size: size)
+        self.emitterPosition = CGPoint(x: size.width / 2.0, y: -10.0)
+        self.emitterSize = CGSize(width: size.width, height: 1.0)
+        CATransaction.commit()
+    }
+
+    /// Густота от 1 до 100 переводится в множитель рождения частиц.
+    public func applyDensity(_ density: Int) {
+        self.birthRate = Float(density) / 20.0
+    }
+
+    private static func makeCell() -> CAEmitterCell {
+        let cell = CAEmitterCell()
+        cell.contents = makeDot().cgImage
+        cell.birthRate = 4.0
+        cell.lifetime = 14.0
+        cell.velocity = 40.0
+        cell.velocityRange = 20.0
+        // Вниз, с небольшим разбросом в стороны, и лёгкое ускорение вниз —
+        // как у настоящего снега, который не падает строго по линейке.
+        cell.emissionLongitude = CGFloat.pi
+        cell.emissionRange = CGFloat.pi / 8.0
+        cell.yAcceleration = 6.0
+        cell.scale = 0.12
+        cell.scaleRange = 0.08
+        cell.alphaRange = 0.4
+        cell.alphaSpeed = -0.05
+        cell.spin = 0.3
+        cell.spinRange = 0.6
+        return cell
+    }
+
+    /// Мягкая белая точка: плотная в центре, прозрачная по краям.
+    private static func makeDot() -> UIImage {
+        let size = CGSize(width: 32.0, height: 32.0)
+        let renderer = UIGraphicsImageRenderer(size: size)
+        return renderer.image { context in
+            let center = CGPoint(x: size.width / 2.0, y: size.height / 2.0)
+            let colors = [
+                UIColor.white.cgColor,
+                UIColor.white.withAlphaComponent(0.0).cgColor
+            ] as CFArray
+            let locations: [CGFloat] = [0.0, 1.0]
+            guard let gradient = CGGradient(
+                colorsSpace: CGColorSpaceCreateDeviceRGB(),
+                colors: colors,
+                locations: locations
+            ) else {
+                return
+            }
+            context.cgContext.drawRadialGradient(
+                gradient,
+                startCenter: center,
+                startRadius: 0.0,
+                endCenter: center,
+                endRadius: size.width / 2.0,
+                options: []
+            )
+        }
+    }
+}
diff --git a/submodules/Lunagram/Sources/LunagramSettings.swift b/submodules/Lunagram/Sources/LunagramSettings.swift
new file mode 100644
index 00000000..99385b66
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramSettings.swift
@@ -0,0 +1,54 @@
+import Foundation
+
+/// Настройки Lunagram.
+///
+/// Храним их в UserDefaults, а не в базе Telegram. База — их, и лезть в неё
+/// ради своих галочек значит рисковать поломкой при каждом их обновлении.
+/// Так наши настройки живут отдельно и никому не мешают.
+public final class LunagramSettings {
+    /// Рассылается при любой смене настройки. Кто рисует что-то наше,
+    /// подписывается на него и перерисовывается сам.
+    public static let didChangeNotification = Notification.Name("LunagramSettingsDidChange")
+
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let particlesEnabled = "lunagram.particles.enabled"
+        static let particlesDensity = "lunagram.particles.density"
+    }
+
+    /// Густота частиц по умолчанию — если человек её ещё не трогал.
+    private static let defaultParticlesDensity = 40
+
+    /// Частицы в переписке: снежинки поверх фона.
+    public static var particlesEnabled: Bool {
+        get {
+            return defaults.bool(forKey: Key.particlesEnabled)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.particlesEnabled)
+            changed()
+        }
+    }
+
+    /// Густота частиц, от 1 до 100.
+    public static var particlesDensity: Int {
+        get {
+            // Незаданный ключ UserDefaults отдаёт нулём, а ноль нам не годится
+            // как значение: у ползунка нижняя граница единица.
+            let value = defaults.integer(forKey: Key.particlesDensity)
+            if value == 0 {
+                return defaultParticlesDensity
+            }
+            return max(1, min(100, value))
+        }
+        set {
+            defaults.set(max(1, min(100, newValue)), forKey: Key.particlesDensity)
+            changed()
+        }
+    }
+
+    private static func changed() {
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
