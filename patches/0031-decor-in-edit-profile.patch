+/// Отдельный экран из заданных разделов, со своим свежим состоянием. Нужен,
+/// чтобы открывать декор прямо из «Изменить профиль», как на ПК, а не только
+/// из настроек Lunagram.
+private func lunagramSectionsScreen(context: AccountContext, title: String, sections: [LunagramSettingsSection]) -> ViewController {
+    let shared = LunagramSharedState()
+    let arguments = lunagramMakeArguments(context: context, shared: shared)
+    shared.arguments = arguments
+
+    let signal = combineLatest(context.sharedContext.presentationData, shared.valuesPromise.get(), shared.mediaPromise.get(), shared.ghostExpandedPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, currentValues, media, ghostExpanded -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [LunagramSettingsEntry] = []
+        for section in sections {
+            entries.append(contentsOf: lunagramSectionEntries(section: section, values: currentValues, media: media, ghostExpanded: ghostExpanded))
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    shared.push = { [weak controller] c in
+        controller?.push(c)
+    }
+    shared.present = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    return controller
+}
+
+/// Экраны декора для блока «Оформление Lunagram» в «Изменить профиль».
+func lunagramBannerScreen(context: AccountContext) -> ViewController {
+    return lunagramSectionsScreen(context: context, title: "Баннер профиля", sections: [.banner, .bannerPhoto])
+}
+
+func lunagramAvatarFrameScreen(context: AccountContext) -> ViewController {
+    return lunagramSectionsScreen(context: context, title: "Рамка аватарки", sections: [.avatarFrame, .avatarFrameSize, .avatarFrameBright, .avatarFrameGlow])
+}
+
+func lunagramProfileNameScreen(context: AccountContext) -> ViewController {
+    return lunagramSectionsScreen(context: context, title: "Имя", sections: [.profileNameColor, .profileNameGlow])
+}
