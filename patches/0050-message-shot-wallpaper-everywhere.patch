@@ -0,0 +1,61 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+
+/// Снимок сообщения.
+///
+/// На ПК это отдельный рисовальщик: он заново собирает пузырь, подставляет
+/// тему, прячет спойлеры и так далее. Здесь сделано иначе и нарочно — снимок
+/// берётся с того пузыря, который уже нарисован на экране.
+///
+/// Причина простая. Собрать пузырь заново можно, но картинки и наклейки в нём
+/// подгружаются не мгновенно: свежесобранный пузырь первые мгновения пустой, и
+/// на снимке вместо фотографии оказалась бы серая заглушка. А то, что на
+/// экране, уже нарисовано целиком — со вложением, реакциями, ответом и обоями
+/// позади. Поэтому снимаем оттуда: это и есть «скриншот выделенного», только
+/// обрезанный ровно по сообщению, без панели ввода и шапки.
+enum LunagramMessageShot {
+    /// Рисует пузырь в картинку. Ноль, если пузыря уже нет на экране.
+    static func image(of node: ASDisplayNode) -> UIImage? {
+        let view = node.view
+        guard let window = view.window else {
+            return nil
+        }
+        // Переводим место пузыря в координаты окна. Список переписки повёрнут
+        // на пол-оборота, но UIKit знает про повороты сам и отдаёт тот
+        // прямоугольник, который видно глазами.
+        var rect = view.convert(view.bounds, to: window).integral
+        rect = rect.intersection(window.bounds)
+        guard rect.width > 1.0, rect.height > 1.0 else {
+            return nil
+        }
+
+        let format = UIGraphicsImageRendererFormat.preferred()
+        format.opaque = true
+        let renderer = UIGraphicsImageRenderer(size: rect.size, format: format)
+        return renderer.image { context in
+            // Рисуем всё окно, но со сдвигом: в картинку попадает только
+            // нужный кусок. Так обои и тени под пузырём остаются настоящими.
+            context.cgContext.translateBy(x: -rect.minX, y: -rect.minY)
+            window.drawHierarchy(in: window.bounds, afterScreenUpdates: false)
+        }
+    }
+
+    /// Снять и отдать в «Поделиться»: оттуда картинку можно сохранить,
+    /// скопировать или сразу отправить. На ПК для этого три кнопки, здесь
+    /// хватает одного окна — его рисует сама система.
+    static func present(node: ASDisplayNode, from presenter: UIViewController, onFailure: () -> Void) {
+        guard let image = self.image(of: node) else {
+            onFailure()
+            return
+        }
+        let controller = UIActivityViewController(activityItems: [image], applicationActivities: nil)
+        // На планшете окно «Поделиться» обязано знать, от чего расти.
+        if let popover = controller.popoverPresentationController {
+            popover.sourceView = node.view
+            popover.sourceRect = node.view.bounds
+        }
+        presenter.present(controller, animated: true)
+    }
+}
