diff --git a/submodules/ChatListUI/Sources/Node/LunagramListWallpaper.swift b/submodules/ChatListUI/Sources/Node/LunagramListWallpaper.swift
new file mode 100644
index 00000000..fe1f4bc6
--- /dev/null
+++ b/submodules/ChatListUI/Sources/Node/LunagramListWallpaper.swift
@@ -0,0 +1,128 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import WallpaperBackgroundNode
+import Lunagram
+
+// Lunagram: обои на всё окно.
+//
+// На ПК обои видно не только в переписке, но и за списком переписок. Здесь то
+// же самое: под список кладётся тот же рисовальщик обоев, что работает в
+// переписке, — значит и однотонные, и узорчатые, и градиентные, и живое видео
+// появятся там сами, без отдельного кода на каждый случай.
+//
+// Почему вышло дёшево: в этой версии Telegram строка списка уже рисуется
+// прозрачной (цвет ей даёт подложка всего экрана). Поэтому достаточно сделать
+// прозрачной подложку и положить обои под неё — трогать сами строки не нужно.
+// Исключение одно: закреплённые переписки рисуют свой цвет, и поверх обоев он
+// смотрелся бы полосой, поэтому ему добавляется прозрачность.
+
+/// Всё, что экрану нужно для обоев. Одним предметом — чтобы в самом экране
+/// было одно новое поле.
+final class LunagramListWallpaperState {
+    var node: WallpaperBackgroundNode?
+    var dimNode: ASDisplayNode?
+    var wallpaper: TelegramWallpaper?
+    var observer: NSObjectProtocol?
+    /// Последний размер — чтобы перерисоваться по смене настройки, не дожидаясь
+    /// следующей раскладки.
+    var size: CGSize?
+    /// Слепок наших настроек на момент последней раскладки.
+    var appliedSnapshot: Int?
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+}
+
+/// Цвет подложки: прозрачный, когда обои на всё окно.
+func lunagramListBackgroundColor(_ color: UIColor) -> UIColor {
+    return LunagramSettings.wallpaperEverywhere ? .clear : color
+}
+
+/// Цвет закреплённой переписки: поверх обоев — полупрозрачный.
+func lunagramPinnedItemBackgroundColor(_ color: UIColor) -> UIColor {
+    return LunagramSettings.wallpaperEverywhere ? color.withAlphaComponent(0.55) : color
+}
+
+/// Заводит, обновляет или убирает обои под списком.
+///
+/// Зовётся из раскладки экрана и из подписки на смену настроек, поэтому всё
+/// состояние — в `state`, а не в переменных этой функции.
+func lunagramUpdateListWallpaper(state: LunagramListWallpaperState, container: ASDisplayNode, context: AccountContext, presentationData: PresentationData, size: CGSize, transition: ContainedViewLayoutTransition) {
+    state.size = size
+
+    guard LunagramSettings.wallpaperEverywhere else {
+        state.node?.removeFromSupernode()
+        state.node = nil
+        state.dimNode?.removeFromSupernode()
+        state.dimNode = nil
+        state.wallpaper = nil
+        return
+    }
+
+    let node: WallpaperBackgroundNode
+    if let current = state.node {
+        node = current
+    } else {
+        // forChatDisplay: false — нам не нужны подложки под пузырями, только
+        // сами обои.
+        node = createWallpaperBackgroundNode(context: context, forChatDisplay: false)
+        state.node = node
+        container.insertSubnode(node, at: 0)
+
+        let dimNode = ASDisplayNode()
+        dimNode.isLayerBacked = true
+        state.dimNode = dimNode
+        container.insertSubnode(dimNode, aboveSubnode: node)
+    }
+
+    if state.wallpaper != presentationData.chatWallpaper {
+        state.wallpaper = presentationData.chatWallpaper
+        node.update(wallpaper: presentationData.chatWallpaper, animated: false)
+    }
+
+    let frame = CGRect(origin: CGPoint(), size: size)
+    transition.updateFrame(node: node, frame: frame)
+    node.updateLayout(size: size, displayMode: .aspectFill, transition: transition)
+
+    if let dimNode = state.dimNode {
+        transition.updateFrame(node: dimNode, frame: frame)
+        // Затемнение — не украшение: в списке текст мелкий, и на пёстрых обоях
+        // без него не прочитать. Цвет берём у темы, чтобы в светлой оно было
+        // белёсым, а в тёмной — тёмным.
+        let dim = CGFloat(max(0, min(100, LunagramSettings.listWallpaperDim))) / 100.0
+        dimNode.backgroundColor = presentationData.theme.chatList.backgroundColor.withAlphaComponent(dim)
+    }
+}
+
+/// Подписка на смену настроек: включили обои — экран перерисуется сам.
+///
+/// Рассылка приходит на любую нашу галочку, а перекладывать весь список
+/// переписок из-за чужой настройки незачем — это не бесплатно. Поэтому держим
+/// слепок своих двух значений и будим экран, только когда поменялись они.
+func lunagramObserveListWallpaper(state: LunagramListWallpaperState, update: @escaping () -> Void) {
+    guard state.observer == nil else {
+        return
+    }
+    state.appliedSnapshot = lunagramListWallpaperSnapshot()
+    state.observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+        let snapshot = lunagramListWallpaperSnapshot()
+        guard snapshot != state.appliedSnapshot else {
+            return
+        }
+        state.appliedSnapshot = snapshot
+        update()
+    })
+}
+
+/// Слепок настроек, которые здесь что-то меняют.
+private func lunagramListWallpaperSnapshot() -> Int {
+    return (LunagramSettings.wallpaperEverywhere ? 1 : 0) &+ LunagramSettings.listWallpaperDim &* 2
+}
