+// Lunagram: таблица своих надписей. Меняется редко, читается часто — отсюда
+// замок, а не очередь: под ним только взятие указателя.
+static NSDictionary<NSString *, NSString *> *lunagramWordingDict = nil;
+static os_unfair_lock lunagramWordingLock = OS_UNFAIR_LOCK_INIT;
+
+void LunagramSetWordingDict(NSDictionary<NSString *, NSString *> * _Nullable dict) {
+    NSDictionary<NSString *, NSString *> *copied = [dict copy];
+    os_unfair_lock_lock(&lunagramWordingLock);
+    lunagramWordingDict = copied;
+    os_unfair_lock_unlock(&lunagramWordingLock);
+}
+
+static NSString * _Nullable lunagramWording(NSString * _Nonnull key) {
+    os_unfair_lock_lock(&lunagramWordingLock);
+    NSString *result = lunagramWordingDict[key];
+    os_unfair_lock_unlock(&lunagramWordingLock);
+    return result;
+}
+
+NSString * _Nullable LunagramOriginalString(_PresentationStrings * _Nonnull strings, NSString * _Nonnull key) {
+    NSString *result = strings.primaryComponent.dict[key];
+    if (!result) {
+        result = strings.secondaryComponent.dict[key];
+    }
+    return result;
+}
