+    private static let packKey = "lunagram.wording.pack"
+    private static let overridesKey = "lunagram.wording.own"
+
+    /// Какой набор выбран: 0 — родные надписи Telegram.
+    public static var pack: Int {
+        get { return UserDefaults.standard.integer(forKey: packKey) }
+        set {
+            UserDefaults.standard.set(newValue, forKey: packKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Свои правки поверх набора: ключ надписи — свой текст.
+    public static var overrides: [String: String] {
+        get { return (UserDefaults.standard.dictionary(forKey: overridesKey) as? [String: String]) ?? [:] }
+        set {
+            if newValue.isEmpty {
+                UserDefaults.standard.removeObject(forKey: overridesKey)
+            } else {
+                UserDefaults.standard.set(newValue, forKey: overridesKey)
+            }
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Правка одной надписи; пустая строка убирает правку.
+    public static func setOverride(key: String, text: String?) {
+        var all = overrides
+        if let text = text, !text.isEmpty {
+            all[key] = text
+        } else {
+            all.removeValue(forKey: key)
+        }
+        overrides = all
+    }
+
+    /// Убрать все свои правки, набор остаётся.
+    public static func clearOverrides() {
+        overrides = [:]
+    }
+
+    /// Что показывать сейчас: набор, а поверх него свои правки.
+    public static func effective() -> [String: String] {
+        var result: [String: String] = [:]
+        if let selected = packs.first(where: { $0.id == pack }) {
+            result = selected.strings
+        }
+        for (key, value) in overrides {
+            result[key] = value
+        }
+        return result
+    }
+
+    /// Какой текст сейчас у надписи по нашим правилам; nil — родной.
+    public static func currentText(for key: String) -> String? {
+        if let own = overrides[key] {
+            return own
+        }
+        return packs.first(where: { $0.id == pack })?.strings[key]
+    }
+}
