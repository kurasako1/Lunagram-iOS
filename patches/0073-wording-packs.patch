@@ -0,0 +1,31 @@
+import Foundation
+import PresentationStrings
+import Lunagram
+
+// Lunagram: свои надписи поверх телеграмовских.
+//
+// Сам список живёт в LunagramWording, а сюда он попадает потому, что только
+// отсюда виден генератор строк Telegram. Таблицу ставим один раз при запуске
+// и потом при каждой смене настроек.
+
+private var lunagramWordingObserver: NSObjectProtocol?
+
+/// Ставит нынешнюю таблицу надписей и следит за её сменой.
+public func lunagramStartWording() {
+    lunagramApplyWording()
+    if lunagramWordingObserver == nil {
+        lunagramWordingObserver = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+            lunagramApplyWording()
+        })
+    }
+}
+
+private func lunagramApplyWording() {
+    let table = LunagramWording.effective()
+    LunagramSetWordingDict(table.isEmpty ? nil : table)
+}
+
+/// Родная надпись Telegram по ключу — мимо наших правок, для редактора.
+public func lunagramOriginalString(_ strings: PresentationStrings, key: String) -> String? {
+    return LunagramOriginalString(strings, key)
+}
