diff --git a/submodules/Lunagram/Sources/LunagramAvatarShape.swift b/submodules/Lunagram/Sources/LunagramAvatarShape.swift
new file mode 100644
index 00000000..1b4d5d84
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramAvatarShape.swift
@@ -0,0 +1,43 @@
+import UIKit
+
+/// Форма аватарок — как «Закругление аватарок» на ПК: ступень от 0 (квадрат)
+/// до 23 (круг), радиус — доля от половины стороны. Та же формула, что у
+/// AyuGram на ПК (ComputeRadiusF), чтобы оба клиента выглядели одинаково.
+public enum LunagramAvatarShape {
+    /// Ступень круга — как kMaxAvatarCorners на ПК.
+    public static let maxCorners = 23
+
+    /// Круг ли сейчас. Тогда Telegram рисует по-своему, и мы не вмешиваемся.
+    public static var isCircle: Bool {
+        return LunagramSettings.avatarCorners >= maxCorners
+    }
+
+    /// Радиус скругления для аватарки этой стороны.
+    public static func cornerRadius(side: CGFloat) -> CGFloat {
+        let corners = LunagramSettings.avatarCorners
+        if corners >= maxCorners {
+            return side / 2.0
+        }
+        if corners <= 0 {
+            return 0.0
+        }
+        return CGFloat(corners) / CGFloat(maxCorners) * side / 2.0
+    }
+
+    /// Контур обычной аватарки: круг или прямоугольник со скруглением.
+    public static func path(in rect: CGRect) -> CGPath {
+        if isCircle {
+            return CGPath(ellipseIn: rect, transform: nil)
+        }
+        return UIBezierPath(roundedRect: rect, cornerRadius: cornerRadius(side: min(rect.width, rect.height))).cgPath
+    }
+
+    /// Радиус у форумов. С «Единым закруглением» — как у чатов, иначе своя
+    /// телеграмовская четверть стороны.
+    public static func forumRadius(side: CGFloat) -> CGFloat {
+        if LunagramSettings.avatarSingleCorner {
+            return cornerRadius(side: side)
+        }
+        return floor(side * 0.25)
+    }
+}
