@@ -0,0 +1,84 @@
+import Foundation
+import UIKit
+
+// Lunagram: сама картинка корзинки — та, что стоит у удалённых сообщений.
+//
+// Лежит здесь, а не рядом с перепиской, нарочно: её рисует и переписка, и
+// экран настроек. Хозяин трижды говорил, что цвет не меняется, а я трижды
+// чинил не ту половину пути — поэтому теперь настройки показывают ровно ту же
+// картинку, что уходит в сообщения. Если образец в настройках меняет цвет, а
+// в переписке нет, значит ломается доставка; если и образец не меняется —
+// ломается рисование или чтение настройки. Догадок больше не будет.
+//
+// Рисуем своими линиями, а не перекрашиваем системный значок: у перекрашенного
+// системного значка цвет живёт в описании картинки, а не в её точках, и кто
+// именно его потеряет по дороге — проверить отсюда нечем.
+
+private let lunagramTrashLock = NSLock()
+private var lunagramTrashCache: [String: UIImage] = [:]
+
+/// Сбросить нарисованное. Зовётся при смене настроек: цвет мог поменяться.
+public func lunagramClearTrashCache() {
+    lunagramTrashLock.lock()
+    lunagramTrashCache.removeAll()
+    lunagramTrashLock.unlock()
+}
+
+/// Корзинка выбранного цвета, высотой примерно `pointSize`.
+///
+/// Памятку держим по самому числу цвета, а не по разобранным на красный,
+/// зелёный и синий долям: разбор — лишний шаг, на котором можно потерять
+/// разницу между двумя близкими цветами.
+public func lunagramTrashImage(pointSize: CGFloat) -> UIImage? {
+    let value = LunagramSettings.deletedIconColor
+    let height = max(6.0, ceil(pointSize))
+    let key = "\(value)-\(Int(height))"
+
+    lunagramTrashLock.lock()
+    if let cached = lunagramTrashCache[key] {
+        lunagramTrashLock.unlock()
+        return cached
+    }
+    lunagramTrashLock.unlock()
+
+    let width = ceil(height * 0.88)
+    let color = UIColor(
+        red: CGFloat((value >> 16) & 0xFF) / 255.0,
+        green: CGFloat((value >> 8) & 0xFF) / 255.0,
+        blue: CGFloat(value & 0xFF) / 255.0,
+        alpha: 1.0
+    )
+
+    let image = UIGraphicsImageRenderer(size: CGSize(width: width, height: height)).image { context in
+        let cg = context.cgContext
+        cg.setFillColor(color.cgColor)
+
+        let unit = height / 12.0
+        // Ручка сверху.
+        let handleWidth = width * 0.38
+        cg.fill(CGRect(x: (width - handleWidth) / 2.0, y: 0.0, width: handleWidth, height: unit))
+        // Крышка во всю ширину.
+        let lid = CGRect(x: 0.0, y: unit * 1.2, width: width, height: unit * 1.6)
+        cg.addPath(UIBezierPath(roundedRect: lid, cornerRadius: unit * 0.8).cgPath)
+        cg.fillPath()
+        // Бак: чуть у́же крышки, со скруглённым низом.
+        let bodyWidth = width * 0.82
+        let body = CGRect(
+            x: (width - bodyWidth) / 2.0,
+            y: lid.maxY + unit * 0.5,
+            width: bodyWidth,
+            height: height - lid.maxY - unit * 0.5
+        )
+        cg.addPath(UIBezierPath(
+            roundedRect: body,
+            byRoundingCorners: [.bottomLeft, .bottomRight],
+            cornerRadii: CGSize(width: unit * 1.2, height: unit * 1.2)
+        ).cgPath)
+        cg.fillPath()
+    }
+
+    lunagramTrashLock.lock()
+    lunagramTrashCache[key] = image
+    lunagramTrashLock.unlock()
+    return image
+}
