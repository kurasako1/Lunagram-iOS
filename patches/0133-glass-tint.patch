+    /// Свой цвет матовых панелей, 0xRRGGBB; пусто — как красит Telegram.
+    public static var glassTintColor: UInt32? {
+        get {
+            guard defaults.object(forKey: Key.glassTintColor) != nil else {
+                return nil
+            }
+            return UInt32(truncatingIfNeeded: defaults.integer(forKey: Key.glassTintColor)) & 0xFFFFFF
+        }
+        set {
+            if let newValue = newValue {
+                defaults.set(Int(newValue & 0xFFFFFF), forKey: Key.glassTintColor)
+            } else {
+                defaults.removeObject(forKey: Key.glassTintColor)
+            }
+            changed()
+        }
+    }
+
+    /// Насколько густо подмешивать свой цвет, 0…100 %.
+    public static var glassTintStrength: Int {
+        get { return percent(Key.glassTintStrength, default: 50) }
+        set { setPercent(newValue, Key.glassTintStrength) }
+    }
+
+    /// Подмешать свой цвет к телеграмовскому. Цвет не выбран — отдаём как было.
+    ///
+    /// Именно подмешать, а не заменить: у панели важна ещё и прозрачность, и
+    /// если поставить свой цвет целиком, стекло перестанет быть стеклом.
+    public static func glassTinted(_ base: UIColor) -> UIColor {
+        guard let rgb = glassTintColor else {
+            return base
+        }
+        let mine = color(from: rgb, alpha: 1.0)
+        let share = CGFloat(glassTintStrength) / 100.0
+        var br: CGFloat = 0.0, bg: CGFloat = 0.0, bb: CGFloat = 0.0, ba: CGFloat = 0.0
+        var mr: CGFloat = 0.0, mg: CGFloat = 0.0, mb: CGFloat = 0.0, ma: CGFloat = 0.0
+        UIColor(cgColor: mine).getRed(&mr, green: &mg, blue: &mb, alpha: &ma)
+        base.getRed(&br, green: &bg, blue: &bb, alpha: &ba)
+        // Прозрачность оставляем телеграмовскую: за неё отвечает вид панели.
+        return UIColor(
+            red: br + (mr - br) * share,
+            green: bg + (mg - bg) * share,
+            blue: bb + (mb - bb) * share,
+            alpha: ba
+        )
+    }
+
     /// Не делать предпросмотр ссылок у своих сообщений.
     public static var noLinkPreview: Bool {
         get { return flag(Key.noLinkPreview, default: false) }
