@@ -0,0 +1,114 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import Lunagram
+
+// Lunagram: корень раздела — все наши экраны одним столбиком.
+//
+// Сделан отдельным файлом и БЕЗ общей машинерии выключателей: своего
+// состояния у него нет, это просто перечень входов. Потяни он сюда общее
+// состояние — каждая правка в нём била бы по всем пятнадцати экранам, а
+// менять ему нечего.
+//
+// Порядок строк — порядок перечисления LunagramPlace.allCases. Один список,
+// одно место правки: добавил место в перечень — оно появилось и здесь.
+
+private final class LunagramRootArguments {
+    let open: (LunagramPlace) -> Void
+
+    init(open: @escaping (LunagramPlace) -> Void) {
+        self.open = open
+    }
+}
+
+private enum LunagramRootEntry: ItemListNodeEntry {
+    case place(Int32, LunagramPlace)
+
+    var section: ItemListSectionId {
+        return 0
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .place(index, _):
+            return index
+        }
+    }
+
+    static func <(lhs: LunagramRootEntry, rhs: LunagramRootEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    static func ==(lhs: LunagramRootEntry, rhs: LunagramRootEntry) -> Bool {
+        switch lhs {
+        case let .place(lhsIndex, lhsPlace):
+            if case let .place(rhsIndex, rhsPlace) = rhs,
+               lhsIndex == rhsIndex, lhsPlace == rhsPlace {
+                return true
+            }
+            return false
+        }
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramRootArguments
+        switch self {
+        case let .place(_, place):
+            return ItemListDisclosureItem(
+                presentationData: presentationData,
+                systemStyle: .glass,
+                icon: place.tileIcon,
+                title: place.title,
+                label: "",
+                sectionId: self.section,
+                style: .blocks,
+                action: {
+                    arguments.open(place)
+                })
+        }
+    }
+}
+
+public func lunagramRootController(context: AccountContext) -> ViewController {
+    var pushImpl: ((ViewController) -> Void)?
+
+    let arguments = LunagramRootArguments(open: { place in
+        pushImpl?(lunagramPlaceController(context: context, place: place))
+    })
+
+    let signal = context.sharedContext.presentationData
+    |> deliverOnMainQueue
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [LunagramRootEntry] = []
+        var index: Int32 = 0
+        for place in LunagramPlace.allCases {
+            entries.append(.place(index, place))
+            index += 1
+        }
+        let controllerState = ItemListControllerState(
+            presentationData: ItemListPresentationData(presentationData),
+            title: .text("Lunagram"),
+            leftNavigationButton: nil,
+            rightNavigationButton: nil,
+            backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(
+            presentationData: ItemListPresentationData(presentationData),
+            entries: entries,
+            style: .blocks,
+            animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    // Под нашими экранами — та же картинка, что под профилем.
+    controller.lunagramShowsBackground = true
+    pushImpl = { [weak controller] next in
+        controller?.push(next)
+    }
+    return controller
+}
