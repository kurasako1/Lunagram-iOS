+import Foundation
+
+/// Откуда записан кружок — как на ПК. Определяется по имени файла: разные
+/// клиенты называют свои записи по-разному, и это единственное, что о
+/// записи вообще приходит. Никаких запросов на сервер.
+///
+/// Правила сняты с плагина round_client_detector (@netconfiger) — это
+/// наблюдение за тем, как клиенты называют файл, а не чей-то код:
+/// - iPhone всегда шлёт ровно «video.mp4»;
+/// - Telegram Desktop — имя вида round_2026-08-28_01-30-00.mp4;
+/// - официальный Android имени не задаёт вовсе;
+/// - всё прочее — сторонний клиент или бот.
+public enum LunagramRoundSource {
+    case iOS
+    case android
+    case desktop
+    case other
+
+    public static func detect(fileName: String?) -> LunagramRoundSource {
+        let name = (fileName ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        if name.isEmpty {
+            return .android
+        }
+        let lower = name.lowercased()
+        if lower == "video.mp4" {
+            return .iOS
+        }
+        if lower.range(of: "^round_\\d{4}-\\d{2}-\\d{2}[_ ]\\d{2}-\\d{2}-\\d{2}", options: .regularExpression) != nil || lower.contains("desktop") {
+            return .desktop
+        }
+        return .other
+    }
+
+    /// Короткая метка рядом со временем. Пусто, если показ выключен или
+    /// источник неясен: неверная метка хуже отсутствующей.
+    public static func badge(fileName: String?) -> String? {
+        guard LunagramSettings.showRoundSource else {
+            return nil
+        }
+        switch detect(fileName: fileName) {
+        case .iOS:
+            return "iOS"
+        case .android:
+            return "Android"
+        case .desktop:
+            return "Desktop"
+        case .other:
+            return nil
+        }
+    }
+
+    /// Развёрнутое пояснение для меню кружка.
+    public static func details(fileName: String?) -> String {
+        let name = (fileName ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        let source: String
+        switch detect(fileName: fileName) {
+        case .iOS:
+            source = "iPhone или iPad — имя файла video.mp4."
+        case .android:
+            source = "Android — имени файла нет, официальный клиент его не задаёт."
+        case .desktop:
+            source = "Telegram Desktop — имя вида round_дата_время."
+        case .other:
+            source = "Сторонний клиент или бот — имя не похоже ни на один официальный."
+        }
+        return name.isEmpty ? source : "\(source)\n\nИмя файла: \(name)"
+    }
+}
