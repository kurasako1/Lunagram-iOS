+import UIKit
+
+/// Свой фон полоски с песней — как на ПК: картинка или гифка с затемнением и
+/// размытием либо ровный свой цвет. Один вид на образец в настройках и на
+/// саму полоску в профиле, чтобы образец не врал.
+public final class LunagramMusicBackgroundView: UIView {
+    private let imageView = UIImageView()
+    private let blurView = UIVisualEffectView(effect: UIBlurEffect(style: .regular))
+    private let dimView = UIView()
+    private var shownURL: URL?
+
+    /// Светлый ли свой цвет — тогда текст поверх пишем тёмным, как на ПК.
+    public private(set) var isLight = false
+
+    public init() {
+        super.init(frame: CGRect())
+        self.isUserInteractionEnabled = false
+        self.clipsToBounds = true
+
+        self.imageView.contentMode = .scaleAspectFill
+        self.imageView.clipsToBounds = true
+        self.addSubview(self.imageView)
+
+        self.blurView.isUserInteractionEnabled = false
+        self.addSubview(self.blurView)
+
+        self.dimView.backgroundColor = .black
+        self.dimView.isUserInteractionEnabled = false
+        self.addSubview(self.dimView)
+
+        self.reload()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        self.imageView.frame = self.bounds
+        self.blurView.frame = self.bounds
+        self.dimView.frame = self.bounds
+    }
+
+    /// Перечитать выбранное. Картинка главнее цвета, как на ПК.
+    public func reload() {
+        let url = LunagramSettings.profileMusicBgURL
+        if url != self.shownURL {
+            self.shownURL = url
+            // Гифка — «анимированная» картинка: UIImageView крутит её сам.
+            self.imageView.image = url.flatMap { LunagramSettings.loadAnimatedImage(url: $0) }
+        }
+        if url != nil, self.imageView.image != nil {
+            self.imageView.isHidden = false
+            self.backgroundColor = .clear
+            self.dimView.alpha = CGFloat(LunagramSettings.profileMusicBgDim) / 100.0
+            self.blurView.alpha = CGFloat(LunagramSettings.profileMusicBgBlur) / 100.0
+            self.isLight = false
+        } else if let rgb = LunagramSettings.profileMusicBgColor {
+            self.imageView.isHidden = true
+            self.dimView.alpha = 0.0
+            self.blurView.alpha = 0.0
+            let red = CGFloat((rgb >> 16) & 0xFF)
+            let green = CGFloat((rgb >> 8) & 0xFF)
+            let blue = CGFloat(rgb & 0xFF)
+            self.backgroundColor = UIColor(red: red / 255.0, green: green / 255.0, blue: blue / 255.0, alpha: 1.0)
+            // Та же граница яркости, что на ПК.
+            self.isLight = (red * 0.299 + green * 0.587 + blue * 0.114) > 150.0
+        } else {
+            self.imageView.isHidden = true
+            self.dimView.alpha = 0.0
+            self.blurView.alpha = 0.0
+            self.backgroundColor = .clear
+            self.isLight = false
+        }
+    }
+}
