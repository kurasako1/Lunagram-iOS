+    // MARK: Фон музыки
+
+    /// Своя картинка или гифка под полоской с песней в своём профиле — как на
+    /// ПК. Картинка главнее цвета.
+    public static var profileMusicBgURL: URL? {
+        return storedURL(forKey: Key.profileMusicBgFile)
+    }
+
+    /// Забирает картинку себе. Гифку копируем как есть — пережатая в JPEG,
+    /// она перестала бы двигаться.
+    public static func importProfileMusicBackground(from source: URL) throws {
+        let folder = try lunagramFolder()
+        let isGIF = source.pathExtension.lowercased() == "gif"
+        let name = "musicbg-\(UUID().uuidString).\(isGIF ? "gif" : "jpg")"
+        if isGIF {
+            try FileManager.default.copyItem(at: source, to: folder.appendingPathComponent(name))
+        } else {
+            try writeScaledImage(from: source, to: folder.appendingPathComponent(name))
+        }
+        store(name, forKey: Key.profileMusicBgFile, in: folder)
+    }
+
+    /// «Убрать свой фон», как на ПК: и картинку, и цвет.
+    public static func clearProfileMusicBackground() {
+        if let folder = try? lunagramFolder(), let name = defaults.string(forKey: Key.profileMusicBgFile) {
+            try? FileManager.default.removeItem(at: folder.appendingPathComponent(name))
+        }
+        defaults.removeObject(forKey: Key.profileMusicBgFile)
+        defaults.removeObject(forKey: Key.profileMusicBgColor)
+        changed()
+    }
+
+    /// Свой цвет полоски, 0xRRGGBB. nil — своего цвета нет.
+    public static var profileMusicBgColor: UInt32? {
+        get {
+            guard defaults.object(forKey: Key.profileMusicBgColor) != nil else {
+                return nil
+            }
+            return UInt32(truncatingIfNeeded: defaults.integer(forKey: Key.profileMusicBgColor)) & 0xFFFFFF
+        }
+        set {
+            if let newValue = newValue {
+                defaults.set(Int(newValue & 0xFFFFFF), forKey: Key.profileMusicBgColor)
+            } else {
+                defaults.removeObject(forKey: Key.profileMusicBgColor)
+            }
+            changed()
+        }
+    }
+
+    /// Затемнение картинки под полоской, 0…100. По умолчанию 45, как на ПК.
+    public static var profileMusicBgDim: Int {
+        get { return clamped(Key.profileMusicBgDim, 0, 100, 45) }
+        set { setClamped(newValue, Key.profileMusicBgDim, 0, 100) }
+    }
+
+    /// Размытие картинки под полоской, 0…100.
+    public static var profileMusicBgBlur: Int {
+        get { return clamped(Key.profileMusicBgBlur, 0, 100, 0) }
+        set { setClamped(newValue, Key.profileMusicBgBlur, 0, 100) }
+    }
+
+    /// Есть ли свой фон полоски вообще — картинка или цвет.
+    public static var hasProfileMusicBackground: Bool {
+        return profileMusicBgURL != nil || profileMusicBgColor != nil
+    }
+
+    /// Картинка из файла, у гифки — с движением. Кадры читаем сами:
+    /// UIImage(contentsOfFile:) у гифки берёт только первый.
+    public static func loadAnimatedImage(url: URL) -> UIImage? {
+        guard let source = CGImageSourceCreateWithURL(url as CFURL, nil) else {
+            return nil
+        }
+        let count = CGImageSourceGetCount(source)
+        if count <= 1 {
+            return UIImage(contentsOfFile: url.path)
+        }
+        var frames: [UIImage] = []
+        var duration: Double = 0.0
+        for index in 0 ..< min(count, 240) {
+            guard let image = CGImageSourceCreateImageAtIndex(source, index, nil) else {
+                continue
+            }
+            frames.append(UIImage(cgImage: image))
+            var delay = 0.08
+            if let properties = CGImageSourceCopyPropertiesAtIndex(source, index, nil) as? [CFString: Any], let gif = properties[kCGImagePropertyGIFDictionary] as? [CFString: Any] {
+                if let value = gif[kCGImagePropertyGIFUnclampedDelayTime] as? Double, value > 0.0 {
+                    delay = value
+                } else if let value = gif[kCGImagePropertyGIFDelayTime] as? Double, value > 0.0 {
+                    delay = value
+                }
+            }
+            duration += max(0.02, delay)
+        }
+        if frames.isEmpty {
+            return nil
+        }
+        return UIImage.animatedImage(with: frames, duration: duration)
+    }
+
