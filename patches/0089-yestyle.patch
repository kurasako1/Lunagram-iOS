+import Foundation
+
+/// «Кавайный стиль» — перенос плагина YeStyle.
+///
+/// Переделывает исходящее сообщение: слова меняются на милые, к ним
+/// приклеиваются уменьшительные окончания, «р» и «л» становятся «в», а в
+/// конец падает каомодзи. Сколько из этого делать — решают выключатели.
+///
+/// Сообщения, начатые с «/» или «!», не трогаем: это команды.
+///
+/// Таблички замен — в LunagramYeStyleWords, собраны разбором плагина.
+public struct LunagramYeStyleOptions {
+    public var extreme: Bool
+    public var kawaiiWords: Bool
+    public var nyacator: Bool
+    public var replaceRL: Bool
+    public var suffixes: Bool
+    public var lowercaseFirst: Bool
+    public var randomUpper: Bool
+    public var emojiPunctuation: Bool
+    public var tilde: Bool
+    public var kaomoji: Bool
+
+    public init(
+        extreme: Bool,
+        kawaiiWords: Bool,
+        nyacator: Bool,
+        replaceRL: Bool,
+        suffixes: Bool,
+        lowercaseFirst: Bool,
+        randomUpper: Bool,
+        emojiPunctuation: Bool,
+        tilde: Bool,
+        kaomoji: Bool
+    ) {
+        self.extreme = extreme
+        self.kawaiiWords = kawaiiWords
+        self.nyacator = nyacator
+        self.replaceRL = replaceRL
+        self.suffixes = suffixes
+        self.lowercaseFirst = lowercaseFirst
+        self.randomUpper = randomUpper
+        self.emojiPunctuation = emojiPunctuation
+        self.tilde = tilde
+        self.kaomoji = kaomoji
+    }
+}
+
+public enum LunagramYeStyle {
+    /// Окончания, после которых уменьшительное не клеим: глаголы,
+    /// прилагательные и то, что и так уже милое.
+    private static let verbEndings = ["ться", "тся", "ать", "еть", "ить", "оть", "уть", "ыть", "ешь", "ишь", "йте", "ти", "ял", "ел", "ил", "ал", "ут", "ют", "ат", "ят", "сь", "ся", "ем", "им", "те", "у", "ю"]
+    private static let adjEndings = ["ыми", "ими", "ому", "ему", "ый", "ий", "ой", "ая", "яя", "ое", "ее", "ые", "ие", "ых", "их", "ую", "юю"]
+    private static let cuteEndings = ["онька", "енька", "очка", "ечка", "чик", "чка", "шка", "ень", "уся", "ик"]
+
+    private static let exclaims = ["!! ✨", "!! 🥺", "!! >_<"]
+    private static let questions = ["? 歪(･ω･)?", "? 🐾", "??"]
+    private static let dots = ["...", "~"]
+
+    public static func apply(to text: String, options: LunagramYeStyleOptions) -> String {
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty || trimmed.hasPrefix("/") || trimmed.hasPrefix("!") {
+            return text
+        }
+
+        let intensity = options.extreme ? 2.5 : 1.0
+        let punctChance = options.emojiPunctuation ? 0.3 : 0.0
+
+        var result = ""
+        var firstWordDone = false
+        for token in tokens(of: trimmed) {
+            if token.first?.isWhitespace == true {
+                result += token
+                continue
+            }
+            if token.hasPrefix("http") || token.hasPrefix("@") || token.hasPrefix("#") || token.hasPrefix("/") {
+                result += token
+                continue
+            }
+
+            let characters = Array(token)
+            var start = 0
+            while start < characters.count, !isWordCharacter(characters[start]) {
+                start += 1
+            }
+            var end = characters.count
+            while end > start, !isWordCharacter(characters[end - 1]) {
+                end -= 1
+            }
+            let clean = String(characters[start ..< end].filter { isWordCharacter($0) })
+            if clean.isEmpty {
+                result += decorated(token, chance: punctChance)
+                continue
+            }
+
+            let lower = clean.lowercased()
+            var word = clean
+
+            if options.kawaiiWords, let cute = LunagramYeStyleWords.replacements[lower] {
+                word = cute
+            } else if options.suffixes, shouldAddSuffix(lower), Double.random(in: 0 ..< 1) < 0.35 * intensity {
+                word = withCuteEnding(clean, lower: lower)
+            }
+
+            if options.nyacator {
+                word = word
+                    .replacingOccurrences(of: "на", with: "ня")
+                    .replacingOccurrences(of: "ма", with: "мя")
+                    .replacingOccurrences(of: "На", with: "Ня")
+                    .replacingOccurrences(of: "Ма", with: "Мя")
+            }
+
+            // Заикание на первом слове: «П-привет».
+            if !firstWordDone, word.count > 2, Double.random(in: 0 ..< 1) < 0.15 * intensity, let first = word.first {
+                word = String(first) + "-" + word.lowercased()
+            }
+            firstWordDone = true
+
+            if clean.first?.isUppercase == true, let first = word.first {
+                word = first.uppercased() + String(word.dropFirst())
+            }
+
+            let leading = String(characters[0 ..< start])
+            let trailing = decorated(String(characters[end ..< characters.count]), chance: punctChance)
+            result += leading + word + trailing
+        }
+
+        if options.replaceRL {
+            var swapped = ""
+            for character in result {
+                if character == "р" || character == "Р" || character == "л" || character == "Л" {
+                    swapped.append("в")
+                } else {
+                    swapped.append(character)
+                }
+            }
+            result = swapped
+        }
+
+        if options.lowercaseFirst, let index = result.firstIndex(where: { $0.isLetter }) {
+            result.replaceSubrange(index ... index, with: result[index].lowercased())
+        }
+
+        if options.randomUpper {
+            // Берём первый знак: у некоторых букв большая форма из двух
+            // знаков, и Character из такой строки собрать нельзя.
+            result = String(result.map { character -> Character in
+                let changed = Double.random(in: 0 ..< 1) > 0.7 ? character.uppercased() : character.lowercased()
+                return changed.first ?? character
+            })
+        }
+
+        if options.kaomoji, Double.random(in: 0 ..< 1) < min(0.15 * intensity, 1.0), let prefix = LunagramYeStyleWords.prefixes.randomElement() {
+            result = prefix + result
+        }
+
+        if options.tilde, let last = result.last, !"~!?.)".contains(last) {
+            result += "~"
+        }
+
+        if options.kaomoji {
+            let value = Double.random(in: 0 ..< 1)
+            if value < min(0.65 * intensity, 1.0), let kaomoji = LunagramYeStyleWords.kaomoji.randomElement() {
+                result = trimmedTildes(result) + " " + kaomoji
+            } else if value < min(0.9 * intensity, 1.0), let suffix = LunagramYeStyleWords.suffixes.randomElement() {
+                result = trimmedTildes(result) + " " + suffix
+            }
+        }
+
+        return result
+    }
+
+    // MARK: Внутреннее
+
+    /// Режем строку на куски: слова и промежутки между ними — чтобы вернуть
+    /// пробелы на место точно такими же, какими они были.
+    private static func tokens(of text: String) -> [String] {
+        var result: [String] = []
+        var current = ""
+        var currentIsSpace: Bool?
+        for character in text {
+            let isSpace = character.isWhitespace
+            if let value = currentIsSpace, value != isSpace {
+                result.append(current)
+                current = ""
+            }
+            current.append(character)
+            currentIsSpace = isSpace
+        }
+        if !current.isEmpty {
+            result.append(current)
+        }
+        return result
+    }
+
+    private static func isWordCharacter(_ character: Character) -> Bool {
+        return character.isLetter || character.isNumber || character == "_"
+    }
+
+    private static func shouldAddSuffix(_ lower: String) -> Bool {
+        if lower.count < 4 || LunagramYeStyleWords.stopWords.contains(lower) {
+            return false
+        }
+        for ending in verbEndings + adjEndings + cuteEndings where lower.hasSuffix(ending) {
+            return false
+        }
+        return true
+    }
+
+    /// Уменьшительное окончание по последней букве — как в плагине.
+    private static func withCuteEnding(_ word: String, lower: String) -> String {
+        if lower.hasSuffix("а") {
+            return String(word.dropLast()) + "очка"
+        }
+        if lower.hasSuffix("я") {
+            return String(word.dropLast()) + "ечка"
+        }
+        if lower.hasSuffix("ь") {
+            return String(word.dropLast()) + "ька"
+        }
+        if lower.hasSuffix("шок") || lower.hasSuffix("жок") {
+            return word + "ок"
+        }
+        if let last = lower.last, "кгхжшщч".contains(last) {
+            return word + "ик"
+        }
+        if let last = lower.last, "тднлрсзмвбпф".contains(last) {
+            return word + "чик"
+        }
+        return word + "ик"
+    }
+
+    /// Знаки в конце слова — на блёстки и мордочки.
+    private static func decorated(_ punctuation: String, chance: Double) -> String {
+        guard chance > 0, !punctuation.isEmpty else {
+            return punctuation
+        }
+        var result = punctuation
+        if result.contains("!"), Double.random(in: 0 ..< 1) < chance, let replacement = exclaims.randomElement() {
+            result = result.replacingOccurrences(of: "!", with: replacement)
+        }
+        if result.contains("?"), Double.random(in: 0 ..< 1) < chance, let replacement = questions.randomElement() {
+            result = result.replacingOccurrences(of: "?", with: replacement)
+        }
+        if result.contains("."), !result.contains("..."), Double.random(in: 0 ..< 1) < chance, let replacement = dots.randomElement() {
+            result = result.replacingOccurrences(of: ".", with: replacement)
+        }
+        return result
+    }
+
+    private static func trimmedTildes(_ text: String) -> String {
+        var result = text
+        while result.hasSuffix("~") {
+            result.removeLast()
+        }
+        return result
+    }
+}
