+// Lunagram: разбор ссылки перед переходом.
+//
+// Все внешние ссылки проходят через `openExternalUrlImpl` — и те, что
+// нажали в сообщении, и те, что из описания канала, и из кнопок ботов.
+// Поэтому спрашиваем здесь: одно место вместо десятка.
+//
+// Пропуск нужен, чтобы не спросить дважды. Нажал «Перейти» — ставим
+// пропуск и зовём ту же самую работу заново, уже без разбора.
+private var lunagramLinkGuardBypass = false
+
+private func lunagramAskBeforeOpening(context: AccountContext, url: String, presentationData: PresentationData, proceed: @escaping (String) -> Void) -> Bool {
+    if lunagramLinkGuardBypass {
+        lunagramLinkGuardBypass = false
+        return false
+    }
+    guard LunagramLinkGuard.enabled else {
+        return false
+    }
+    guard let report = LunagramLinkGuard.inspect(url) else {
+        return false
+    }
+
+    var lines: [String] = ["Перейти на \(report.host)?"]
+    if !report.warnings.isEmpty {
+        lines.append("")
+        for warning in report.warnings {
+            lines.append("⚠️ " + warning)
+        }
+    }
+    if !report.removed.isEmpty {
+        lines.append("")
+        lines.append("Вырезано меток слежения: " + report.removed.joined(separator: ", "))
+    }
+
+    let target = report.cleaned
+    let controller = textAlertController(
+        context: context,
+        title: report.isSuspicious ? "Ссылка выглядит подозрительно" : "Переход по ссылке",
+        text: lines.joined(separator: "\n"),
+        actions: [
+            TextAlertAction(type: .genericAction, title: "Скопировать", action: {
+                UIPasteboard.general.string = target
+            }),
+            TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: report.isSuspicious ? .destructiveAction : .defaultAction, title: "Перейти", action: {
+                lunagramLinkGuardBypass = true
+                proceed(target)
+            })
+        ]
+    )
+    context.sharedContext.presentGlobalController(controller, nil)
+    return true
+}
+
 func openExternalUrlImpl(context: AccountContext, urlContext: OpenURLContext, url: String, forceExternal: Bool, presentationData: PresentationData, navigationController: NavigationController?, dismissInput: @escaping () -> Void) {
+    // Lunagram: спросить перед выходом наружу. Выключено — эта строка
