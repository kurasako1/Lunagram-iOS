+import Foundation
+
+/// Разбор ссылки перед переходом.
+///
+/// Задумка из Link Guard (@Robobloxi). Взята **без сетевой части**: сам
+/// плагин качает списки мошеннических адресов с чужого хранилища и
+/// спрашивает у стороннего сервиса, кому принадлежит домен. Туда уходил
+/// бы адрес, по которому человек только собирается перейти, — ровно то,
+/// за что хозяин отменил LyricsPlus. Здесь всё считается на телефоне и
+/// наружу не уходит ни одного запроса.
+///
+/// Что остаётся без сети и при этом ловит почти все подделки:
+///
+/// 1. **Настоящий домен.** В ссылке он может прятаться за чем угодно —
+///    за длинным путём, за «@» перед именем, за поддоменами вида
+///    `sberbank.ru.xyz.com`. Показываем тот, куда браузер пойдёт на
+///    самом деле.
+/// 2. **Подмена букв.** Кириллическая «о» неотличима от латинской, и на
+///    этом держится половина поддельных адресов. Смотрим, не намешаны ли
+///    в одном слове буквы из разных азбук.
+/// 3. **Чистка меток.** Из ссылки вырезаются хвосты, по которым тебя
+///    узнают на том конце.
+public enum LunagramLinkGuard {
+    private static let enabledKey = "lunagram.linkGuard.enabled"
+    private static let cleanKey = "lunagram.linkGuard.clean"
+
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    /// Спрашивать перед переходом.
+    public static var enabled: Bool {
+        get {
+            guard defaults.object(forKey: enabledKey) != nil else {
+                return false
+            }
+            return defaults.bool(forKey: enabledKey)
+        }
+        set {
+            defaults.set(newValue, forKey: enabledKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Вырезать метки слежения.
+    public static var cleanTrackers: Bool {
+        get {
+            guard defaults.object(forKey: cleanKey) != nil else {
+                return true
+            }
+            return defaults.bool(forKey: cleanKey)
+        }
+        set {
+            defaults.set(newValue, forKey: cleanKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Хвосты, по которым узнают, откуда ты пришёл. Список неполный по
+    /// природе своей — новые придумывают быстрее, чем их вносят, — но
+    /// закрывает то, что попадается каждый день.
+    private static let trackerNames: Set<String> = [
+        "fbclid", "gclid", "dclid", "gbraid", "wbraid", "yclid", "ysclid",
+        "msclkid", "twclid", "igshid", "mc_eid", "mc_cid", "vero_id",
+        "_openstat", "spm", "scm", "ref_src", "ref_url", "si",
+    ]
+
+    private static let trackerPrefixes = ["utm_", "pk_", "mtm_", "matomo_", "hsa_", "_hs"]
+
+    /// Что нашлось в ссылке.
+    public struct Report {
+        /// Куда браузер пойдёт на самом деле.
+        public var host: String
+        /// Ссылка, из которой вырезаны метки.
+        public var cleaned: String
+        /// Какие метки вырезаны.
+        public var removed: [String]
+        /// Чем ссылка подозрительна. Пусто — ничем.
+        public var warnings: [String]
+
+        public var isSuspicious: Bool {
+            return !self.warnings.isEmpty
+        }
+    }
+
+    /// Разобрать ссылку. Ничего не открывает и никуда не ходит.
+    public static func inspect(_ url: String) -> Report? {
+        guard var components = URLComponents(string: url), let host = components.host, !host.isEmpty else {
+            return nil
+        }
+
+        var warnings: [String] = []
+
+        // Имя пользователя перед адресом: «https://sberbank.ru@зло.рф»
+        // выглядит как банк, а ведёт на «зло.рф».
+        if let user = components.user, !user.isEmpty {
+            warnings.append("Перед адресом стоит «\(user)@» — браузер на это не смотрит и пойдёт на \(host).")
+        }
+
+        if host.lowercased().contains("xn--") {
+            warnings.append("Адрес записан особым образом (xn--): за этим прячут буквы, похожие на латинские.")
+        }
+
+        for label in host.split(separator: ".") {
+            if self.hasMixedScripts(String(label)) {
+                warnings.append("В части адреса «\(label)» намешаны буквы из разных азбук — обычный признак подделки.")
+                break
+            }
+        }
+
+        if components.scheme?.lowercased() == "http" {
+            warnings.append("Ссылка без защиты (http): то, что отправишь на этой странице, увидят по дороге.")
+        }
+
+        var removed: [String] = []
+        if self.cleanTrackers, let items = components.queryItems, !items.isEmpty {
+            var kept: [URLQueryItem] = []
+            for item in items {
+                if self.isTracker(item.name) {
+                    removed.append(item.name)
+                } else {
+                    kept.append(item)
+                }
+            }
+            if !removed.isEmpty {
+                components.queryItems = kept.isEmpty ? nil : kept
+            }
+        }
+
+        return Report(
+            host: host,
+            cleaned: components.url?.absoluteString ?? url,
+            removed: removed,
+            warnings: warnings
+        )
+    }
+
+    private static func isTracker(_ name: String) -> Bool {
+        let lower = name.lowercased()
+        if self.trackerNames.contains(lower) {
+            return true
+        }
+        for prefix in self.trackerPrefixes where lower.hasPrefix(prefix) {
+            return true
+        }
+        return false
+    }
+
+    /// Намешаны ли в одном слове буквы из разных азбук.
+    ///
+    /// Целиком русский адрес — дело обычное и ничем не подозрителен.
+    /// Подозрительно именно смешение: «gооgle» с двумя русскими «о»
+    /// от настоящего на вид не отличить.
+    private static func hasMixedScripts(_ text: String) -> Bool {
+        var hasLatin = false
+        var hasOther = false
+        for scalar in text.unicodeScalars {
+            switch scalar.value {
+            case 0x41 ... 0x5A, 0x61 ... 0x7A:
+                hasLatin = true
+            case 0x0400 ... 0x04FF, 0x0500 ... 0x052F: // кириллица
+                hasOther = true
+            case 0x0370 ... 0x03FF: // греческий
+                hasOther = true
+            default:
+                break
+            }
+            if hasLatin && hasOther {
+                return true
+            }
+        }
+        return false
+    }
+}
