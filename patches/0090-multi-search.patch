--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Messages/LunagramMultiSearch.swift
@@ -0,0 +1,71 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import LunagramGhost
+
+// Lunagram: поиск сразу по нескольким словам — из плагина Search+.
+//
+// Пишешь «кот | пёс» — и находится то, где есть кот, и то, где есть пёс.
+// Telegram так не умеет: его поиск принимает одно слово за раз. Поэтому
+// запрос разбирается на части, каждая ищется сама по себе, а найденное
+// складывается в один список — свежее сверху, повторы выброшены.
+//
+// Стоит это прямо в том месте, куда приходит любой поиск по сообщениям:
+// и в переписке, и в общем поиске, и в избранном. Без «|» в запросе всё
+// идёт как раньше, ни одна проверка не добавляется.
+//
+// Одно ограничение честное: «показать ещё» у такого поиска нет. Telegram
+// отдаёт метку продолжения на один запрос, а у нас их несколько, и общей
+// метки не существует. Поэтому каждое слово отдаёт свою первую сотню, и на
+// этом список закрывается.
+
+/// Части запроса, если это мультипоиск. Пусто — искать как обычно.
+func lunagramSearchParts(_ query: String) -> [String]? {
+    guard LunagramSearchSettings.multiSearch, query.contains("|") else {
+        return nil
+    }
+    let parts = query
+        .split(separator: "|")
+        .map { $0.trimmingCharacters(in: .whitespaces) }
+        .filter { !$0.isEmpty }
+    return parts.count > 1 ? parts : nil
+}
+
+/// Ищем каждое слово отдельно и складываем найденное в один список.
+func lunagramMultiSearch(
+    account: Account,
+    location: SearchMessagesLocation,
+    parts: [String],
+    centerId: MessageId?,
+    limit: Int32
+) -> Signal<(SearchMessagesResult, SearchMessagesState), NoError> {
+    let searches = parts.map { part in
+        return _internal_searchMessages(account: account, location: location, query: part, state: nil, centerId: centerId, limit: limit)
+    }
+    return combineLatest(searches)
+    |> map { results -> (SearchMessagesResult, SearchMessagesState) in
+        var messages: [Message] = []
+        var seen = Set<MessageId>()
+        var readStates: [PeerId: CombinedPeerReadState] = [:]
+        var threadInfo: [MessageId: MessageHistoryThreadData] = [:]
+        for (result, _) in results {
+            for message in result.messages where !seen.contains(message.id) {
+                seen.insert(message.id)
+                messages.append(message)
+            }
+            readStates.merge(result.readStates, uniquingKeysWith: { current, _ in current })
+            threadInfo.merge(result.threadInfo, uniquingKeysWith: { current, _ in current })
+        }
+        messages.sort(by: { $0.index > $1.index })
+        // Сколько нашли, столько и пишем: складывать чужие счётчики нельзя,
+        // одно и то же сообщение могло попасться по нескольким словам.
+        let merged = SearchMessagesResult(
+            messages: messages,
+            readStates: readStates,
+            threadInfo: threadInfo,
+            totalCount: Int32(messages.count),
+            completed: true
+        )
+        return (merged, results[0].1)
+    }
+}
