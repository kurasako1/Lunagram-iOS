diff --git a/submodules/LunagramGhost/Sources/LunagramSearchSettings.swift b/submodules/LunagramGhost/Sources/LunagramSearchSettings.swift
new file mode 100644
index 00000000..dc022587
--- /dev/null
+++ b/submodules/LunagramGhost/Sources/LunagramSearchSettings.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// Поиск сразу по нескольким словам.
+///
+/// Живёт рядом с Ghost по той же причине: его читает сетевая часть Telegram
+/// — в том самом месте, куда приходит любой поиск по сообщениям.
+public enum LunagramSearchSettings {
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let multiSearch = "lunagram.search.multi"
+    }
+
+    /// Считать ли «|» разделителем: «кот | пёс» ищет и то и другое.
+    public static var multiSearch: Bool {
+        get {
+            return defaults.bool(forKey: Key.multiSearch)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.multiSearch)
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Messages/LunagramMultiSearch.swift b/submodules/TelegramCore/Sources/TelegramEngine/Messages/LunagramMultiSearch.swift
