+private func lunagramCopyPack(
+    context: AccountContext,
+    info: StickerPackCollectionInfo.Accessor,
+    items: [StickerPackItem],
+    title: String
+) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
