+        var dimensions = PixelDimensions(width: 512, height: 512)
+        var duration: Double?
+        for attribute in file.attributes {
+            switch attribute {
+            case let .Sticker(displayText, _, _):
+                emoji = displayText
+            case let .CustomEmoji(_, _, alt, _):
+                emoji = alt
+            case let .ImageSize(size):
+                dimensions = size
+            case let .Video(videoDuration, size, _, _, _, _):
+                duration = videoDuration
+                dimensions = size
+            default:
+                break
+            }
+        }
+        if file.mimeType == "video/webm" {
+            isVideo = true
+        } else if file.mimeType == "application/x-tgsticker" {
+            isAnimated = true
+        }
+        stickers.append(ImportSticker(
+            resource: FileMediaReference.standalone(media: file).resourceReference(file.resource),
+            thumbnailResource: nil,
+            emojis: [emoji.isEmpty ? "⭐️" : emoji],
+            dimensions: dimensions,
+            duration: duration,
+            mimeType: file.mimeType,
+            keywords: ""
+        ))
+    }
+
+    let content: CreateStickerSetType.ContentType = isVideo ? .video : (isAnimated ? .animation : .image)
+    let type: CreateStickerSetType = info.flags.contains(.isEmoji)
