diff --git a/submodules/LunagramGhost/BUILD b/submodules/LunagramGhost/BUILD
new file mode 100644
index 00000000..98c07c7b
--- /dev/null
+++ b/submodules/LunagramGhost/BUILD
@@ -0,0 +1,21 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Выключатели Ghost — отдельно от остального Lunagram.
+#
+# Их читает TelegramCore, сетевое сердце Telegram. Любая правка в том, от
+# чего он зависит, пересобирает его, а за ним почти всё приложение. Пока
+# Ghost жил в общем модуле Lunagram, каждая новая функция стоила лишних
+# полчаса сборки. Здесь только Ghost: меняется он редко.
+swift_library(
+    name = "LunagramGhost",
+    module_name = "LunagramGhost",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/submodules/LunagramGhost/Sources/LunagramGhostSettings.swift b/submodules/LunagramGhost/Sources/LunagramGhostSettings.swift
new file mode 100644
index 00000000..bc7e7367
--- /dev/null
+++ b/submodules/LunagramGhost/Sources/LunagramGhostSettings.swift
@@ -0,0 +1,63 @@
+import Foundation
+
+/// Выключатели Ghost.
+///
+/// Здесь только чтение и запись. Рассылку «настройки поменялись» делает
+/// LunagramSettings из основного модуля: экрану настроек она нужна, а
+/// сетевой части нет.
+///
+/// Читать можно из любого потока: сетевая часть Telegram читает из своих
+/// очередей, а UserDefaults к этому готов.
+public enum LunagramGhostSettings {
+    private static let defaults = UserDefaults.standard
+
+    // Ключи те же, что были в LunagramSettings, — переезд ничего не
+    // сбрасывает.
+    private enum Key {
+        static let dontRead = "lunagram.ghost.dontRead"
+        static let dontType = "lunagram.ghost.dontType"
+        static let stayOffline = "lunagram.ghost.stayOffline"
+        static let dontViewStories = "lunagram.ghost.dontViewStories"
+    }
+
+    /// Не отправлять отметку о прочтении. Собеседник видит одну галочку, пока
+    /// ты не ответишь. Сюда же — прослушивание голосовых и кружков.
+    public static var dontRead: Bool {
+        get {
+            return defaults.bool(forKey: Key.dontRead)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.dontRead)
+        }
+    }
+
+    /// Не отправлять «печатает…», «записывает голосовое» и прочее.
+    public static var dontType: Bool {
+        get {
+            return defaults.bool(forKey: Key.dontType)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.dontType)
+        }
+    }
+
+    /// Не выходить в сеть: для всех ты «был(а) недавно».
+    public static var stayOffline: Bool {
+        get {
+            return defaults.bool(forKey: Key.stayOffline)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.stayOffline)
+        }
+    }
+
+    /// Не отмечать истории просмотренными: тебя не будет в списке зрителей.
+    public static var dontViewStories: Bool {
+        get {
+            return defaults.bool(forKey: Key.dontViewStories)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.dontViewStories)
+        }
+    }
+}
