+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import AccountContext
+
+// Lunagram: удаление фото профиля пачкой, как на ПК. У Telegram их удаляют
+// по одному из галереи — с десятком старых аватарок это долго.
+
+/// Удалить свои фото профиля — все или все, кроме главного.
+///
+/// Сначала спрашиваем, сколько их, и просим подтвердить: вернуть удалённые
+/// нельзя. Сервер отдаёт за раз до сотни — больше у людей почти не бывает.
+func lunagramDeleteProfilePhotos(context: AccountContext, keepMain: Bool, present: @escaping (ViewController) -> Void) {
+    let _ = (context.engine.peers.requestPeerPhotos(peerId: context.account.peerId)
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { photos in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        // Главное — первое в списке, так его отдаёт сервер.
+        let targets = (keepMain ? Array(photos.dropFirst()) : photos).filter { $0.reference != nil }
+        let ok = TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+        guard !targets.isEmpty else {
+            present(textAlertController(context: context, title: nil, text: keepMain ? "Кроме главного, других фото профиля нет." : "Фото профиля нет.", actions: [ok]))
+            return
+        }
+        let question = keepMain
+            ? "Удалить \(targets.count) фото профиля, кроме главного? Вернуть их будет нельзя."
+            : "Удалить все фото профиля — \(targets.count)? Вернуть их будет нельзя."
+        present(textAlertController(context: context, title: "Фото профиля", text: question, actions: [
+            TextAlertAction(type: .genericAction, title: presentationData.strings.Common_Cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: "Удалить", action: {
+                // По одному, друг за другом: разом сервер может не принять.
+                var signal: Signal<Void, NoError> = .complete()
+                for photo in targets {
+                    signal = signal |> then(context.engine.accountData.removeAccountPhoto(reference: photo.reference))
+                }
+                // Своё фото в приложении обновится, когда подтянем данные
+                // профиля заново.
+                let refresh = context.engine.peers.fetchAndUpdateCachedPeerData(peerId: context.account.peerId)
+                |> map { _ -> Void in
+                    return Void()
+                }
+                let _ = (signal
+                |> then(refresh)
+                |> deliverOnMainQueue).startStandalone(completed: {
+                    present(textAlertController(context: context, title: nil, text: "Готово: удалено \(targets.count) фото.", actions: [ok]))
+                })
+            })
+        ]))
+    })
+}
