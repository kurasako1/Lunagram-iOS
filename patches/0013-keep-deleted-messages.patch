diff --git a/submodules/TelegramCore/Sources/State/LunagramKeepDeletedMessages.swift b/submodules/TelegramCore/Sources/State/LunagramKeepDeletedMessages.swift
new file mode 100644
index 00000000..73e61b80
--- /dev/null
+++ b/submodules/TelegramCore/Sources/State/LunagramKeepDeletedMessages.swift
@@ -0,0 +1,64 @@
+import Foundation
+import Postbox
+import LunagramGhost
+
+// Lunagram: сохранение удалённых сообщений.
+//
+// Когда сервер велит стереть сообщение — его удалил собеседник, админ
+// канала или ты сам на другом устройстве, — мы его не стираем, а помечаем.
+// Свои удаления с этого телефона сюда не доходят: Telegram стирает их у себя
+// сразу, и к приходу команды от сервера стирать уже нечего.
+
+/// Возвращает те сообщения, что всё-таки надо стереть. Остальные помечены.
+func lunagramKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    guard LunagramSpySettings.keepDeleted else {
+        return ids
+    }
+    let date = Int32(Date().timeIntervalSince1970)
+    return ids.filter { id in
+        return !lunagramKeepDeletedMessage(transaction: transaction, id: id, date: date)
+    }
+}
+
+/// То же для личек и обычных групп: там сервер присылает не номера в
+/// переписке, а сквозные номера сообщений.
+func lunagramKeepDeletedMessages(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    guard LunagramSpySettings.keepDeleted else {
+        return globalIds
+    }
+    let date = Int32(Date().timeIntervalSince1970)
+    return globalIds.filter { globalId in
+        guard let id = transaction.messageIdsForGlobalIds([globalId]).first else {
+            return true
+        }
+        return !lunagramKeepDeletedMessage(transaction: transaction, id: id, date: date)
+    }
+}
+
+/// Помечает одно сообщение удалённым. false — стираем как обычно.
+private func lunagramKeepDeletedMessage(transaction: Transaction, id: MessageId, date: Int32) -> Bool {
+    // Только обычные сообщения переписки. Отложенные, быстрые ответы и
+    // исчезающие Telegram стирает тем же путём, но это не «удалил
+    // собеседник»: отложенное, например, стирается, когда отправилось.
+    guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id) else {
+        return false
+    }
+    // Боты стирают свои сообщения постоянно — меню, подсказки, «печатаю».
+    // Хранить их незачем; на ПК сохранение для ботов тоже выключено.
+    if let user = transaction.getPeer(id.peerId) as? TelegramUser, user.botInfo != nil {
+        return false
+    }
+    if message.attributes.contains(where: { $0 is LunagramDeletedMessageAttribute }) {
+        return true
+    }
+    transaction.updateMessage(id, update: { currentMessage in
+        var storeForwardInfo: StoreMessageForwardInfo?
+        if let forwardInfo = currentMessage.forwardInfo {
+            storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+        }
+        var attributes = currentMessage.attributes
+        attributes.append(LunagramDeletedMessageAttribute(date: date))
+        return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: storeForwardInfo, authorId: currentMessage.author?.id, text: currentMessage.text, attributes: attributes, media: currentMessage.media))
+    })
+    return true
+}
diff --git a/submodules/TelegramCore/Sources/SyncCore/SyncCore_LunagramDeletedMessageAttribute.swift b/submodules/TelegramCore/Sources/SyncCore/SyncCore_LunagramDeletedMessageAttribute.swift
