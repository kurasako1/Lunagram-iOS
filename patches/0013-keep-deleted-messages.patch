@@ -0,0 +1,23 @@
+import Foundation
+
+/// Сохранение удалённых — «шпионский режим», как его зовут в AyuGram.
+///
+/// Живёт рядом с Ghost по той же причине: его читает сетевая часть
+/// Telegram, в тот момент, когда сервер велит стереть сообщение.
+public enum LunagramSpySettings {
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let keepDeleted = "lunagram.spy.keepDeleted"
+    }
+
+    /// Удалённое собеседником не стирать, а оставлять с пометкой.
+    public static var keepDeleted: Bool {
+        get {
+            return defaults.bool(forKey: Key.keepDeleted)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.keepDeleted)
+        }
+    }
+}
