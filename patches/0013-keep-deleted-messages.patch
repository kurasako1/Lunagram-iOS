+++ b/submodules/TelegramCore/Sources/SyncCore/SyncCore_LunagramDeletedMessageAttribute.swift
@@ -0,0 +1,22 @@
+import Foundation
+import Postbox
+
+/// Lunagram: сообщение удалено у собеседника, но сохранено у нас.
+///
+/// date — когда пришло удаление. По этой пометке возле времени рисуется
+/// метла, как на ПК.
+public final class LunagramDeletedMessageAttribute: MessageAttribute {
+    public let date: Int32
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+}
