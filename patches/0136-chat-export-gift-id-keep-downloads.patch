+import Foundation
+
+/// Не обрывать начатую закачку.
+///
+/// Живёт рядом с Ghost, а не в общем модуле Lunagram, и это нарочно: читает
+/// эту настройку AccountContext — очень низкий слой, от которого зависит
+/// почти всё приложение. Подключи туда общий Lunagram — и каждая наша
+/// новая мелочь пересобирала бы полприложения. Здесь меняется редко.
+public enum LunagramDownloadSettings {
+    private static let defaults = UserDefaults.standard
+
+    private enum Key {
+        static let keepDownloads = "lunagram.downloads.keep"
+    }
+
+    /// Держать свою ссылку на начатую закачку, чтобы она не оборвалась,
+    /// когда сообщение уходит с экрана.
+    public static var keepDownloads: Bool {
+        get { return defaults.bool(forKey: Key.keepDownloads) }
+        set { defaults.set(newValue, forKey: Key.keepDownloads) }
+    }
+}
