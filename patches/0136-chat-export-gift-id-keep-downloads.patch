+import Foundation
+import SwiftSignalKit
+import Postbox
+import LunagramGhost
+
+// Lunagram: не обрывать начатую закачку.
+//
+// Закачку в переписке держит узел сообщения: он подписывается на неё и
+// отпускает подписку, когда уходит с экрана. А с последней отпущенной ссылкой
+// управляющий закачками выкидывает запись и останавливает саму закачку.
+// Поэтому стоит выйти из переписки или отмотать далеко вверх — и недокачанное
+// бросается на полпути.
+//
+// Здесь держится своя ссылка: ничья, не привязанная ни к какому узлу.
+// Отпускается она сама — когда файл докачан или когда ждать уже бессмысленно.
+
+public final class LunagramKeepDownloads {
+    /// Всё делаем на одной очереди: список ниже общий, а трогают его и
+    /// начало закачки, и её конец.
+    private static let queue = Queue.mainQueue()
+    private static var held: [String: DisposableSet] = [:]
+
+    /// Сколько ждать, прежде чем отпустить. Не вечность: файл может не
+    /// докачаться никогда — например, его удалили с сервера, — и тогда наша
+    /// ссылка висела бы до конца работы приложения.
+    private static let limit: Double = 30.0 * 60.0
+
+    /// Подержать закачку своей ссылкой.
+    ///
+    /// `fetch` — тот же сигнал, который взял себе узел сообщения. Подписка на
+    /// него и есть ссылка: пока жива хоть одна, закачка идёт.
+    public static func keep(postbox: Postbox, resource: MediaResource, fetch: Signal<Void, NoError>) {
+        guard LunagramDownloadSettings.keepDownloads else {
+            return
+        }
+        let key = resource.id.stringRepresentation
+        queue.async {
+            guard self.held[key] == nil else {
+                return
+            }
+            let bag = DisposableSet()
+            self.held[key] = bag
+
+            bag.add(fetch.startStrict())
+
+            bag.add((postbox.mediaBox.resourceStatus(resource)
+            |> deliverOn(self.queue)).startStrict(next: { status in
+                if case .Local = status {
+                    LunagramKeepDownloads.release(key)
+                }
+            }))
+
+            bag.add((Signal<Never, NoError>.complete()
+            |> delay(self.limit, queue: self.queue)).startStrict(completed: {
+                LunagramKeepDownloads.release(key)
+            }))
+        }
+    }
+
+    private static func release(_ key: String) {
+        queue.async {
+            if let bag = self.held.removeValue(forKey: key) {
+                bag.dispose()
+            }
+        }
+    }
+}
