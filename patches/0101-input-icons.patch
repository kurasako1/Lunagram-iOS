diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramInputIconsController.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramInputIconsController.swift
new file mode 100644
index 00000000..19cb5ac7
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramInputIconsController.swift
@@ -0,0 +1,332 @@
+import AccountContext
+import AsyncDisplayKit
+import Display
+import Foundation
+import Lunagram
+import TelegramPresentationData
+import UIKit
+
+// Lunagram: где какой кнопке стоять на полосе ввода.
+//
+// Двигать кнопки прямо в переписке я не стал. Полоса ввода — самое частое
+// место в приложении, и режим правки поверх неё дрался бы за каждое
+// касание с набором текста, прокруткой и долгим нажатием на отправку.
+// Поэтому тут свой образец полосы: таскаешь по нему, а настоящая полоса
+// потом просто берёт готовые числа.
+
+/// Образец полосы ввода, по которому таскают кнопки.
+private final class LunagramInputIconsPreview: UIView {
+    private let fieldView = UIView()
+    private var chips: [LunagramInputIcons.Slot: UIView] = [:]
+    private var dragging: LunagramInputIcons.Slot?
+    private var dragStart = CGPoint()
+    private var dragOrigin = LunagramInputIcons.Placement()
+
+    var selected: LunagramInputIcons.Slot = .attach {
+        didSet {
+            self.updateChips()
+        }
+    }
+    var selectionChanged: (() -> Void)?
+    var placementChanged: (() -> Void)?
+
+    private var theme: PresentationTheme
+
+    init(theme: PresentationTheme) {
+        self.theme = theme
+        super.init(frame: CGRect())
+
+        self.fieldView.layer.cornerRadius = 18.0
+        self.addSubview(self.fieldView)
+
+        for slot in LunagramInputIcons.Slot.allCases {
+            let chip = UIView()
+            chip.layer.cornerRadius = 20.0
+            chip.isUserInteractionEnabled = false
+
+            let label = UILabel()
+            label.textAlignment = .center
+            label.font = UIFont.systemFont(ofSize: 18.0)
+            label.text = LunagramInputIconsPreview.glyph(for: slot)
+            label.tag = 1
+            chip.addSubview(label)
+
+            self.addSubview(chip)
+            self.chips[slot] = chip
+        }
+
+        self.applyTheme()
+
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.onPan))
+        self.addGestureRecognizer(pan)
+        let tap = UITapGestureRecognizer(target: self, action: #selector(self.onTap))
+        self.addGestureRecognizer(tap)
+    }
+
+    required init?(coder: NSCoder) {
+        preconditionFailure()
+    }
+
+    /// Значки рисуем буквами: тянуть сюда настоящие картинки Telegram ради
+    /// образца не стоит, а узнаются они и так.
+    private static func glyph(for slot: LunagramInputIcons.Slot) -> String {
+        switch slot {
+        case .attach:
+            return "📎"
+        case .menu:
+            return "☰"
+        case .send:
+            return "🎤"
+        }
+    }
+
+    func updateTheme(_ theme: PresentationTheme) {
+        self.theme = theme
+        self.applyTheme()
+    }
+
+    private func applyTheme() {
+        self.backgroundColor = self.theme.list.itemBlocksBackgroundColor
+        self.fieldView.backgroundColor = self.theme.chat.inputPanel.inputBackgroundColor
+        self.updateChips()
+    }
+
+    private func updateChips() {
+        for (slot, chip) in self.chips {
+            let isSelected = (slot == self.selected)
+            chip.backgroundColor = isSelected
+                ? self.theme.list.itemAccentColor.withAlphaComponent(0.22)
+                : self.theme.chat.inputPanel.inputBackgroundColor
+            chip.layer.borderWidth = isSelected ? 2.0 : 0.0
+            chip.layer.borderColor = self.theme.list.itemAccentColor.cgColor
+            if let label = chip.viewWithTag(1) as? UILabel {
+                label.textColor = self.theme.chat.inputPanel.inputTextColor
+            }
+        }
+        self.setNeedsLayout()
+    }
+
+    /// Куда кнопка встала бы без наших сдвигов.
+    private func basePosition(for slot: LunagramInputIcons.Slot, in size: CGSize) -> CGPoint {
+        let centerY = size.height / 2.0
+        switch slot {
+        case .attach:
+            return CGPoint(x: 40.0, y: centerY)
+        case .menu:
+            return CGPoint(x: 40.0, y: centerY - 46.0)
+        case .send:
+            return CGPoint(x: size.width - 40.0, y: centerY)
+        }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let size = self.bounds.size
+        self.fieldView.frame = CGRect(x: 68.0, y: size.height / 2.0 - 18.0, width: max(40.0, size.width - 68.0 - 68.0), height: 36.0)
+
+        for slot in LunagramInputIcons.Slot.allCases {
+            guard let chip = self.chips[slot] else {
+                continue
+            }
+            let base = self.basePosition(for: slot, in: size)
+            let placement = LunagramInputIcons.placement(slot)
+            chip.bounds = CGRect(origin: CGPoint(), size: CGSize(width: 40.0, height: 40.0))
+            chip.center = CGPoint(x: base.x + CGFloat(placement.offsetX), y: base.y + CGFloat(placement.offsetY))
+            chip.transform = placement.angle == 0
+                ? .identity
+                : CGAffineTransform(rotationAngle: CGFloat(placement.angle) * .pi / 180.0)
+            if let label = chip.viewWithTag(1) {
+                label.frame = chip.bounds
+            }
+        }
+    }
+
+    private func slot(at point: CGPoint) -> LunagramInputIcons.Slot? {
+        // Сверху вниз по списку: если кнопки наехали друг на друга, берём
+        // ту, что нарисована последней.
+        for slot in LunagramInputIcons.Slot.allCases.reversed() {
+            if let chip = self.chips[slot], chip.frame.insetBy(dx: -6.0, dy: -6.0).contains(point) {
+                return slot
+            }
+        }
+        return nil
+    }
+
+    @objc private func onTap(_ recognizer: UITapGestureRecognizer) {
+        guard let slot = self.slot(at: recognizer.location(in: self)) else {
+            return
+        }
+        self.selected = slot
+        self.selectionChanged?()
+    }
+
+    @objc private func onPan(_ recognizer: UIPanGestureRecognizer) {
+        let point = recognizer.location(in: self)
+        switch recognizer.state {
+        case .began:
+            guard let slot = self.slot(at: point) else {
+                return
+            }
+            self.dragging = slot
+            self.dragStart = point
+            self.dragOrigin = LunagramInputIcons.placement(slot)
+            self.selected = slot
+            self.selectionChanged?()
+        case .changed:
+            guard let slot = self.dragging else {
+                return
+            }
+            let delta = CGPoint(x: point.x - self.dragStart.x, y: point.y - self.dragStart.y)
+            var placement = self.dragOrigin
+            placement.offsetX = self.dragOrigin.offsetX + Int(delta.x)
+            placement.offsetY = self.dragOrigin.offsetY + Int(delta.y)
+            LunagramInputIcons.setPlacement(placement, for: slot)
+            self.setNeedsLayout()
+            self.placementChanged?()
+        default:
+            self.dragging = nil
+        }
+    }
+}
+
+private final class LunagramInputIconsNode: ASDisplayNode {
+    private var presentationData: PresentationData
+    private let scrollView = UIScrollView()
+    private let preview: LunagramInputIconsPreview
+    private let hintLabel = UILabel()
+    private let angleLabel = UILabel()
+    private let angleSlider = UISlider()
+    private let resetButton = UIButton(type: .system)
+
+    init(presentationData: PresentationData) {
+        self.presentationData = presentationData
+        self.preview = LunagramInputIconsPreview(theme: presentationData.theme)
+
+        super.init()
+
+        self.setViewBlock({
+            return UIView()
+        })
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        let theme = self.presentationData.theme
+        self.view.backgroundColor = theme.list.blocksBackgroundColor
+
+        self.view.addSubview(self.scrollView)
+        self.scrollView.alwaysBounceVertical = true
+        self.scrollView.addSubview(self.preview)
+
+        self.hintLabel.numberOfLines = 0
+        self.hintLabel.font = UIFont.systemFont(ofSize: 14.0)
+        self.hintLabel.textColor = theme.list.freeTextColor
+        self.hintLabel.text = "Перетащи кнопку пальцем по образцу. Нажми на неё, чтобы выбрать, и крути поворот ползунком.\n\nНастоящая полоса ввода возьмёт эти же числа. Пока ничего не сдвинуто, она рисуется ровно как обычно."
+        self.scrollView.addSubview(self.hintLabel)
+
+        self.angleLabel.font = UIFont.systemFont(ofSize: 15.0)
+        self.angleLabel.textColor = theme.list.itemPrimaryTextColor
+        self.scrollView.addSubview(self.angleLabel)
+
+        self.angleSlider.minimumValue = Float(-LunagramInputIcons.angleRange)
+        self.angleSlider.maximumValue = Float(LunagramInputIcons.angleRange)
+        self.angleSlider.addTarget(self, action: #selector(self.angleChanged), for: .valueChanged)
+        self.scrollView.addSubview(self.angleSlider)
+
+        self.resetButton.setTitle("Вернуть всё на место", for: .normal)
+        self.resetButton.setTitleColor(theme.list.itemDestructiveColor, for: .normal)
+        self.resetButton.addTarget(self, action: #selector(self.resetPressed), for: .touchUpInside)
+        self.scrollView.addSubview(self.resetButton)
+
+        self.preview.selectionChanged = { [weak self] in
+            self?.syncControls()
+        }
+        self.preview.placementChanged = { [weak self] in
+            self?.syncControls()
+        }
+        self.syncControls()
+    }
+
+    private func syncControls() {
+        let slot = self.preview.selected
+        let placement = LunagramInputIcons.placement(slot)
+        self.angleLabel.text = "\(slot.title): поворот \(placement.angle)°"
+        self.angleSlider.value = Float(placement.angle)
+    }
+
+    @objc private func angleChanged() {
+        let slot = self.preview.selected
+        var placement = LunagramInputIcons.placement(slot)
+        placement.angle = Int(self.angleSlider.value.rounded())
+        LunagramInputIcons.setPlacement(placement, for: slot)
+        self.preview.setNeedsLayout()
+        self.syncControls()
+    }
+
+    @objc private func resetPressed() {
+        LunagramInputIcons.reset()
+        self.preview.setNeedsLayout()
+        self.syncControls()
+    }
+
+    func updateLayout(layout: ContainerViewLayout, navigationHeight: CGFloat, transition: ContainedViewLayoutTransition) {
+        let sideInset = 16.0 + layout.safeInsets.left
+        let width = layout.size.width - sideInset * 2.0
+
+        self.scrollView.frame = CGRect(origin: CGPoint(), size: layout.size)
+        self.scrollView.contentInset = UIEdgeInsets(top: navigationHeight, left: 0.0, bottom: layout.intrinsicInsets.bottom, right: 0.0)
+
+        var y: CGFloat = 12.0
+        self.preview.frame = CGRect(x: sideInset, y: y, width: width, height: 160.0)
+        self.preview.layer.cornerRadius = 12.0
+        self.preview.clipsToBounds = true
+        y += 160.0 + 18.0
+
+        self.angleLabel.frame = CGRect(x: sideInset, y: y, width: width, height: 20.0)
+        y += 24.0
+        self.angleSlider.frame = CGRect(x: sideInset, y: y, width: width, height: 30.0)
+        y += 40.0
+
+        self.resetButton.frame = CGRect(x: sideInset, y: y, width: width, height: 44.0)
+        y += 52.0
+
+        let hintSize = self.hintLabel.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+        self.hintLabel.frame = CGRect(x: sideInset, y: y, width: width, height: hintSize.height)
+        y += hintSize.height + 24.0
+
+        self.scrollView.contentSize = CGSize(width: layout.size.width, height: y)
+    }
+}
+
+private final class LunagramInputIconsControllerImpl: ViewController {
+    private var presentationData: PresentationData
+
+    private var iconsNode: LunagramInputIconsNode {
+        return self.displayNode as! LunagramInputIconsNode
+    }
+
+    init(context: AccountContext) {
+        self.presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: self.presentationData))
+        self.title = "Раскладка кнопок"
+    }
+
+    required init(coder: NSCoder) {
+        preconditionFailure()
+    }
+
+    override func loadDisplayNode() {
+        self.displayNode = LunagramInputIconsNode(presentationData: self.presentationData)
+        self.displayNodeDidLoad()
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
