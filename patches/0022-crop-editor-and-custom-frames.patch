+    private static func drawCustom(source: UIImage, in context: CGContext, center: CGPoint, avatarSize: CGFloat) {
+        let scale = CGFloat(LunagramSettings.avatarFrameScale) / 100.0
+        let full = avatarSize * scale
+        let rect = CGRect(x: center.x - full / 2.0, y: center.y - full / 2.0, width: full, height: full)
+
+        // Осветление: 100 % — как есть, 300 % — заметно светлее. Делаем
