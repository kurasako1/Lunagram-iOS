+            context.saveGState()
+            context.setAlpha(0.5 * glow)
+            drawImage.draw(in: glowRect)
+            context.restoreGState()
+        }
+
+        drawImage.draw(in: rect)
+
+        if LunagramSettings.avatarFrameSparkle {
+            context.setFillColor(rgb(255, 252, 232).cgColor)
+            let radius = full / 2.0 * 1.02
