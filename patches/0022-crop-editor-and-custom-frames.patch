diff --git a/submodules/Lunagram/Sources/LunagramCropEditor.swift b/submodules/Lunagram/Sources/LunagramCropEditor.swift
new file mode 100644
index 00000000..ad9e3698
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramCropEditor.swift
@@ -0,0 +1,252 @@
+import AVFoundation
+import UIKit
+
+/// Окно подгонки кадра — как на ПК: двигаешь картинку пальцем, приближаешь
+/// щипком, сразу видно результат. Работает для фото и для видео.
+///
+/// Обычное окно UIKit, показанное поверх, а не экран Telegram: тут нужны
+/// только жесты и предпросмотр, а так — меньше зависимостей и надёжнее.
+public enum LunagramCropEditor {
+    public enum Kind {
+        case banner
+        case wallpaper
+    }
+
+    /// Показывает окно поверх `presenter`. onChange зовётся, когда кадр
+    /// поменяли, — чтобы обновить настройки-экран под ним.
+    public static func present(from presenter: UIViewController, kind: Kind, onChange: @escaping () -> Void) {
+        let editor = LunagramCropEditorViewController(kind: kind, onChange: onChange)
+        editor.modalPresentationStyle = .fullScreen
+        presenter.present(editor, animated: true, completion: nil)
+    }
+}
+
+private final class LunagramCropEditorViewController: UIViewController {
+    private let kind: LunagramCropEditor.Kind
+    private let onChange: () -> Void
+
+    private let clipView = UIView()
+    private let imageView = UIImageView()
+    private var playerLayer: AVPlayerLayer?
+    private var player: AVQueuePlayer?
+    private var looper: AVPlayerLooper?
+    private let dimView = UIView()
+    private let hintLabel = UILabel()
+
+    private var originalSize: CGSize = .zero
+    private var startCrop = LunagramSettings.Crop(offsetX: 0, offsetY: 0, zoom: 100)
+
+    init(kind: LunagramCropEditor.Kind, onChange: @escaping () -> Void) {
+        self.kind = kind
+        self.onChange = onChange
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private var crop: LunagramSettings.Crop {
+        get {
+            return kind == .banner ? LunagramSettings.bannerCrop : LunagramSettings.wallpaperCrop
+        }
+        set {
+            if kind == .banner {
+                LunagramSettings.bannerCrop = newValue
+            } else {
+                LunagramSettings.wallpaperCrop = newValue
+            }
+            self.onChange()
+        }
+    }
+
+    private var sourceURL: URL? {
+        return kind == .banner ? LunagramSettings.profileBannerURL : LunagramSettings.liveWallpaperURL
+    }
+
+    private var isVideo: Bool {
+        return kind == .banner ? LunagramSettings.profileBannerIsVideo : true
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .black
+
+        let bar = UINavigationBar()
+        bar.translatesAutoresizingMaskIntoConstraints = false
+        let item = UINavigationItem(title: kind == .banner ? "Кадр баннера" : "Кадр обоев")
+        item.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+        bar.items = [item]
+        self.view.addSubview(bar)
+        NSLayoutConstraint.activate([
+            bar.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+            bar.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+            bar.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor)
+        ])
+
+        self.clipView.clipsToBounds = true
+        self.clipView.backgroundColor = UIColor(white: 0.1, alpha: 1.0)
+        self.view.addSubview(self.clipView)
+
+        self.imageView.contentMode = .scaleToFill
+        self.clipView.addSubview(self.imageView)
+
+        self.dimView.backgroundColor = .black
+        self.dimView.isUserInteractionEnabled = false
+        self.clipView.addSubview(self.dimView)
+
+        self.hintLabel.text = "Двигай пальцем, приближай щипком"
+        self.hintLabel.textColor = UIColor(white: 1.0, alpha: 0.85)
+        self.hintLabel.font = .systemFont(ofSize: 14.0)
+        self.hintLabel.textAlignment = .center
+        self.hintLabel.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(self.hintLabel)
+        NSLayoutConstraint.activate([
+            self.hintLabel.leadingAnchor.constraint(equalTo: self.view.leadingAnchor, constant: 16.0),
+            self.hintLabel.trailingAnchor.constraint(equalTo: self.view.trailingAnchor, constant: -16.0),
+            self.hintLabel.bottomAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.bottomAnchor, constant: -20.0)
+        ])
+
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.handlePan(_:)))
+        let pinch = UIPinchGestureRecognizer(target: self, action: #selector(self.handlePinch(_:)))
+        pan.delegate = self
+        pinch.delegate = self
+        self.clipView.addGestureRecognizer(pan)
+        self.clipView.addGestureRecognizer(pinch)
+
+        self.loadSource()
+        self.applyDim()
+    }
+
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        self.layoutClip()
+        self.layoutContent()
+    }
+
+    override func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        self.player?.pause()
+    }
+
+    /// Область предпросмотра примерно тех же пропорций, что и место в
+    /// профиле: баннер широкий и низкий, обои — во весь экран.
+    private func layoutClip() {
+        let safe = self.view.safeAreaLayoutGuide.layoutFrame
+        let top = safe.minY + 44.0
+        let bottom = safe.maxY - 60.0
+        let availWidth = safe.width - 24.0
+        let availHeight = bottom - top
+        let box: CGRect
+        if kind == .banner {
+            let w = availWidth
+            let h = min(availHeight, w * 0.62)
+            box = CGRect(x: safe.minX + (safe.width - w) / 2.0, y: top + (availHeight - h) / 2.0, width: w, height: h)
+        } else {
+            let h = availHeight
+            let w = min(availWidth, h * 0.56)
+            box = CGRect(x: safe.minX + (safe.width - w) / 2.0, y: top, width: w, height: h)
+        }
+        self.clipView.frame = box
+        self.dimView.frame = self.clipView.bounds
+    }
+
+    private func layoutContent() {
+        guard self.originalSize.width > 0 else {
+            return
+        }
+        let placement = LunagramSettings.place(original: self.originalSize, target: self.clipView.bounds.size, crop: self.crop)
+        let frame = CGRect(origin: placement.origin, size: placement.size)
+        self.imageView.frame = frame
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.playerLayer?.frame = frame
+        CATransaction.commit()
+    }
+
+    private func loadSource() {
+        guard let url = self.sourceURL else {
+            return
+        }
+        if self.isVideo {
+            let asset = AVURLAsset(url: url)
+            if let track = asset.tracks(withMediaType: .video).first {
+                let rotated = CGRect(origin: .zero, size: track.naturalSize).applying(track.preferredTransform)
+                self.originalSize = CGSize(width: abs(rotated.width), height: abs(rotated.height))
+            }
+            let player = AVQueuePlayer()
+            player.isMuted = true
+            let item = AVPlayerItem(asset: asset)
+            self.looper = AVPlayerLooper(player: player, templateItem: item)
+            let layer = AVPlayerLayer(player: player)
+            layer.videoGravity = .resize
+            self.clipView.layer.insertSublayer(layer, below: self.dimView.layer)
+            self.playerLayer = layer
+            self.player = player
+            player.play()
+        } else {
+            if let image = UIImage(contentsOfFile: url.path) {
+                self.imageView.image = image
+                self.originalSize = image.size
+            }
+        }
+        self.view.setNeedsLayout()
+    }
+
+    private func applyDim() {
+        let index: Int
+        let alphas: [CGFloat]
+        if kind == .banner {
+            index = LunagramSettings.profileBannerDim
+            alphas = [0.0, 0.3, 0.55, 0.75]
+        } else {
+            index = LunagramSettings.liveWallpaperDim
+            alphas = [0.0, 0.25, 0.5]
+        }
+        self.dimView.alpha = alphas[max(0, min(alphas.count - 1, index))]
+    }
+
+    @objc private func handlePan(_ gesture: UIPanGestureRecognizer) {
+        guard self.originalSize.width > 0 else {
+            return
+        }
+        if gesture.state == .began {
+            self.startCrop = self.crop
+        }
+        let placement = LunagramSettings.place(original: self.originalSize, target: self.clipView.bounds.size, crop: self.startCrop)
+        let extraX = placement.size.width - self.clipView.bounds.width
+        let extraY = placement.size.height - self.clipView.bounds.height
+        let delta = gesture.translation(in: self.clipView)
+        var updated = self.startCrop
+        // Так же, как на ПК: сдвиг — доля от лишка, весь ход от −100 до +100.
+        if extraX > 0 {
+            updated.offsetX = self.startCrop.offsetX - Int((delta.x * 200.0 / extraX).rounded())
+        }
+        if extraY > 0 {
+            updated.offsetY = self.startCrop.offsetY - Int((delta.y * 200.0 / extraY).rounded())
+        }
+        self.crop = updated
+        self.layoutContent()
+    }
+
+    @objc private func handlePinch(_ gesture: UIPinchGestureRecognizer) {
+        if gesture.state == .began {
+            self.startCrop = self.crop
+        }
+        var updated = self.startCrop
+        updated.zoom = Int((Double(self.startCrop.zoom) * Double(gesture.scale)).rounded())
+        self.crop = updated
+        self.layoutContent()
+    }
+
+    @objc private func done() {
+        self.dismiss(animated: true, completion: nil)
+    }
+}
+
+extension LunagramCropEditorViewController: UIGestureRecognizerDelegate {
+    // Двигать и приближать можно одновременно — жесты не мешают друг другу.
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return true
+    }
+}
