+import Foundation
+
+// Lunagram: разбор текстов песен.
+//
+// Тексты приходят в двух видах. Простой — просто строки. Размеченный — строки
+// с временем: «[01:23.45] и тут он поёт». Второй и даёт караоке: видно, какая
+// строка звучит сейчас.
+//
+// Здесь только разбор, без сети и без картинки: так его легко читать и трудно
+// сломать.
+
+public struct LunagramLyricLine: Equatable {
+    /// Секунда, на которой строка начинает звучать. Нет времени — строка из
+    /// простого текста, подсвечивать её не по чему.
+    public let time: Double?
+    public let text: String
+
+    public init(time: Double?, text: String) {
+        self.time = time
+        self.text = text
+    }
+}
+
+/// Разобрать одну метку времени вида «01:23.45» или «01:23».
+private func lunagramParseStamp(_ value: String) -> Double? {
+    let parts = value.components(separatedBy: ":")
+    guard parts.count == 2, let minutes = Double(parts[0]) else {
+        return nil
+    }
+    // Доли секунды отделяются точкой, но кое-где ставят и запятую.
+    let secondsText = parts[1].replacingOccurrences(of: ",", with: ".")
+    guard let seconds = Double(secondsText) else {
+        return nil
+    }
+    return minutes * 60.0 + seconds
+}
+
+/// Собрать строки песни: сперва размеченные, а если их нет — простые.
+public func lunagramParseLyrics(synced: String?, plain: String?) -> [LunagramLyricLine] {
+    if let synced = synced, !synced.isEmpty {
+        var result: [LunagramLyricLine] = []
+        for raw in synced.components(separatedBy: "\n") {
+            var rest = raw
+            var stamps: [Double] = []
+            // У одной строки меток может быть несколько: припев поют не раз, а
+            // пишут его в файле однажды.
+            while rest.hasPrefix("[") {
+                guard let close = rest.firstIndex(of: "]") else {
+                    break
+                }
+                let inside = String(rest[rest.index(after: rest.startIndex) ..< close])
+                rest = String(rest[rest.index(after: close)...])
+                if let stamp = lunagramParseStamp(inside) {
+                    stamps.append(stamp)
+                }
+            }
+            let text = rest.trimmingCharacters(in: .whitespaces)
+            for stamp in stamps {
+                result.append(LunagramLyricLine(time: stamp, text: text))
+            }
+        }
+        if !result.isEmpty {
+            result.sort(by: { ($0.time ?? 0.0) < ($1.time ?? 0.0) })
+            return result
+        }
+    }
+
+    guard let plain = plain, !plain.isEmpty else {
+        return []
+    }
+    return plain.components(separatedBy: "\n").map { line in
+        return LunagramLyricLine(time: nil, text: line.trimmingCharacters(in: .whitespaces))
+    }
+}
+
+/// Какая строка звучит сейчас. Отдаём последнюю, чьё время уже прошло.
+public func lunagramCurrentLyricLine(_ lines: [LunagramLyricLine], at position: Double) -> Int? {
+    var found: Int?
+    for (index, line) in lines.enumerated() {
+        guard let time = line.time else {
+            continue
+        }
+        if time <= position {
+            found = index
+        } else {
+            break
+        }
+    }
+    return found
+}
