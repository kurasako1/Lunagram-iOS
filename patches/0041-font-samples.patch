+    /// Шрифт для показа образца в списке: 0 — системный, 1…7 — готовые,
+    /// `ownFileStyle` — свой файл. Нужен, чтобы строка выбора писалась тем
+    /// самым шрифтом и было видно, какой из них какой.
+    public static func sampleFont(styleIndex: Int, size: CGFloat) -> UIFont? {
+        if styleIndex == 0 {
+            return nil
+        }
+        if styleIndex == ownFileStyle {
+            lock.lock()
+            let family = resolvedFamily()
+            lock.unlock()
+            guard let family = family else {
+                return nil
+            }
+            return UIFont(name: family, size: size)
+        }
+        return builtInFont(style: styleIndex, size: size)
+    }
