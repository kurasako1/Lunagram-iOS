+/// Контурные значки, как на ПК: символ из набора самого айфона, серого
+/// цвета, без цветного квадрата. Клетка 30×30 — как у значков Telegram,
+/// чтобы названия строк стояли на одной линии с соседними экранами.
+private final class LunagramLineIcons {
+    static let shared = LunagramLineIcons()
+
+    private var cache: [String: UIImage] = [:]
+
+    func image(_ names: String?, color: UIColor) -> UIImage? {
+        guard let names = names else {
+            return nil
+        }
+        let key = "\(names)|\(color.argb)"
+        if let cached = self.cache[key] {
+            return cached
+        }
+        let configuration = UIImage.SymbolConfiguration(pointSize: 19.0, weight: .regular)
+        var found: UIImage?
+        for name in names.split(separator: ",") {
+            if let symbol = UIImage(systemName: String(name), withConfiguration: configuration) {
+                found = symbol
+                break
+            }
+        }
+        guard let symbol = found?.withTintColor(color, renderingMode: .alwaysOriginal) else {
+            return nil
+        }
+        let size = CGSize(width: 30.0, height: 30.0)
+        let image = UIGraphicsImageRenderer(size: size).image { _ in
+            let symbolSize = symbol.size
+            symbol.draw(in: CGRect(x: floor((size.width - symbolSize.width) / 2.0), y: floor((size.height - symbolSize.height) / 2.0), width: symbolSize.width, height: symbolSize.height))
+        }
+        self.cache[key] = image
+        return image
+    }
+}
+
+private func lunagramLineIcon(_ names: String?, _ presentationData: ItemListPresentationData) -> UIImage? {
+    return LunagramLineIcons.shared.image(names, color: presentationData.theme.list.itemSecondaryTextColor)
+}
