+    case read(Bool, [Bool])
+    // Строка со значением справа, как на ПК: что открыть, название,
+    // значение, значок. Нажатие открывает выбор.
+    case value(Int32, String, String, String?)
+    case info(String)
+}
+
+/// Собирает экран как на ПК: заголовок раздела, строки, под строкой —
+/// подпись. Подпись закрывает свой блок, и следующая строка идёт уже новым
+/// блоком — так подпись встаёт ровно под своей строкой, как на ПК.
+private struct LunagramRowsBuilder {
+    private(set) var entries: [LunagramSettingsEntry] = []
+    private var block: Int32 = 0
+    private var order: Int32 = 0
+    private var closed = false
+
+    mutating func header(_ text: String) {
+        if !self.entries.isEmpty {
+            self.block += 1
+        }
+        self.closed = false
+        self.append(.header(text))
+    }
+
+    mutating func row(_ row: LunagramRow) {
+        if self.closed {
+            self.block += 1
+            self.closed = false
+        }
+        self.append(row)
+    }
+
+    mutating func info(_ text: String) {
+        self.row(.info(text))
+        self.closed = true
+    }
+
+    /// Разрыв без подписи: следующая строка — новым блоком.
+    mutating func split() {
+        self.closed = true
+    }
+
+    private mutating func append(_ row: LunagramRow) {
+        self.entries.append(.row(1000 + self.block, self.order, row))
+        self.order += 1
+    }
+}
