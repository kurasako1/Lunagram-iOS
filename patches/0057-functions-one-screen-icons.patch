+        })
+    case let .value(id, title, value, iconName):
+        return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: lunagramLineIcon(iconName, presentationData), title: title, label: value, sectionId: sectionId, style: .blocks, action: {
+            arguments.openChoice(id)
+        })
+    case let .info(text):
+        return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: sectionId)
+    }
+}
