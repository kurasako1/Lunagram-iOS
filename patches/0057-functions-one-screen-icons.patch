+/// Экран выбора одного значения из списка — как окошко выбора на ПК.
+private func lunagramChoiceScreen(context: AccountContext, title: String, options: [String], selected: Int, info: String?, select: @escaping (Int) -> Void) -> ViewController {
+    let selectedPromise = ValuePromise<Int>(selected, ignoreRepeated: true)
+    let arguments: (Int) -> Void = { index in
+        selectedPromise.set(index)
+        select(index)
+    }
+    let signal = combineLatest(context.sharedContext.presentationData, selectedPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, current -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries = options.enumerated().map { LunagramChoiceEntry.option(Int32($0.offset), $0.element, $0.offset == current) }
+        if let info = info {
+            entries.append(.info(info))
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
