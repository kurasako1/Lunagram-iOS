+/// Экран «Функции» — один, как на ПК. Режим призрака одним разделом вместе
+/// с сохранением удалённых: для хозяина это одно целое, и на ПК теперь так
+/// же. Под каждой строкой — подпись, как на ПК. Внизу — то, чего на ПК нет.
+private func lunagramFunctionsEntries(values: [LunagramToggle: Bool], media: LunagramMediaState, ghostExpanded: Bool, expandedToggles: Set<Int32>) -> [LunagramSettingsEntry] {
+    func value(_ toggle: LunagramToggle) -> Bool {
+        return values[toggle] ?? toggle.value
+    }
+    var rows = LunagramRowsBuilder()
+
+    rows.header("Режим призрака")
+    rows.row(.ghost(ghostExpanded, lunagramGhostToggles.map { value($0) }))
+    rows.row(.read(expandedToggles.contains(LunagramToggle.markReadAfterSend.rawValue), lunagramMarkReadToggles.map { value($0) }))
+    rows.info("Автоматически читает сообщение при отправке нового, при реакции на сообщение или голосе в опросе. Призрак при этом остаётся включённым.")
+    rows.row(.toggle(.useScheduledSend, value(.useScheduledSend), "Использовать отложку", nil))
+    rows.info("Автоматически ставит задержку в ~12 секунд (дольше для сообщений с вложениями) при отправке сообщений. При использовании этой функции ты не будешь появляться в сети.\nНе рекомендуется использовать на слабом интернете.")
+    let sound = max(0, min(LunagramSettings.sendWithoutSoundTitles.count - 1, media.sendWithoutSound))
+    rows.row(.value(LunagramChoice.sendWithoutSound.rawValue, "Отправлять без звука", LunagramSettings.sendWithoutSoundTitles[sound], nil))
+    rows.info("Отправляет сообщения по умолчанию без звука.")
+    rows.row(.toggle(.suggestGhostForStories, value(.suggestGhostForStories), "Предлагать призрака для сторис", nil))
+    rows.info("Показывает предупреждение перед открытием сторис, предлагая включить режим призрака.")
+    rows.row(.toggle(.keepDeleted, value(.keepDeleted), "Сохранять удалённые сообщения", nil))
+    rows.row(.toggle(.keepEditHistory, value(.keepEditHistory), "Сохранять историю правок", nil))
+    rows.split()
+    rows.row(.toggle(.saveForBots, value(.saveForBots), "Сохранять в чатах с ботами", nil))
+
+    rows.header("Другое")
+    rows.row(.toggle(.disableAds, value(.disableAds), "Отключить рекламу", "nosign"))
+    rows.info("Скрывает спонсорские сообщения в каналах.")
+    rows.row(.toggle(.showMessageShot, value(.showMessageShot), "Показывать ф-ию снимка сообщений", "eye"))
+    rows.info("Позволяет снять сообщение в аккуратную картинку: зажми его → «Снимок сообщения».")
+    rows.row(.toggle(.streamerMode, value(.streamerMode), "Режим стримера", "dot.radiowaves.left.and.right"))
+    rows.info("Прячет содержимое, пока айфон записывает или транслирует экран. Срабатывает само — айфон сам говорит, что экран пишется.")
+    rows.row(.toggle(.hideOwnPhone, value(.hideOwnPhone), "Скрыть свой номер", "phone"))
+    rows.info("В твоём профиле вместо номера будут точки. Сам номер не меняется — прячется только показ на экране.")
+
+    rows.header("Мут")
+    rows.row(.toggle(.showMutedDeleted, value(.showMutedDeleted), "Показывать удалённые в чате", "square.grid.2x2"))
+    rows.info("Заглушить человека: зажми его сообщение → «Заглушить». Его новые сообщения приходят с корзинкой, как удалённые. Выключи — и не будут появляться у тебя вовсе.")
+    rows.row(.toggle(.showMessageSeconds, value(.showMessageSeconds), "Время с секундами", "stopwatch"))
+    rows.info("У сообщений будет видно не только час и минуту, но и секунды.")
+    let fonts = LunagramSendFont.allCases
+    let font = fonts[max(0, min(fonts.count - 1, media.sendFontStyle))]
+    rows.row(.value(LunagramChoice.sendFont.rawValue, "Шрифт отправки", font.title, "textformat"))
+    rows.info("Буквы заменяются похожими символами Юникода, поэтому стиль видят все — в любом клиенте. Такой текст не находится поиском Telegram.")
+    let masks = LunagramSettings.deviceMaskPresets
+    let mask = masks[max(0, min(masks.count - 1, media.deviceMask))]
+    rows.row(.value(LunagramChoice.deviceMask.rawValue, "Маскировка устройства", mask.title, "iphone"))
+    rows.info("Telegram покажет выбранное устройство в списке твоих сессий вместо настоящего — вместе со значком. Применяется при следующем запуске.")
+
+    rows.header("Сообщения")
+    rows.row(.toggle(.showRoundSource, value(.showRoundSource), "Откуда записан кружок", "info.circle"))
+    rows.info("Рядом с длительностью кружка появится iOS, Android или Desktop. Когда определить не выходит, метки просто нет — неверная хуже отсутствующей.")
+
+    // Этого на экране ПК нет — айфонное. Внизу того же экрана, как решили.
+    rows.header("Только на айфоне")
+    let phoneOnly: [LunagramToggle] = [.roundFromVideo, .showPeerId, .replyToDeleted, .showDeletedGifts, .giftTheSame, .sendSoldOutGifts]
+    for toggle in phoneOnly {
+        rows.row(.toggle(toggle, value(toggle), toggle.title, toggle.iconName))
+        if let text = toggle.descriptionText {
+            rows.info(text)
+        }
+    }
+    rows.row(.value(LunagramChoice.fontAndWording.rawValue, "Шрифт и надписи", "", "textformat.size"))
+    rows.info("Шрифт всего приложения и свои надписи вместо телеграмовских — «языки».")
+
+    return rows.entries
+}
