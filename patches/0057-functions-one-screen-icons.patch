+/// Строка экрана, собранного по образцу ПК: заголовок раздела, строка,
+/// подпись под ней. Номер блока и порядок раздаёт LunagramRowsBuilder.
+private enum LunagramRow: Equatable {
+    case header(String)
+    // Переключатель: какой, включён ли, название, значок.
+    case toggle(LunagramToggle, Bool, String, String?)
