+/// Что открывает строка со значением справа.
+private enum LunagramChoice: Int32 {
+    case sendWithoutSound = 1
+    case sendFont = 2
+    case deviceMask = 3
+    case fontAndWording = 4
+}
+
+private enum LunagramChoiceEntry: ItemListNodeEntry {
+    case option(Int32, String, Bool)
+    case info(String)
+
+    var section: ItemListSectionId {
+        return 0
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .option(index, _, _):
+            return index
+        case .info:
+            return 10_000
+        }
+    }
+
+    static func ==(lhs: LunagramChoiceEntry, rhs: LunagramChoiceEntry) -> Bool {
+        switch lhs {
+        case let .option(lhsIndex, lhsTitle, lhsChecked):
+            if case let .option(rhsIndex, rhsTitle, rhsChecked) = rhs, lhsIndex == rhsIndex, lhsTitle == rhsTitle, lhsChecked == rhsChecked {
+                return true
+            } else {
+                return false
+            }
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        }
+    }
+
+    static func <(lhs: LunagramChoiceEntry, rhs: LunagramChoiceEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let select = arguments as! (Int) -> Void
+        switch self {
+        case let .option(index, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                select(Int(index))
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
