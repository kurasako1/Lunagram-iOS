+/// Окошко «впиши название». Родное системное — такое же, как в редакторе
+/// надписей: поле ввода и две кнопки.
+private func lunagramAskName(context: AccountContext, title: String, value: String, done: @escaping (String) -> Void) {
+    let alert = UIAlertController(title: title, message: "Как назвать набор?", preferredStyle: .alert)
+    alert.addTextField(configurationHandler: { field in
+        field.text = value
+        field.placeholder = "Название"
+        field.clearButtonMode = .whileEditing
+        field.autocapitalizationType = .sentences
+    })
+    alert.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: nil))
+    alert.addAction(UIAlertAction(title: "Готово", style: .default, handler: { [weak alert] _ in
+        let name = (alert?.textFields?.first?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !name.isEmpty else {
+            return
+        }
+        done(name)
+    }))
+    (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController?.present(alert, animated: true, completion: nil)
+}
+
+/// Окошко «точно удалить?» — набор со словами вернуть будет нельзя.
+private func lunagramAskDelete(context: AccountContext, title: String, done: @escaping () -> Void) {
+    let alert = UIAlertController(title: title, message: "Удалить набор вместе со словами? Вернуть его будет нельзя.", preferredStyle: .alert)
+    alert.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: nil))
+    alert.addAction(UIAlertAction(title: "Удалить", style: .destructive, handler: { _ in
+        done()
+    }))
+    (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController?.present(alert, animated: true, completion: nil)
+}
