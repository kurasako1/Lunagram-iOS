diff --git a/submodules/Lunagram/Sources/LunagramProfileBackgroundView.swift b/submodules/Lunagram/Sources/LunagramProfileBackgroundView.swift
new file mode 100644
index 00000000..0a63810d
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramProfileBackgroundView.swift
@@ -0,0 +1,108 @@
+import Foundation
+import UIKit
+
+/// Своя картинка под списком — в профиле и на экранах настроек.
+///
+/// Держится по размеру экрана, а не по длине списка: списки бывают очень
+/// длинные, и растянутая на них картинка превратилась бы в полосу. Так она
+/// остаётся на виду и как будто едет за тобой, пока крутишь.
+///
+/// Лежит в общем куске сборки, а не рядом с профилем, потому что нужна и
+/// экранам настроек: они собраны из другого куска и до профиля не достают.
+public final class LunagramProfileBackgroundView: UIView {
+    /// Где показываемся. В профиле картинка кладётся только под свой профиль
+    /// своего же аккаунта, иначе она легла бы под чужую страницу и под второй
+    /// аккаунт. На экранах настроек такой проверки нет: настройки и так свои.
+    public enum Place {
+        case profile
+        case settings
+    }
+
+    private let place: Place
+    private let imageView = UIImageView()
+    private let blurView = UIVisualEffectView(effect: UIBlurEffect(style: .regular))
+    private let dimView = UIView()
+    private var shownURL: URL?
+    private var settingsObserver: NSObjectProtocol?
+    private var accountId: Int64 = 0
+    private var screenId: Int64 = 0
+
+    public init(place: Place = .profile) {
+        self.place = place
+        super.init(frame: CGRect())
+        self.isUserInteractionEnabled = false
+        self.clipsToBounds = true
+
+        // Кадр считаем сами (см. layoutImage), поэтому картинка просто
+        // заполняет выданную ей рамку.
+        self.imageView.contentMode = .scaleToFill
+        self.addSubview(self.imageView)
+
+        self.blurView.isUserInteractionEnabled = false
+        self.addSubview(self.blurView)
+
+        self.dimView.backgroundColor = .black
+        self.dimView.isUserInteractionEnabled = false
+        self.addSubview(self.dimView)
+
+        self.reload()
+        self.settingsObserver = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+    }
+
+    public required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let settingsObserver = self.settingsObserver {
+            NotificationCenter.default.removeObserver(settingsObserver)
+        }
+    }
+
+    /// Чей это экран: свой профиль своего же аккаунта — или чужая страница.
+    public func setOwner(account: Int64, screen: Int64) {
+        self.accountId = account
+        self.screenId = screen
+        self.reload()
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        let bounds = self.bounds
+        self.layoutImage()
+        self.blurView.frame = bounds
+        self.dimView.frame = bounds
+    }
+
+    /// Картинка — по выбранному кадру: сдвиг и приближение, как у баннера
+    /// и обоев. Без подгонки кадр — середина картинки.
+    private func layoutImage() {
+        let bounds = self.bounds
+        guard let image = self.imageView.image, image.size.width > 0.0 else {
+            self.imageView.frame = bounds
+            return
+        }
+        let placement = LunagramSettings.place(original: image.size, target: bounds.size, crop: LunagramSettings.profileBackgroundCrop)
+        self.imageView.frame = CGRect(origin: placement.origin, size: placement.size)
+    }
+
+    /// Настройки поменялись: перечитываем картинку и силу затемнения.
+    public func reload() {
+        let url = LunagramSettings.profileBackgroundURL
+        if url != self.shownURL {
+            self.shownURL = url
+            self.imageView.image = url.flatMap { UIImage(contentsOfFile: $0.path) }
+        }
+        switch self.place {
+        case .profile:
+            self.isHidden = !LunagramSettings.showsProfileBackground(account: self.accountId, screen: self.screenId)
+        case .settings:
+            self.isHidden = !LunagramSettings.hasProfileBackground || !LunagramSettings.settingsBackground
+        }
+        self.dimView.alpha = CGFloat(LunagramSettings.profileBackgroundDim) / 100.0
+        self.blurView.alpha = CGFloat(LunagramSettings.profileBackgroundBlur) / 100.0
+        self.layoutImage()
+    }
+}
