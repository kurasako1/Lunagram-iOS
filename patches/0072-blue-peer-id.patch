+/// Lunagram: копирует ID и говорит об этом, как Telegram говорит о
+/// скопированном имени пользователя.
+private func lunagramCopyPeerId(_ value: String, presentationData: PresentationData, controller: ViewController?) {
+    UIPasteboard.general.string = value
+    controller?.present(UndoOverlayController(presentationData: presentationData, content: .copy(text: "ID скопирован"), elevatedLayout: false, animateInAsReplacement: false, action: { _ in return false }), in: .current)
