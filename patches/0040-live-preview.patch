@@ -0,0 +1,284 @@
+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import Lunagram
+
+/// Что показываем в образце.
+enum LunagramPreviewKind {
+    case dialogCard
+    case avatarFrame
+    case name
+}
+
+/// Живой образец сверху экрана настроек — «так это будет выглядеть», как на
+/// ПК. Рисуют его те же куски, что рисуют настоящий интерфейс, поэтому
+/// образец не врёт: что видно здесь, то и получится.
+final class LunagramPreviewItem: ListViewItem, ItemListItem {
+    let presentationData: ItemListPresentationData
+    let kind: LunagramPreviewKind
+    /// Слепок настроек: меняется — значит образец надо перерисовать.
+    let token: Int
+    let sectionId: ItemListSectionId
+
+    init(presentationData: ItemListPresentationData, kind: LunagramPreviewKind, token: Int, sectionId: ItemListSectionId) {
+        self.presentationData = presentationData
+        self.kind = kind
+        self.token = token
+        self.sectionId = sectionId
+    }
+
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, previousItem: ListViewItem?, nextItem: ListViewItem?, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        async {
+            let node = LunagramPreviewItemNode()
+            let (layout, apply) = node.asyncLayout()(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            Queue.mainQueue().async {
+                completion(node, {
+                    return (nil, { _ in apply() })
+                })
+            }
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            if let node = node() as? LunagramPreviewItemNode {
+                let makeLayout = node.asyncLayout()
+                async {
+                    let (layout, apply) = makeLayout(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+                    Queue.mainQueue().async {
+                        completion(layout, { _ in apply() })
+                    }
+                }
+            }
+        }
+    }
+}
+
+final class LunagramPreviewItemNode: ListViewItemNode {
+    private let backgroundNode: ASDisplayNode
+    private let topStripeNode: ASDisplayNode
+    private let bottomStripeNode: ASDisplayNode
+    private let maskNode: ASImageNode
+
+    /// Сюда кладём то, что показываем. У каждого вида свои слои.
+    private let previewContainer: UIView
+    private var cardView: LunagramDialogCardView?
+    private let avatarView: UIView
+    private let frameHost: UIView
+    private let titleNode: TextNode
+    private let subtitleNode: TextNode
+
+    private var item: LunagramPreviewItem?
+
+    init() {
+        self.backgroundNode = ASDisplayNode()
+        self.backgroundNode.isLayerBacked = true
+        self.topStripeNode = ASDisplayNode()
+        self.topStripeNode.isLayerBacked = true
+        self.bottomStripeNode = ASDisplayNode()
+        self.bottomStripeNode.isLayerBacked = true
+        self.maskNode = ASImageNode()
+
+        self.previewContainer = UIView()
+        self.previewContainer.isUserInteractionEnabled = false
+        self.previewContainer.clipsToBounds = true
+
+        self.avatarView = UIView()
+        self.frameHost = UIView()
+        self.frameHost.isUserInteractionEnabled = false
+
+        self.titleNode = TextNode()
+        self.titleNode.isUserInteractionEnabled = false
+        self.subtitleNode = TextNode()
+        self.subtitleNode.isUserInteractionEnabled = false
+
+        super.init(layerBacked: false)
+
+        self.addSubnode(self.titleNode)
+        self.addSubnode(self.subtitleNode)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.view.addSubview(self.previewContainer)
+        self.previewContainer.addSubview(self.avatarView)
+        self.previewContainer.addSubview(self.frameHost)
+    }
+
+    func asyncLayout() -> (_ item: LunagramPreviewItem, _ params: ListViewItemLayoutParams, _ neighbors: ItemListNeighbors) -> (ListViewItemNodeLayout, () -> Void) {
+        let makeTitleLayout = TextNode.asyncLayout(self.titleNode)
+        let makeSubtitleLayout = TextNode.asyncLayout(self.subtitleNode)
+
+        return { item, params, neighbors in
+            let separatorHeight = UIScreenPixel
+            let leftInset = 16.0 + params.leftInset
+
+            // Для имени цвет и свечение берём из настроек — как в профиле.
+            let nameColor = LunagramSettings.profileNameTint().flatMap { UIColor(cgColor: $0) } ?? item.presentationData.theme.list.itemPrimaryTextColor
+            let titleFont: UIFont
+            let titleColor: UIColor
+            switch item.kind {
+            case .name:
+                titleFont = Font.medium(24.0)
+                titleColor = nameColor
+            default:
+                titleFont = Font.medium(16.0)
+                titleColor = item.presentationData.theme.list.itemPrimaryTextColor
+            }
+
+            let titleText: String = "kura"
+            let subtitleText: String
+            switch item.kind {
+            case .dialogCard:
+                subtitleText = "Так будет выглядеть переписка"
+            case .avatarFrame:
+                subtitleText = "Так будет выглядеть аватарка"
+            case .name:
+                subtitleText = "Так будет выглядеть имя"
+            }
+
+            let (titleLayout, titleApply) = makeTitleLayout(TextNodeLayoutArguments(attributedString: NSAttributedString(string: titleText, font: titleFont, textColor: titleColor), backgroundColor: nil, maximumNumberOfLines: 1, truncationType: .end, constrainedSize: CGSize(width: params.width - leftInset * 2.0, height: .greatestFiniteMagnitude), alignment: .natural, cutout: nil, insets: UIEdgeInsets()))
+            let (subtitleLayout, subtitleApply) = makeSubtitleLayout(TextNodeLayoutArguments(attributedString: NSAttributedString(string: subtitleText, font: Font.regular(13.0), textColor: item.presentationData.theme.list.itemSecondaryTextColor), backgroundColor: nil, maximumNumberOfLines: 1, truncationType: .end, constrainedSize: CGSize(width: params.width - leftInset * 2.0, height: .greatestFiniteMagnitude), alignment: .natural, cutout: nil, insets: UIEdgeInsets()))
+
+            let previewHeight: CGFloat
+            switch item.kind {
+            case .dialogCard:
+                previewHeight = 84.0
+            case .avatarFrame:
+                previewHeight = 150.0
+            case .name:
+                previewHeight = 76.0
+            }
+            let contentSize = CGSize(width: params.width, height: previewHeight)
+            let insets = itemListNeighborsGroupedInsets(neighbors, params)
+            let layout = ListViewItemNodeLayout(contentSize: contentSize, insets: insets)
+            let layoutSize = layout.size
+
+            return (layout, { [weak self] in
+                guard let strongSelf = self else {
+                    return
+                }
+                strongSelf.item = item
+
+                strongSelf.backgroundNode.backgroundColor = item.presentationData.theme.list.itemBlocksBackgroundColor
+                strongSelf.topStripeNode.backgroundColor = item.presentationData.theme.list.itemBlocksSeparatorColor
+                strongSelf.bottomStripeNode.backgroundColor = item.presentationData.theme.list.itemBlocksSeparatorColor
+                if strongSelf.backgroundNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.backgroundNode, at: 0)
+                }
+                if strongSelf.topStripeNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.topStripeNode, at: 1)
+                }
+                if strongSelf.bottomStripeNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.bottomStripeNode, at: 2)
+                }
+                if strongSelf.maskNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.maskNode, at: 3)
+                }
+                let hasCorners = itemListHasRoundedBlockLayout(params)
+                var hasTopCorners = false
+                var hasBottomCorners = false
+                switch neighbors.top {
+                case .sameSection(false):
+                    strongSelf.topStripeNode.isHidden = true
+                default:
+                    hasTopCorners = true
+                    strongSelf.topStripeNode.isHidden = hasCorners
+                }
+                switch neighbors.bottom {
+                case .sameSection(false):
+                    strongSelf.bottomStripeNode.isHidden = false
+                default:
+                    hasBottomCorners = true
+                    strongSelf.bottomStripeNode.isHidden = hasCorners
+                }
+                strongSelf.maskNode.image = hasCorners ? PresentationResourcesItemList.cornersImage(item.presentationData.theme, top: hasTopCorners, bottom: hasBottomCorners, glass: false) : nil
+                strongSelf.backgroundNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: params.width, height: contentSize.height + min(insets.top, separatorHeight) + min(insets.bottom, separatorHeight)))
+                strongSelf.maskNode.frame = strongSelf.backgroundNode.frame.insetBy(dx: params.leftInset, dy: 0.0)
+                strongSelf.topStripeNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: layoutSize.width, height: separatorHeight))
+                strongSelf.bottomStripeNode.frame = CGRect(origin: CGPoint(x: 0.0, y: contentSize.height - separatorHeight), size: CGSize(width: layoutSize.width - params.rightInset - 16.0, height: separatorHeight))
+
+                let rowRect = CGRect(x: params.leftInset, y: 0.0, width: params.width - params.leftInset - params.rightInset, height: contentSize.height)
+                strongSelf.previewContainer.frame = rowRect
+
+                let _ = titleApply()
+                let _ = subtitleApply()
+
+                strongSelf.updateContent(item: item, rowSize: rowRect.size, titleSize: titleLayout.size, subtitleSize: subtitleLayout.size, leftInset: leftInset, params: params)
+            })
+        }
+    }
+
+    /// Собственно образец: у каждого вида своя раскладка.
+    private func updateContent(item: LunagramPreviewItem, rowSize: CGSize, titleSize: CGSize, subtitleSize: CGSize, leftInset: CGFloat, params: ListViewItemLayoutParams) {
+        let theme = item.presentationData.theme
+
+        switch item.kind {
+        case .dialogCard:
+            // Настоящая плитка из списка переписок — с теми же настройками.
+            let card: LunagramDialogCardView
+            if let current = self.cardView {
+                card = current
+            } else {
+                card = LunagramDialogCardView(frame: CGRect())
+                self.cardView = card
+                self.previewContainer.insertSubview(card, at: 0)
+            }
+            card.setColor(theme.list.itemAccentColor)
+            card.update(rowSize: rowSize, themeBackgroundColor: theme.list.plainBackgroundColor, isMuted: false)
+            card.applySettings()
+
+            self.avatarView.isHidden = false
+            self.frameHost.isHidden = true
+            let avatarSize: CGFloat = 44.0
+            self.avatarView.frame = CGRect(x: 14.0, y: floor((rowSize.height - avatarSize) / 2.0), width: avatarSize, height: avatarSize)
+            self.avatarView.layer.cornerRadius = avatarSize / 2.0
+            self.avatarView.backgroundColor = theme.list.itemAccentColor
+            self.avatarView.layer.sublayers?.forEach { $0.removeFromSuperlayer() }
+
+            let textX = leftInset + avatarSize + 12.0
+            self.titleNode.frame = CGRect(x: textX, y: floor(rowSize.height / 2.0) - titleSize.height - 2.0, width: titleSize.width, height: titleSize.height)
+            self.subtitleNode.frame = CGRect(x: textX, y: floor(rowSize.height / 2.0) + 2.0, width: subtitleSize.width, height: subtitleSize.height)
+
+        case .avatarFrame:
+            self.cardView?.isHidden = true
+            self.avatarView.isHidden = false
+            self.frameHost.isHidden = false
+            let avatarSize: CGFloat = 74.0
+            let centerX = rowSize.width / 2.0
+            let centerY = 76.0
+            self.avatarView.frame = CGRect(x: centerX - avatarSize / 2.0, y: centerY - avatarSize / 2.0, width: avatarSize, height: avatarSize)
+            self.avatarView.layer.cornerRadius = avatarSize / 2.0
+            self.avatarView.backgroundColor = theme.list.itemAccentColor
+            // Рамка рисуется вокруг начала координат своего слоя.
+            self.frameHost.frame = CGRect(x: centerX, y: centerY, width: 0.0, height: 0.0)
+            LunagramAvatarFrameLayer.update(in: self.frameHost.layer, avatarSize: avatarSize, skip: 0.0, active: LunagramSettings.avatarFrameEnabled)
+
+            self.titleNode.frame = CGRect(x: floor((rowSize.width - titleSize.width) / 2.0), y: 8.0, width: titleSize.width, height: titleSize.height)
+            self.subtitleNode.frame = CGRect(x: floor((rowSize.width - subtitleSize.width) / 2.0), y: rowSize.height - subtitleSize.height - 10.0, width: subtitleSize.width, height: subtitleSize.height)
+
+        case .name:
+            self.cardView?.isHidden = true
+            self.avatarView.isHidden = true
+            self.frameHost.isHidden = true
+            // Свечение имени — та же тень, что в шапке профиля.
+            if let glow = LunagramSettings.profileNameGlowColor() {
+                self.titleNode.layer.shadowColor = glow
+                self.titleNode.layer.shadowOpacity = 1.0
+                self.titleNode.layer.shadowRadius = 6.0
+                self.titleNode.layer.shadowOffset = CGSize()
+            } else {
+                self.titleNode.layer.shadowOpacity = 0.0
+            }
+            self.titleNode.frame = CGRect(x: floor((rowSize.width - titleSize.width) / 2.0), y: 14.0, width: titleSize.width, height: titleSize.height)
+            self.subtitleNode.frame = CGRect(x: floor((rowSize.width - subtitleSize.width) / 2.0), y: rowSize.height - subtitleSize.height - 12.0, width: subtitleSize.width, height: subtitleSize.height)
+        }
+    }
+}
