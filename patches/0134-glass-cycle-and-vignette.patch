diff --git a/submodules/Lunagram/Sources/LunagramVignette.swift b/submodules/Lunagram/Sources/LunagramVignette.swift
new file mode 100644
index 00000000..a9f68a2d
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramVignette.swift
@@ -0,0 +1,71 @@
+import Foundation
+import UIKit
+
+// Lunagram: виньетка — края экрана притемняются, середина остаётся светлее.
+//
+// Задумка из Visual Ecstasy. Кладётся поверх всего окна одним слоем и нажатий
+// себе не забирает: она только рисует.
+//
+// Держится наверху не порядком добавления, а высотой слоя. Порядок сбивался бы
+// каждый раз, когда Telegram добавляет своё поверх, — а высота слоя выигрывает
+// у порядка всегда, и переставлять ничего не надо.
+
+public final class LunagramVignetteView: UIView {
+    private let gradient = CAGradientLayer()
+
+    public override init(frame: CGRect) {
+        super.init(frame: frame)
+
+        self.isUserInteractionEnabled = false
+        self.layer.zPosition = 10_000.0
+        self.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+
+        self.gradient.type = .radial
+        self.gradient.startPoint = CGPoint(x: 0.5, y: 0.5)
+        // Конец за углом прямоугольника: иначе по углам остаётся светлый крест.
+        self.gradient.endPoint = CGPoint(x: 1.2, y: 1.2)
+        self.gradient.locations = [0.0, 0.55, 1.0] as [NSNumber]
+        self.layer.addSublayer(self.gradient)
+
+        self.reload()
+    }
+
+    required init?(coder: NSCoder) {
+        preconditionFailure()
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        self.gradient.frame = self.bounds
+    }
+
+    /// Перечитать настройки: включена ли и насколько густая.
+    public func reload() {
+        let strength = CGFloat(LunagramSettings.vignetteStrength) / 100.0
+        self.isHidden = !LunagramSettings.vignette || strength <= 0.0
+        self.gradient.colors = [
+            UIColor.black.withAlphaComponent(0.0).cgColor,
+            UIColor.black.withAlphaComponent(strength * 0.25).cgColor,
+            UIColor.black.withAlphaComponent(strength).cgColor
+        ]
+    }
+}
+
+public enum LunagramVignette {
+    private static var view: LunagramVignetteView?
+    private static var observer: NSObjectProtocol?
+
+    /// Поставить виньетку на окно. Зовётся один раз при запуске.
+    public static func install(in window: UIWindow) {
+        guard self.view == nil else {
+            return
+        }
+        let view = LunagramVignetteView(frame: window.bounds)
+        window.addSubview(view)
+        self.view = view
+
+        self.observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { _ in
+            LunagramVignette.view?.reload()
+        })
+    }
+}
