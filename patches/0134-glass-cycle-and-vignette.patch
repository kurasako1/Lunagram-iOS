+/// Lunagram: кто перекрашивается, пока цвет едет по кругу.
+///
+/// Стеклянная панель меняет цвет только когда её хозяин зовёт `update`. Своего
+/// повода звать его у неё нет, поэтому общий повторитель четыре раза в секунду
+/// просит живые панели повторить последнюю раскладку.
+///
+/// Четыре раза, а не шестьдесят: цвет едет медленно, разницы не видно, а будить
+/// каждую панель каждый кадр — греть телефон впустую. Панели держим слабо: они
+/// приходят и уходят вместе с экранами.
+final class LunagramGlassTicker {
+    static let shared = LunagramGlassTicker()
+
+    private final class Box {
+        weak var view: GlassBackgroundView?
+        init(view: GlassBackgroundView) {
+            self.view = view
+        }
+    }
+
+    private var boxes: [Box] = []
+    private var timer: Timer?
+
+    func add(_ view: GlassBackgroundView) {
+        if self.boxes.contains(where: { $0.view === view }) {
+            return
+        }
+        self.boxes.append(Box(view: view))
+        self.start()
+    }
+
+    private func start() {
+        guard self.timer == nil else {
+            return
+        }
+        let timer = Timer(timeInterval: 0.25, repeats: true, block: { [weak self] _ in
+            self?.tick()
+        })
+        RunLoop.main.add(timer, forMode: .common)
+        self.timer = timer
+    }
+
+    private func tick() {
+        var alive: [Box] = []
+        for box in self.boxes {
+            guard let view = box.view else {
+                continue
+            }
+            alive.append(box)
+            view.lunagramRefreshTint()
+        }
+        self.boxes = alive
+        if self.boxes.isEmpty {
+            self.timer?.invalidate()
+            self.timer = nil
+        }
+    }
+}
+
 public class GlassBackgroundView: UIView {
+    /// Последняя раскладка — чтобы повторить её с новым цветом.
+    private var lunagramLast: (size: CGSize, shape: Shape, isDark: Bool, tintColor: TintColor, isInteractive: Bool, isVisible: Bool)?
+
+    func lunagramRefreshTint() {
+        guard let last = self.lunagramLast else {
+            return
+        }
+        self.update(size: last.size, shape: last.shape, isDark: last.isDark, tintColor: last.tintColor, isInteractive: last.isInteractive, isVisible: last.isVisible, transition: .immediate)
+    }
+
