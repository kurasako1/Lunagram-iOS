+    /// Свой цвет полосы ввода, 0xRRGGBB. nil — обычный.
+    public static var composeColor: UInt32? {
+        get {
+            guard defaults.object(forKey: Key.composeColor) != nil else {
+                return nil
+            }
+            return UInt32(truncatingIfNeeded: defaults.integer(forKey: Key.composeColor)) & 0xFFFFFF
+        }
+        set {
+            if let newValue = newValue {
+                defaults.set(Int(newValue & 0xFFFFFF), forKey: Key.composeColor)
+            } else {
+                defaults.removeObject(forKey: Key.composeColor)
+            }
+            changed()
+        }
+    }
+
+    /// Плотность своей плёнки полосы ввода, 0…100. По умолчанию 75, как на ПК.
+    public static var composeDensity: Int {
+        get { return clamped(Key.composeDensity, 0, 100, 75) }
+        set { setClamped(newValue, Key.composeDensity, 0, 100) }
+    }
+
+    /// «Плёнка подстраивается сама» — как на ПК. На айфоне это родное стекло
+    /// Telegram: оно и так подбирается под то, что под ним. По умолчанию
+    /// включено — обычный вид Telegram не меняется, пока не выберешь своё.
+    public static var composeAuto: Bool {
+        get {
+            guard defaults.object(forKey: Key.composeAuto) != nil else {
+                return true
+            }
+            return defaults.bool(forKey: Key.composeAuto)
+        }
+        set {
+            defaults.set(newValue, forKey: Key.composeAuto)
+            changed()
+        }
+    }
+
+    /// Цвет своей плёнки с плотностью — или nil, если стекло родное. Как на
+    /// ПК: свой цвет, а без него — обычный цвет полосы, и плотность поверх.
+    public static func composeTintColor(fallback: UIColor) -> UIColor? {
+        guard !composeAuto else {
+            return nil
+        }
+        let density = CGFloat(composeDensity) / 100.0
+        guard let rgb = composeColor else {
+            return fallback.withAlphaComponent(density)
+        }
+        let red = CGFloat((rgb >> 16) & 0xFF) / 255.0
+        let green = CGFloat((rgb >> 8) & 0xFF) / 255.0
+        let blue = CGFloat(rgb & 0xFF) / 255.0
+        return UIColor(red: red, green: green, blue: blue, alpha: density)
+    }
+
