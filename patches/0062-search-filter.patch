diff --git a/submodules/TelegramUI/Sources/LunagramSearchFilterController.swift b/submodules/TelegramUI/Sources/LunagramSearchFilterController.swift
new file mode 100644
index 00000000..d9b61512
--- /dev/null
+++ b/submodules/TelegramUI/Sources/LunagramSearchFilterController.swift
@@ -0,0 +1,282 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import Lunagram
+
+// Окно «Фильтр поиска» — как на ПК: период с даты по дату, автор (в личке —
+// «мои» или «собеседника»), тип сообщений. «Готово» применяет, «Сбросить»
+// снимает всё. Отбор живёт, пока открыт поиск.
+
+private final class LunagramSearchFilterArguments {
+    let pickDate: (Bool) -> Void
+    let setAuthor: (Int) -> Void
+    let setType: (Int) -> Void
+    let reset: () -> Void
+
+    init(pickDate: @escaping (Bool) -> Void, setAuthor: @escaping (Int) -> Void, setType: @escaping (Int) -> Void, reset: @escaping () -> Void) {
+        self.pickDate = pickDate
+        self.setAuthor = setAuthor
+        self.setType = setType
+        self.reset = reset
+    }
+}
+
+private enum LunagramSearchFilterSection: Int32 {
+    case period
+    case author
+    case type
+    case reset
+}
+
+private enum LunagramSearchFilterEntry: ItemListNodeEntry {
+    case periodHeader
+    case from(String)
+    case till(String)
+    case authorHeader
+    case author(Int32, String, Bool)
+    case typeHeader
+    case type(Int32, String, Bool)
+    case info(String)
+    case reset
+
+    var section: ItemListSectionId {
+        switch self {
+        case .periodHeader, .from, .till:
+            return LunagramSearchFilterSection.period.rawValue
+        case .authorHeader, .author:
+            return LunagramSearchFilterSection.author.rawValue
+        case .typeHeader, .type, .info:
+            return LunagramSearchFilterSection.type.rawValue
+        case .reset:
+            return LunagramSearchFilterSection.reset.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .periodHeader:
+            return 0
+        case .from:
+            return 1
+        case .till:
+            return 2
+        case .authorHeader:
+            return 10
+        case let .author(index, _, _):
+            return 11 + index
+        case .typeHeader:
+            return 20
+        case let .type(index, _, _):
+            return 21 + index
+        case .info:
+            return 40
+        case .reset:
+            return 50
+        }
+    }
+
+    static func ==(lhs: LunagramSearchFilterEntry, rhs: LunagramSearchFilterEntry) -> Bool {
+        switch lhs {
+        case .periodHeader:
+            if case .periodHeader = rhs {
+                return true
+            } else {
+                return false
+            }
+        case let .from(lhsText):
+            if case let .from(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        case let .till(lhsText):
+            if case let .till(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        case .authorHeader:
+            if case .authorHeader = rhs {
+                return true
+            } else {
+                return false
+            }
+        case let .author(lhsIndex, lhsTitle, lhsChecked):
+            if case let .author(rhsIndex, rhsTitle, rhsChecked) = rhs, lhsIndex == rhsIndex, lhsTitle == rhsTitle, lhsChecked == rhsChecked {
+                return true
+            } else {
+                return false
+            }
+        case .typeHeader:
+            if case .typeHeader = rhs {
+                return true
+            } else {
+                return false
+            }
+        case let .type(lhsIndex, lhsTitle, lhsChecked):
+            if case let .type(rhsIndex, rhsTitle, rhsChecked) = rhs, lhsIndex == rhsIndex, lhsTitle == rhsTitle, lhsChecked == rhsChecked {
+                return true
+            } else {
+                return false
+            }
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            } else {
+                return false
+            }
+        case .reset:
+            if case .reset = rhs {
+                return true
+            } else {
+                return false
+            }
+        }
+    }
+
+    static func <(lhs: LunagramSearchFilterEntry, rhs: LunagramSearchFilterEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramSearchFilterArguments
+        switch self {
+        case .periodHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "Период", sectionId: self.section)
+        case let .from(text):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: "С даты", label: text, sectionId: self.section, style: .blocks, action: {
+                arguments.pickDate(true)
+            })
+        case let .till(text):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: "По дату", label: text, sectionId: self.section, style: .blocks, action: {
+                arguments.pickDate(false)
+            })
+        case .authorHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "Автор", sectionId: self.section)
+        case let .author(index, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.setAuthor(Int(index))
+            })
+        case .typeHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "Тип", sectionId: self.section)
+        case let .type(index, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.setType(Int(index))
+            })
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case .reset:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Сбросить", kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.reset()
+            })
+        }
+    }
+}
+
+private func lunagramSearchFilterEntries(state: LunagramSearchFilter.State, privateName: String?) -> [LunagramSearchFilterEntry] {
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: "ru_RU")
+    formatter.dateStyle = .long
+    formatter.timeStyle = .none
+    var entries: [LunagramSearchFilterEntry] = [
+        .periodHeader,
+        .from(state.from.map { formatter.string(from: $0) } ?? "не выбрано"),
+        .till(state.till.map { formatter.string(from: $0) } ?? "не выбрано")
+    ]
+    // Автора в личке выбирают тут: «мои» или «собеседника». В группах —
+    // штатной кнопкой участника рядом.
+    if let privateName = privateName {
+        entries.append(.authorHeader)
+        entries.append(.author(0, "Все", state.author == 0))
+        entries.append(.author(1, "Только мои", state.author == 1))
+        entries.append(.author(2, "Только \(privateName)", state.author == 2))
+    }
+    entries.append(.typeHeader)
+    for type in LunagramSearchFilter.MessageType.allCases {
+        entries.append(.type(Int32(type.rawValue), type.title, state.type == type))
+    }
+    entries.append(.info("Период ищет по дням включительно. Если выбран тип или автор, искать можно и без текста — найдутся все такие сообщения. Отбор сбросится, когда закроешь поиск."))
+    entries.append(.reset)
+    return entries
+}
+
+func lunagramSearchFilterController(context: AccountContext, peerId: EnginePeer.Id, privateName: String?) -> ViewController {
+    let key = peerId.toInt64()
+    let initialState = LunagramSearchFilter.shared.state(peer: key)
+    let statePromise = ValuePromise(initialState, ignoreRepeated: true)
+    let stateValue = Atomic(value: initialState)
+    let updateState: ((LunagramSearchFilter.State) -> LunagramSearchFilter.State) -> Void = { f in
+        statePromise.set(stateValue.modify { f($0) })
+    }
+
+    var dismissImpl: (() -> Void)?
+    var pickDateImpl: ((Bool) -> Void)?
+
+    let arguments = LunagramSearchFilterArguments(pickDate: { isFrom in
+        pickDateImpl?(isFrom)
+    }, setAuthor: { value in
+        updateState { state in
+            var state = state
+            state.author = value
+            return state
+        }
+    }, setType: { value in
+        updateState { state in
+            var state = state
+            state.type = LunagramSearchFilter.MessageType(rawValue: value) ?? .any
+            return state
+        }
+    }, reset: {
+        // Как на ПК: «Сбросить» снимает всё и сразу закрывает окно.
+        let _ = stateValue.swap(LunagramSearchFilter.State())
+        LunagramSearchFilter.shared.set(LunagramSearchFilter.State(), peer: key)
+        dismissImpl?()
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, statePromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, state -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let doneButton = ItemListNavigationButton(content: .text("Готово"), style: .bold, enabled: true, action: {
+            LunagramSearchFilter.shared.set(stateValue.with { $0 }, peer: key)
+            dismissImpl?()
+        })
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Фильтр поиска"), leftNavigationButton: nil, rightNavigationButton: doneButton, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: lunagramSearchFilterEntries(state: state, privateName: privateName), style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    dismissImpl = { [weak controller] in
+        let _ = (controller?.navigationController as? NavigationController)?.popViewController(animated: true)
+    }
+    pickDateImpl = { isFrom in
+        guard let presenter = (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController else {
+            return
+        }
+        let state = stateValue.with { $0 }
+        // Telegram открылся в августе 2013 — раньше сообщений нет.
+        var launched = DateComponents()
+        launched.year = 2013
+        launched.month = 8
+        launched.day = 1
+        let earliest = Calendar.current.date(from: launched)
+        let today = Date()
+        LunagramDatePickerSheet.present(from: presenter, title: isFrom ? "С даты" : "По дату", date: isFrom ? state.from : state.till, minimum: isFrom ? earliest : (state.from ?? earliest), maximum: isFrom ? (state.till ?? today) : today, completion: { date in
+            updateState { state in
+                var state = state
+                if isFrom {
+                    state.from = date
+                } else {
+                    state.till = date
+                }
+                return state
+            }
+        })
+    }
+    return controller
+}
