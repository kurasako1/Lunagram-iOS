+++ b/submodules/Lunagram/Sources/LunagramSearchFilter.swift
@@ -0,0 +1,170 @@
+import UIKit
+
+/// Отбор поиска по переписке — как кнопка «Фильтр» на ПК: период, автор,
+/// тип сообщений. Живёт, пока открыт поиск в этой переписке: закрыл поиск —
+/// отбор сбросился, как на ПК.
+public final class LunagramSearchFilter {
+    /// Тип сообщений — те же, что на ПК.
+    public enum MessageType: Int, CaseIterable {
+        case any
+        case photos
+        case videos
+        case files
+        case links
+        case voice
+        case music
+        case gifs
+
+        public var title: String {
+            switch self {
+            case .any:
+                return "Любые"
+            case .photos:
+                return "Фото"
+            case .videos:
+                return "Видео"
+            case .files:
+                return "Файлы"
+            case .links:
+                return "Ссылки"
+            case .voice:
+                return "Голосовые"
+            case .music:
+                return "Музыка"
+            case .gifs:
+                return "Гифки"
+            }
+        }
+    }
+
+    public struct State: Equatable {
+        /// С какого дня и по какой, оба включительно. nil — без границы.
+        public var from: Date?
+        public var till: Date?
+        /// Только в личке: 0 — все, 1 — мои, 2 — собеседника.
+        public var author: Int
+        public var type: MessageType
+
+        public init(from: Date? = nil, till: Date? = nil, author: Int = 0, type: MessageType = .any) {
+            self.from = from
+            self.till = till
+            self.author = author
+            self.type = type
+        }
+
+        public var isActive: Bool {
+            return self.from != nil || self.till != nil || self.author != 0 || self.type != .any
+        }
+
+        /// Границы для сервера. Он отдаёт сообщения строго новее нижней и
+        /// строго старше верхней — поэтому секунда до начала первого дня и
+        /// начало дня, следующего за последним: так оба дня входят целиком.
+        public var bounds: (minDate: Int32?, maxDate: Int32?) {
+            let calendar = Calendar.current
+            var minDate: Int32?
+            var maxDate: Int32?
+            if let from = self.from {
+                minDate = Int32(calendar.startOfDay(for: from).timeIntervalSince1970) - 1
+            }
+            if let till = self.till, let next = calendar.date(byAdding: .day, value: 1, to: calendar.startOfDay(for: till)) {
+                maxDate = Int32(next.timeIntervalSince1970)
+            }
+            return (minDate, maxDate)
+        }
+    }
+
+    public static let shared = LunagramSearchFilter()
+
+    private var states: [Int64: State] = [:]
+    private var refreshers: [Int64: () -> Void] = [:]
+
+    public func state(peer: Int64) -> State {
+        return self.states[peer] ?? State()
+    }
+
+    /// Поменять отбор и сразу перезапустить поиск в этой переписке.
+    public func set(_ state: State, peer: Int64) {
+        self.states[peer] = state
+        self.refreshers[peer]?()
+    }
+
+    /// Поиск закрыли — отбор сбрасывается, как на ПК.
+    public func reset(peer: Int64) {
+        self.states.removeValue(forKey: peer)
+        self.refreshers.removeValue(forKey: peer)
+    }
+
+    /// Чем перезапустить поиск, когда отбор поменяли.
+    public func setRefresh(peer: Int64, _ refresh: @escaping () -> Void) {
+        self.refreshers[peer] = refresh
+    }
+}
+
+/// Выбор дня для периода поиска — календарь айфона в листке снизу. «Без
+/// границы» снимает этот конец периода, как кнопка в календаре на ПК.
+public final class LunagramDatePickerSheet: UIViewController {
+    private let picker = UIDatePicker()
+    private let initialDate: Date
+    private let minimum: Date?
+    private let maximum: Date?
+    private let titleText: String
+    private let completion: (Date?) -> Void
+
+    public static func present(from presenter: UIViewController, title: String, date: Date?, minimum: Date?, maximum: Date?, completion: @escaping (Date?) -> Void) {
+        let sheet = LunagramDatePickerSheet(title: title, date: date ?? Date(), minimum: minimum, maximum: maximum, completion: completion)
+        let navigation = UINavigationController(rootViewController: sheet)
+        navigation.modalPresentationStyle = .pageSheet
+        presenter.present(navigation, animated: true, completion: nil)
+    }
+
+    private init(title: String, date: Date, minimum: Date?, maximum: Date?, completion: @escaping (Date?) -> Void) {
+        self.titleText = title
+        self.initialDate = date
+        self.minimum = minimum
+        self.maximum = maximum
+        self.completion = completion
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    public override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        self.title = self.titleText
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: "Без границы", style: .plain, target: self, action: #selector(self.clearTapped))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "Готово", style: .done, target: self, action: #selector(self.doneTapped))
+
+        self.picker.datePickerMode = .date
+        if #available(iOS 14.0, *) {
+            self.picker.preferredDatePickerStyle = .inline
+        }
+        self.picker.minimumDate = self.minimum
+        self.picker.maximumDate = self.maximum
+        self.picker.date = self.initialDate
+        self.picker.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(self.picker)
+        NSLayoutConstraint.activate([
+            self.picker.leadingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.leadingAnchor, constant: 12.0),
+            self.picker.trailingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.trailingAnchor, constant: -12.0),
+            self.picker.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor, constant: 8.0)
+        ])
+    }
+
+    @objc private func doneTapped() {
+        let date = self.picker.date
+        let completion = self.completion
+        self.dismiss(animated: true, completion: {
+            completion(date)
+        })
+    }
+
+    @objc private func clearTapped() {
+        let completion = self.completion
+        self.dismiss(animated: true, completion: {
+            completion(nil)
+        })
+    }
+}
