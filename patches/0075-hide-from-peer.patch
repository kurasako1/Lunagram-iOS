diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramHidePeer.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramHidePeer.swift
new file mode 100644
index 00000000..543ca7f5
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramHidePeer.swift
@@ -0,0 +1,123 @@
+import Foundation
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import Lunagram
+
+// Lunagram: «как будто заблокировал» — по-настоящему.
+//
+// Telegram умеет прятать аватарку, описание, время в сети и номер от
+// выбранных людей — это его же настройки приватности, только обычно их
+// правят руками на четырёх разных экранах. Здесь то же самое одним
+// движением: ползунок в профиле человека.
+//
+// Переписываться при этом можно по-прежнему: приватность не блокировка,
+// из списка чатов ты у него не исчезаешь и писать друг другу не мешает.
+//
+// Важная особенность самого Telegram: спрятал своё время в сети — перестал
+// видеть чужое. Это его правило, обойти нельзя.
+
+/// Что именно прячем.
+private let lunagramHideTypes: [UpdateSelectiveAccountPrivacySettingsType] = [.presence, .profilePhoto, .bio, .phoneNumber]
+
+private func lunagramCurrent(_ settings: AccountPrivacySettings, _ type: UpdateSelectiveAccountPrivacySettingsType) -> SelectivePrivacySettings? {
+    switch type {
+    case .presence:
+        return settings.presence
+    case .profilePhoto:
+        return settings.profilePhoto
+    case .bio:
+        return settings.bio
+    case .phoneNumber:
+        return settings.phoneNumber
+    default:
+        return nil
+    }
+}
+
+/// Та же настройка, но с одним человеком в списке исключений.
+private func lunagramWithPeer(_ settings: SelectivePrivacySettings, peer: SelectivePrivacyPeer, hidden: Bool) -> SelectivePrivacySettings {
+    let peerId = peer.peer.id
+    switch settings {
+    case let .enableEveryone(disableFor):
+        var disableFor = disableFor
+        if hidden {
+            disableFor[peerId] = peer
+        } else {
+            disableFor.removeValue(forKey: peerId)
+        }
+        return .enableEveryone(disableFor: disableFor)
+    case let .enableContacts(enableFor, disableFor, enableForPremium, enableForBots):
+        var enableFor = enableFor
+        var disableFor = disableFor
+        if hidden {
+            enableFor.removeValue(forKey: peerId)
+            disableFor[peerId] = peer
+        } else {
+            disableFor.removeValue(forKey: peerId)
+        }
+        return .enableContacts(enableFor: enableFor, disableFor: disableFor, enableForPremium: enableForPremium, enableForBots: enableForBots)
+    case let .disableEveryone(enableFor, enableForCloseFriends, enableForPremium, enableForBots):
+        // Здесь наоборот: видят только те, кто в списке. Прячем — вычёркиваем.
+        var enableFor = enableFor
+        if hidden {
+            enableFor.removeValue(forKey: peerId)
+        } else {
+            enableFor[peerId] = peer
+        }
+        return .disableEveryone(enableFor: enableFor, enableForCloseFriends: enableForCloseFriends, enableForPremium: enableForPremium, enableForBots: enableForBots)
+    }
+}
+
+/// Скрыть себя от человека или вернуть всё как было.
+func lunagramSetHidden(context: AccountContext, peer: EnginePeer, hidden: Bool) {
+    LunagramSettings.setHiddenPeer(peer.id.toInt64(), hidden)
+    let privacyPeer = SelectivePrivacyPeer(peer: peer, participantCount: nil)
+    let _ = (context.engine.privacy.requestAccountPrivacySettings()
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { settings in
+        for type in lunagramHideTypes {
+            guard let current = lunagramCurrent(settings, type) else {
+                continue
+            }
+            let updated = lunagramWithPeer(current, peer: privacyPeer, hidden: hidden)
+            if updated != current {
+                let _ = context.engine.privacy.updateSelectiveAccountPrivacySettings(type: type, settings: updated).startStandalone()
+            }
+        }
+    })
+}
+
+/// Скрыться от всех разом или вернуться всем.
+///
+/// Возвращаясь, не забываем тех, кого прятал поимённо: их список у нас свой,
+/// и они снова уходят в исключения.
+func lunagramSetHiddenFromEveryone(context: AccountContext, hidden: Bool) {
+    LunagramSettings.hiddenFromEveryone = hidden
+    if hidden {
+        for type in lunagramHideTypes {
+            let _ = context.engine.privacy.updateSelectiveAccountPrivacySettings(type: type, settings: .disableEveryone(enableFor: [:], enableForCloseFriends: false, enableForPremium: false, enableForBots: false)).startStandalone()
+        }
+        return
+    }
+    let hiddenIds = LunagramSettings.hiddenPeers.map { PeerId($0) }
+    guard !hiddenIds.isEmpty else {
+        for type in lunagramHideTypes {
+            let _ = context.engine.privacy.updateSelectiveAccountPrivacySettings(type: type, settings: .enableEveryone(disableFor: [:])).startStandalone()
+        }
+        return
+    }
+    let _ = (context.engine.data.get(EngineDataMap(hiddenIds.map { TelegramEngine.EngineData.Item.Peer.Peer(id: $0) }))
+    |> deliverOnMainQueue).startStandalone(next: { peers in
+        var disableFor: [PeerId: SelectivePrivacyPeer] = [:]
+        for (peerId, maybePeer) in peers {
+            if let peer = maybePeer {
+                disableFor[peerId] = SelectivePrivacyPeer(peer: peer, participantCount: nil)
+            }
+        }
+        for type in lunagramHideTypes {
+            let _ = context.engine.privacy.updateSelectiveAccountPrivacySettings(type: type, settings: .enableEveryone(disableFor: disableFor)).startStandalone()
+        }
+    })
+}
