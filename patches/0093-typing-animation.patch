diff --git a/submodules/TelegramUI/Components/Chat/ChatInputTextNode/Sources/LunagramTypingAnimation.swift b/submodules/TelegramUI/Components/Chat/ChatInputTextNode/Sources/LunagramTypingAnimation.swift
new file mode 100644
index 00000000..1098ab8a
--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatInputTextNode/Sources/LunagramTypingAnimation.swift
@@ -0,0 +1,166 @@
+import Foundation
+import UIKit
+import CoreImage
+import TextFormat
+import Lunagram
+
+// Lunagram: «Буквы прилетают» — перенос плагина Text Animation.
+//
+// Набранная буква не возникает на месте, а влетает на него: сверху, из
+// размытия, чуть увеличенной и повёрнутой. Пока она летит, настоящая буква
+// невидима — иначе их было бы две.
+//
+// Прячем её не в тексте, а в отрисовке: у NSLayoutManager есть «временные
+// приметы», которые видит только он и которые к самому тексту отношения не
+// имеют. Поэтому отправка, свои эмодзи, спойлеры и цитаты ничего не
+// замечают, а в набранном сообщении ничего лишнего не появляется.
+//
+// Поле ввода Telegram и так рисуется этим движком — переводить его никуда
+// не пришлось. Я сперва думал, что придётся, и предупредил хозяина; залез
+// внутрь — оказалось, тревога ложная.
+//
+// Свои эмодзи не трогаем: их рисует не движок текста, а отдельные слои
+// поверх, и спрятать их временной приметой нечем.
+
+final class LunagramTypingAnimation {
+    private var lastText: String = ""
+    private static let ciContext = CIContext(options: [.useSoftwareRenderer: false])
+
+    func textChanged(_ textView: UITextView) {
+        let text = textView.text ?? ""
+        let previous = self.lastText
+        self.lastText = text
+
+        guard LunagramSettings.typingLetters, text.utf16.count > previous.utf16.count else {
+            return
+        }
+
+        // Ищем вставленный кусок: общее начало и общий хвост отбрасываем.
+        let old = Array(previous.utf16)
+        let new = Array(text.utf16)
+        var prefix = 0
+        while prefix < old.count, prefix < new.count, old[prefix] == new[prefix] {
+            prefix += 1
+        }
+        var suffix = 0
+        while suffix < old.count - prefix, suffix < new.count - prefix, old[old.count - 1 - suffix] == new[new.count - 1 - suffix] {
+            suffix += 1
+        }
+        let length = new.count - prefix - suffix
+        // Вставили сразу много — значит, это вставка из буфера, а не набор.
+        guard length > 0, length <= 4 else {
+            return
+        }
+        self.animate(textView, NSRange(location: prefix, length: length))
+    }
+
+    private func animate(_ textView: UITextView, _ range: NSRange) {
+        guard let attributed = textView.attributedText, range.location + range.length <= attributed.length else {
+            return
+        }
+        var hasCustomEmoji = false
+        attributed.enumerateAttribute(ChatTextInputAttributes.customEmoji, in: range, options: [], using: { value, _, stop in
+            if value != nil {
+                hasCustomEmoji = true
+                stop.pointee = true
+            }
+        })
+        if hasCustomEmoji {
+            return
+        }
+
+        guard let start = textView.position(from: textView.beginningOfDocument, offset: range.location),
+              let end = textView.position(from: start, offset: range.length),
+              let textRange = textView.textRange(from: start, to: end) else {
+            return
+        }
+        var rect = textView.firstRect(for: textRange)
+        guard rect.origin.x.isFinite, rect.origin.y.isFinite, rect.width > 0.5, rect.height > 0.5, rect.width < 240.0 else {
+            return
+        }
+        rect = rect.insetBy(dx: -2.0, dy: -2.0)
+
+        let layoutManager = textView.layoutManager
+        let image = UIGraphicsImageRenderer(bounds: rect).image { context in
+            context.cgContext.translateBy(x: -rect.minX, y: -rect.minY)
+            textView.layer.render(in: context.cgContext)
+        }
+
+        layoutManager.setTemporaryAttributes([.foregroundColor: UIColor.clear], forCharacterRange: range)
+
+        let sharp = UIImageView(image: image)
+        sharp.frame = rect
+        sharp.isUserInteractionEnabled = false
+        textView.addSubview(sharp)
+
+        var blurred: UIImageView?
+        if LunagramSettings.typingBlur, let blurImage = LunagramTypingAnimation.blurred(image, radius: CGFloat(LunagramSettings.typingBlurRadius)) {
+            let view = UIImageView(image: blurImage)
+            view.frame = rect
+            view.isUserInteractionEnabled = false
+            textView.addSubview(view)
+            blurred = view
+        }
+
+        var transform = CGAffineTransform.identity
+        if LunagramSettings.typingSlide {
+            transform = transform.translatedBy(x: 0.0, y: -CGFloat(LunagramSettings.typingDistance))
+        }
+        if LunagramSettings.typingScale {
+            transform = transform.scaledBy(x: 0.55, y: 0.55)
+        }
+        if LunagramSettings.typingRotate {
+            transform = transform.rotated(by: -0.22)
+        }
+
+        let views = [blurred, sharp].compactMap { $0 }
+        for view in views {
+            view.transform = transform
+        }
+        // Размытая видна сразу и тает, чёткая проступает ей на смену. Без
+        // размытия чёткая просто проявляется на лету.
+        sharp.alpha = 0.0
+        blurred?.alpha = 1.0
+
+        let duration = max(0.05, Double(LunagramSettings.typingDuration) / 1000.0)
+        UIView.animate(withDuration: duration, delay: 0.0, options: [.curveEaseOut], animations: {
+            for view in views {
+                view.transform = .identity
+            }
+            sharp.alpha = 1.0
+            blurred?.alpha = 0.0
+        }, completion: { [weak textView] _ in
+            for view in views {
+                view.removeFromSuperview()
+            }
+            // Снимаем прятки со всего текста разом: пока летела буква, его
+            // могли и поправить, и тогда прежний кусок указывал бы мимо.
+            guard let textView = textView else {
+                return
+            }
+            let length = textView.textStorage.length
+            if length > 0 {
+                textView.layoutManager.setTemporaryAttributes([:], forCharacterRange: NSRange(location: 0, length: length))
+            }
+        })
+    }
+
+    private static func blurred(_ image: UIImage, radius: CGFloat) -> UIImage? {
+        guard radius > 0.0, let cgImage = image.cgImage else {
+            return nil
+        }
+        let input = CIImage(cgImage: cgImage)
+        guard let filter = CIFilter(name: "CIGaussianBlur") else {
+            return nil
+        }
+        filter.setValue(input.clampedToExtent(), forKey: kCIInputImageKey)
+        filter.setValue(radius, forKey: kCIInputRadiusKey)
+        guard let output = filter.outputImage?.cropped(to: input.extent) else {
+            return nil
+        }
+        guard let result = LunagramTypingAnimation.ciContext.createCGImage(output, from: input.extent) else {
+            return nil
+        }
+        return UIImage(cgImage: result, scale: image.scale, orientation: .up)
+    }
+}
