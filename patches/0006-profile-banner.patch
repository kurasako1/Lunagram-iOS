+import AVFoundation
+import UIKit
+
+/// Баннер в шапке своего профиля: фото или ролик из галереи.
+///
+/// Шапку рисует Telegram, и перекраивать её мы не стали. Баннер встаёт
+/// поверх цветной подложки, которую Telegram кладёт профилям с цветом, и
+/// растягивается вместе с ней. Имя, кнопки и строку состояния шапка сама
+/// перекрашивает в белый — как у любого профиля с цветом.
+///
+/// Виден только тебе: это оформление твоего приложения, на сервер оно не
+/// уходит. Так же и на ПК.
+public final class LunagramProfileBannerView: UIView {
+    /// Показывать ли баннер. Спрашивают на каждом кадре прокрутки шапки,
+    /// поэтому без похода на диск — только настройки.
+    public static var isActive: Bool {
+        return LunagramSettings.profileBannerEnabled && LunagramSettings.hasProfileBanner
+    }
+
+    /// Ставит, обновляет или убирает баннер внутри подложки шапки.
+    ///
+    /// restHeight — высота подложки в покое. Короче неё баннер не сжимается,
+    /// а уезжает вверх вместе со списком. Длиннее — когда шапку тянут вниз —
+    /// растягивается, как и подложка под ним.
+    public static func update(in container: UIView, active: Bool, restHeight: CGFloat) {
+        let current = container.subviews.compactMap({ $0 as? LunagramProfileBannerView }).first
+        guard active else {
+            current?.removeFromSuperview()
+            return
+        }
+        let banner: LunagramProfileBannerView
+        if let current = current {
+            banner = current
+        } else {
+            banner = LunagramProfileBannerView(restHeight: restHeight)
+            container.addSubview(banner)
+        }
+        // Подложка сама подкладывает слои на время своих анимаций — баннер
+        // должен остаться сверху.
+        if container.subviews.last !== banner {
+            container.bringSubviewToFront(banner)
+        }
+        banner.restHeight = restHeight
+        banner.frame = container.bounds
+        banner.layoutContent()
+    }
+
+    /// Затемнение по номеру из настроек.
+    private static let dimAlphas: [CGFloat] = [0.0, 0.3, 0.55, 0.75]
+
+    private let contentView = UIView()
+    private let imageView = UIImageView()
+    private var playerView: LunagramBannerPlayerView?
+    private let dimView = UIView()
+    private var restHeight: CGFloat
+    private var shownURL: URL?
+    private var isAttached = false
+    private var settingsObserver: NSObjectProtocol?
+
+    private init(restHeight: CGFloat) {
+        self.restHeight = restHeight
+        super.init(frame: CGRect())
+        self.isUserInteractionEnabled = false
+        self.clipsToBounds = true
+        // Подложка меняет размер и между нашими обновлениями — при своих
+        // анимациях. Пусть баннер следует за ней сам.
+        self.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+
+        self.imageView.contentMode = .scaleAspectFill
+        self.imageView.clipsToBounds = true
+        self.contentView.addSubview(self.imageView)
+
+        self.dimView.backgroundColor = .black
+        self.contentView.addSubview(self.dimView)
+
+        self.addSubview(self.contentView)
+
+        self.reload()
+        self.settingsObserver = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+    }
+
+    required public init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let settingsObserver = self.settingsObserver {
+            NotificationCenter.default.removeObserver(settingsObserver)
+        }
+        if self.isAttached {
+            LunagramVideoWallpaper.banner.detach()
+        }
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        self.layoutContent()
+    }
+
+    /// Профиль ушёл с экрана — ролик на паузу. Экран настроек живёт всё
+    /// время, пока открыто приложение, и без этого видео крутилось бы
+    /// впустую, пока человек сидит в переписках.
+    public override func didMoveToWindow() {
+        super.didMoveToWindow()
+        self.updatePlayback()
+    }
+
+    private func layoutContent() {
+        let size = self.bounds.size
+        let height = max(size.height, self.restHeight)
+        let frame = CGRect(x: 0.0, y: size.height - height, width: size.width, height: height)
+        if self.contentView.frame != frame {
+            self.contentView.frame = frame
+            let bounds = CGRect(origin: CGPoint(), size: frame.size)
+            self.imageView.frame = bounds
+            self.playerView?.frame = bounds
+            self.dimView.frame = bounds
+        }
+    }
+
+    private func reload() {
+        let dim = max(0, min(LunagramProfileBannerView.dimAlphas.count - 1, LunagramSettings.profileBannerDim))
+        self.dimView.alpha = LunagramProfileBannerView.dimAlphas[dim]
+
+        let url = LunagramSettings.profileBannerURL
+        if url != self.shownURL {
+            self.shownURL = url
+            if url != nil && LunagramSettings.profileBannerIsVideo {
+                self.imageView.image = nil
+                if self.playerView == nil {
+                    let playerView = LunagramBannerPlayerView()
+                    playerView.playerLayer.player = LunagramVideoWallpaper.banner.player
+                    // Заполняем целиком, обрезая лишнее по краям: у шапки и
+                    // ролика разная вытянутость.
+                    playerView.playerLayer.videoGravity = .resizeAspectFill
+                    playerView.frame = self.imageView.frame
+                    self.contentView.insertSubview(playerView, belowSubview: self.dimView)
+                    self.playerView = playerView
+                }
+            } else {
+                self.playerView?.removeFromSuperview()
+                self.playerView = nil
+                self.imageView.image = url.flatMap(LunagramProfileBannerView.loadImage)
+            }
+        }
+        self.updatePlayback()
+    }
+
+    private func updatePlayback() {
+        let video = LunagramVideoWallpaper.banner
+        video.sync()
+        let shouldPlay = self.window != nil && self.playerView != nil
+        if shouldPlay != self.isAttached {
+            self.isAttached = shouldPlay
+            if shouldPlay {
+                video.attach()
+            } else {
+                video.detach()
+            }
+        }
+    }
+
+    /// Последнее открытое фото. Шапка создаётся заново при каждом открытии
+    /// профиля, а читать и раскодировать снимок каждый раз незачем.
+    private static var cachedImage: (url: URL, image: UIImage)?
+
+    private static func loadImage(_ url: URL) -> UIImage? {
+        if let cachedImage = self.cachedImage, cachedImage.url == url {
+            return cachedImage.image
+        }
+        guard var image = UIImage(contentsOfFile: url.path) else {
+            return nil
+        }
+        // Раскодируем сразу, а не при первой отрисовке: иначе это случилось
+        // бы посреди анимации открытия профиля и дёрнуло её.
+        if #available(iOS 15.0, *), let prepared = image.preparingForDisplay() {
+            image = prepared
+        }
+        self.cachedImage = (url, image)
+        return image
+    }
+}
+
+/// Вид, у которого сам слой — проигрыватель. Слой, принадлежащий виду, не
+/// анимирует смену размера по своей воле, и ролик не «плывёт» за шапкой.
+private final class LunagramBannerPlayerView: UIView {
+    override class var layerClass: AnyClass {
+        return AVPlayerLayer.self
+    }
+
+    var playerLayer: AVPlayerLayer {
+        return self.layer as! AVPlayerLayer
+    }
+}
