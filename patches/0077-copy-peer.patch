@@ -0,0 +1,205 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import AvatarNode
+import MapResourceToAvatarSizes
+import Lunagram
+
+// Lunagram: «стать копией человека».
+//
+// Берёт его аватарку, имя, описание и премиум-оформление и ставит их себе.
+// Это настоящая смена своего профиля: её увидят все, кто тебя видит, —
+// поэтому перед сменой спрашиваем, а прежнее своё сохраняем и возвращаем
+// кнопкой «Вернуть моё».
+//
+// Чужой @ник скопировать нельзя: он занят, такого в Telegram не бывает.
+// Премиум-оформление (цвет имени, фон профиля, значок-статус) сервер примет
+// только при своём премиуме — без него эта часть просто не применится.
+
+/// Номер картинки статуса: он лежит и у обычного значка, и у подарочного.
+private func lunagramStatusFileId(_ status: PeerEmojiStatus?) -> Int64? {
+    guard let content = status?.content else {
+        return nil
+    }
+    switch content {
+    case let .emoji(fileId):
+        return fileId
+    case let .starGift(_, fileId, _, _, _, _, _, _, _):
+        return fileId
+    }
+}
+
+/// Прежний свой профиль — чтобы вернуть всё как было.
+private struct LunagramProfileBackup: Codable {
+    var firstName: String
+    var lastName: String
+    var about: String
+    var nameColor: Int32?
+    var profileColor: Int32?
+    var backgroundEmojiId: Int64?
+    var profileBackgroundEmojiId: Int64?
+    var statusFileId: Int64?
+    var hadAvatar: Bool
+    var avatarFile: String?
+}
+
+private func lunagramLoadBackup() -> LunagramProfileBackup? {
+    guard let data = LunagramSettings.ownProfileBackupData else {
+        return nil
+    }
+    return try? JSONDecoder().decode(LunagramProfileBackup.self, from: data)
+}
+
+private func lunagramSaveBackup(_ backup: LunagramProfileBackup?) {
+    if let backup = backup {
+        LunagramSettings.ownProfileBackupData = try? JSONEncoder().encode(backup)
+    } else {
+        LunagramSettings.ownProfileBackupData = nil
+    }
+}
+
+/// Носим ли мы сейчас чью-то копию.
+func lunagramCopiedPeerId() -> Int64? {
+    let value = LunagramSettings.copiedPeerId
+    return value == 0 ? nil : value
+}
+
+/// Аватарка человека крупной картинкой — её же потом ставим себе.
+private func lunagramAvatarImage(context: AccountContext, peer: EnginePeer) -> Signal<UIImage?, NoError> {
+    guard peer.largeProfileImage != nil else {
+        return .single(nil)
+    }
+    return peerAvatarCompleteImage(account: context.account, peer: peer, size: CGSize(width: 640.0, height: 640.0), round: false, drawLetters: false, fullSize: true)
+    |> take(1)
+}
+
+/// Поставить себе эту картинку аватаркой. nil — убрать аватарку вовсе.
+private func lunagramSetOwnAvatar(context: AccountContext, image: UIImage?) {
+    guard let image = image, let data = image.jpegData(compressionQuality: 0.85) else {
+        let _ = context.engine.accountData.updateAccountPhoto(resource: nil, videoResource: nil, videoStartTimestamp: nil, markup: nil, mapResourceToAvatarSizes: { resource, representations in
+            return mapResourceToAvatarSizes(engine: context.engine, resource: resource, representations: representations)
+        }).startStandalone()
+        return
+    }
+    let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max))
+    context.engine.resources.storeResourceData(id: EngineMediaResource.Id(resource.id), data: data)
+    let _ = context.engine.accountData.updateAccountPhoto(resource: EngineMediaResource(resource), videoResource: nil, videoStartTimestamp: nil, markup: nil, mapResourceToAvatarSizes: { resource, representations in
+        return mapResourceToAvatarSizes(engine: context.engine, resource: resource, representations: representations)
+    }).startStandalone()
+}
+
+private func lunagramApplyColors(context: AccountContext, nameColor: Int32?, backgroundEmojiId: Int64?, profileColor: Int32?, profileBackgroundEmojiId: Int64?) {
+    let color = PeerNameColor(rawValue: nameColor ?? 0)
+    let _ = context.engine.accountData.updateNameColorAndEmoji(nameColor: .preset(color: color, backgroundEmojiId: backgroundEmojiId), profileColor: profileColor.flatMap { PeerNameColor(rawValue: $0) }, profileBackgroundEmojiId: profileBackgroundEmojiId).startStandalone()
+}
+
+private func lunagramApplyStatus(context: AccountContext, fileId: Int64?) {
+    guard let fileId = fileId else {
+        let _ = context.engine.accountData.setEmojiStatus(file: nil, expirationDate: nil).startStandalone()
+        return
+    }
+    let _ = (context.engine.stickers.resolveInlineStickers(fileIds: [fileId])
+    |> deliverOnMainQueue).startStandalone(next: { files in
+        guard let file = files[fileId] else {
+            return
+        }
+        let _ = context.engine.accountData.setEmojiStatus(file: file, expirationDate: nil).startStandalone()
+    })
+}
+
+/// Стать копией человека. Прежнее своё запоминаем.
+func lunagramCopyPeer(context: AccountContext, peer: EnginePeer, completion: @escaping () -> Void) {
+    let ownId = context.account.peerId
+    let _ = (combineLatest(
+        context.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: ownId)),
+        context.engine.data.get(TelegramEngine.EngineData.Item.Peer.AboutText(id: ownId)),
+        context.engine.data.get(TelegramEngine.EngineData.Item.Peer.AboutText(id: peer.id))
+    )
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { ownPeer, ownAbout, targetAbout in
+        guard let ownPeer = ownPeer else {
+            return
+        }
+        // Своё сохраняем один раз: если уже носим копию, прежнее «своё» — то,
+        // что сохранили в самом начале, а не чужое лицо.
+        if lunagramLoadBackup() == nil {
+            var backup = LunagramProfileBackup(
+                firstName: ownPeer.compactDisplayTitle,
+                lastName: "",
+                about: "",
+                nameColor: ownPeer.nameColor?.rawValue,
+                profileColor: ownPeer.profileColor?.rawValue,
+                backgroundEmojiId: ownPeer.backgroundEmojiId,
+                profileBackgroundEmojiId: ownPeer.profileBackgroundEmojiId,
+                statusFileId: lunagramStatusFileId(ownPeer.emojiStatus),
+                hadAvatar: ownPeer.largeProfileImage != nil,
+                avatarFile: nil
+            )
+            if case let .user(user) = ownPeer {
+                backup.firstName = user.firstName ?? ""
+                backup.lastName = user.lastName ?? ""
+            }
+            if case let .known(text) = ownAbout, let text = text {
+                backup.about = text
+            }
+            // Своё лицо кладём в свою папку: вернуть его иначе будет нечем.
+            let _ = (lunagramAvatarImage(context: context, peer: ownPeer)
+            |> deliverOnMainQueue).startStandalone(next: { image in
+                var backup = backup
+                if let image = image, let data = image.jpegData(compressionQuality: 0.85) {
+                    backup.avatarFile = LunagramSettings.storeOwnAvatar(data)
+                }
+                lunagramSaveBackup(backup)
+            })
+        }
+
+        LunagramSettings.copiedPeerId = peer.id.toInt64()
+
+        var firstName = peer.compactDisplayTitle
+        var lastName = ""
+        if case let .user(user) = peer {
+            firstName = user.firstName ?? ""
+            lastName = user.lastName ?? ""
+        }
+        let _ = context.engine.accountData.updateAccountPeerName(firstName: firstName, lastName: lastName).startStandalone()
+        if case let .known(text) = targetAbout {
+            let _ = context.engine.accountData.updateAbout(about: text ?? "").startStandalone()
+        }
+        lunagramApplyColors(context: context, nameColor: peer.nameColor?.rawValue, backgroundEmojiId: peer.backgroundEmojiId, profileColor: peer.profileColor?.rawValue, profileBackgroundEmojiId: peer.profileBackgroundEmojiId)
+        lunagramApplyStatus(context: context, fileId: lunagramStatusFileId(peer.emojiStatus))
+        let _ = (lunagramAvatarImage(context: context, peer: peer)
+        |> deliverOnMainQueue).startStandalone(next: { image in
+            lunagramSetOwnAvatar(context: context, image: image)
+        })
+        completion()
+    })
+}
+
+/// Вернуть своё: имя, описание, оформление и аватарку из запаса.
+func lunagramRestoreOwnProfile(context: AccountContext, completion: @escaping () -> Void) {
+    guard let backup = lunagramLoadBackup() else {
+        LunagramSettings.copiedPeerId = 0
+        completion()
+        return
+    }
+    let _ = context.engine.accountData.updateAccountPeerName(firstName: backup.firstName, lastName: backup.lastName).startStandalone()
+    let _ = context.engine.accountData.updateAbout(about: backup.about).startStandalone()
+    lunagramApplyColors(context: context, nameColor: backup.nameColor, backgroundEmojiId: backup.backgroundEmojiId, profileColor: backup.profileColor, profileBackgroundEmojiId: backup.profileBackgroundEmojiId)
+    lunagramApplyStatus(context: context, fileId: backup.statusFileId)
+    if let name = backup.avatarFile, let data = LunagramSettings.ownAvatarData(name) {
+        lunagramSetOwnAvatar(context: context, image: UIImage(data: data))
+    } else if backup.hadAvatar {
+        // Картинки в запасе нет, а аватарка была: трогать её не станем —
+        // лучше оставить чужую, чем снести своё лицо без возврата.
+    } else {
+        lunagramSetOwnAvatar(context: context, image: nil)
+    }
+    LunagramSettings.copiedPeerId = 0
+    lunagramSaveBackup(nil)
+    LunagramSettings.clearOwnAvatar(backup.avatarFile)
+    completion()
+}
