+    /// Lunagram: над своей картинкой уголки строк нельзя «закрашивать».
+    ///
+    /// Telegram скругляет строки не обрезкой, а картинкой-накладкой, у которой
+    /// уголки залиты цветом фона темы. На обычном фоне это незаметно, а над
+    /// фото уголки видны чёрной или серой каймой по краям кнопок — хозяин
+    /// поймал это на айфоне, на ПК была та же беда. Поэтому при своей
+    /// картинке накладки прячем, а блок скругляем настоящей обрезкой. Заголовок
+    /// над блоком и подпись под ним обрезке не подлежат.
+    private func lunagramUpdateCorners(width: CGFloat, safeInsets: UIEdgeInsets, hasCorners: Bool, theme: PresentationTheme, cardTop: CGFloat, cardBottom: CGFloat, contentHeight: CGFloat) {
+        let active = LunagramSettings.hasProfileBackground && hasCorners
+        var overlays: [UIImage] = []
+        for glass in [true, false] {
+            for (top, bottom) in [(true, true), (true, false), (false, true)] {
+                if let image = PresentationResourcesItemList.cornersImage(theme, top: top, bottom: bottom, glass: glass) {
+                    overlays.append(image)
+                }
+            }
+        }
+        for (_, itemNode) in self.itemNodes {
+            for subnode in itemNode.subnodes ?? [] {
+                if let imageNode = subnode as? ASImageNode, let image = imageNode.image, overlays.contains(where: { $0 === image }) {
+                    imageNode.isHidden = active
+                }
+            }
+        }
+        guard active, cardBottom > cardTop else {
+            self.layer.mask = nil
+            return
+        }
+        let path = UIBezierPath(rect: CGRect(x: 0.0, y: 0.0, width: width, height: cardTop))
+        path.append(UIBezierPath(roundedRect: CGRect(x: safeInsets.left, y: cardTop, width: width - safeInsets.left - safeInsets.right, height: cardBottom - cardTop), cornerRadius: 26.0))
+        path.append(UIBezierPath(rect: CGRect(x: 0.0, y: cardBottom, width: width, height: max(0.0, contentHeight - cardBottom))))
+        let mask = (self.layer.mask as? CAShapeLayer) ?? CAShapeLayer()
+        mask.path = path.cgPath
+        self.layer.mask = mask
+    }
     
