diff --git a/submodules/Lunagram/Sources/LunagramCropPreviewView.swift b/submodules/Lunagram/Sources/LunagramCropPreviewView.swift
new file mode 100644
index 00000000..0b1d4980
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramCropPreviewView.swift
@@ -0,0 +1,280 @@
+import AVFoundation
+import UIKit
+
+/// Образец с выбором кадра прямо в экране настроек — как на ПК: тянешь
+/// картинку пальцем, щипком приближаешь, и сразу видно, что попадёт в шапку,
+/// в обои или под список профиля. Раньше для этого открывалось отдельное
+/// окно подгонки; математика та же, что в нём и на ПК.
+public final class LunagramCropPreviewView: UIView, UIGestureRecognizerDelegate {
+    public let kind: LunagramCropEditor.Kind
+
+    private let clipView = UIView()
+    private let imageView = UIImageView()
+    private var playerLayer: AVPlayerLayer?
+    private var player: AVQueuePlayer?
+    private var looper: AVPlayerLooper?
+    private let blurView = UIVisualEffectView(effect: UIBlurEffect(style: .regular))
+    private let dimView = UIView()
+    private let hintLabel = UILabel()
+
+    private var shownKey: String?
+    private var originalSize: CGSize = .zero
+    private var isPreset = false
+    private var presetSize: CGSize = .zero
+    private var startCrop = LunagramSettings.Crop(offsetX: 0, offsetY: 0, zoom: 100)
+    private var observer: NSObjectProtocol?
+
+    public init(kind: LunagramCropEditor.Kind) {
+        self.kind = kind
+        super.init(frame: CGRect())
+
+        self.clipView.clipsToBounds = true
+        self.clipView.layer.cornerRadius = 12.0
+        self.clipView.backgroundColor = UIColor(white: 0.5, alpha: 0.15)
+        self.addSubview(self.clipView)
+
+        self.imageView.contentMode = .scaleToFill
+        self.clipView.addSubview(self.imageView)
+
+        self.blurView.isUserInteractionEnabled = false
+        self.clipView.addSubview(self.blurView)
+
+        self.dimView.backgroundColor = .black
+        self.dimView.isUserInteractionEnabled = false
+        self.clipView.addSubview(self.dimView)
+
+        // Та же подсказка, что на ПК, только вместо колеса — щипок.
+        self.hintLabel.text = "Потяни, чтобы выбрать кадр. Щипок — приблизить"
+        self.hintLabel.textColor = UIColor(white: 1.0, alpha: 0.92)
+        self.hintLabel.font = .systemFont(ofSize: 12.0)
+        self.hintLabel.textAlignment = .center
+        self.hintLabel.adjustsFontSizeToFitWidth = true
+        self.hintLabel.minimumScaleFactor = 0.7
+        self.hintLabel.layer.shadowColor = UIColor.black.cgColor
+        self.hintLabel.layer.shadowOpacity = 0.8
+        self.hintLabel.layer.shadowRadius = 2.0
+        self.hintLabel.layer.shadowOffset = CGSize()
+        self.clipView.addSubview(self.hintLabel)
+
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(self.handlePan(_:)))
+        let pinch = UIPinchGestureRecognizer(target: self, action: #selector(self.handlePinch(_:)))
+        pan.delegate = self
+        pinch.delegate = self
+        self.clipView.addGestureRecognizer(pan)
+        self.clipView.addGestureRecognizer(pinch)
+
+        self.observer = NotificationCenter.default.addObserver(forName: LunagramSettings.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+        self.reload()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let observer = self.observer {
+            NotificationCenter.default.removeObserver(observer)
+        }
+        self.player?.pause()
+    }
+
+    private var crop: LunagramSettings.Crop {
+        get {
+            switch self.kind {
+            case .banner:
+                return LunagramSettings.bannerCrop
+            case .wallpaper:
+                return LunagramSettings.wallpaperCrop
+            case .profileBackground:
+                return LunagramSettings.profileBackgroundCrop
+            }
+        }
+        set {
+            switch self.kind {
+            case .banner:
+                LunagramSettings.bannerCrop = newValue
+            case .wallpaper:
+                LunagramSettings.wallpaperCrop = newValue
+            case .profileBackground:
+                LunagramSettings.profileBackgroundCrop = newValue
+            }
+        }
+    }
+
+    private var sourceURL: URL? {
+        switch self.kind {
+        case .banner:
+            return LunagramSettings.profileBannerURL
+        case .wallpaper:
+            return LunagramSettings.liveWallpaperURL
+        case .profileBackground:
+            return LunagramSettings.profileBackgroundURL
+        }
+    }
+
+    private var isVideo: Bool {
+        switch self.kind {
+        case .banner:
+            return LunagramSettings.profileBannerIsVideo
+        case .wallpaper:
+            return true
+        case .profileBackground:
+            return false
+        }
+    }
+
+    /// Нарисованный баннер, если выбран он: у него своя картинка и кадр не
+    /// подгоняется.
+    private var bannerPreset: LunagramBannerPreset? {
+        guard self.kind == .banner else {
+            return nil
+        }
+        return LunagramBannerPreset(rawValue: LunagramSettings.profileBannerPreset)
+    }
+
+    /// Перечитать выбранное: файл, затемнение, размытие, кадр.
+    public func reload() {
+        let preset = self.bannerPreset
+        let key: String
+        if let preset = preset {
+            key = "preset-\(preset.rawValue)"
+        } else if let url = self.sourceURL {
+            key = url.lastPathComponent
+        } else {
+            key = "none"
+        }
+        if key != self.shownKey {
+            self.shownKey = key
+            self.player?.pause()
+            self.playerLayer?.removeFromSuperlayer()
+            self.playerLayer = nil
+            self.player = nil
+            self.looper = nil
+            self.imageView.image = nil
+            self.originalSize = .zero
+            self.presetSize = .zero
+            self.isPreset = preset != nil
+            if preset == nil, let url = self.sourceURL {
+                if self.isVideo {
+                    let asset = AVURLAsset(url: url)
+                    if let track = asset.tracks(withMediaType: .video).first {
+                        let rotated = CGRect(origin: .zero, size: track.naturalSize).applying(track.preferredTransform)
+                        self.originalSize = CGSize(width: abs(rotated.width), height: abs(rotated.height))
+                    }
+                    let player = AVQueuePlayer()
+                    player.isMuted = true
+                    self.looper = AVPlayerLooper(player: player, templateItem: AVPlayerItem(asset: asset))
+                    let layer = AVPlayerLayer(player: player)
+                    layer.videoGravity = .resize
+                    self.clipView.layer.insertSublayer(layer, above: self.imageView.layer)
+                    self.playerLayer = layer
+                    self.player = player
+                    player.play()
+                } else if let image = UIImage(contentsOfFile: url.path) {
+                    self.imageView.image = image
+                    self.originalSize = image.size
+                }
+            }
+        }
+
+        switch self.kind {
+        case .banner:
+            if let preset = preset {
+                self.dimView.alpha = preset.dim
+                self.blurView.alpha = 0.0
+            } else {
+                self.dimView.alpha = CGFloat(LunagramSettings.profileBannerDimPercent) / 100.0
+                self.blurView.alpha = CGFloat(LunagramSettings.profileBannerBlur) / 100.0
+            }
+        case .wallpaper:
+            self.dimView.alpha = CGFloat(LunagramSettings.liveWallpaperDimPercent) / 100.0
+            self.blurView.alpha = 0.0
+        case .profileBackground:
+            self.dimView.alpha = CGFloat(LunagramSettings.profileBackgroundDim) / 100.0
+            self.blurView.alpha = CGFloat(LunagramSettings.profileBackgroundBlur) / 100.0
+        }
+        self.hintLabel.isHidden = self.isPreset || self.originalSize.width <= 0.0
+        self.setNeedsLayout()
+    }
+
+    public override func layoutSubviews() {
+        super.layoutSubviews()
+        self.clipView.frame = self.bounds
+        self.blurView.frame = self.clipView.bounds
+        self.dimView.frame = self.clipView.bounds
+        let hintHeight: CGFloat = 18.0
+        self.hintLabel.frame = CGRect(x: 8.0, y: self.clipView.bounds.height - hintHeight - 6.0, width: max(0.0, self.clipView.bounds.width - 16.0), height: hintHeight)
+        self.layoutContent()
+    }
+
+    private func layoutContent() {
+        let bounds = self.clipView.bounds
+        guard bounds.width > 0.0, bounds.height > 0.0 else {
+            return
+        }
+        let frame: CGRect
+        if self.isPreset {
+            // Нарисованный баннер рисуем ровно под размер образца.
+            if self.presetSize != bounds.size {
+                self.presetSize = bounds.size
+                self.imageView.image = self.bannerPreset?.image(size: bounds.size)
+            }
+            frame = bounds
+        } else if self.originalSize.width > 0.0 {
+            let placement = LunagramSettings.place(original: self.originalSize, target: bounds.size, crop: self.crop)
+            frame = CGRect(origin: placement.origin, size: placement.size)
+        } else {
+            frame = bounds
+        }
+        self.imageView.frame = frame
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.playerLayer?.frame = frame
+        CATransaction.commit()
+    }
+
+    @objc private func handlePan(_ gesture: UIPanGestureRecognizer) {
+        guard !self.isPreset, self.originalSize.width > 0.0 else {
+            return
+        }
+        if gesture.state == .began {
+            self.startCrop = self.crop
+        }
+        let bounds = self.clipView.bounds
+        let placement = LunagramSettings.place(original: self.originalSize, target: bounds.size, crop: self.startCrop)
+        let extraX = placement.size.width - bounds.width
+        let extraY = placement.size.height - bounds.height
+        let delta = gesture.translation(in: self.clipView)
+        var updated = self.startCrop
+        // Как на ПК: сдвиг — доля от лишка, весь ход от −100 до +100.
+        if extraX > 0.0 {
+            updated.offsetX = max(-100, min(100, self.startCrop.offsetX - Int((delta.x * 200.0 / extraX).rounded())))
+        }
+        if extraY > 0.0 {
+            updated.offsetY = max(-100, min(100, self.startCrop.offsetY - Int((delta.y * 200.0 / extraY).rounded())))
+        }
+        self.crop = updated
+        self.layoutContent()
+    }
+
+    @objc private func handlePinch(_ gesture: UIPinchGestureRecognizer) {
+        guard !self.isPreset, self.originalSize.width > 0.0 else {
+            return
+        }
+        if gesture.state == .began {
+            self.startCrop = self.crop
+        }
+        var updated = self.startCrop
+        updated.zoom = max(100, min(300, Int((Double(self.startCrop.zoom) * Double(gesture.scale)).rounded())))
+        self.crop = updated
+        self.layoutContent()
+    }
+
+    // Двигать и приближать можно вместе, а со списком — нет: иначе тянешь
+    // картинку, а едет весь экран.
+    public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return otherGestureRecognizer.view === self.clipView
+    }
+}
