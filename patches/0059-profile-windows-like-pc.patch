+import Foundation
+import UIKit
+import AVFoundation
+import ImageIO
+import Display
+import AsyncDisplayKit
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+import Lunagram
+
+/// Плитка выбора — как на ПК: картинка, подпись снизу, у выбранной галочка.
+struct LunagramTile: Equatable {
+    enum Content: Equatable {
+        // «Без картинки» / «Без рамки»: только надпись посередине.
+        case empty
+        // «+ Выбрать файл».
+        case add
+        // Свой файл: где лежит и видео ли это.
+        case file(URL, Bool)
+        // Свой файл-рамка: рисуется вокруг кружка-заглушки.
+        case frameFile(URL)
+        case bannerPreset(Int)
+        case frameStyle(Int)
+    }
+
+    let id: String
+    let title: String
+    let content: Content
+    let selected: Bool
+}
+
+/// Ряд плиток выбора, по три в строку — как в окнах оформления на ПК.
+/// Нажатие выбирает; долгое нажатие на своём файле — «Удалить».
+final class LunagramTilesItem: ListViewItem, ItemListItem {
+    let presentationData: ItemListPresentationData
+    let tiles: [LunagramTile]
+    /// Высота картинки к ширине плитки: баннер низкий, рамка квадратная.
+    let aspect: CGFloat
+    let sectionId: ItemListSectionId
+    let select: (String) -> Void
+    let longPress: (String) -> Void
+
+    init(presentationData: ItemListPresentationData, tiles: [LunagramTile], aspect: CGFloat, sectionId: ItemListSectionId, select: @escaping (String) -> Void, longPress: @escaping (String) -> Void) {
+        self.presentationData = presentationData
+        self.tiles = tiles
+        self.aspect = aspect
+        self.sectionId = sectionId
+        self.select = select
+        self.longPress = longPress
+    }
+
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, previousItem: ListViewItem?, nextItem: ListViewItem?, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        async {
+            let node = LunagramTilesItemNode()
+            let (layout, apply) = node.asyncLayout()(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            Queue.mainQueue().async {
+                completion(node, {
+                    return (nil, { _ in apply() })
+                })
+            }
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            if let node = node() as? LunagramTilesItemNode {
+                let makeLayout = node.asyncLayout()
+                async {
+                    let (layout, apply) = makeLayout(self, params, itemListNeighbors(item: self, topItem: previousItem as? ItemListItem, bottomItem: nextItem as? ItemListItem))
+                    Queue.mainQueue().async {
+                        completion(layout, { _ in apply() })
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Готовые картинки плиток. Читать и уменьшать файл на каждой перерисовке
+/// дорого, а список плиток перестраивается от каждого ползунка.
+private final class LunagramTileImages {
+    static let shared = LunagramTileImages()
+
+    let cache = NSCache<NSString, UIImage>()
+
+    /// Уменьшенная картинка своего файла, первый кадр — для видео.
+    func load(url: URL, isVideo: Bool, side: CGFloat, completion: @escaping (UIImage?) -> Void) {
+        let key = "\(url.lastPathComponent)|\(Int(side))" as NSString
+        if let cached = self.cache.object(forKey: key) {
+            completion(cached)
+            return
+        }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let pixels = side * 3.0
+            var image: UIImage?
+            if isVideo {
+                let generator = AVAssetImageGenerator(asset: AVURLAsset(url: url))
+                generator.appliesPreferredTrackTransform = true
+                generator.maximumSize = CGSize(width: pixels, height: pixels)
+                if let cgImage = try? generator.copyCGImage(at: .zero, actualTime: nil) {
+                    image = UIImage(cgImage: cgImage)
+                }
+            } else if let source = CGImageSourceCreateWithURL(url as CFURL, nil) {
+                let options: [CFString: Any] = [
+                    kCGImageSourceCreateThumbnailFromImageAlways: true,
+                    kCGImageSourceCreateThumbnailWithTransform: true,
+                    kCGImageSourceThumbnailMaxPixelSize: pixels
+                ]
+                if let cgImage = CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary) {
+                    image = UIImage(cgImage: cgImage)
+                }
+            }
+            let result = image
+            DispatchQueue.main.async {
+                if let result = result {
+                    self.cache.setObject(result, forKey: key)
+                }
+                completion(result)
+            }
+        }
+    }
+}
+
+final class LunagramTilesItemNode: ListViewItemNode {
+    private let backgroundNode: ASDisplayNode
+    private let topStripeNode: ASDisplayNode
+    private let bottomStripeNode: ASDisplayNode
+    private let maskNode: ASImageNode
+
+    private let tilesContainer: UIView
+    private var tileViews: [UIView] = []
+    private var shownTiles: [LunagramTile] = []
+    private var shownWidth: CGFloat = 0.0
+
+    private var item: LunagramTilesItem?
+
+    init() {
+        self.backgroundNode = ASDisplayNode()
+        self.backgroundNode.isLayerBacked = true
+        self.topStripeNode = ASDisplayNode()
+        self.topStripeNode.isLayerBacked = true
+        self.bottomStripeNode = ASDisplayNode()
+        self.bottomStripeNode.isLayerBacked = true
+        self.maskNode = ASImageNode()
+        self.tilesContainer = UIView()
+
+        super.init(layerBacked: false)
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.view.addSubview(self.tilesContainer)
+    }
+
+    private static let columns = 3
+    private static let spacing: CGFloat = 8.0
+    private static let padding: CGFloat = 12.0
+    private static let titleHeight: CGFloat = 20.0
+
+    private static func tileWidth(rowWidth: CGFloat) -> CGFloat {
+        let columns = CGFloat(LunagramTilesItemNode.columns)
+        return floor((rowWidth - LunagramTilesItemNode.padding * 2.0 - LunagramTilesItemNode.spacing * (columns - 1.0)) / columns)
+    }
+
+    func asyncLayout() -> (_ item: LunagramTilesItem, _ params: ListViewItemLayoutParams, _ neighbors: ItemListNeighbors) -> (ListViewItemNodeLayout, () -> Void) {
+        return { item, params, neighbors in
+            let separatorHeight = UIScreenPixel
+            let rowWidth = params.width - params.leftInset - params.rightInset
+            let tileWidth = LunagramTilesItemNode.tileWidth(rowWidth: rowWidth)
+            let imageHeight = floor(tileWidth * item.aspect)
+            let rows = (item.tiles.count + LunagramTilesItemNode.columns - 1) / LunagramTilesItemNode.columns
+            let rowHeight = imageHeight + LunagramTilesItemNode.titleHeight
+            let height = LunagramTilesItemNode.padding * 2.0 + CGFloat(rows) * rowHeight + CGFloat(max(0, rows - 1)) * LunagramTilesItemNode.spacing
+
+            let contentSize = CGSize(width: params.width, height: height)
+            let insets = itemListNeighborsGroupedInsets(neighbors, params)
+            let layout = ListViewItemNodeLayout(contentSize: contentSize, insets: insets)
+            let layoutSize = layout.size
+
+            return (layout, { [weak self] in
+                guard let strongSelf = self else {
+                    return
+                }
+                strongSelf.item = item
+
+                strongSelf.backgroundNode.backgroundColor = item.presentationData.theme.list.itemBlocksBackgroundColor
+                strongSelf.topStripeNode.backgroundColor = item.presentationData.theme.list.itemBlocksSeparatorColor
+                strongSelf.bottomStripeNode.backgroundColor = item.presentationData.theme.list.itemBlocksSeparatorColor
+                if strongSelf.backgroundNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.backgroundNode, at: 0)
+                }
+                if strongSelf.topStripeNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.topStripeNode, at: 1)
+                }
+                if strongSelf.bottomStripeNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.bottomStripeNode, at: 2)
+                }
+                if strongSelf.maskNode.supernode == nil {
+                    strongSelf.insertSubnode(strongSelf.maskNode, at: 3)
+                }
+                let hasCorners = itemListHasRoundedBlockLayout(params)
+                var hasTopCorners = false
+                var hasBottomCorners = false
+                switch neighbors.top {
+                case .sameSection(false):
+                    strongSelf.topStripeNode.isHidden = true
+                default:
+                    hasTopCorners = true
+                    strongSelf.topStripeNode.isHidden = hasCorners
+                }
+                switch neighbors.bottom {
+                case .sameSection(false):
+                    strongSelf.bottomStripeNode.isHidden = false
+                default:
+                    hasBottomCorners = true
+                    strongSelf.bottomStripeNode.isHidden = hasCorners
+                }
+                strongSelf.maskNode.image = hasCorners ? PresentationResourcesItemList.cornersImage(item.presentationData.theme, top: hasTopCorners, bottom: hasBottomCorners, glass: false) : nil
+                strongSelf.backgroundNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: params.width, height: contentSize.height + min(insets.top, separatorHeight) + min(insets.bottom, separatorHeight)))
+                strongSelf.maskNode.frame = strongSelf.backgroundNode.frame.insetBy(dx: params.leftInset, dy: 0.0)
+                strongSelf.topStripeNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: layoutSize.width, height: separatorHeight))
+                strongSelf.bottomStripeNode.frame = CGRect(origin: CGPoint(x: 0.0, y: contentSize.height - separatorHeight), size: CGSize(width: layoutSize.width - params.rightInset - 16.0, height: separatorHeight))
+
+                strongSelf.tilesContainer.frame = CGRect(x: params.leftInset, y: 0.0, width: rowWidth, height: contentSize.height)
+                if strongSelf.shownTiles != item.tiles || strongSelf.shownWidth != rowWidth {
+                    strongSelf.shownTiles = item.tiles
+                    strongSelf.shownWidth = rowWidth
+                    strongSelf.rebuildTiles(item: item, tileWidth: tileWidth, imageHeight: imageHeight)
+                }
+            })
+        }
+    }
+
+    private func rebuildTiles(item: LunagramTilesItem, tileWidth: CGFloat, imageHeight: CGFloat) {
+        for view in self.tileViews {
+            view.removeFromSuperview()
+        }
+        self.tileViews.removeAll()
+
+        let theme = item.presentationData.theme
+        let accent = theme.list.itemAccentColor
+        let placeholder = theme.list.itemSecondaryTextColor.withAlphaComponent(0.16)
+        let avatarPlaceholder = accent.withAlphaComponent(0.55)
+
+        for (index, tile) in item.tiles.enumerated() {
+            let column = index % LunagramTilesItemNode.columns
+            let row = index / LunagramTilesItemNode.columns
+            let x = LunagramTilesItemNode.padding + CGFloat(column) * (tileWidth + LunagramTilesItemNode.spacing)
+            let y = LunagramTilesItemNode.padding + CGFloat(row) * (imageHeight + LunagramTilesItemNode.titleHeight + LunagramTilesItemNode.spacing)
+
+            let tileView = LunagramTileView(frame: CGRect(x: x, y: y, width: tileWidth, height: imageHeight + LunagramTilesItemNode.titleHeight))
+            tileView.tileId = tile.id
+            tileView.onTap = { [weak self] id in
+                self?.item?.select(id)
+            }
+            tileView.onLongPress = { [weak self] id in
+                self?.item?.longPress(id)
+            }
+            self.tilesContainer.addSubview(tileView)
+            self.tileViews.append(tileView)
+
+            let imageFrame = CGRect(x: 0.0, y: 0.0, width: tileWidth, height: imageHeight)
+            tileView.imageBox.frame = imageFrame
+            tileView.imageBox.backgroundColor = placeholder
+            tileView.imageView.frame = CGRect(origin: CGPoint(), size: imageFrame.size)
+            tileView.titleLabel.frame = CGRect(x: 0.0, y: imageHeight + 2.0, width: tileWidth, height: LunagramTilesItemNode.titleHeight - 2.0)
+            tileView.titleLabel.text = tile.title
+            tileView.titleLabel.textColor = theme.list.itemSecondaryTextColor
+            tileView.centerLabel.frame = CGRect(origin: CGPoint(), size: imageFrame.size)
+            tileView.centerLabel.textColor = theme.list.itemSecondaryTextColor
+
+            switch tile.content {
+            case .empty:
+                // Надпись посередине, подпись снизу не нужна.
+                tileView.centerLabel.text = tile.title
+                tileView.titleLabel.text = nil
+            case .add:
+                tileView.imageView.contentMode = .center
+                tileView.imageView.image = UIImage(systemName: "plus", withConfiguration: UIImage.SymbolConfiguration(pointSize: 24.0, weight: .light))?.withTintColor(theme.list.itemSecondaryTextColor, renderingMode: .alwaysOriginal)
+            case let .file(url, isVideo):
+                tileView.imageView.contentMode = .scaleAspectFill
+                let expected = tile.id
+                LunagramTileImages.shared.load(url: url, isVideo: isVideo, side: max(tileWidth, imageHeight), completion: { [weak tileView] image in
+                    guard let tileView = tileView, tileView.tileId == expected else {
+                        return
+                    }
+                    tileView.imageView.image = image
+                })
+                if isVideo {
+                    tileView.showPlayBadge()
+                }
+            case let .frameFile(url):
+                // Своя рамка — вокруг кружка-заглушки, как на ПК.
+                tileView.imageView.contentMode = .scaleAspectFit
+                tileView.showAvatarPlaceholder(color: avatarPlaceholder)
+                let expected = tile.id
+                LunagramTileImages.shared.load(url: url, isVideo: false, side: max(tileWidth, imageHeight), completion: { [weak tileView] image in
+                    guard let tileView = tileView, tileView.tileId == expected else {
+                        return
+                    }
+                    tileView.imageView.image = image
+                })
+            case let .bannerPreset(rawValue):
+                tileView.imageView.contentMode = .scaleAspectFill
+                let key = "preset-\(rawValue)|\(Int(tileWidth))" as NSString
+                if let cached = LunagramTileImages.shared.cache.object(forKey: key) {
+                    tileView.imageView.image = cached
+                } else if let image = LunagramBannerPreset(rawValue: rawValue)?.image(size: imageFrame.size) {
+                    LunagramTileImages.shared.cache.setObject(image, forKey: key)
+                    tileView.imageView.image = image
+                }
+            case let .frameStyle(rawValue):
+                tileView.imageView.contentMode = .center
+                if let style = LunagramAvatarFrameStyle(rawValue: rawValue) {
+                    let side = min(tileWidth, imageHeight)
+                    tileView.imageView.image = LunagramAvatarFrameLayer.thumbnail(style: style, side: side, placeholder: avatarPlaceholder)
+                }
+            }
+
+            tileView.setSelected(tile.selected, accent: accent)
+        }
+    }
+}
+
+/// Одна плитка: картинка в скруглённой рамке, подпись, галочка.
+private final class LunagramTileView: UIView {
+    let imageBox = UIView()
+    let imageView = UIImageView()
+    let titleLabel = UILabel()
+    let centerLabel = UILabel()
+    private let checkView = UIImageView()
+    private var badgeView: UIImageView?
+    private var avatarView: UIView?
+
+    var tileId: String = ""
+    var onTap: ((String) -> Void)?
+    var onLongPress: ((String) -> Void)?
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+
+        self.imageBox.clipsToBounds = true
+        self.imageBox.layer.cornerRadius = 10.0
+        self.addSubview(self.imageBox)
+        self.imageView.clipsToBounds = true
+        self.imageBox.addSubview(self.imageView)
+
+        self.centerLabel.font = .systemFont(ofSize: 12.0)
+        self.centerLabel.textAlignment = .center
+        self.centerLabel.numberOfLines = 2
+        self.imageBox.addSubview(self.centerLabel)
+
+        self.titleLabel.font = .systemFont(ofSize: 12.0)
+        self.titleLabel.textAlignment = .center
+        self.titleLabel.lineBreakMode = .byTruncatingTail
+        self.addSubview(self.titleLabel)
+
+        self.checkView.isHidden = true
+        self.addSubview(self.checkView)
+
+        self.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.tapped)))
+        self.addGestureRecognizer(UILongPressGestureRecognizer(target: self, action: #selector(self.longPressed(_:))))
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func setSelected(_ selected: Bool, accent: UIColor) {
+        // Как на ПК: у выбранной — рамка цвета темы и галочка в углу.
+        self.imageBox.layer.borderWidth = selected ? 2.0 : 0.0
+        self.imageBox.layer.borderColor = accent.cgColor
+        self.checkView.isHidden = !selected
+        if selected {
+            let side: CGFloat = 20.0
+            self.checkView.image = UIImage(systemName: "checkmark.circle.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: side, weight: .regular))?.withTintColor(accent, renderingMode: .alwaysOriginal)
+            self.checkView.frame = CGRect(x: self.imageBox.frame.maxX - side - 4.0, y: self.imageBox.frame.minY + 4.0, width: side, height: side)
+        }
+    }
+
+    func showPlayBadge() {
+        let badge = UIImageView(image: UIImage(systemName: "play.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 16.0, weight: .regular))?.withTintColor(.white, renderingMode: .alwaysOriginal))
+        badge.contentMode = .center
+        badge.layer.shadowColor = UIColor.black.cgColor
+        badge.layer.shadowOpacity = 0.6
+        badge.layer.shadowRadius = 2.0
+        badge.layer.shadowOffset = CGSize()
+        badge.frame = self.imageBox.bounds
+        self.imageBox.addSubview(badge)
+        self.badgeView = badge
+    }
+
+    func showAvatarPlaceholder(color: UIColor) {
+        let side = min(self.imageBox.bounds.width, self.imageBox.bounds.height) * 0.56
+        let avatar = UIView(frame: CGRect(x: (self.imageBox.bounds.width - side) / 2.0, y: (self.imageBox.bounds.height - side) / 2.0, width: side, height: side))
+        avatar.backgroundColor = color
+        avatar.layer.cornerRadius = side / 2.0
+        self.imageBox.insertSubview(avatar, belowSubview: self.imageView)
+        self.avatarView = avatar
+    }
+
+    @objc private func tapped() {
+        self.onTap?(self.tileId)
+    }
+
+    @objc private func longPressed(_ gesture: UILongPressGestureRecognizer) {
+        if gesture.state == .began {
+            self.onLongPress?(self.tileId)
+        }
+    }
+}
