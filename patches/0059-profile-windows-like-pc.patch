+/// Отдельный экран, собранный по образцу ПК, со своим свежим состоянием.
+/// Открывается из «Изменить профиль».
+private func lunagramBuiltScreen(context: AccountContext, title: String, build: @escaping ([LunagramToggle: Bool], LunagramMediaState) -> [LunagramSettingsEntry]) -> ViewController {
+    let shared = LunagramSharedState()
+    let arguments = lunagramMakeArguments(context: context, shared: shared)
+    shared.arguments = arguments
+
+    let signal = combineLatest(context.sharedContext.presentationData, shared.valuesPromise.get(), shared.mediaPromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, currentValues, media -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = build(currentValues, media)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    shared.push = { [weak controller] c in
+        controller?.push(c)
+    }
+    shared.present = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    return controller
+}
