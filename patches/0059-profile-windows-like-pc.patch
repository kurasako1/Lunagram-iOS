+/// Число-отпечаток имени файла: образец перерисовывается, когда выбор сменился.
+private func lunagramNameToken(_ name: String?) -> Int {
+    guard let name = name else {
+        return 0
+    }
+    var result = 0
+    for scalar in name.unicodeScalars {
+        result = (result &* 31 &+ Int(scalar.value)) % 1_000_003
+    }
+    return result + 1
+}
