diff --git a/submodules/TelegramCore/Sources/State/LunagramEditHistory.swift b/submodules/TelegramCore/Sources/State/LunagramEditHistory.swift
new file mode 100644
index 00000000..c1247430
--- /dev/null
+++ b/submodules/TelegramCore/Sources/State/LunagramEditHistory.swift
@@ -0,0 +1,26 @@
+import Foundation
+import Postbox
+import LunagramGhost
+
+/// Lunagram: история изменений.
+///
+/// Зовётся, когда сервер прислал новую версию сообщения, прямо перед тем, как
+/// Telegram заменит ею старую. Новая версия приходит без нашей пометки,
+/// поэтому историю переносим всегда — даже если сохранение потом выключили,
+/// уже собранное не теряется.
+func lunagramKeepEditHistory(previousMessage: Message, updatedText: String, attributes: inout [MessageAttribute]) {
+    var versions = (previousMessage.attributes.first(where: { $0 is LunagramEditHistoryAttribute }) as? LunagramEditHistoryAttribute)?.versions ?? []
+    // Правкой приходит не только новый текст: число просмотров, кнопки,
+    // реакции. Храним, только если поменялся сам текст.
+    if LunagramSpySettings.keepEditHistory && previousMessage.text != updatedText {
+        let date = previousMessage.editedTime ?? previousMessage.timestamp
+        versions.append(LunagramEditHistoryAttribute.Version(date: date, text: previousMessage.text))
+        if versions.count > LunagramEditHistoryAttribute.limit {
+            versions.removeFirst(versions.count - LunagramEditHistoryAttribute.limit)
+        }
+    }
+    attributes.removeAll(where: { $0 is LunagramEditHistoryAttribute })
+    if !versions.isEmpty {
+        attributes.append(LunagramEditHistoryAttribute(versions: versions))
+    }
+}
