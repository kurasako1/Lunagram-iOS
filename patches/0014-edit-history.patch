--- /dev/null
+++ b/submodules/TelegramCore/Sources/SyncCore/SyncCore_LunagramEditHistoryAttribute.swift
@@ -0,0 +1,34 @@
+import Foundation
+import Postbox
+
+/// Lunagram: история изменений сообщения — каким оно было до правок.
+///
+/// Версии по порядку, старые первыми. date — с какого момента текст был
+/// таким: время отправки или прошлой правки.
+public final class LunagramEditHistoryAttribute: MessageAttribute {
+    public struct Version {
+        public let date: Int32
+        public let text: String
+    }
+
+    /// Больше не храним: сообщение, которое правят каждую минуту, иначе
+    /// разрослось бы в базе без меры.
+    public static let limit = 20
+
+    public let versions: [Version]
+
+    public init(versions: [Version]) {
+        self.versions = versions
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        let texts = decoder.decodeStringArrayForKey("t")
+        self.versions = zip(dates, texts).map { Version(date: $0.0, text: $0.1) }
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32Array(self.versions.map { $0.date }, forKey: "d")
+        encoder.encodeStringArray(self.versions.map { $0.text }, forKey: "t")
+    }
+}
