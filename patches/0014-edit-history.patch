+import Foundation
+
+/// Текст окна «История изменений»: каждая прежняя версия со временем, в
+/// конце — нынешняя.
+public enum LunagramEditHistoryText {
+    /// Сколько версий показывать. Окно не прокручивается, и длинная история
+    /// ушла бы за край экрана; самые старые отбрасываем.
+    private static let shownVersions = 8
+    /// Сколько знаков от каждой версии. Остальное — многоточием.
+    private static let shownCharacters = 300
+
+    public static func make(versions: [(date: Int32, text: String)], current: String) -> String {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "d MMM, HH:mm"
+        formatter.locale = Locale(identifier: "ru_RU")
+
+        var lines: [String] = []
+        let shown = versions.suffix(shownVersions)
+        if versions.count > shown.count {
+            lines.append("…и ещё \(versions.count - shown.count) раньше")
+        }
+        for version in shown {
+            let date = formatter.string(from: Date(timeIntervalSince1970: TimeInterval(version.date)))
+            lines.append("\(date)\n\(trimmed(version.text))")
+        }
+        lines.append("Сейчас\n\(trimmed(current))")
+        return lines.joined(separator: "\n\n")
+    }
+
+    private static func trimmed(_ text: String) -> String {
+        if text.isEmpty {
+            return "(без текста)"
+        }
+        if text.count <= shownCharacters {
+            return text
+        }
+        return String(text.prefix(shownCharacters)) + "…"
+    }
+}
