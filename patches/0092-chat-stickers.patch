diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramChatStickers.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/LunagramChatStickers.swift
