@@ -0,0 +1,255 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import ItemListStickerPackItem
+import StickerPackPreviewUI
+import Lunagram
+
+// Lunagram: «Эмодзи и стикеры чата» — перенос задумки плагина
+// Chat Emoji & Stickers.
+//
+// Листаешь переписку, видишь незнакомый значок или стикер и не знаешь, где
+// его взять. Экран отвечает на этот вопрос: проходит по сохранённым
+// сообщениям переписки и собирает наборы, из которых там что-то
+// попадалось, — отдельно эмодзи, отдельно стикеры, и у каждого написано,
+// сколько раз встретился. Нажал — открылось окно набора с «Добавить».
+//
+// Смотрим только то, что уже лежит на телефоне: переписку, которую ты
+// листал. У сервера ничего не спрашиваем — ни одного лишнего запроса, и
+// Telegram не попросит подождать, как случалось у плагина.
+//
+// Чего здесь нет: копирования чужих наборов в свой через @stickers. Это
+// отдельная машина — разговор с ботом и перезаливка чужих картинок под
+// своим именем. Скажет хозяин — сделаю отдельно.
+
+private struct LunagramFoundPack {
+    var reference: StickerPackReference
+    var count: Int
+}
+
+private struct LunagramChatStickersData {
+    var emoji: [LunagramFoundPack] = []
+    var stickers: [LunagramFoundPack] = []
+    var scanned: Int = 0
+}
+
+private final class LunagramChatStickersArguments {
+    let context: AccountContext
+    let open: (StickerPackReference) -> Void
+
+    init(context: AccountContext, open: @escaping (StickerPackReference) -> Void) {
+        self.context = context
+        self.open = open
+    }
+}
+
+/// Проходим по сохранённым сообщениям и считаем, из каких наборов что было.
+private func lunagramScanChat(context: AccountContext, peerId: EnginePeer.Id, depth: Int) -> Signal<LunagramChatStickersData, NoError> {
+    return context.account.postbox.transaction { transaction -> LunagramChatStickersData in
+        var emojiCounts: [StickerPackReference: Int] = [:]
+        var stickerCounts: [StickerPackReference: Int] = [:]
+        var scanned = 0
+
+        transaction.withAllMessages(peerId: peerId, { message in
+            scanned += 1
+
+            for media in message.media {
+                if let file = media as? TelegramMediaFile {
+                    for attribute in file.attributes {
+                        if case let .Sticker(_, packReference, _) = attribute, let reference = packReference {
+                            stickerCounts[reference] = (stickerCounts[reference] ?? 0) + 1
+                        }
+                    }
+                }
+            }
+
+            // Свои эмодзи лежат отдельно от текста: в сообщении стоят отметки
+            // с их номерами, а сами картинки — в приложенных к сообщению.
+            for media in message.associatedMedia.values {
+                if let file = media as? TelegramMediaFile {
+                    for attribute in file.attributes {
+                        if case let .CustomEmoji(_, _, _, packReference) = attribute, let reference = packReference {
+                            emojiCounts[reference] = (emojiCounts[reference] ?? 0) + 1
+                        }
+                    }
+                }
+            }
+
+            return scanned < depth
+        })
+
+        var data = LunagramChatStickersData()
+        data.scanned = scanned
+        data.emoji = emojiCounts.map { LunagramFoundPack(reference: $0.key, count: $0.value) }.sorted(by: { $0.count > $1.count })
+        data.stickers = stickerCounts.map { LunagramFoundPack(reference: $0.key, count: $0.value) }.sorted(by: { $0.count > $1.count })
+        return data
+    }
+}
+
+private enum LunagramChatStickersEntry: ItemListNodeEntry {
+    case header(Int32, String)
+    case pack(Int32, StickerPackCollectionInfo.Accessor, StickerPackItem?, String)
+    case info(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(index, _):
+            return index < 1_000 ? 0 : 1
+        case let .pack(index, _, _, _):
+            return index < 1_000 ? 0 : 1
+        case .info:
+            return 2
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(index, _):
+            return index
+        case let .pack(index, _, _, _):
+            return index
+        case .info:
+            return 10_000
+        }
+    }
+
+    static func ==(lhs: LunagramChatStickersEntry, rhs: LunagramChatStickersEntry) -> Bool {
+        switch lhs {
+        case let .header(lhsIndex, lhsText):
+            if case let .header(rhsIndex, rhsText) = rhs, lhsIndex == rhsIndex, lhsText == rhsText {
+                return true
+            }
+            return false
+        case let .pack(lhsIndex, lhsInfo, _, lhsCount):
+            if case let .pack(rhsIndex, rhsInfo, _, rhsCount) = rhs, lhsIndex == rhsIndex, lhsInfo.id == rhsInfo.id, lhsCount == rhsCount {
+                return true
+            }
+            return false
+        case let .info(lhsText):
+            if case let .info(rhsText) = rhs, lhsText == rhsText {
+                return true
+            }
+            return false
+        }
+    }
+
+    static func <(lhs: LunagramChatStickersEntry, rhs: LunagramChatStickersEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! LunagramChatStickersArguments
+        switch self {
+        case let .header(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .pack(_, info, topItem, count):
+            return ItemListStickerPackItem(
+                presentationData: presentationData,
+                context: arguments.context,
+                packInfo: info,
+                itemCount: count,
+                topItem: topItem,
+                unread: false,
+                control: .none,
+                editing: ItemListStickerPackItemEditing(editable: false, editing: false, revealed: false, reorderable: false, selectable: false),
+                enabled: true,
+                playAnimatedStickers: true,
+                sectionId: self.section,
+                action: {
+                    arguments.open(.id(id: info.id.id, accessHash: info.accessHash))
+                },
+                setPackIdWithRevealedOptions: { _, _ in
+                },
+                addPack: {
+                },
+                removePack: {
+                },
+                toggleSelected: {
+                }
+            )
+        case let .info(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+func lunagramChatStickersController(context: AccountContext, peerId: EnginePeer.Id) -> ViewController {
+    let arguments = LunagramChatStickersArguments(context: context, open: { reference in
+        let navigationController = context.sharedContext.mainWindow?.viewController as? NavigationController
+        let controller = StickerPackScreen(context: context, mainStickerPack: reference, stickerPacks: [reference], parentNavigationController: navigationController)
+        navigationController?.pushViewController(controller)
+    })
+
+    let loaded: Signal<(LunagramChatStickersData, [StickerPackReference: LoadedStickerPack]), NoError> = lunagramScanChat(context: context, peerId: peerId, depth: LunagramSettings.chatStickersDepth)
+    |> mapToSignal { data -> Signal<(LunagramChatStickersData, [StickerPackReference: LoadedStickerPack]), NoError> in
+        let references = data.emoji.map { $0.reference } + data.stickers.map { $0.reference }
+        if references.isEmpty {
+            return .single((data, [:]))
+        }
+        let packs = references.map { reference -> Signal<(StickerPackReference, LoadedStickerPack), NoError> in
+            return context.engine.stickers.loadedStickerPack(reference: reference, forceActualized: false)
+            |> filter { pack in
+                if case .fetching = pack {
+                    return false
+                }
+                return true
+            }
+            |> take(1)
+            |> map { pack -> (StickerPackReference, LoadedStickerPack) in
+                return (reference, pack)
+            }
+        }
+        return combineLatest(packs)
+        |> map { results -> (LunagramChatStickersData, [StickerPackReference: LoadedStickerPack]) in
+            var map: [StickerPackReference: LoadedStickerPack] = [:]
+            for (reference, pack) in results {
+                map[reference] = pack
+            }
+            return (data, map)
+        }
+    }
+
+    let signal = combineLatest(context.sharedContext.presentationData, loaded)
+    |> deliverOnMainQueue
+    |> map { presentationData, value -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let (data, packs) = value
+        var entries: [LunagramChatStickersEntry] = []
+
+        func append(_ found: [LunagramFoundPack], base: Int32, title: String) {
+            var index = base
+            var added = false
+            for item in found {
+                guard let pack = packs[item.reference], case let .result(info, items, _) = pack else {
+                    continue
+                }
+                if !added {
+                    entries.append(.header(base - 1, title))
+                    added = true
+                }
+                entries.append(.pack(index, info, items.first, "встретилось \(item.count)"))
+                index += 1
+            }
+        }
+
+        append(data.emoji, base: 1, title: "НАБОРЫ ЭМОДЗИ")
+        append(data.stickers, base: 1_001, title: "НАБОРЫ СТИКЕРОВ")
+
+        if entries.isEmpty {
+            entries.append(.info("В сохранённых сообщениях этой переписки своих эмодзи и стикеров не нашлось. Пролистай её подальше и загляни снова: считаем только то, что уже лежит на телефоне."))
+        } else {
+            entries.append(.info("Просмотрено сообщений: \(data.scanned). Считаем только сохранённое на телефоне — у сервера ничего не спрашиваем.\n\nНажми на набор, чтобы открыть его и добавить себе."))
+        }
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Эмодзи и стикеры чата"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
