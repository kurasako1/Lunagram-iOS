diff --git a/submodules/Lunagram/Sources/LunagramComposeButton.swift b/submodules/Lunagram/Sources/LunagramComposeButton.swift
new file mode 100644
index 00000000..6c88a0ba
--- /dev/null
+++ b/submodules/Lunagram/Sources/LunagramComposeButton.swift
@@ -0,0 +1,97 @@
+import Foundation
+
+/// Что делает кнопка «написать» — карандаш справа вверху списка чатов.
+///
+/// Задумка из Custom FAB (@itsv1eds, @immat0x1). В исходном плагине речь
+/// о плавающей круглой кнопке, но её нет ни в iPhone-версии Telegram, ни
+/// в настольной: там «написать» — это карандаш в шапке. Придумывать ради
+/// переноса чужую круглую кнопку я не стал — настраивается то, что есть.
+public enum LunagramComposeButton {
+    /// Куда ведёт карандаш.
+    public enum Action: Int, CaseIterable {
+        /// Как в обычном Telegram — выбор, кому написать.
+        case compose
+        /// Избранное, оно же «Сохранённые сообщения».
+        case saved
+        /// Список звонков.
+        case calls
+        /// Поиск по чатам — тот же, что по нажатию на строку поиска.
+        case search
+        /// Чей-то профиль по номеру.
+        case peer
+
+        public var title: String {
+            switch self {
+            case .compose:
+                return "Как обычно"
+            case .saved:
+                return "Избранное"
+            case .calls:
+                return "Звонки"
+            case .search:
+                return "Поиск"
+            case .peer:
+                return "Чей-то профиль"
+            }
+        }
+    }
+
+    private static let hiddenKey = "lunagram.compose.hidden"
+    private static let actionKey = "lunagram.compose.action"
+    private static let peerKey = "lunagram.compose.peer"
+
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    /// Убрать карандаш совсем.
+    public static var hidden: Bool {
+        get {
+            guard defaults.object(forKey: hiddenKey) != nil else {
+                return false
+            }
+            return defaults.bool(forKey: hiddenKey)
+        }
+        set {
+            defaults.set(newValue, forKey: hiddenKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Что делать по нажатию.
+    public static var action: Action {
+        get {
+            let raw = defaults.integer(forKey: actionKey)
+            return Action(rawValue: raw) ?? .compose
+        }
+        set {
+            defaults.set(newValue.rawValue, forKey: actionKey)
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Чей профиль открывать, если выбран профиль. Номер храним строкой:
+    /// он длиннее, чем помещается в обычное целое у настроек.
+    public static var peerId: Int64? {
+        get {
+            guard let text = defaults.string(forKey: peerKey), let value = Int64(text), value != 0 else {
+                return nil
+            }
+            return value
+        }
+        set {
+            if let newValue, newValue != 0 {
+                defaults.set(String(newValue), forKey: peerKey)
+            } else {
+                defaults.removeObject(forKey: peerKey)
+            }
+            LunagramSettings.changed()
+        }
+    }
+
+    /// Трогаем ли мы карандаш вообще. Пока не трогаем — весь наш разбор
+    /// в сторону, и кнопка ведёт себя как в обычном Telegram.
+    public static var isCustomized: Bool {
+        return self.hidden || self.action != .compose
+    }
+}
