diff --git a/submodules/TelegramUI/Sources/Chat/ChatControllerLunagramReplyToDeleted.swift b/submodules/TelegramUI/Sources/Chat/ChatControllerLunagramReplyToDeleted.swift
new file mode 100644
index 00000000..89016c9c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Chat/ChatControllerLunagramReplyToDeleted.swift
@@ -0,0 +1,86 @@
+import Foundation
+import Postbox
+import TelegramCore
+import AccountContext
+import TelegramStringFormatting
+
+// Lunagram: ответ на удалённое сообщение, как в AyuGram.
+//
+// Удалённое собеседником у нас сохранено, а у сервера его уже нет — и
+// сослаться на него в ответе нельзя: сервер такого номера не знает. Поэтому
+// обычная ссылка на ответ снимается, а в начало своего сообщения ставится
+// цитата: имя автора и начало его текста. Имя — упоминанием, чтобы автор
+// получил уведомление, как при обычном ответе. В личке имени нет — и так
+// понятно, чья это цитата.
+
+extension ChatControllerImpl {
+    /// Сообщение, на которое отвечают, — если это сохранённое у нас удалённое.
+    /// Ищем сначала в панели ответа, потом в загруженной ленте: пока человек
+    /// пишет ответ, сообщение наверняка там.
+    func lunagramDeletedReplyTarget(_ id: MessageId) -> Message? {
+        let isDeleted: (Message) -> Bool = { message in
+            return message.attributes.contains(where: { $0 is LunagramDeletedMessageAttribute })
+        }
+        if let reply = self.presentationInterfaceState.replyMessage, reply.id == id {
+            return isDeleted(reply) ? reply : nil
+        }
+        if let message = self.chatDisplayNode.historyNode.messageInCurrentHistoryView(id)?._asMessage() {
+            return isDeleted(message) ? message : nil
+        }
+        return nil
+    }
+
+    /// Текст и атрибуты сообщения с цитатой удалённого в начале.
+    func lunagramPseudoReply(text: String, attributes: [MessageAttribute], replied: Message, quote: String?) -> (String, [MessageAttribute]) {
+        // Имя — везде, кроме лички с тем же человеком.
+        let chatPeerId = self.chatLocation.peerId
+        let isSamePrivateChat = chatPeerId?.namespace == Namespaces.Peer.CloudUser && replied.id.peerId == chatPeerId
+        var name = ""
+        if !isSamePrivateChat, let author = replied.author {
+            name = EnginePeer(author).displayTitle(strings: self.presentationData.strings, displayOrder: self.presentationData.nameDisplayOrder)
+        }
+
+        // Цитата — выделенный кусок, если отвечали на него, иначе текст
+        // сообщения; у вложения без подписи — его описание («Фотография»).
+        var quoted = quote ?? replied.text
+        if quoted.isEmpty {
+            quoted = descriptionStringForMessage(contentSettings: self.context.currentContentSettings.with { $0 }, message: EngineMessage(replied), strings: self.presentationData.strings, nameDisplayOrder: self.presentationData.nameDisplayOrder, dateTimeFormat: self.presentationData.dateTimeFormat, accountPeerId: self.context.account.peerId).0.string
+        }
+        // Как в AyuGram — не длиннее ста знаков.
+        if quoted.count >= 100 {
+            quoted = String(quoted.prefix(99)) + "\u{2026}"
+        }
+
+        let prefix = name.isEmpty ? quoted : name + "\n" + quoted
+        let newText = text.isEmpty ? prefix : prefix + "\n" + text
+
+        // Отметки в тексте считаются в знаках UTF-16, и все свои сдвигаем на
+        // длину цитаты — иначе жирное и ссылки уехали бы на чужие буквы.
+        let prefixLength = (prefix as NSString).length
+        let shift = prefixLength + (text.isEmpty ? 0 : 1)
+        var entities: [MessageTextEntity] = []
+        var otherAttributes: [MessageAttribute] = []
+        for attribute in attributes {
+            if let textEntities = attribute as? TextEntitiesMessageAttribute {
+                entities = textEntities.entities.map { entity -> MessageTextEntity in
+                    var entity = entity
+                    entity.range = (entity.range.lowerBound + shift) ..< (entity.range.upperBound + shift)
+                    return entity
+                }
+            } else {
+                otherAttributes.append(attribute)
+            }
+        }
+        entities.insert(MessageTextEntity(range: 0 ..< prefixLength, type: .BlockQuote(isCollapsed: false)), at: 0)
+        if !name.isEmpty {
+            let nameLength = (name as NSString).length
+            entities.append(MessageTextEntity(range: 0 ..< nameLength, type: .Bold))
+            // Упоминание — только у людей: у канала уведомлений нет.
+            if let author = replied.author, author is TelegramUser {
+                entities.append(MessageTextEntity(range: 0 ..< nameLength, type: .TextMention(peerId: author.id)))
+            }
+        }
+        otherAttributes.append(TextEntitiesMessageAttribute(entities: entities))
+        return (newText, otherAttributes)
+    }
+}
