--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatMessageDateAndStatusNode/Sources/LunagramDeletedIcon.swift
@@ -0,0 +1,43 @@
+import Foundation
+import UIKit
+
+// Lunagram: значок удалённого — корзинка, как в AyuGram.
+//
+// Картинку AyuGram не берём: их настольная версия под GPLv3, а Telegram для
+// iOS — под GPLv2, и смешивать их нельзя. Рисуем системной корзинкой iOS:
+// она почти такая же — залитый бак с крышкой, — а разрешение на неё даёт
+// сама Apple всем приложениям.
+//
+// Цвет — цвет времени рядом, размер — от шрифта времени. Готовые картинки
+// запоминаются: сообщений с корзинкой на экране может быть много, а цветов
+// и размеров — пара штук.
+
+private let lunagramDeletedIconLock = NSLock()
+private var lunagramDeletedIconCache: [String: UIImage] = [:]
+
+func lunagramDeletedIcon(color: UIColor, baseFontSize: CGFloat) -> UIImage? {
+    // Шрифт времени — 11/17 от основного; корзинка чуть мельче букв.
+    let pointSize = floor(baseFontSize * 10.0 / 17.0)
+    var red: CGFloat = 0.0
+    var green: CGFloat = 0.0
+    var blue: CGFloat = 0.0
+    var alpha: CGFloat = 0.0
+    color.getRed(&red, green: &green, blue: &blue, alpha: &alpha)
+    let key = "\(Int(red * 255.0))-\(Int(green * 255.0))-\(Int(blue * 255.0))-\(Int(alpha * 255.0))-\(Int(pointSize))"
+
+    // Узел времени раскладывается и не на главном потоке — отсюда замок.
+    lunagramDeletedIconLock.lock()
+    defer {
+        lunagramDeletedIconLock.unlock()
+    }
+    if let cached = lunagramDeletedIconCache[key] {
+        return cached
+    }
+    let configuration = UIImage.SymbolConfiguration(pointSize: pointSize, weight: .semibold)
+    guard let symbol = UIImage(systemName: "trash.fill", withConfiguration: configuration) else {
+        return nil
+    }
+    let image = symbol.withTintColor(color, renderingMode: .alwaysOriginal)
+    lunagramDeletedIconCache[key] = image
+    return image
+}
