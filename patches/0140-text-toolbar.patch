+        case .strikethrough:
+            self.formatAttributesStrikethrough(self)
+        case .monospace:
+            self.formatAttributesMonospace(self)
+        case .spoiler:
+            self.formatAttributesSpoiler(self)
+        case .quote:
+            self.formatAttributesQuote(self)
+        case .link:
