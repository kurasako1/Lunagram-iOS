diff --git a/submodules/TelegramUI/Components/Chat/ChatTextInputPanelNode/Sources/LunagramTextToolbar.swift b/submodules/TelegramUI/Components/Chat/ChatTextInputPanelNode/Sources/LunagramTextToolbar.swift
