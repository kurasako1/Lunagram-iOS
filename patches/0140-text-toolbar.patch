+import Foundation
+import UIKit
+import Display
+
+// Lunagram: панель работы с текстом над клавиатурой.
+//
+// Четыре группы: оформление текста, работа с написанным, стрелки по тексту,
+// упомянуть и эмодзи. Стоит она в том месте, которое iOS отводит под свою
+// полоску над клавиатурой, — значит появляется и уезжает вместе с клавиатурой
+// сама, и разметку переписки не двигает.
+//
+// Кнопок много, а экран узкий, поэтому панель прокручивается вбок. Группы
+// разделены тонкими чёрточками: так видно, где кончается одна и начинается
+// другая, без подписей.
+
+enum LunagramToolbarAction {
+    // Оформление текста.
+    case bold
+    case italic
+    case underline
+    case strikethrough
+    case monospace
+    case spoiler
+    case quote
+    case link
+    // Работа с написанным.
+    case cut
+    case copy
+    case paste
+    case selectAll
+    case clear
+    // Стрелки по тексту.
+    case home
+    case wordLeft
+    case left
+    case right
+    case wordRight
+    case end
+    // Упомянуть и эмодзи.
+    case mention
+    case emoji
+}
+
+private struct LunagramToolbarButton {
+    let action: LunagramToolbarAction
+    let symbol: String
+}
+
+/// Порядок групп — тот, что назвал хозяин: сперва оформление, потом работа с
+/// написанным, потом стрелки, потом упоминание и эмодзи.
+private let lunagramToolbarGroups: [[LunagramToolbarButton]] = [
+    [
+        LunagramToolbarButton(action: .bold, symbol: "bold"),
+        LunagramToolbarButton(action: .italic, symbol: "italic"),
+        LunagramToolbarButton(action: .underline, symbol: "underline"),
+        LunagramToolbarButton(action: .strikethrough, symbol: "strikethrough"),
+        LunagramToolbarButton(action: .monospace, symbol: "chevron.left.forwardslash.chevron.right"),
+        LunagramToolbarButton(action: .spoiler, symbol: "eye.slash"),
+        LunagramToolbarButton(action: .quote, symbol: "text.quote"),
+        LunagramToolbarButton(action: .link, symbol: "link")
+    ],
+    [
+        LunagramToolbarButton(action: .cut, symbol: "scissors"),
+        LunagramToolbarButton(action: .copy, symbol: "doc.on.doc"),
+        LunagramToolbarButton(action: .paste, symbol: "doc.on.clipboard"),
+        LunagramToolbarButton(action: .selectAll, symbol: "textformat.abc.dottedunderline"),
+        LunagramToolbarButton(action: .clear, symbol: "trash")
+    ],
+    [
+        LunagramToolbarButton(action: .home, symbol: "arrow.left.to.line"),
+        LunagramToolbarButton(action: .wordLeft, symbol: "chevron.left.2"),
+        LunagramToolbarButton(action: .left, symbol: "chevron.left"),
+        LunagramToolbarButton(action: .right, symbol: "chevron.right"),
+        LunagramToolbarButton(action: .wordRight, symbol: "chevron.right.2"),
+        LunagramToolbarButton(action: .end, symbol: "arrow.right.to.line")
+    ],
+    [
+        LunagramToolbarButton(action: .mention, symbol: "at"),
+        LunagramToolbarButton(action: .emoji, symbol: "face.smiling")
+    ]
+]
+
+final class LunagramTextToolbarView: UIView {
+    private let scrollView = UIScrollView()
+    private let separator = UIView()
+    private var buttons: [UIButton] = []
+    private var dividers: [UIView] = []
+    private var actions: [Int: LunagramToolbarAction] = [:]
+
+    var pressed: ((LunagramToolbarAction) -> Void)?
+
+    init() {
+        super.init(frame: CGRect(origin: CGPoint(), size: CGSize(width: 320.0, height: 44.0)))
+
+        self.autoresizingMask = [.flexibleWidth]
+        self.scrollView.showsHorizontalScrollIndicator = false
+        self.scrollView.alwaysBounceHorizontal = true
+        self.addSubview(self.scrollView)
+        self.addSubview(self.separator)
+
+        var tag = 0
+        for (index, group) in lunagramToolbarGroups.enumerated() {
+            if index > 0 {
+                let divider = UIView()
+                self.dividers.append(divider)
+                self.scrollView.addSubview(divider)
+            }
+            for item in group {
+                let button = UIButton(type: .system)
+                button.tag = tag
+                self.actions[tag] = item.action
+                tag += 1
+                let configuration = UIImage.SymbolConfiguration(pointSize: 17.0, weight: .regular)
+                button.setImage(UIImage(systemName: item.symbol, withConfiguration: configuration), for: .normal)
+                button.addTarget(self, action: #selector(self.buttonPressed(_:)), for: .touchUpInside)
+                self.buttons.append(button)
+                self.scrollView.addSubview(button)
+            }
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        preconditionFailure()
+    }
+
+    /// Цвета берём у темы переписки: панель стоит вплотную к полосе ввода, и
+    /// своя раскраска выпадала бы из неё.
+    func update(background: UIColor, tint: UIColor, separator separatorColor: UIColor) {
+        self.backgroundColor = background
+        self.separator.backgroundColor = separatorColor
+        for button in self.buttons {
+            button.tintColor = tint
+        }
+        for divider in self.dividers {
+            divider.backgroundColor = separatorColor
+        }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+
+        let height = self.bounds.height
+        self.separator.frame = CGRect(origin: CGPoint(), size: CGSize(width: self.bounds.width, height: UIScreenPixel))
+        self.scrollView.frame = self.bounds
+
+        let buttonWidth: CGFloat = 40.0
+        let groupSpacing: CGFloat = 10.0
+        var x: CGFloat = 8.0
+        var buttonIndex = 0
+        var dividerIndex = 0
+        for (index, group) in lunagramToolbarGroups.enumerated() {
+            if index > 0 {
+                if dividerIndex < self.dividers.count {
+                    x += groupSpacing
+                    self.dividers[dividerIndex].frame = CGRect(x: x, y: floor((height - 20.0) / 2.0), width: UIScreenPixel, height: 20.0)
+                    dividerIndex += 1
+                    x += groupSpacing
+                }
+            }
+            for _ in group {
+                if buttonIndex < self.buttons.count {
+                    self.buttons[buttonIndex].frame = CGRect(x: x, y: 0.0, width: buttonWidth, height: height)
+                    buttonIndex += 1
+                    x += buttonWidth
+                }
+            }
+        }
+        self.scrollView.contentSize = CGSize(width: x + 8.0, height: height)
+    }
+
+    @objc private func buttonPressed(_ sender: UIButton) {
+        guard let action = self.actions[sender.tag] else {
+            return
+        }
+        self.pressed?(action)
+    }
+}
+
+/// Стрелки по тексту. Считаем по знакам, а не по «ячейкам» поля ввода: слово
+/// ищем по ближайшему пробелу, как это делает любой редактор.
+func lunagramToolbarMoveCaret(_ textView: UITextView, action: LunagramToolbarAction) {
+    let text = textView.text as NSString
+    let length = text.length
+    let range = textView.selectedRange
+    // От выделения отталкиваемся от того края, куда идём: так стрелка после
+    // выделения ведёт себя привычно, а не прыгает в середину.
+    let start = range.location
+    let end = range.location + range.length
+
+    func wordBoundary(from position: Int, forward: Bool) -> Int {
+        var index = position
+        let separators = CharacterSet.whitespacesAndNewlines
+        func isSeparator(_ at: Int) -> Bool {
+            guard at >= 0, at < length else {
+                return true
+            }
+            guard let scalar = Unicode.Scalar(text.character(at: at)) else {
+                return false
+            }
+            return separators.contains(scalar)
+        }
+        if forward {
+            while index < length, isSeparator(index) {
+                index += 1
+            }
+            while index < length, !isSeparator(index) {
+                index += 1
+            }
+        } else {
+            while index > 0, isSeparator(index - 1) {
+                index -= 1
+            }
+            while index > 0, !isSeparator(index - 1) {
+                index -= 1
+            }
+        }
+        return index
+    }
+
+    var target: Int
+    switch action {
+    case .home:
+        target = 0
+    case .end:
+        target = length
+    case .left:
+        target = range.length > 0 ? start : max(0, start - 1)
+    case .right:
+        target = range.length > 0 ? end : min(length, end + 1)
+    case .wordLeft:
+        target = wordBoundary(from: start, forward: false)
+    case .wordRight:
+        target = wordBoundary(from: end, forward: true)
+    default:
+        return
+    }
+    target = max(0, min(length, target))
+    textView.selectedRange = NSRange(location: target, length: 0)
+    textView.scrollRangeToVisible(textView.selectedRange)
+}
