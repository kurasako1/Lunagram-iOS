+    /// Поставить или снять растворение нижнего края.
+    ///
+    /// Маску вешаем на СЕБЯ, а не на contentView: внутри и картинка, и
+    /// затемнение, и размытие — таять они должны вместе, иначе на хвосте
+    /// останется висеть затемнение без картинки.
+    ///
+    /// Ноль — маску снимаем совсем. Пустая маска стоит кадра на каждой
+    /// перерисовке шапки, а шапку перерисовывают на каждом движении
+    /// прокрутки.
+    private func lunagramLayoutFade(size: CGSize) {
+        let share = CGFloat(LunagramSettings.profileBannerFade) / 100.0
+        guard share > 0.001, size.height > 1.0, size.width > 1.0 else {
+            if self.layer.mask === self.fadeMask {
+                self.layer.mask = nil
+            }
+            return
+        }
+        if self.layer.mask !== self.fadeMask {
+            self.layer.mask = self.fadeMask
+        }
+        // Шапку тянут и отпускают — рамку маски двигаем без анимации,
+        // иначе хвост отстаёт от баннера и на миг видно шов.
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.fadeMask.frame = CGRect(origin: CGPoint(), size: size)
+        self.fadeMask.locations = [
+            0.0,
+            NSNumber(value: Float(1.0 - share)),
+            1.0,
+        ]
+        CATransaction.commit()
+    }
